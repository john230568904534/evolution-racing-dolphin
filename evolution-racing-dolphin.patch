+// Evolution Racing emit-quads hook: a graphics-mod action that draws its OWN extra geometry when a target
+// draw happens. After the target draw (optionally skipped) it issues N camera-facing quads
+// (6 * N vertices, no vertex buffer: the quads are built in the vertex shader from gl_VertexID)
+// with a custom vertex + pixel shader pair read from files, using the target draw's depth test and
+// either its blending or an additive / alpha blend. The shaders get the instance index, time_ms,
+// the target draw's view-space centroid / AABB / bounding radius / position matrix, its screen-space
+// bounding box, the same anchor from the previous frame, and 16 user floats from the json.
+
+#pragma once
+
+#include <array>
+#include <map>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include <picojson.h>
+
+#include "Common/CommonTypes.h"
+#include "VideoCommon/GraphicsModSystem/Runtime/GraphicsModAction.h"
+#include "VideoCommon/RenderState.h"
