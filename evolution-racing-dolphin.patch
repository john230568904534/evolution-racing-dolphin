+// Evolution Racing dolphin-lit17s14m: a tiny always-compiled profiler for the graphics-mod effects.
+// On when the Dolphin user dir holds a file "pc5090prof" (checked once); then every 600 frames stderr gets
+// "EQPROF" lines: ms per frame spent in each graphics-mod feature group's callbacks (video thread), in the shared
+// racer snapshot, and in the Vulkan waits / submits. Off = one predictable branch per callback.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <string>
+
+namespace PC5090Prof
+{
+bool Enabled();
+bool ShareCopies();
+bool NoSnapshot();
+bool NoCopyShare();
+bool NoHalfRes();
+bool HrNoClear();  // EXPERIMENT file "pc5090hrnoclear": the half-res target is not cleared per emit  // user dir file "pc5090nohalfres": every effect at full resolution (A/B)  // user dir file "pc5090noshare": every action keeps its own EFB copies (A/B)
+// EFB content generations: bumped by everything that can change the EFB colour / depth (game draws, emit draws,
+// clears, pokes, reinterprets). Two actions whose copy would be taken at the same generation get the same pixels,
+// so the second one re-uses the first one's copy (exact; lit17s14m).
+extern uint64_t g_scene_gen, g_depth_gen, g_stage, g_game_gen;  // g_game_gen: game draws / clears only (no effect quads)
+// stages: one shared copy per stage; a stage ends at a full-screen pass (night grade, weather, screen water) and at
+// EFB clears / reinterprets / pokes
+inline void BumpStage() { g_stage++; }
+bool StageScene();  // file "pc5090stagescene" (A/B)
+bool StageDepth();  // file "pc5090stagedepth" (A/B)
+inline void BumpScene() { g_scene_gen++; }
+inline void BumpDepth() { g_depth_gen++; }
+inline void BumpBoth() { g_scene_gen++; g_depth_gen++; }
+inline void BumpAll() { g_scene_gen++; g_depth_gen++; g_stage++; g_game_gen++; }
+inline void BumpGame() { g_scene_gen++; g_game_gen++; }  // user dir file "pc5090nosnap": the old per-action racer reads (A/B)  // user dir file "pc5090sharecopy": EXPERIMENT, one scene / depth copy per frame for all actions
+inline uint64_t NowNs()
+{
+  return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                   std::chrono::steady_clock::now().time_since_epoch())
+                                   .count());
+}
+enum Counter : int
+{
+  VkWaitWorker = 0,  // video thread waiting for the submit thread
+  VkWaitFence,       // video thread in vkWaitForFences
+  VkSubmitCalls,     // command buffers submitted (count)
+  VkSyncSubmits,     // of those, submitted with wait_for_completion (count)
+  VkQueueSubmit,     // vkQueueSubmit (any thread)
+  VkPresent,         // vkQueuePresentKHR (any thread)
+  RacerSnapshot,     // the shared per-frame racer RAM read
+  ModFrameEnd,       // EmitQuadsAction::OnGlobalFrameEnd + every action's OnFrameEnd
+  AnchorCompute,     // VertexManagerBase: ComputeEmitQuadsAnchor for draws with emitters
+  FlushTotal,        // VertexManagerBase::Flush, whole (video thread)
+  EmitDraws,         // emit_quads utility draws (count)
+  SceneCopies,       // full-EFB colour copies by emit_quads actions (count)
+  DepthCopies,       // full-EFB depth copies (count)
+  ShaderCompileNs,   // backend shader compiles from source (any thread)
+  ShaderCompiles,    // (count)
+  PipelineNs,        // backend pipeline creations
+  Pipelines,         // (count)
+  NumCounters
+};
+extern std::atomic<uint64_t> g_counters[NumCounters];
+inline void Add(Counter c, uint64_t v)
+{
+  g_counters[c].fetch_add(v, std::memory_order_relaxed);
+}
+struct Scope
+{
+  Counter c;
+  uint64_t t0;
+  explicit Scope(Counter c_) : c(c_), t0(Enabled() ? NowNs() : 0) {}
+  ~Scope()
+  {
+    if (t0)
+      Add(c, NowNs() - t0);
+  }
+};
+// per feature group (video thread only)
+int GroupId(const char* name);
+void AddGroup(int id, uint64_t ns);
+void FrameEnd();  // called once per frame from the video thread
+// GPU timing (user-dir file "pc5090gpuprof"): the backend writes a timestamp pair around each effect pass;
+// results come back when the command buffer is reused. id = feature group (GroupId), -1 = whole command buffer
+bool GpuEnabled();
+extern void (*g_gpu_mark)(int id, bool end);
+inline void GpuMark(int id, bool end)
+{
+  if (g_gpu_mark && GpuEnabled())
+    g_gpu_mark(id, end);
+}
+void AddGroupGpu(int id, uint64_t ns);
+void AddGpuCmdBuf(uint64_t ns);
+void SetNextName(const std::string& n);
+const std::string& NextName();
+}  // namespace PC5090Prof
