+// Evolution Racing lit17s35mv: the members' per-group effect switches (GFX.ini [PC5090] Fx<Group> = On | Off, e.g.
+// FxWeather = Off), read by emit_quads and custom_pipeline features with "group_switch" (the effects pack sets it)
+bool ERFxSwitchOn(const std::string& name)
+{
+  return FxSwitchOn(name);
+}
+
+// ---- Evolution Racing lit17s30 BOOST REWORK ----
+// Boost tracker (every frame while a "boost_core" / "pads" action exists, from RefreshRacerEvents): per racer a KICK =
+// a boost start (+0x0 bit 0x20 rising) or a dash plate hit during a boost (bit 0x00400000 rising, or the boost timer
+// +0x18A jumping up); its strength = manual (0) or the plate's: the boost code sets the timer to 0.5 x 60 x the
+// boost duration +0x234 for a stock plate, 57 x for a 1.5x plate and 90 x for a 2x plate (the dash plate strength
+// patch, docs fzgx-custom game-code.md), so timer / (30 x duration) = 1 / 1.9 / 3. CHAIN: kicks less than the chain
+// window apart (or while still boosting) count up; the level eases towards the count and falls back after the chain.
+// FOV KICK (player, GFX.ini [PC5090] BoostFov): the race camera's fov (camera 0 = [REL + 0x1BAFAC], +0x08, camera.c
+// fn_1_90E0) gets a short widening + settle on each kick, scaled by the kick strength and the chain. The game eases
+// its own fov every frame (fov += r x (target - fov)); we add our offset K(t) on top and give back what the game's
+// step took from our offset (r from the same branch as the game: boosting 0.1 then 0.2, else 0.01..0.05), so the
+// game's own boost widening (to 1.35 x, camera.c) runs unchanged underneath. Paused (frame counter 0x801A66A0 still)
+// = held. Only the normal chase camera (+0xA8 == 0) of the player's racer, mode 2 / sub-mode 41 (race).
+// PADS: the dash plates from the course's static collider (lbl_1_bss_3BE0 = REL .bss + 0x3BE0 -> Stcoli: +0x18 cells,
+// +0x1C cell array (0x4B0 each); a cell: +0x24 triangles (0x58), +0x28 per-layer triangle lists [11], +0x60 grid
+// x0 z0 sx sz nx nz, +0x78 quads (0x70), +0x7C per-layer quad lists; layer 3 = dash, 0 = driveable, 2 = wall (the
+// 1.5x / 2x markers under a plate); stcoli.c fn_1_163BC), read once per course: polygons joined by shared corners
+// into plates (centre, up, along / across axes from the corner spread, half sizes), strength from the markers.
+namespace
+{
+struct BoostRacer
+{
+  bool kick_ever = false;
+  u32 kick_ms = 0;
+  float strength = 1.0f;  // 0 manual, 1 / 1.5 / 2 plate
+  int count = 0;
+  float level = 0.0f;
+  float env = 0.0f;
+  u32 last_ms = 0;
+  int cap_frames = 0;
+  u32 cap_timer = 0;
+  bool cap_plate = false;
+  u32 prev_timer = 0;
+  bool plate_ever = false;
+  u32 plate_ms = 0;
+  float speed = 0.0f;
+  bool sonic_above = false, sonic_ever = false;
+  u32 sonic_ms = 0;
+};
+std::array<BoostRacer, 64> s_bst;
+struct BoostCfg
+{
+  float chain_ms = 1800.0f;
+  float fov_deg = 5.0f, fov_max = 12.0f, fov_attack = 85.0f, fov_hold = 70.0f, fov_settle = 560.0f;
+  float fov_chain = 0.22f;  // + per extra kick in the chain
+  float sonic_kmh = 1500.0f;
+  bool fov = true;
+};
+BoostCfg s_bcfg;
+u32 s_bst_arr = 0;
+u32 s_bst_trace = 0;  // user-dir file pc5090boosttrace: BOOST lines on stderr
+
+struct Pad
+{
+  std::array<float, 3> c{}, up{}, along{}, across{};
+  float hl = 0.0f, hw = 0.0f, strength = 1.0f;
+  bool hit_ever = false;
+  u32 hit_ms = 0;
+  bool dir_known = false;  // lit17s33p: along = the course's forward (checkpoint direction)
+};
+struct PadScan
+{
+  u32 key_rel = 0, key_st = 0, key_cells = 0, key_slot = 0xFFFFFFFFu, key_arr = 0;
+  std::vector<Pad> pads;
+  bool scanned = false;
+  u64 tried_frame = ~0ull;
+};
+PadScan s_pads;
+std::array<float, 12> s_pad_view{};  // lit17s33p
+u64 s_pad_view_frame = ~0ull;
+
+float PlateStrength(float k) { return k < 1.45f ? 1.0f : (k < 2.45f ? 1.5f : 2.0f); }
+
+void PadNoteHit(const std::array<float, 3>& pos, u32 now)
+{
+  float best = 1e30f;
+  Pad* bp = nullptr;
+  for (Pad& p : s_pads.pads)
+  {
+    const float lim = std::max(p.hl, p.hw) + 12.0f;
+    const float d = Dist2(pos, p.c);
+    if (d < lim * lim && d < best)
+    {
+      best = d;
+      bp = &p;
+    }
+  }
+  if (bp)
+  {
+    bp->hit_ever = true;
+    bp->hit_ms = now;
+  }
+}
+
+void BoostConfigure(const picojson::object& g)
+{
+  const auto num = [&](const char* k, float def) {
+    const auto n = ReadNumericFromJson<double>(g, k);
+    return n ? static_cast<float>(*n) : def;
+  };
+  s_bcfg.chain_ms = num("chain_ms", 1800.0f);
+  s_bcfg.fov_deg = num("fov_deg", 5.0f);
+  s_bcfg.fov_max = num("fov_max", 12.0f);
+  s_bcfg.fov_attack = std::max(num("fov_attack_ms", 85.0f), 1.0f);
+  s_bcfg.fov_hold = std::max(num("fov_hold_ms", 70.0f), 0.0f);
+  s_bcfg.fov_settle = std::max(num("fov_settle_ms", 560.0f), 1.0f);
+  s_bcfg.fov_chain = num("fov_chain", 0.22f);
+  s_bcfg.sonic_kmh = num("sonic_kmh", 1500.0f);
+  s_bcfg.fov = num("fov", 1.0f) > 0.5f;
+  s_bst_trace = File::Exists(File::GetUserPath(D_USER_IDX) + "pc5090boosttrace") ? 1 : 0;
+  std::fprintf(stderr, "BOOSTFX core: chain %.0f ms, fov %s %.1f deg (max %.1f), sonic %.0f km/h%s\n", s_bcfg.chain_ms,
+               s_bcfg.fov ? "on" : "off", s_bcfg.fov_deg, s_bcfg.fov_max, s_bcfg.sonic_kmh, s_bst_trace ? " (trace)" : "");
+}
+
+void BoostUpdate(u32 i, const u8* r, u32 fl, u32 prev, u32 now, bool have, bool jump, const std::array<float, 3>& pos)
+{
+  if (i >= s_bst.size())
+    return;
+  if (s_rs.arr != s_bst_arr)
+  {
+    s_bst = {};  // a new race
+    s_bst_arr = s_rs.arr;
+  }
+  BoostRacer& b = s_bst[i];
+  const s32 dts = static_cast<s32>(now - b.last_ms);
+  const float dt = (b.last_ms != 0 && dts > 0 && dts < 250) ? static_cast<float>(dts) / 1000.0f : 0.0f;
+  b.last_ms = now;
+  const float spd = EvF32(r + 0x17C);
+  b.speed = std::isfinite(spd) ? spd : 0.0f;
+  const bool boosting = (fl & 0x20u) != 0;
+  {
+    const float tgt = boosting ? 1.0f : 0.0f;
+    const float tau = tgt > b.env ? 0.045f : 0.30f;
+    b.env = dt > 0.0f ? b.env + (tgt - b.env) * (1.0f - std::exp(-dt / tau)) : tgt;
+  }
+  const u32 timer = r[0x18A];
+  if (have && !jump)
+  {
+    const u32 rise = fl & ~prev;
+    bool kick = false, plate = false;
+    if (rise & 0x20u)
+    {
+      kick = true;
+      plate = (fl & 0x00200000u) != 0;
+    }
+    else if (boosting && (prev & 0x20u))
+    {
+      // a plate during a boost: the touch edge (a one-frame bit, can be missed from this thread) or the timer reset
+      const bool touch = (rise & 0x00400000u) != 0;
+      const bool reset = timer > b.prev_timer + 3;
+      if ((touch || reset) && (!b.plate_ever || static_cast<s32>(now - b.plate_ms) > 220))
+      {
+        kick = true;
+        plate = true;
+      }
+    }
+    if (plate || (rise & 0x00400000u))
+    {
+      b.plate_ever = true;
+      b.plate_ms = now;
+    }
+    if (kick)
+    {
+      const s32 since = static_cast<s32>(now - b.kick_ms);
+      const bool alive = b.kick_ever && since >= 0 && (static_cast<float>(since) < s_bcfg.chain_ms || (prev & 0x20u));
+      b.count = alive ? std::min(b.count + 1, 6) : 1;
+      b.kick_ever = true;
+      b.kick_ms = now;
+      b.cap_frames = 4;
+      b.cap_timer = 0;
+      b.cap_plate = plate;
+      b.strength = plate ? 1.0f : 0.0f;
+      if (plate)
+        PadNoteHit(pos, now);
+    }
+    if (b.cap_frames > 0)
+    {
+      b.cap_frames--;
+      b.cap_timer = std::max(b.cap_timer, timer);
+      const float dur = EvF32(r + 0x234);
+      if (b.cap_plate && dur > 0.05f && dur < 20.0f)
+        b.strength = PlateStrength(static_cast<float>(b.cap_timer) / (30.0f * dur));
+      if (b.cap_frames == 0 && s_bst_trace)
+        std::fprintf(stderr, "BOOST f=%llu t=%u racer=%u kick %s timer=%u dur=%.3f k=%.2f strength=%.1f chain=%d spd=%.0f\n",
+                     static_cast<unsigned long long>(s_global_frame), now, i, b.cap_plate ? "plate" : "manual",
+                     b.cap_timer, dur, dur > 0.0f ? static_cast<float>(b.cap_timer) / (30.0f * dur) : 0.0f, b.strength,
+                     b.count, b.speed);
+    }
+    // sonic threshold crossing (hysteresis 60 km/h)
+    if (!b.sonic_above && b.speed > s_bcfg.sonic_kmh)
+    {
+      b.sonic_above = true;
+      b.sonic_ever = true;
+      b.sonic_ms = now;
+    }
+    else if (b.sonic_above && b.speed < s_bcfg.sonic_kmh - 60.0f)
+      b.sonic_above = false;
+  }
+  b.prev_timer = timer;
+  // chain level: towards the kick count while the chain lives (boosting, or within the window of the last kick)
+  const s32 since = static_cast<s32>(now - b.kick_ms);
+  const bool alive = b.kick_ever && since >= 0 && (boosting || static_cast<float>(since) < s_bcfg.chain_ms);
+  const float tgt = alive ? static_cast<float>(b.count) : 0.0f;
+  const float tau = tgt > b.level ? 0.08f : 0.6f;
+  b.level = dt > 0.0f ? b.level + (tgt - b.level) * (1.0f - std::exp(-dt / tau)) : tgt;
+  if (!alive && b.level < 0.02f)
+    b.count = 0;
+}
+
+bool BoostRacerMachine(int racer, float* machine)
+{
+  if (racer < 0 || !s_rs.ok || static_cast<u32>(racer) >= s_rs.count)
+    return false;
+  *machine = static_cast<float>(s_rs.machine[racer]);
+  return true;
+}
+
+void BoostFill(int racer, EmitQuadsUniforms& u)
+{
+  if (racer < 0 || racer >= static_cast<int>(s_bst.size()) || s_rs.arr != s_bst_arr || !RefreshRacerEvents(s_now_ms))
+    return;
+  const BoostRacer& b = s_bst[racer];
+  const bool chain = FxSwitchOn("BoostChain");
+  const bool looks = FxSwitchOn("BoostPadLooks");
+  const s32 since = static_cast<s32>(s_now_ms - b.kick_ms);
+  const s32 ss = static_cast<s32>(s_now_ms - b.sonic_ms);
+  float strength = b.strength;
+  if (!looks && strength > 1.0f)
+    strength = 1.0f;
+  u.boost = {b.env, (b.kick_ever && since >= 0) ? static_cast<float>(since) : 1e6f, strength,
+             chain ? b.level : std::min(b.level, 1.0f)};
+  u.boost2 = {chain ? static_cast<float>(b.count) : std::min(static_cast<float>(b.count), 1.0f), b.speed,
+              (b.sonic_ever && ss >= 0) ? static_cast<float>(ss) : 1e6f, 1.0f};
+}
+
+// ---- the FOV kick ----
+struct FovKick
+{
+  bool have_kick = false;
+  u32 kick_ms = 0;   // the tracker's kick time we follow
+  float t = 1e9f;    // ms into the kick (advanced only while the game runs)
+  float amp = 0.0f;
+  float applied = 0.0f;  // the offset in the fov after our last write
+  float written = 0.0f;
+  bool have_written = false;
+  u32 cam = 0;
+  u32 last_frames = 0;
+  u32 last_ms = 0;
+  float last_speed = 0.0f;
+  bool logged = false;
+};
+FovKick s_fov;
+
+float FovShape(float t)
+{
+  const float a = s_bcfg.fov_attack, h = s_bcfg.fov_hold, st = s_bcfg.fov_settle;
+  if (t < 0.0f)
+    return 0.0f;
+  if (t < a)
+  {
+    const float x = t / a;
+    return x * x * (3.0f - 2.0f * x);
+  }
+  if (t < a + h)
+    return 1.0f;
+  const float x = (t - a - h) / st;
+  if (x >= 1.0f)
+    return 0.0f;
+  // settle: eased fall with a slight undershoot-free tail (cosine ease)
+  return 0.5f + 0.5f * std::cos(3.14159265f * x);
+}
+
+void FovRelease(Memory::MemoryManager& memory)
+{
+  // put the game's own value back when we stop in the middle of a kick
+  if (s_fov.have_written && s_fov.applied != 0.0f && s_fov.cam)
+  {
+    if (u8* p = PC5090TryPointer(memory, s_fov.cam + 8, 4))
+    {
+      u32 v;
+      std::memcpy(&v, p, 4);
+      v = Common::swap32(v);
+      float cur;
+      std::memcpy(&cur, &v, 4);
+      if (std::isfinite(cur))
+      {
+        cur -= s_fov.applied;
+        std::memcpy(&v, &cur, 4);
+        v = Common::swap32(v);
+        std::memcpy(p, &v, 4);
+      }
+    }
+  }
+  s_fov.applied = 0.0f;
+  s_fov.have_written = false;
+  s_fov.t = 1e9f;
+}
+
+void BoostFov(u32 now)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  if (!s_bcfg.fov || !FxSwitchOn("BoostFov") || !s_rs.ok)
+  {
+    FovRelease(memory);
+    return;
+  }
+  const auto rd32 = [&](u32 a, u32* o) {
+    const u8* p = PC5090TryPointer(memory, a, 4);
+    if (!p)
+      return false;
+    u32 v;
+    std::memcpy(&v, p, 4);
+    *o = Common::swap32(v);
+    return true;
+  };
+  const u32 base = s_rs.base;
+  u32 ms = 0, cams = 0, frames = 0;
+  // mode 2 = GAME (the race sub-mode seen live is 0x24, not the KB's 41) + the race gate (venue < 256, no demo)
+  u32 gv = 0, gs = 0;
+  bool gdemo = false;
+  const bool race = rd32(base + 0x1BA9A0u, &ms) && (ms >> 16) == 2 && ReadGate(&gv, &gs, &gdemo) && gv < 256 && !gdemo;
+  if (!race || !rd32(base + 0x1BAFACu, &cams) || cams < 0x80000000u || cams >= 0x817FFE00u ||
+      !rd32(0x801A66A0u, &frames))
+  {
+    if (s_bst_trace && (s_global_frame % 120) == 0)
+      std::fprintf(stderr, "BOOSTFOV off: mode %08x cams %08x\n", ms, cams);
+    FovRelease(memory);
+    return;
+  }
+  const int pr = EventPlayerRacer();
+  u32 w2 = 0, wa8 = 0, w88 = 0;
+  if (pr < 0 || !rd32(cams, &w2) || static_cast<s16>(w2 & 0xFFFFu) != pr || !rd32(cams + 0xA8, &wa8) ||
+      static_cast<s16>(wa8 >> 16) != 0 || !rd32(cams + 0x88, &w88))
+  {
+    if (s_bst_trace && (s_global_frame % 120) == 0)
+      std::fprintf(stderr, "BOOSTFOV off: player %d cam+0 %08x cam+a8 %08x\n", pr, w2, wa8);
+    FovRelease(memory);
+    return;
+  }
+  if (s_fov.cam != cams)
+  {
+    s_fov = {};
+    s_fov.cam = cams;
+  }
+  const BoostRacer& b = s_bst[pr];
+  const s32 dms = static_cast<s32>(now - s_fov.last_ms);
+  s_fov.last_ms = now;
+  const bool running = frames != s_fov.last_frames;  // the game's unpaused frame counter moved
+  s_fov.last_frames = frames;
+  if (b.kick_ever && (!s_fov.have_kick || b.kick_ms != s_fov.kick_ms))
+  {
+    s_fov.have_kick = true;
+    s_fov.kick_ms = b.kick_ms;
+    const float sf = b.strength <= 0.0f ? 1.0f : (b.strength < 1.25f ? 0.85f : (b.strength < 1.75f ? 1.3f : 1.7f));
+    const float ch = 1.0f + s_bcfg.fov_chain * static_cast<float>(std::max(b.count - 1, 0));
+    // a kick inside a running one starts from the current offset's level
+    const float cur_level = s_fov.amp * FovShape(s_fov.t);
+    s_fov.amp = std::min(s_bcfg.fov_deg * sf * ch, s_bcfg.fov_max);
+    s_fov.t = (cur_level > 0.0f && s_fov.amp > 0.0f) ?
+                  s_bcfg.fov_attack * std::clamp(cur_level / s_fov.amp, 0.0f, 0.9f) * 0.5f :
+                  0.0f;
+  }
+  if (running && dms > 0 && dms < 250)
+    s_fov.t += static_cast<float>(dms);
+  u8* p = PC5090TryPointer(memory, cams + 8, 4);
+  if (!p)
+    return;
+  u32 v;
+  std::memcpy(&v, p, 4);
+  v = Common::swap32(v);
+  float cur;
+  std::memcpy(&cur, &v, 4);
+  if (!std::isfinite(cur) || cur < 10.0f || cur > 170.0f)
+    return;
+  const float K = s_fov.amp * FovShape(s_fov.t);
+  if (K == 0.0f && s_fov.applied == 0.0f)
+  {
+    s_fov.have_written = false;
+    return;
+  }
+  // the game's own value: our last offset minus what its easing step took of it (no step if the value is ours)
+  float r = 0.0f;
+  if (!(s_fov.have_written && cur == s_fov.written))
+  {
+    const s32 c88 = static_cast<s32>(w88);
+    const bool boosting = b.env > 0.5f;
+    const bool accel = b.speed > s_fov.last_speed;
+    if (c88 > 10)
+      r = accel ? 0.2f : 0.01f;
+    else if (boosting)
+      r = 0.1f;
+    else
+      r = std::clamp(0.05f - 4e-5f * b.speed, 0.01f, 0.05f);
+  }
+  s_fov.last_speed = b.speed;
+  const float game = cur - s_fov.applied * (1.0f - r);
+  float out = std::min(game + K, 150.0f);
+  std::memcpy(&v, &out, 4);
+  v = Common::swap32(v);
+  std::memcpy(p, &v, 4);
+  if (s_bst_trace && (K != 0.0f || s_fov.applied != 0.0f))
+    std::fprintf(stderr, "BOOSTFOV f=%llu t=%u kick_t=%.0f amp=%.2f K=%.2f game=%.2f cur=%.2f out=%.2f r=%.2f\n",
+                 static_cast<unsigned long long>(s_global_frame), now, s_fov.t, s_fov.amp, K, game, cur, out, r);
+  s_fov.applied = out - game;
+  s_fov.written = out;
+  s_fov.have_written = true;
+}
+
+// ---- the dash plates ----
+bool PadRead32(Memory::MemoryManager& m, u32 a, u32* o)
+{
+  const u8* p = PC5090TryPointer(m, a, 4);
+  if (!p)
+    return false;
+  *o = EvU32(p);
+  return true;
+}
+bool PadInRam(u32 a) { return a >= 0x80000000u && a < 0x81800000u; }
+
+struct RawPoly
+{
+  std::array<std::array<float, 3>, 4> v{};
+  int nv = 0;
+  std::array<float, 3> n{};
+  std::array<float, 3> c{};
+};
+
+void PadCollect(Memory::MemoryManager& m, u32 cell, int layer, std::vector<RawPoly>* out)
+{
+  float g[4];
+  u32 nx = 0, nz = 0;
+  for (int k = 0; k < 4; k++)
+  {
+    const u8* p = PC5090TryPointer(m, cell + 0x60 + 4 * k, 4);
+    g[k] = p ? EvF32(p) : 0.0f;
+  }
+  if (!PadRead32(m, cell + 0x70, &nx) || !PadRead32(m, cell + 0x74, &nz) || nx == 0 || nz == 0 || nx > 4096 ||
+      nz > 4096 || nx * nz > 1u << 20)
+    return;
+  for (int type = 0; type < 2; type++)
+  {
+    const u32 polys_at = cell + (type == 0 ? 0x24u : 0x78u);
+    const u32 lists_at = cell + (type == 0 ? 0x28u : 0x7Cu);
+    const u32 stride = type == 0 ? 0x58u : 0x70u;
+    const int nv = type == 0 ? 3 : 4;
+    u32 polys = 0, arr = 0;
+    if (!PadRead32(m, polys_at, &polys) || !PadInRam(polys) || !PadRead32(m, lists_at + 4u * layer, &arr) ||
+        !PadInRam(arr))
+      continue;
+    const u8* ap = PC5090TryPointer(m, arr, nx * nz * 4u);
+    if (!ap)
+      continue;
+    std::vector<u16> seen;
+    for (u32 idx = 0; idx < nx * nz; idx++)
+    {
+      const u32 lp = EvU32(ap + 4 * idx);
+      if (!PadInRam(lp))
+        continue;
+      for (u32 k = 0; k < 4096; k++)
+      {
+        const u8* q = PC5090TryPointer(m, lp + 2 * k, 2);
+        if (!q)
+          break;
+        const s16 pi = static_cast<s16>((q[0] << 8) | q[1]);
+        if (pi < 0)
+          break;
+        seen.push_back(static_cast<u16>(pi));
+      }
+    }
+    std::sort(seen.begin(), seen.end());
+    seen.erase(std::unique(seen.begin(), seen.end()), seen.end());
+    for (u16 pi : seen)
+    {
+      const u8* q = PC5090TryPointer(m, polys + pi * stride, stride);
+      if (!q)
+        continue;
+      RawPoly rp;
+      rp.nv = nv;
+      bool ok = true;
+      for (int k = 0; k < 3; k++)
+        rp.n[k] = EvF32(q + 4 + 4 * k);
+      for (int j = 0; j < nv; j++)
+        for (int k = 0; k < 3; k++)
+        {
+          rp.v[j][k] = EvF32(q + 0x10 + 12 * j + 4 * k);
+          ok = ok && std::abs(rp.v[j][k]) < 1e6f;
+          rp.c[k] += rp.v[j][k] / static_cast<float>(nv);
+        }
+      if (ok)
+        out->push_back(rp);
+    }
+  }
+  (void)g;
+}
+
+// lit17s33p PADPLATE: each plate's forward = the course direction at it. The course header (st = REL bss 0x3BE0,
+// ColiHeader) +0x08 track node count, +0x0C nodes (12 bytes: checkpoint count, checkpoint pointer, root segment);
+// a checkpoint is 0x50 bytes: planeStart origin +0x18, planeEnd origin +0x34 (world). The nearest checkpoint segment
+// to the plate centre gives the direction; along / across are flipped to point forward (across keeps the handedness).
+float PadF32(const u8* p) { return EvF32(p); }
+void PadDirections(Memory::MemoryManager& m, u32 st)
+{
+  u32 nn = 0, nodes = 0;
+  if (!PadRead32(m, st + 0x08, &nn) || !PadRead32(m, st + 0x0C, &nodes) || nn == 0 || nn > 8192 || !PadInRam(nodes))
+    return;
+  struct Seg { std::array<float, 3> a, b; };
+  std::vector<Seg> segs;
+  segs.reserve(nn);
+  for (u32 i = 0; i < nn; i++)
+  {
+    u32 cnt = 0, cps = 0;
+    if (!PadRead32(m, nodes + i * 12, &cnt) || !PadRead32(m, nodes + i * 12 + 4, &cps) || cnt == 0 || cnt > 4 ||
+        !PadInRam(cps))
+      continue;
+    for (u32 k = 0; k < cnt; k++)
+    {
+      const u8* q = PC5090TryPointer(m, cps + k * 0x50, 0x50);
+      if (!q)
+        continue;
+      Seg g;
+      for (int j = 0; j < 3; j++)
+      {
+        g.a[j] = PadF32(q + 0x18 + 4 * j);
+        g.b[j] = PadF32(q + 0x34 + 4 * j);
+      }
+      if (!(std::isfinite(g.a[0]) && std::isfinite(g.b[0])) || Dist2(g.a, g.b) < 1e-4f || Dist2(g.a, g.b) > 4e6f)
+        continue;
+      segs.push_back(g);
+    }
+  }
+  if (segs.empty())
+    return;
+  int known = 0, flipped = 0;
+  for (Pad& p : s_pads.pads)
+  {
+    float best = 1e30f;
+    const Seg* bs = nullptr;
+    for (const Seg& g : segs)
+    {
+      const std::array<float, 3> ab = {g.b[0] - g.a[0], g.b[1] - g.a[1], g.b[2] - g.a[2]};
+      const float l2 = ab[0] * ab[0] + ab[1] * ab[1] + ab[2] * ab[2];
+      float t = ((p.c[0] - g.a[0]) * ab[0] + (p.c[1] - g.a[1]) * ab[1] + (p.c[2] - g.a[2]) * ab[2]) / l2;
+      t = std::clamp(t, 0.0f, 1.0f);
+      const std::array<float, 3> q = {g.a[0] + ab[0] * t, g.a[1] + ab[1] * t, g.a[2] + ab[2] * t};
+      const float d = Dist2(q, p.c);
+      if (d < best)
+      {
+        best = d;
+        bs = &g;
+      }
+    }
+    if (!bs || best > 150.0f * 150.0f)
+      continue;
+    const std::array<float, 3> f = {bs->b[0] - bs->a[0], bs->b[1] - bs->a[1], bs->b[2] - bs->a[2]};
+    const float dt = f[0] * p.along[0] + f[1] * p.along[1] + f[2] * p.along[2];
+    if (dt < 0.0f)
+    {
+      for (int j = 0; j < 3; j++)
+      {
+        p.along[j] = -p.along[j];
+        p.across[j] = -p.across[j];
+      }
+      flipped++;
+    }
+    p.dir_known = true;
+    known++;
+  }
+  std::fprintf(stderr, "BOOSTPADS directions: %d of %zu plates from %zu checkpoints (%d flipped)\n", known,
+               s_pads.pads.size(), segs.size(), flipped);
+}
+
+void PadScanNow(Memory::MemoryManager& m, u32 st)
+{
+  s_pads.pads.clear();
+  u32 ncells = 0, cells = 0;
+  if (!PadRead32(m, st + 0x18, &ncells) || !PadRead32(m, st + 0x1C, &cells) || ncells == 0 || ncells > 64 ||
+      !PadInRam(cells))
+    return;
+  std::vector<RawPoly> dash, drive, wall;
+  // cell 0 is in world space (the others carry a transform for moving parts: left out)
+  PadCollect(m, cells, 3, &dash);
+  if (dash.empty())
+    return;
+  PadCollect(m, cells, 0, &drive);
+  PadCollect(m, cells, 2, &wall);
+  // join polygons that share a corner (0.4 m) into plates
+  const size_t n = std::min<size_t>(dash.size(), 4096);
+  std::vector<int> par(n);
+  for (size_t i = 0; i < n; i++)
+    par[i] = static_cast<int>(i);
+  const auto find = [&](int x) {
+    while (par[x] != x)
+      x = par[x] = par[par[x]];
+    return x;
+  };
+  for (size_t i = 0; i < n; i++)
+    for (size_t j = i + 1; j < n; j++)
+    {
+      if (Dist2(dash[i].c, dash[j].c) > 80.0f * 80.0f)
+        continue;
+      bool share = false;
+      for (int a = 0; a < dash[i].nv && !share; a++)
+        for (int b = 0; b < dash[j].nv && !share; b++)
+          share = Dist2(dash[i].v[a], dash[j].v[b]) < 0.16f;
+      if (share)
+        par[find(static_cast<int>(i))] = find(static_cast<int>(j));
+    }
+  std::map<int, std::vector<size_t>> groups;
+  for (size_t i = 0; i < n; i++)
+    groups[find(static_cast<int>(i))].push_back(i);
+  for (const auto& [root, idx] : groups)
+  {
+    Pad pd;
+    std::vector<std::array<float, 3>> pts;
+    std::array<float, 3> nsum{};
+    for (size_t i : idx)
+    {
+      for (int a = 0; a < dash[i].nv; a++)
+        pts.push_back(dash[i].v[a]);
+      for (int k = 0; k < 3; k++)
+        nsum[k] += dash[i].n[k];
+    }
+    std::array<float, 3> c{};
+    for (const auto& q : pts)
+      for (int k = 0; k < 3; k++)
+        c[k] += q[k] / static_cast<float>(pts.size());
+    float nl = std::sqrt(nsum[0] * nsum[0] + nsum[1] * nsum[1] + nsum[2] * nsum[2]);
+    if (!(nl > 1e-6f))
+      continue;
+    std::array<float, 3> up = {nsum[0] / nl, nsum[1] / nl, nsum[2] / nl};
+    // in-plane basis, then the 2D spread of the corners: its main axis = along the plate
+    std::array<float, 3> t0 = std::abs(up[1]) < 0.9f ? std::array<float, 3>{0.0f, 1.0f, 0.0f} :
+                                                        std::array<float, 3>{1.0f, 0.0f, 0.0f};
+    std::array<float, 3> e1 = {up[1] * t0[2] - up[2] * t0[1], up[2] * t0[0] - up[0] * t0[2],
+                               up[0] * t0[1] - up[1] * t0[0]};
+    const float l1 = std::sqrt(e1[0] * e1[0] + e1[1] * e1[1] + e1[2] * e1[2]);
+    for (auto& x : e1)
+      x /= l1;
+    const std::array<float, 3> e2 = {up[1] * e1[2] - up[2] * e1[1], up[2] * e1[0] - up[0] * e1[2],
+                                     up[0] * e1[1] - up[1] * e1[0]};
+    float sxx = 0, sxy = 0, syy = 0;
+    for (const auto& q : pts)
+    {
+      const float dx = (q[0] - c[0]) * e1[0] + (q[1] - c[1]) * e1[1] + (q[2] - c[2]) * e1[2];
+      const float dy = (q[0] - c[0]) * e2[0] + (q[1] - c[1]) * e2[1] + (q[2] - c[2]) * e2[2];
+      sxx += dx * dx;
+      sxy += dx * dy;
+      syy += dy * dy;
+    }
+    const float ang = 0.5f * std::atan2(2.0f * sxy, sxx - syy);
+    std::array<float, 3> al, ac;
+    for (int k = 0; k < 3; k++)
+    {
+      al[k] = std::cos(ang) * e1[k] + std::sin(ang) * e2[k];
+      ac[k] = -std::sin(ang) * e1[k] + std::cos(ang) * e2[k];
+    }
+    float hl = 0.0f, hw = 0.0f;
+    for (const auto& q : pts)
+    {
+      const std::array<float, 3> d = {q[0] - c[0], q[1] - c[1], q[2] - c[2]};
+      hl = std::max(hl, std::abs(d[0] * al[0] + d[1] * al[1] + d[2] * al[2]));
+      hw = std::max(hw, std::abs(d[0] * ac[0] + d[1] * ac[1] + d[2] * ac[2]));
+    }
+    if (hl < hw)  // along = the longer side (plates are longer than wide)
+    {
+      std::swap(hl, hw);
+      std::swap(al, ac);
+    }
+    if (hw < 0.5f || hl > 200.0f)
+      continue;
+    // strength markers under the plate (the dash plate strength patch): driveable -> 1.5x, + wall -> 2x
+    const auto under = [&](const std::vector<RawPoly>& L) {
+      for (const RawPoly& q : L)
+      {
+        const std::array<float, 3> d = {q.c[0] - c[0], q.c[1] - c[1], q.c[2] - c[2]};
+        const float a = std::abs(d[0] * al[0] + d[1] * al[1] + d[2] * al[2]);
+        const float w = std::abs(d[0] * ac[0] + d[1] * ac[1] + d[2] * ac[2]);
+        const float h = std::abs(d[0] * up[0] + d[1] * up[1] + d[2] * up[2]);
+        if (a < hl + 2.0f && w < hw + 2.0f && h < 4.0f)
+          return true;
+      }
+      return false;
+    };
+    const bool dv = under(drive), wl = under(wall);
+    pd.strength = dv ? (wl ? 2.0f : 1.5f) : 1.0f;
+    pd.c = c;
+    pd.up = up;
+    pd.along = al;
+    pd.across = ac;
+    pd.hl = hl;
+    pd.hw = hw;
+    s_pads.pads.push_back(pd);
+    if (s_pads.pads.size() >= 512)
+      break;
+  }
+  PadDirections(m, st);  // lit17s33p
+}
+
+void BoostFrameEnd(u32 now)
+{
+  if (!RefreshRacerEvents(now))
+    return;
+  if (s_bst_refs > 0)
+    BoostFov(now);
+  if (s_pad_refs > 0)
+  {
+    auto& m = Core::System::GetInstance().GetMemory();
+    u32 venue = 0, slot = 0, st = 0, cells = 0;
+    bool demo = false;
+    if (!ReadGate(&venue, &slot, &demo) || venue >= 256 || !PadRead32(m, s_rs.base + 0x1BA040u + 0x3BE0u, &st) ||
+        !PadInRam(st) || !PadRead32(m, st + 0x1C, &cells))
+      return;
+    if (st != s_pads.key_st || cells != s_pads.key_cells || slot != s_pads.key_slot || s_rs.base != s_pads.key_rel ||
+        s_rs.arr != s_pads.key_arr || (!s_pads.scanned && s_global_frame - s_pads.tried_frame > 60))
+    {
+      s_pads.key_st = st;
+      s_pads.key_cells = cells;
+      s_pads.key_slot = slot;
+      s_pads.key_rel = s_rs.base;
+      s_pads.key_arr = s_rs.arr;
+      s_pads.tried_frame = s_global_frame;
+      const u64 t0 = PC5090Prof::NowNs();
+      PadScanNow(m, st);
+      s_pads.scanned = !s_pads.pads.empty();
+      int n15 = 0, n20 = 0;
+      for (const Pad& p : s_pads.pads)
+      {
+        n15 += p.strength == 1.5f;
+        n20 += p.strength == 2.0f;
+      }
+      std::fprintf(stderr, "BOOSTPADS slot %u venue %u: %zu plates (1.5x %d, 2x %d) in %.2f ms\n", slot, venue,
+                   s_pads.pads.size(), n15, n20, (PC5090Prof::NowNs() - t0) * 1e-6);
+      if (s_bst_trace)
+        for (const Pad& p : s_pads.pads)
+          std::fprintf(stderr, "BOOSTPAD c=(%.1f %.1f %.1f) up=(%.2f %.2f %.2f) along=(%.2f %.2f %.2f) %.1f x %.1f s=%.1f\n",
+                       p.c[0], p.c[1], p.c[2], p.up[0], p.up[1], p.up[2], p.along[0], p.along[1], p.along[2],
+                       2 * p.hl, 2 * p.hw, p.strength);
+    }
+  }
+}
