+// Evolution Racing lit13: WideScreenHackGate = "<term> [==|!= <term>]"; term = "[ADDR]" (u32 read from emulated RAM, optional
+// "&MASK") or a hex literal; a lone term means "!= 0". Evaluated once per presented frame on the video thread (as the
+// emit-quads RAM gates do). Unreadable RAM / an unparsable gate leave the hack ON (stock behaviour).
+struct HackGateTerm
+{
+  // Evolution Racing lit17s4: chain like the emit-quads RAM gates: "[A]" = {A}, "[[A]+O]" = {A, O} (read *A, add O, read),
+  // "[[[A]+O1]+O2]" = {A, O1, O2}; empty = a literal (value)
+  std::vector<u32> chain;
+  u32 value = 0;
+  u32 mask = 0xFFFFFFFFu;
+};
+struct HackGate
+{
+  std::string src;
+  bool valid = false;
+  HackGateTerm lhs, rhs;
+  int op = 0;  // 0: lhs != 0, 1: ==, 2: !=
+};
+
+bool ParseHex(const std::string& t, u32* out)
+{
+  if (t.empty())
+    return false;
+  char* end = nullptr;
+  *out = static_cast<u32>(std::strtoul(t.c_str(), &end, 16));
+  return end && !*end;
+}
+
+// "[X]" or "[X+O]" where X is "A" or another bracket: appends the chain (innermost address first)
+bool ParseDeref(const std::string& t, std::vector<u32>* chain)
+{
+  if (t.size() < 3 || t.front() != '[' || t.back() != ']')
+    return false;
+  const std::string in = t.substr(1, t.size() - 2);
+  if (in.front() == '[')
+  {
+    int depth = 0;
+    size_t close = std::string::npos;
+    for (size_t i = 0; i < in.size(); i++)
+    {
+      if (in[i] == '[')
+        depth++;
+      else if (in[i] == ']' && --depth == 0)
+      {
+        close = i;
+        break;
+      }
+    }
+    if (close == std::string::npos || !ParseDeref(in.substr(0, close + 1), chain))
+      return false;
+    const std::string rest = in.substr(close + 1);
+    u32 off = 0;
+    if (rest.empty())
+      off = 0;
+    else if (rest.front() != '+' || !ParseHex(rest.substr(1), &off))
+      return false;
+    chain->push_back(off);
+    return true;
+  }
+  u32 a = 0;
+  if (!ParseHex(in, &a))
+    return false;
+  chain->push_back(a);
+  return true;
+}
+
+bool ParseGateTerm(std::string t, HackGateTerm* out)
+{
+  t.erase(std::remove_if(t.begin(), t.end(), [](char c) { return std::isspace(static_cast<unsigned char>(c)); }),
+          t.end());
+  if (t.empty())
+    return false;
+  std::string mask;
+  if (const auto amp = t.rfind('&'); amp != std::string::npos)
+  {
+    mask = t.substr(amp + 1);
+    t = t.substr(0, amp);
+  }
+  if (t.front() == '[')
+  {
+    if (!ParseDeref(t, &out->chain))
+      return false;
+  }
+  else if (!ParseHex(t, &out->value))
+    return false;
+  if (!mask.empty() && !ParseHex(mask, &out->mask))
+    return false;
+  return true;
+}
+
+bool EvalGateTerm(const HackGateTerm& t, u32* out)
+{
+  u32 v = t.value;
+  if (!t.chain.empty())
+  {
+    auto& memory = Core::System::GetInstance().GetMemory();
+    const auto read32 = [&](u32 addr, u32* o) {
+      if (addr < 0x80000000u || addr >= 0x81800000u)
+        return false;
+      const u8* p = memory.GetPointerForRange(addr, 4);
+      if (!p)
+        return false;
+      u32 w;
+      std::memcpy(&w, p, 4);
+      *o = Common::swap32(w);
+      return true;
+    };
+    u32 a = t.chain[0];
+    for (size_t i = 1; i < t.chain.size(); i++)
+    {
+      u32 w = 0;
+      if (!read32(a, &w))
+        return false;
+      a = w + t.chain[i];
+    }
+    if (!read32(a, &v))
+      return false;
+  }
+  *out = v & t.mask;
+  return true;
+}
