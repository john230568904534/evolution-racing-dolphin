+std::string CourseSha1(int slot)
+{
+  std::string path;
+  {
+    std::lock_guard lk(s_mutex);
+    path = s_boot_disc;
+  }
+  if (path.empty() || slot < 0 || slot > 99)
+    return {};
+  const std::unique_ptr<DiscIO::Volume> vol = DiscIO::CreateVolume(path);
+  if (!vol)
+    return {};
+  const DiscIO::Partition part = vol->GetGamePartition();
+  const DiscIO::FileSystem* fs = vol->GetFileSystem(part);
+  if (!fs)
+    return {};
+  const auto info = fs->FindFileInfo(fmt::format("stage/COLI_COURSE{:02}.lz", slot));
+  if (!info || info->GetSize() == 0 || info->GetSize() > (64u << 20))
+    return {};
+  std::vector<u8> buf(info->GetSize());
+  if (DiscIO::ReadFile(*vol, part, info.get(), buf.data(), buf.size()) != buf.size())
+    return {};
+  return Hex(Common::SHA1::CalculateDigest(buf));
+}
