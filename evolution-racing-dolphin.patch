+
+std::vector<Ghost> TakeNew()
+{
+  std::vector<Ghost> out;
+  const std::string folder = GciFolder();
+  if (!File::IsDirectory(folder))
+    return out;
+  bool had_ledger = false;
+  const std::set<std::string> ledger = ReadLedger(&had_ledger);
+  for (const std::string& path : Common::DoFileSearch(folder, ".gci", false))
+  {
+    const std::string base = path.substr(path.find_last_of("/\\") + 1);
+    if (!base.starts_with("8P-GFZE-fzg"))
+      continue;
+    std::error_code ec;
+    const auto mtime = std::filesystem::last_write_time(StringToPath(path), ec);
+    const u64 sig = File::GetSize(path) ^
+                    (static_cast<u64>(ec ? 0 : mtime.time_since_epoch().count()) * 0x9E3779B97F4A7C15ull);
+    auto it = s_scan.find(path);
+    if (it != s_scan.end() && it->second.first == sig)
+      continue;
+    std::string text;
+    if (!File::ReadFileToString(path, text))
+      continue;
+    Ghost g;
+    g.data.assign(text.begin(), text.end());
+    g.path = path;
+    const std::string bad = Check(g.data, &g);
+    s_scan[path] = {sig, bad.empty() ? g.sha1 : std::string()};
+    if (!bad.empty())
+      continue;  // not a ghost (or not written completely yet): looked at again when it changes
+    if (ledger.contains(g.sha1) || s_offered.contains(g.sha1))
+      continue;
+    if (!had_ledger)
+    {
+      AppendLedger(g.sha1, "there-before");  // ghosts from before this feature are not sent
+      continue;
+    }
+    s_offered.insert(g.sha1);
+    out.push_back(std::move(g));
+  }
+  if (!had_ledger)
+  {
+    File::CreateFullPath(Dir());
+    if (!File::Exists(LedgerPath()))
+      File::WriteStringToFile(LedgerPath(), "");
+  }
+  return out;
+}
