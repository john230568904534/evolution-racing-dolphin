+bool OverlayOn()
+{
+  std::string m = Config::Get(GFX_PC5090_WEATHER_MENU);
+  for (auto& ch : m)
+    ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+  return m == "overlay";
+}
