+// Evolution Racing lit17s32 NIGHT LIGHT FADE: the machine lights' level (underglow, headlights, lamp units; player + CPUs) from
+// the night look: 0 day, "dusk" (default 0.65) at dusk, 1 night, eased over "ms" (host clock, so a Time change in the
+// pause menu fades behind the paused game instead of popping). Actions with "night_fade": {"dusk": d, "ms": t} get it
+// as params[15] = 1 + level (the shaders multiply their light by it; 0 = an older build: full), and their
+// "night_only" skip waits until the level has faded to 0.
+struct NightFade
+{
+  float dusk = 0.65f, ms = 900.0f;
+  u64 frame = ~0ull;
+  float level = 0.0f;
+  bool have = false;
+  std::chrono::steady_clock::time_point last{};
+};
+NightFade s_nf;
+float NightLightLevel()
+{
+  if (s_nf.frame == s_global_frame)
+    return s_nf.level;
+  s_nf.frame = s_global_frame;
+  const int look = NightLook();
+  const float target = look >= 2 ? 1.0f : (look == 1 ? s_nf.dusk : 0.0f);
+  const auto now = std::chrono::steady_clock::now();
+  const float dt = s_nf.have ? std::chrono::duration<float, std::milli>(now - s_nf.last).count() : 1e9f;
+  s_nf.last = now;
+  s_nf.have = true;
+  if (dt > 3000.0f || s_nf.ms <= 0.0f)
+    s_nf.level = target;  // first frame / after a long stall (a load): no fade
+  else
+  {
+    s_nf.level += (target - s_nf.level) * (1.0f - std::exp(-dt / s_nf.ms));
+    if (std::abs(target - s_nf.level) < 0.002f)
+      s_nf.level = target;
+  }
+  return s_nf.level;
+}
