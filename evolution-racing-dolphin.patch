+
+  auto* modes = new QGroupBox(tr("Ghost upload"));
+  auto* ml = new QVBoxLayout(modes);
+  auto* r_auto = new QRadioButton(tr("Auto - send every new or faster ghost"));
+  auto* r_ask = new QRadioButton(tr("Ask - show the track and time, send when I say so (default)"));
+  auto* r_off = new QRadioButton(tr("Off - send nothing (the memory card folder is not even looked at)"));
+  ml->addWidget(r_auto);
+  ml->addWidget(r_ask);
+  ml->addWidget(r_off);
+  lay->addWidget(modes);
+
+  auto* link = new QGroupBox(tr("Hub link"));
+  auto* ll = new QVBoxLayout(link);
+  auto* status = new QLabel;
+  status->setWordWrap(true);
+  ll->addWidget(status);
+  auto* row = new QHBoxLayout;
+  auto* code = new QLineEdit;
+  code->setPlaceholderText(tr("Link code from the hub's Ghosts page (erd_...)"));
+  auto* do_link = new QPushButton(tr("Link"));
+  row->addWidget(code, 1);
+  row->addWidget(do_link);
+  ll->addLayout(row);
+  auto* row2 = new QHBoxLayout;
+  auto* open = new QPushButton(tr("Open the hub's Ghosts page"));
+  auto* unlink = new QPushButton(tr("Unlink"));
+  row2->addWidget(open);
+  row2->addWidget(unlink);
+  row2->addStretch(1);
+  ll->addLayout(row2);
+  lay->addWidget(link);
+  auto* buttons = new QDialogButtonBox(QDialogButtonBox::Close);
+  lay->addWidget(buttons);
+  connect(buttons, &QDialogButtonBox::rejected, dlg, &QDialog::close);
+
+  auto refresh = [=] {
+    const ERGhosts::Settings s = ERGhosts::Load();
+    r_auto->setChecked(s.mode == ERGhosts::Mode::Auto);
+    r_ask->setChecked(s.mode == ERGhosts::Mode::Ask);
+    r_off->setChecked(s.mode == ERGhosts::Mode::Off);
+    status->setText(s.token.empty() ?
+                        tr("Not linked. Make a link code on the hub's Ghosts page (signed in) and paste it here.") :
+                        Q(fmt::format("Linked to {} as {}.", Host(s.hub),
+                                      s.username.empty() ? std::string("(checking...)") : s.username)));
+    unlink->setEnabled(!s.token.empty());
+  };
+  refresh();
+  connect(this, &MainWindow::ERGhostsChanged, dlg, refresh);
+  auto set_mode = [this](ERGhosts::Mode m) {
+    ERGhosts::Settings s = ERGhosts::Load();
+    s.mode = m;
+    ERGhosts::Save(s);
+    ERGhostProbe(false);
+  };
+
+  connect(r_auto, &QRadioButton::toggled, dlg, [=](bool on) { if (on) set_mode(ERGhosts::Mode::Auto); });
+  connect(r_ask, &QRadioButton::toggled, dlg, [=](bool on) { if (on) set_mode(ERGhosts::Mode::Ask); });
+  connect(r_off, &QRadioButton::toggled, dlg, [=](bool on) { if (on) set_mode(ERGhosts::Mode::Off); });
+  connect(do_link, &QPushButton::clicked, dlg, [=, this] {
+    std::string c = code->text().trimmed().toStdString(), hub;
+    const ERGhosts::Settings s = ERGhosts::Load();
+    if (c.starts_with("evoracing:"))
+    {
+      if (!ERGhosts::ParseLink(c, &c, &hub))
+        return ERNote("that is not a link code.");
+    }
+    if (!c.starts_with("erd_"))
+      return ERNote("a link code starts with erd_ (make one on the hub's Ghosts page).");
+    if (hub.empty())
+      hub = s.hub;
+    if (!ERGhosts::HubAllowed(hub))
+      return ERNote("that link points to an address this Dolphin does not send ghosts to: " + hub);
+    status->setText(tr("Linking..."));
+    ERGhostLink(c, hub);
+  });
+  connect(open, &QPushButton::clicked, dlg, [] {
+    QDesktopServices::openUrl(QUrl(Q(ERGhosts::Load().hub + "/hub/ghosts")));
+  });
+  connect(unlink, &QPushButton::clicked, dlg, [=, this] {
+    ERGhosts::Settings s = ERGhosts::Load();
+    s.token.clear();
+    s.username.clear();
+    ERGhosts::Save(s);
+    ERGhostProbe(false);
+    refresh();
+  });
+  dlg->resize(560, dlg->sizeHint().height());
+  dlg->show();
+}
