+  // staged depth too (A/B)
+  static int c = -1;
+  return StageScene() && FlagFile("pc5090stagedepth", &c);
+}
+bool NoSnapshot()
+{
+  static int s = -1;
+  if (s < 0)
+  {
+    s = File::Exists(File::GetUserPath(D_USER_IDX) + "pc5090nosnap") ? 1 : 0;
+    std::fprintf(stderr, "EQPROF nosnap -> %d\n", s);
+  }
+  return s == 1;
+}
+int GroupId(const char* name)
+{
+  for (size_t i = 0; i < s_names.size(); i++)
+    if (s_names[i] == name)
+      return static_cast<int>(i);
+  s_names.emplace_back(name);
+  s_group_ns.push_back(0);
+  s_group_calls.push_back(0);
+  s_group_gpu.push_back(0);
+  return static_cast<int>(s_names.size() - 1);
+}
+void (*g_gpu_mark)(int id, bool end) = nullptr;
+bool GpuEnabled()
+{
+  static int c = -1;
+  return FlagFile("pc5090gpuprof", &c);
+}
+void AddGroupGpu(int id, uint64_t ns)
+{
+  if (id >= 0 && static_cast<size_t>(id) < s_group_gpu.size())
+    s_group_gpu[id] += ns;
+}
+void AddGpuCmdBuf(uint64_t ns)
+{
+  s_gpu_cmdbuf += ns;
+  s_gpu_cmdbufs++;
+}
+void AddGroup(int id, uint64_t ns)
+{
+  if (id >= 0 && static_cast<size_t>(id) < s_group_ns.size())
+  {
+    s_group_ns[id] += ns;
+    s_group_calls[id]++;
+  }
+}
+void FrameEnd()
+{
+  if (!Enabled() && !GpuEnabled())
+    return;
+  const uint64_t now = NowNs();
+  {
+    // lit17s16: per-frame spikes (user-dir file "pc5090spikes"): a frame over 40 ms prints its breakdown
+    static int sp = -1;
+    static uint64_t prev_t = 0, prev_c[NumCounters] = {};
+    static uint64_t spike_frame = 0;
+    spike_frame++;
+    uint64_t d[NumCounters];
+    for (int c = 0; c < NumCounters; c++)
+    {
+      const uint64_t v = g_counters[c].load(std::memory_order_relaxed);
+      d[c] = v >= prev_c[c] ? v - prev_c[c] : v;
+      prev_c[c] = v;
+    }
+    if (FlagFile("pc5090spikes", &sp) && prev_t && now - prev_t > 40000000ull)
+    {
+      std::fprintf(stderr,
+                   "EQSPIKE t=%.3f f=%llu wall=%.1f ms flush=%.1f wait_worker=%.1f present=%.1f shaders=%llu (%.1f ms) "
+                   "pipelines=%llu (%.1f ms) emits=%llu copies=%llu+%llu\n",
+                   std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count(),
+                   static_cast<unsigned long long>(spike_frame), (now - prev_t) * 1e-6, d[FlushTotal] * 1e-6,
+                   d[VkWaitWorker] * 1e-6, d[VkPresent] * 1e-6, static_cast<unsigned long long>(d[ShaderCompiles]),
+                   d[ShaderCompileNs] * 1e-6, static_cast<unsigned long long>(d[Pipelines]), d[PipelineNs] * 1e-6,
+                   static_cast<unsigned long long>(d[EmitDraws]), static_cast<unsigned long long>(d[SceneCopies]),
+                   static_cast<unsigned long long>(d[DepthCopies]));
+    }
+    prev_t = now;
+  }
+  if (!s_t0)
+    s_t0 = now;
+  if (++s_frames < 600)
+    return;
+  const double f = static_cast<double>(s_frames), ms = 1e-6 / f;
+  std::fprintf(stderr, "EQPROF frames=%llu wall_ms_per_frame=%.3f\n", static_cast<unsigned long long>(s_frames),
+               (now - s_t0) * ms);
+  static const char* cn[NumCounters] = {"vk_wait_worker", "vk_wait_fence", "vk_submits", "vk_sync_submits",
+                                         "vk_queue_submit", "vk_present", "racer_snapshot", "mod_frame_end",
+                                         "anchor_compute", "flush_total", "emit_draws", "scene_copies",
+                                         "depth_copies", "shader_compile", "shader_compiles", "pipeline_create",
+                                         "pipelines"};
+  for (int c = 0; c < NumCounters; c++)
+  {
+    const uint64_t v = g_counters[c].exchange(0);
+    if (c == VkSubmitCalls || c == VkSyncSubmits || c == EmitDraws || c == SceneCopies || c == DepthCopies ||
+        c == ShaderCompiles || c == Pipelines)
+      std::fprintf(stderr, "EQPROF   %-22s %.2f /frame\n", cn[c], v / f);
+    else
+      std::fprintf(stderr, "EQPROF   %-22s %.3f ms\n", cn[c], v * ms);
+  }
+  double tot = 0;
+  for (size_t i = 0; i < s_names.size(); i++)
+    tot += s_group_ns[i] * ms;
+  std::fprintf(stderr, "EQPROF   groups_total           %.3f ms\n", tot);
+  double gtot = 0;
+  for (size_t i = 0; i < s_group_gpu.size(); i++)
+    gtot += s_group_gpu[i] * ms;
+  if (GpuEnabled())
+    std::fprintf(stderr, "EQPROF   gpu_effects_total      %.3f ms (gpu cmdbuf %.3f ms per frame, %llu bufs)\n", gtot,
+                 s_gpu_cmdbuf * ms, static_cast<unsigned long long>(s_gpu_cmdbufs));
+  s_gpu_cmdbuf = s_gpu_cmdbufs = 0;
+  for (size_t i = 0; i < s_group_gpu.size(); i++)
+  {
+    if (s_group_gpu[i])
+      std::fprintf(stderr, "EQPROF   gpu %-30s %.3f ms\n", s_names[i].c_str(), s_group_gpu[i] * ms);
+    s_group_gpu[i] = 0;
+  }
+  for (size_t i = 0; i < s_names.size(); i++)
+  {
+    if (s_group_calls[i])
+      std::fprintf(stderr, "EQPROF   group %-28s %.3f ms %.1f calls\n", s_names[i].c_str(), s_group_ns[i] * ms,
+                   s_group_calls[i] / f);
+    s_group_ns[i] = s_group_calls[i] = 0;
+  }
+  s_frames = 0;
+  s_t0 = now;
+}
+void SetNextName(const std::string& n)
+{
+  s_next_name = n;
+}
+const std::string& NextName()
+{
+  return s_next_name;
+}
