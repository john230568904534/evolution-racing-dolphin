+bool ReadU32(u32 a, u32* o)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const u8* p = PC5090TryPointer(memory, a, 4);
+  if (!p)
+    return false;
+  u32 v;
+  std::memcpy(&v, p, 4);
+  *o = Common::swap32(v);
+  return true;
+}
