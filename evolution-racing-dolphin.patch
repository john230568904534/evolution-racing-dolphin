+void MainWindow::ERUpdatePopup(const std::vector<ERUpdates::Item>& items)
+{
+  if (m_er_popup)
+    m_er_popup->close();
+  auto* dlg = new QDialog(this);
+  m_er_popup = dlg;
+  dlg->setAttribute(Qt::WA_DeleteOnClose);
+  dlg->setWindowTitle(tr("Evolution Racing updates"));
+  auto* lay = new QVBoxLayout(dlg);
+  std::vector<ERUpdates::Item> go;
+  u64 total = 0;
+  std::string lines;
+  // "Evolution Racing 1.3 -> 1.4": this setup's version and the newest the items bring (the hub's versions.json)
+  std::string newest = Common::GetERSetupVersion();
+  for (const auto& i : items)
+    if (!i.er_version.empty() && Common::ERVersionCompare(i.er_version, newest) > 0)
+      newest = i.er_version;
+  const std::string heading = newest == Common::GetERSetupVersion() ? std::string() :
+                              "Evolution Racing " + Common::GetERSetupVersion() + " \u2192 " + newest;
+  if (!heading.empty())
+    lines += "<h3>" + heading + "</h3>";
+  for (const auto& i : items)
+  {
+    std::string line = "<b>" + i.title + "</b>";
+    if (i.Ready())
+    {
+      line += " (" + ERUpdates::Human(i.size) + ")";
+      go.push_back(i);
+      total += i.size;
+    }
+    if (!i.detail.empty())
+      line += "<br><span style='color:gray'>" + i.detail + "</span>";
+    if (!i.note.empty())
+      line += "<br><i>" + i.note + "</i>";
+    lines += "<p>" + line + "</p>";
+  }
+  auto* text = new QLabel(Q(lines));
+  text->setTextFormat(Qt::RichText);
+  text->setWordWrap(true);
+  lay->addWidget(text);
+  auto* small = new QLabel(tr("It downloads in the background: keep playing. %1").arg(Q(OPTIONAL_LINE)));
+  small->setWordWrap(true);
+  small->setStyleSheet(QStringLiteral("color:gray;font-size:small"));
+  lay->addWidget(small);
+  auto* row = new QHBoxLayout;
+  auto* later = new QPushButton(tr("Later"));
+  auto* now = new QPushButton(go.empty() ? tr("Nothing to download yet") : tr("Update now (%1)").arg(Q(ERUpdates::Human(total))));
+  now->setEnabled(!go.empty());
+  now->setDefault(true);
+  QFont f = now->font();
+  f.setBold(true);
+  f.setPointSizeF(f.pointSizeF() * 1.2);
+  now->setFont(f);
+  now->setMinimumHeight(now->sizeHint().height() * 3 / 2);
+  row->addWidget(later);
+  row->addStretch(1);
+  row->addWidget(now);
+  lay->addLayout(row);
+  connect(later, &QPushButton::clicked, dlg, &QDialog::close);
+  connect(now, &QPushButton::clicked, dlg, [this, dlg, go] {
+    dlg->close();
+    ERUpdateStart(go);
+  });
+  dlg->setMinimumWidth(460);
+  dlg->show();
+  dlg->raise();
+  dlg->activateWindow();
+  if (!TestDir().empty())
+  {
+    std::string list;
+    for (const auto& i : items)
+      list += fmt::format("{} | {} | {} | {} | ready={}\n", i.kind, i.title, i.version, ERUpdates::Human(i.size), i.Ready() ? 1 : 0);
+    TestWrite("popup.txt", (heading.empty() ? std::string() : "heading | " + heading + "\n") + list, false);
+    QTimer::singleShot(700, dlg, [dlg, now] {
+      dlg->grab().save(QString::fromStdString(TestDir() + "popup.png"));
+      if (TestHas("accept"))
+        now->click();
+    });
+  }
+  if (!Core::IsUninitialized(m_system))
+    Core::DisplayMessage("Evolution Racing: updates are ready - see the Dolphin window.", 8000);
+}
+
+void MainWindow::ERUpdateStart(std::vector<ERUpdates::Item> items)
+{
+  // the Dolphin first (a pack that needs it waits for it), then the packs, small ones first
+  std::stable_sort(items.begin(), items.end(), [](const ERUpdates::Item& a, const ERUpdates::Item& b) {
+    if ((a.kind == "dolphin") != (b.kind == "dolphin"))
+      return a.kind == "dolphin";
+    return a.size < b.size;
+  });
+  auto run = std::make_shared<ERUpdateRun>();
+  m_er_run = run;
+  m_er_manual_pending = false;
+  ERUpdateOverlay(true);
+  m_er_upd_timer->start(500);
+  const ERGhosts::Settings s = ERGhosts::Load();
+  ERUpdates::Log(fmt::format("update started: {} item(s)", items.size()));
+  std::thread([run, s, items] {
+    for (const ERUpdates::Item& it : items)
+    {
+      if (run->cancel)
+        break;
+      {
+        std::lock_guard lk(run->mu);
+        run->current = it.title;
+      }
+      run->done = 0;
+      run->total = it.size;
+      std::string path, err;
+      const bool ok = ERUpdates::Download(s, it, &path, &err,
+                                          [run](u64 d, u64 t) {
+                                            run->done = d;
+                                            if (t)
+                                              run->total = t;
+                                            return !run->cancel;
+                                          },
+                                          &run->cancel);
+      std::lock_guard lk(run->mu);
+      if (!ok)
+      {
+        run->errors.push_back(it.title + ": " + err);
+        continue;
+      }
+      if (it.kind == "dolphin")
+      {
+        std::string msg;
+        run->current = "Unpacking the new Dolphin";
+        if (ERUpdates::StageDolphin(it, path, &msg))
+          run->dolphin = it.er_version.empty() ? "Evolution Racing Dolphin " + it.version : "Evolution Racing " + it.er_version;
+        else
+          run->errors.push_back(it.title + ": " + msg);
+      }
+      else if (it.after_dolphin || !ERUpdates::BuildHas(Common::GetERBuildStr(), it.needs))
+      {
+        ERUpdates::KeepForNewDolphin(it, path);
+        run->notes.push_back(it.title + ": installs with the new Dolphin");
+      }
+      else
+      {
+        run->ready.emplace_back(it, path);
+      }
+    }
+    run->finished = true;
+  }).detach();
+}
