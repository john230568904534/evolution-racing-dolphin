+bool WaitLockFree(const std::string& user_dir, int seconds)
+{
+  // the older folder's Dolphin (ERGhosts running.lock) must have closed before its saves are copied
+  const std::string lock = Strip(user_dir) + "/ERGhosts/running.lock";
+  if (!File::Exists(lock))
+    return true;
+  for (int i = 0; i < seconds * 4; ++i)
+  {
+#ifdef _WIN32
+    HANDLE h = CreateFileW(UTF8ToWString(lock).c_str(), GENERIC_READ | GENERIC_WRITE, 0, nullptr, OPEN_EXISTING,
+                           FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (h != INVALID_HANDLE_VALUE)
+    {
+      CloseHandle(h);
+      return true;
+    }
+#else
+    const int fd = open(lock.c_str(), O_RDWR | O_CLOEXEC);
+    if (fd < 0)
+      return true;
+    const bool free = flock(fd, LOCK_EX | LOCK_NB) == 0;
+    close(fd);  // (closing drops the lock again)
+    if (free)
+      return true;
+#endif
+    std::this_thread::sleep_for(std::chrono::milliseconds(250));
+  }
+  return false;
+}
+
+void CopyTree(const fs::path& from, const fs::path& to, bool hardlink, int* files)
+{
+  std::error_code ec;
+  if (!fs::is_directory(from, ec))
+    return;
+  for (auto it = fs::recursive_directory_iterator(from, ec); !ec && it != fs::recursive_directory_iterator(); it.increment(ec))
+  {
+    const fs::path rel = fs::relative(it->path(), from, ec);
+    const fs::path dst = to / rel;
+    if (it->is_directory(ec))
+    {
+      fs::create_directories(dst, ec);
+      continue;
+    }
+    fs::create_directories(dst.parent_path(), ec);
+    std::error_code e2;
+    if (fs::exists(dst, e2))
+      fs::remove(dst, e2);
+    bool ok = false;
+    if (hardlink)
+    {
+      fs::create_hard_link(it->path(), dst, e2);  // same disk: no second copy of the HD textures
+      ok = !e2;
+    }
+    if (!ok)
+      fs::copy_file(it->path(), dst, fs::copy_options::overwrite_existing, e2);
+    if (files)
+      ++*files;
+  }
+}
