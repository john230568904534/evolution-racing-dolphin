+bool SafeName(const std::string& s, bool allow_slash)
+{
+  if (s.empty() || s.size() > 200 || s.find("..") != std::string::npos || s[0] == '/')
+    return false;
+  for (char c : s)
+  {
+    const bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+                    c == '_' || c == '-' || c == '.' || (allow_slash && c == '/');
+    if (!ok)
+      return false;
+  }
+  return true;
+}
