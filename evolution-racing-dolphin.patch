+// Copyright 2026 Evolution Racing contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// The OPTIONAL updater of the Evolution Racing member Dolphin. Optional: it just makes updating easier (one click
+// instead of re-downloading); everything can still be downloaded by hand from the hub's Setup page.
+//
+// With the Dolphin linked to the member's hub account (the erd_ link code of Core/ERGhosts.h), it asks the hub what is
+// newer than what this Dolphin has: a newer Dolphin build, the effects pack (the member's own tier and effects), the HD
+// texture pack, the machine remasters and the HD textures / 3D scenery of the member's newest disc. Each download is
+// checked (size + sha256) before anything changes:
+//   - packs install in place, with a backup of what they replace, put back when anything fails;
+//   - a newer Dolphin goes into a NEW folder next to this one; its first start brings saves, settings, packs and the
+//     link over from this folder (what "Import old folder" does, plus the settings), and this folder then forwards to it.
+// Modes: Off, Notify (default: one small window lists what is new, "Update now" / "Later") or Auto (no window).
+// Play offline (ERGhosts::Settings::offline) stops every hub call, including this one.
+
+#pragma once
+
+#include <atomic>
+#include <functional>
+#include <string>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+#include "Core/ERGhosts.h"
+
+namespace ERUpdates
+{
+enum class Mode
+{
+  Off,
+  Notify,
+  Auto
+};
+
+struct Settings
+{
+  Mode mode = Mode::Notify;  // "Check for updates when Dolphin starts": Notify / Auto; Off = only when asked
+  bool asked = false;        // the first-start question was answered
+};
+
+Settings Load();
+void Save(const Settings& s);
+std::string ModeName(Mode m);
+
+// The package folder (the parent of the user folder), the user folder, User/ERUpdates/
+std::string TopDir();
+std::string UserDir();
+std::string Dir();
+std::string Platform();  // "linux" / "windows"
+// Updates come only from the project's hub (or a hub on this computer, for tests): a link to another address may send
+// ghosts there, but never installs anything from it.
+bool UpdateHubAllowed(const std::string& hub);
+// does member Dolphin `own` include build `need` (lit17s35mvu includes lit17s35mv)
+bool BuildHas(const std::string& own, const std::string& need);
+
+struct Item
+{
+  std::string id, kind, title, detail, version, url, sha256, needs, note, blocked, file;
+  std::string er_version;  // its Evolution Racing X.Y.Z (the hub's versions.json; "" = none)
+  u64 size = 0;
+  bool required = false, preparing = false, after_dolphin = false;
+  bool Ready() const { return blocked.empty() && !preparing && !sha256.empty() && size > 0; }
+};
+
+struct CheckResult
+{
+  int status = 0;
+  std::string error;
+  bool relink = false;  // 401: the link ended
+  std::vector<Item> items;
+};
+
+// What is newer (POST /hub/api/erd/updates). Never called while Play offline is on (returns an error).
+CheckResult Check(const ERGhosts::Settings& s);
+
+using ProgressFn = std::function<bool(u64 done, u64 total)>;
+// Download one item into User/ERUpdates/dl/ (resumes a cut one), check size + sha256. *path = the checked file.
+bool Download(const ERGhosts::Settings& s, const Item& it, std::string* path, std::string* error, const ProgressFn& progress,
+              const std::atomic<bool>* cancel);
+
+// Install a checked pack now (no game running): backup, unpack, check, roll back on failure.
+bool InstallPack(const Item& it, const std::string& zip, std::string* message);
+// A pack for the newer Dolphin that is being installed: kept for that Dolphin's first start.
+void KeepForNewDolphin(const Item& it, const std::string& zip);
+// Packs kept by an older folder (imported): installed at this Dolphin's first start.
+std::vector<std::pair<Item, std::string>> PendingPacks();
+void PendingDone(const std::string& zip);
+
+// A checked newer Dolphin: Linux = the start script unpacks it next to this folder at the next start (run.sh);
+// Windows = unpacked next to this folder now (the next start, or Restart, switches to it).
+bool StageDolphin(const Item& it, const std::string& archive, std::string* message);
+bool DolphinStaged();
+// Windows: switch to the staged / moved-to folder (start its Dolphin.exe with these arguments). True = it was started.
+bool StartNewFolder(const std::vector<std::string>& args);
+// Linux: ask the desktop to run this folder's start script again (evoracing://restart, the registered link handler)
+void RestartViaLink();
+
+// The first start of a NEW folder: bring everything over from the older one (User/Config/er-import-from.txt).
+// "" = nothing to do; else what happened.
+std::string ImportIfAsked();
+
+// Config/er-installed.json (what the start scripts and the installer recorded) as JSON text
+std::string InstalledJson();
+// User/ERUpdates/updates.log
+void Log(const std::string& line);
+std::string Human(u64 bytes);
+}  // namespace ERUpdates
