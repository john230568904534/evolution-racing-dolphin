+{
+  std::unique_ptr<AbstractTexture> verts, color, orm, emissive;
+  u32 nverts = 0;
+};
+constexpr u32 SC_ROW = 4096;  // vertex texture: R32F, 4096 floats a row
+}  // namespace PC5090Scenery
