+void MainWindow::ERUpdateTick()
+{
+  auto run = m_er_run;
+  if (!run)
+  {
+    m_er_upd_timer->stop();
+    return;
+  }
+  const u64 d = run->done, t = run->total;
+  std::string cur;
+  {
+    std::lock_guard lk(run->mu);
+    cur = run->current;
+  }
+  if (!run->finished)
+  {
+    const int pct = t ? static_cast<int>(d * 100 / t) : 0;
+    ERUpdateOverlay(true);  // (before the texts: it makes them)
+    m_er_overlay_text->setText(tr("Updating: %1 %2%").arg(Q(cur)).arg(pct));
+    m_er_overlay_bar->setValue(t ? static_cast<int>(d * 1000 / t) : 0);
+    if (!Core::IsUninitialized(m_system) && pct / 25 != m_er_osd_step)  // a line in game every 25 %
+    {
+      m_er_osd_step = pct / 25;
+      Core::DisplayMessage(fmt::format("Evolution Racing update: {} {}%", cur, pct), 4000);
+    }
+    return;
+  }
+  // downloads done: packs install when no game runs (the graphics mods and textures load at the next game start)
+  std::vector<std::pair<ERUpdates::Item, std::string>> ready;
+  {
+    std::lock_guard lk(run->mu);
+    if (!run->ready.empty() && Core::IsUninitialized(m_system))
+      ready.swap(run->ready);
+  }
+  if (!ready.empty())
+  {
+    ERUpdateOverlay(true);  // (makes the box the first time: packs kept by an older folder install at the first start)
+    m_er_overlay_text->setText(tr("Installing..."));
+    m_er_overlay_bar->setRange(0, 0);
+    for (auto& [it, path] : ready)
+    {
+      std::string msg;
+      if (ERUpdates::InstallPack(it, path, &msg))
+        ++run->installed;
+      else
+        run->errors.push_back(it.title + ": " + msg);
+      ERUpdates::PendingDone(path);  // installed, or refused (a damaged file is downloaded again at the next check)
+    }
+    m_er_overlay_bar->setRange(0, 1000);
+  }
+  {
+    std::lock_guard lk(run->mu);
+    if (!run->ready.empty())
+    {
+      ERUpdateOverlay(true);
+      m_er_overlay_text->setText(tr("Downloaded: installs when you stop the game"));
+      m_er_overlay_bar->setValue(1000);
+      return;
+    }
+  }
+  m_er_upd_timer->stop();
+  ERUpdateOverlay(false);
+  m_er_osd_step = -1;
+  ERUpdateDone(run);
+}
+
+void MainWindow::ERUpdateDone(std::shared_ptr<ERUpdateRun> run)
+{
+  ERUpdateTitle();  // (Evolution Racing X.Y.Z: an installed pack can add the .Z)
+  std::string text;
+  if (!run->dolphin.empty())
+    text += "Updated: " + run->dolphin +
+            " is ready. Restart Dolphin to use the new version (your saves, settings and packs come along).\n";
+  if (run->installed)
+    text += fmt::format("{} updated: active from the next race.\n",
+                        run->installed == 1 ? std::string("The pack is") : fmt::format("{} packs are", run->installed));
+  for (const auto& n : run->notes)
+    text += n + "\n";
+  for (const auto& e : run->errors)
+    text += "Not updated: " + e + "\n";
+  if (run->cancel && run->errors.empty())
+    text += "The download stopped; it continues next time.\n";
+  if (text.empty())
+    return;
+  ERUpdates::Log("update finished: " + text);
+  TestWrite("done.txt", text, false);
+  if (!Core::IsUninitialized(m_system))
+    Core::DisplayMessage(run->dolphin.empty() ? "Evolution Racing: effects updated, active next race." :
+                                                "Evolution Racing: updated, restart Dolphin to use the new version.",
+                         8000);
+  auto* box = new QMessageBox(this);
+  box->setAttribute(Qt::WA_DeleteOnClose);
+  box->setWindowModality(Qt::NonModal);
+  box->setWindowTitle(tr("Evolution Racing updates"));
+  box->setText(Q(text));
+  QPushButton* restart = nullptr;
+  if (!run->dolphin.empty())
+    restart = box->addButton(tr("Restart now"), QMessageBox::AcceptRole);
+  box->addButton(run->dolphin.empty() ? tr("OK") : tr("Later"), QMessageBox::RejectRole);
+  connect(box, &QMessageBox::buttonClicked, this, [this, restart](QAbstractButton* b) {
+    if (b && b == restart)
+      ERRestart();
+  });
+  box->show();
+  box->raise();
+  if (restart && TestHas("restart"))
+    QTimer::singleShot(1500, box, [restart] { restart->click(); });
+}
+
+void MainWindow::ERRestart()
+{
+  if (!Core::IsUninitialized(m_system) && !RequestStop())
+    return;
+  // the game is stopped (memory card and states written): let go of this folder's lock, so the newer folder can copy
+  // it at once, whatever the rest of this Dolphin's shutdown takes
+  ERGhosts::ReleaseLock();
+#ifdef _WIN32
+  if (!ERUpdates::StartNewFolder({}))
+    return ERNote("could not start the new Dolphin: start it from its folder.");
+#else
+  // the start script (run.sh, registered for evoracing:// links) moves to the new folder and starts it
+  ERUpdates::RestartViaLink();
+  QDesktopServices::openUrl(QUrl(QStringLiteral("evoracing://restart")));
+#endif
+  QTimer::singleShot(300, this, [this] {
+    close();
+    QCoreApplication::quit();
+  });
+}
