+// Evolution Racing member build id (one id for the Linux and the Windows build of the same source)
+#ifndef ER_BUILD_ID
+#define ER_BUILD_ID "lit17s41mg"
+#endif
+const std::string& GetERBuildStr()
+{
+  static const std::string s = ER_BUILD_ID;
+  return s;
+}
+
+// Evolution Racing X.Y (hub/server/versions.json; lighting_mod/updater/apply_version.py sets it)
+#ifndef ER_VERSION
+#define ER_VERSION "1.5"
+#endif
+// "ER_VERSION=1.3" stays in the binary (not const, read below): scripts/dolphinpack.py / winpack.py look for it
+extern char er_version_marker[];
+char er_version_marker[] = "ER_VERSION=" ER_VERSION;
+
+const std::string& GetERFriendlyStr()
+{
+  static const std::string s = er_version_marker + 11;
+  return s;
+}
+
+static std::vector<int> ERParts(const std::string& v)
+{
+  std::vector<int> p;
+  size_t i = 0;
+  while (i < v.size() && p.size() < 3)
+  {
+    size_t j = i;
+    while (j < v.size() && v[j] >= '0' && v[j] <= '9')
+      ++j;
+    if (j == i || j - i > 6)
+      return {};
+    p.push_back(std::stoi(v.substr(i, j - i)));
+    if (j < v.size() && v[j] != '.')
+      return {};
+    i = j + 1;
+  }
+  while (p.size() < 3)
+    p.push_back(0);
+  return p;
+}
+
+int ERVersionCompare(const std::string& a, const std::string& b)
+{
+  const auto x = ERParts(a), y = ERParts(b);
+  return x < y ? -1 : (x > y ? 1 : 0);
+}
+
+static std::mutex s_er_mu;
+static std::string s_er_setup;
+static bool s_er_dirty = true;
+
+void ERVersionChanged()
+{
+  std::lock_guard lk(s_er_mu);
+  s_er_dirty = true;
+}
+
+std::string GetERSetupVersion()
+{
+  std::lock_guard lk(s_er_mu);
+  if (s_er_dirty)
+  {
+    s_er_dirty = false;
+    s_er_setup = GetERFriendlyStr();
+    std::string text;
+    std::smatch m;
+    static const std::regex re("\"er_version\"\\s*:\\s*\"([0-9]+\\.[0-9]+(\\.[0-9]+)?)\"");
+    if (File::ReadFileToString(File::GetUserPath(D_CONFIG_IDX) + "er-installed.json", text) &&
+        std::regex_search(text, m, re))
+    {
+      const auto own = ERParts(GetERFriendlyStr()), inst = ERParts(m[1].str());
+      // the packs' .Z counts on this Dolphin's own X.Y line only (a 1.3 Dolphin with 1.3.1 packs = 1.3.1)
+      if (!inst.empty() && !own.empty() && inst[0] == own[0] && inst[1] == own[1] && inst > own)
+        s_er_setup = m[1].str();
+    }
+  }
+  return s_er_setup;
+}
+
+std::string GetERVersionStr()
+{
+  return "Evolution Racing " + GetERSetupVersion();
+}
