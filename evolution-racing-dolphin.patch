+constexpr std::string_view UNIFORM_BLOCK = R"(
+#define EQ_LIT10 1
+#define EQ_LIT14 1
+#define EQ_LIT15 1
+#define EQ_LIT16 1
+#define EQ_LIT17 1
+#define EQ_LIT17C 1
+#define EQ_LIT17S 1
+#define EQ_LIT17S6 1
+#define EQ_LIT17S30 1
+UBO_BINDING(std140, 1) uniform PSBlock
+{
+  float4 eq_projection[4];   // GX projection rows (view -> GX clip), incl. Dolphin's adjustments
+  float4 eq_pixel_center;
+  float4 eq_anchor;          // xyz = target draw's vertex centroid (GX view space, camera looks down -z), w = bounding radius
+  float4 eq_view_min;        // xyz = view-space AABB min, w = number of vertices sampled
+  float4 eq_view_max;        // xyz = view-space AABB max, w = 1 if the original draw was skipped
+  float4 eq_screen_box;      // GX NDC (y up) bounding box of the projected vertices: min.xy, max.xy
+  float4 eq_screen_centre;   // xy = NDC of the centroid, zw = same anchor last frame (= xy if none)
+  float4 eq_prev_anchor;     // xyz = the nearest anchor of this action last frame (view space), w = 1 if found
+  float4 eq_matrix[3];       // the draw's position matrix rows (model -> view), as GX stores it
+  float4 eq_viewport;        // xy = viewport size in native pixels, zw = 1 / xy
+  uint4 eq_info;             // x = time_ms, y = quad count, z = emit index this frame, w = frame counter
+  float4 eq_model_min;       // xyz = model-space AABB min of the anchor (vertices sharing eq_matrix), w = 1 if valid
+  float4 eq_model_max;
+  float4 eq_gate;            // x = ms since the "gate" slot was last published, y = ms since its current run started, z = run length ms, w = 1 if a gate is set
+  float4 eq_target;          // xyz = the trigger draw's own centroid (view), w = its radius (differs from eq_anchor with "anchor_from")
+  float4 eq_target_far;      // xyz = the trigger draw's far end (mean of its vertices nearest the farthest depth, view), w = 1 if found
+  float4 eq_params[4];       // action_data "params" (16 floats)
+  float4 eq_ram[2];          // action_data "ram_values" 0..7 (lit10)
+  float4 eq_player;          // "player_from" slot's largest cluster: centroid xyz (view), w = radius (0 = none) (lit10)
+  float4 eq_scene_size;      // "scene_copy": EFB size xy, 1 / size zw (0 = none) (lit10)
+  float4 eq_depth_size;      // "depth_copy": EFB size xy, 1 / size zw (0 = none) (lit14)
+  float4 eq_depth_range;     // the game viewport's host depth range: x = near, y = far (lit14)
+  float4 eq_racer;           // lit15 per_racer emit: x = racer index, y = machine id (racer block byte "machine"), z = 1; else 0
+  float4 eq_surf_info;       // lit16: x = number of hull surface samples (0..64), y = 1 if they have normals
+  float4 eq_surf_pos[64];    // lit16: hull surface samples, model space of eq_matrix (eq_model_to_view), w = 1
+  float4 eq_surf_normal[64]; // lit16: their normals (model space of eq_matrix), w = 1 if valid
+  float4 eq_dm_info;         // lit17: x = damage hits (0..16), y = time s, z = machine size (model units), w = 1 if racer known
+  float4 eq_dm_pos[16];      // lit17: hit centre (model space of eq_matrix), w = dent radius
+  float4 eq_dm_dir[16];      // lit17: outward hull normal at the hit (unit), w = dent depth
+  float4 eq_dm_tan[16];      // lit17: scrape direction (unit), w = seed 0..1
+  float4 eq_dm_aux[16];      // lit17: x = age s, y = strength (1 = a hard hit), z = 1 intact .. 0 repaired, w = heat
+  float4 eq_hx_info;         // lit17c: x = speed heat 0..1 (smoothed), y = speed km/h, z = grip level 0..1+, w = s since the last grip impact
+  float4 eq_hx_dir;          // lit17c: travel direction (model space of eq_matrix, unit), w = strength of the last grip impact
+  float4 eq_hx_ctr;          // lit17c: machine centre (model space), w = machine size (max sample radius)
+  float4 eq_hx_aux;          // lit17c: x = how far the lowest hull point lies below the centre (along eq_hx_up, model units), y = front / z = back extent along eq_hx_dir, w = 1 if valid
+  float4 eq_hx_up;           // lit17c: the machine's up (model space of eq_matrix, unit; the model's own axes are not y-up)
+  // lit17s24 RACER FRAME from RAM (decomp: basis +0xEC x lean +0x5E0, position +0x7C, velocity +0x94, speed +0x17C) of
+  // the emitted machine (per_racer: its racer; classic path: the player's), in view space. w = 1 when valid (0 = none:
+  // keep the old estimate). right / up / back = the machine's own axes as drawn (back = -forward).
+  float4 eq_rf_pos;          // xyz = machine centre (racer position), w = 1 valid
+  float4 eq_rf_right;        // xyz unit, w = 1 valid
+  float4 eq_rf_up;           // lit17s29: w = on the ground (1) .. airborne (0)
+  float4 eq_rf_back;
+  float4 eq_rf_vel;          // xyz = travel direction (unit, view), w = speed km/h
+  // lit17s30 BOOST ("boost": true actions; per_racer: that racer, else the player). eq_boost: x = boost envelope 0..1
+  // (+0x0 bit 0x20, eased), y = ms since the last kick (a boost start or a dash plate hit, 1e6 = none), z = its
+  // strength (0 manual boost, 1 / 1.5 / 2 = the plate: boost timer +0x18A / (30 x duration +0x234)), w = chain level
+  // (kicks less than the chain window apart, eased, 0..6). eq_boost2: x = kicks in this chain, y = speed km/h,
+  // z = ms since the speed last crossed the sonic threshold (1e6 = none), w = 1 valid.
+  // "pads" actions: eq_surf_info = (pads, 2, range, 0); pad k: eq_surf_pos[2k] = centre (view) + w half length,
+  // eq_surf_pos[2k+1] = across axis (view) + w half width, eq_surf_normal[2k] = up (view) + w strength (1, 1.5, 2),
+  // eq_surf_normal[2k+1] = along axis (view) + w ms since a machine last hit the plate (1e6 = never)
+  float4 eq_boost;
+  float4 eq_boost2;
+};
+float eq_ram_value(int i) { return eq_ram[i >> 2][i & 3]; }
+uint eq_time_ms() { return eq_info.x; }
+uint eq_quad_count() { return eq_info.y; }
+uint eq_emit_index() { return eq_info.z; }
+uint eq_frame() { return eq_info.w; }
+float eq_param(int i) { return eq_params[i >> 2][i & 3]; }
+float eq_aspect() { return eq_viewport.x * eq_viewport.w; }
+)";
+
+std::string GenerateVertexShader(const std::string& user_code, int near_fade = 0)
+{
+  ShaderCode code;
+  code.Write("#define EQ_VERTEX 1\n");
+  if (near_fade)
+    code.Write("#define EQ_NEAR_FADE 1\n");  // lit17s29n
+  code.Write("{}", UNIFORM_BLOCK);
+  code.Write("{}", R"(
+VARYING_LOCATION(0) out float2 eq_v_uv;
+VARYING_LOCATION(1) out float4 eq_v_data0;
+VARYING_LOCATION(2) out float4 eq_v_data1;
+VARYING_LOCATION(3) flat out uint eq_v_instance;
+#ifdef EQ_NEAR_FADE
+VARYING_LOCATION(4) out float eq_v_fade;
+#endif
+
+struct EmitVertex
+{
+  float4 clip;   // GX clip space (eq_view_to_clip); the host conversion is done afterwards
+  float2 uv;     // defaults to the quad corner (0..1)
+  float4 data0;  // free for the pixel shader
+  float4 data1;
+};
+// Put every corner of a quad here to drop it (zero-area and off screen).
+const float4 EQ_CULLED = float4(4.0, 4.0, 0.0, 1.0);
+
+float4 eq_view_to_clip(float3 v)
+{
+  float4 p = float4(v, 1.0);
+  return float4(dot(eq_projection[0], p), dot(eq_projection[1], p), dot(eq_projection[2], p),
+                dot(eq_projection[3], p));
+}
+float3 eq_model_to_view(float3 m)
+{
+  float4 p = float4(m, 1.0);
+  return float3(dot(eq_matrix[0], p), dot(eq_matrix[1], p), dot(eq_matrix[2], p));
+}
+// Model axis i (0 = x, 1 = y, 2 = z) of the draw's position matrix, in view space (normalized).
+float3 eq_model_axis(int i)
+{
+  float3 a = float3(eq_matrix[0][i], eq_matrix[1][i], eq_matrix[2][i]);
+  return a / max(length(a), 1e-6);
+}
+// A point at GX NDC xy with the depth / w of a reference clip position (screen-space sprites).
+float4 eq_ndc_at(float2 ndc, float4 ref_clip)
+{
+  return float4(ndc * ref_clip.w, ref_clip.z, ref_clip.w);
+}
+)");
+  // Same conversion as the end of the emulated vertex shader (VertexShaderGen).
+  code.Write("float4 eq_to_host(float4 pos)\n"
+             "{{\n"
+             "  pos.z = pos.w * eq_pixel_center.w - pos.z * eq_pixel_center.z;\n");
+  if (!g_backend_info.bSupportsClipControl)
+    code.Write("  pos.z = pos.z * 2.0 - pos.w;\n");
+  code.Write("  pos.xy *= sign(eq_pixel_center.xy * float2(1.0, -1.0));\n"
+             "  pos.xy = pos.xy - pos.w * eq_pixel_center.xy;\n");
+  if (g_backend_info.api_type == APIType::Vulkan)
+    code.Write("  pos.y = -pos.y;\n");
+  code.Write("  return pos;\n"
+             "}}\n\n");
+
+  code.Write("// ---- user code ----\n{}\n// ---- end user code ----\n\n", user_code);
+
+  code.Write("{}", R"(
+void main()
+{
+  uint vid = uint(gl_VertexID);
+  uint instance = vid / 6u;
+  uint k = vid - instance * 6u;
+  // Two triangles: (0,0) (1,0) (0,1) and (0,1) (1,0) (1,1).
+  float2 corner = float2((k == 1u || k == 4u || k == 5u) ? 1.0 : 0.0,
+                         (k == 2u || k == 3u || k == 5u) ? 1.0 : 0.0);
+  EmitVertex v;
+  v.clip = EQ_CULLED;
+  v.uv = corner;
+  v.data0 = float4(0.0, 0.0, 0.0, 0.0);
+  v.data1 = float4(0.0, 0.0, 0.0, 0.0);
+#ifdef EQ_NEAR_FADE
+  EmitVertex v0 = v;
+#endif
+  emit_vertex(instance, corner, v);
+#ifdef EQ_NEAR_FADE
+  // lit17s29n "near_fade": a quad is drawn whole or not at all (a corner the user code culled, or one at / behind the
+  // camera, culls all four - before, the other corners still drew a long triangle to EQ_CULLED), and it dissolves
+  // over the last ramp of view depth before its nearest corner reaches the camera (no pop when a puff passes it)
+  float eq_fade = 1.0;
+  if (all(equal(v.clip, EQ_CULLED)))
+    eq_fade = 0.0;
+  else
+  {
+    float wmin = 1e30;
+    float2 lo = float2(1e30, 1e30), hi = float2(-1e30, -1e30);
+    bool cull = false;
+    for (uint i = 0u; i < 4u; i++)
+    {
+      float2 c2 = float2(float(i & 1u), float(i >> 1u));
+      EmitVertex o = v0;
+      o.uv = c2;
+      emit_vertex(instance, c2, o);
+      if (all(equal(o.clip, EQ_CULLED)) || o.clip.w <= 1e-4)
+      {
+        cull = true;
+        break;
+      }
+      wmin = min(wmin, o.clip.w);
+      float2 nd = o.clip.xy / o.clip.w;
+      lo = min(lo, nd);
+      hi = max(hi, nd);
+    }
+    if (cull)
+    {
+      v.clip = EQ_CULLED;
+      eq_fade = 0.0;
+    }
+    else
+    {
+      // the quad's view-space size (its NDC extent at the nearest corner's depth); ramp 1.5 .. 3 view units
+      float ext = max((hi.x - lo.x) / max(abs(eq_projection[0].x), 1e-3), (hi.y - lo.y) / max(abs(eq_projection[1].y), 1e-3)) * wmin;
+      eq_fade = smoothstep(0.8, 0.8 + clamp(ext, 1.5, 3.0), wmin);
+      if (eq_fade <= 0.0)
+        v.clip = EQ_CULLED;
+    }
+  }
+  eq_v_fade = eq_fade;
+#endif
+  eq_v_uv = v.uv;
+  eq_v_data0 = v.data0;
+  eq_v_data1 = v.data1;
+  eq_v_instance = instance;
+  gl_Position = eq_to_host(v.clip);
+}
+)");
+  return code.GetBuffer();
+}
+
+std::string GeneratePixelShader(const std::string& user_code, int near_fade = 0)
+{
+  ShaderCode code;
+  code.Write("#define EQ_PIXEL 1\n");
+  if (near_fade)
+    code.Write("#define EQ_NEAR_FADE {}\n", near_fade);  // lit17s29n: 1 alpha x fade, 2 rgba x fade
+  code.Write("{}", UNIFORM_BLOCK);
+  code.Write("{}", R"(
+SAMPLER_BINDING(0) uniform sampler2DArray samp0;
+SAMPLER_BINDING(1) uniform sampler2DArray samp1;
+SAMPLER_BINDING(2) uniform sampler2DArray samp2;
+VARYING_LOCATION(0) in float2 eq_v_uv;
+VARYING_LOCATION(1) in float4 eq_v_data0;
+VARYING_LOCATION(2) in float4 eq_v_data1;
+VARYING_LOCATION(3) flat in uint eq_v_instance;
+#ifdef EQ_NEAR_FADE
+VARYING_LOCATION(4) in float eq_v_fade;
+#endif
+FRAGMENT_OUTPUT_LOCATION(0) out float4 ocol0;
+
+// The action's texture ("texture_file"), or the target draw's own texture.
+float4 eq_texture(float2 uv) { return texture(samp0, float3(uv, 0.0)); }
+// "scene_copy" (lit10): the EFB colour as it was before this action's first emit of the frame.
+// eq_scene_px() = this fragment's position in that texture (0..1); eq_scene(uv) samples it (clamped).
+float2 eq_scene_px() { return gl_FragCoord.xy * eq_scene_size.zw; }
+float4 eq_scene(float2 uv) { return texture(samp1, float3(clamp(uv, eq_scene_size.zw * 0.5, 1.0 - eq_scene_size.zw * 0.5), 0.0)); }
+// "depth_copy" (lit14): the EFB depth as it was before this action's first emit of the frame (host depth, as
+// gl_FragCoord.z). eq_depth_raw(uv) = point sample at 0..1; eq_host_depth(view) = the host depth a GX view-space
+// point gets (same conversion as the vertex stage); eq_depth_to_view_z(d) = the view z (negative = in front) of a
+// host depth (perspective projections); eq_scene_view_z(uv) = both.
+float eq_depth_raw(float2 uv)
+{
+  int2 p = clamp(int2(uv * eq_depth_size.xy), int2(0, 0), int2(eq_depth_size.xy) - int2(1, 1));
+  return texelFetch(samp2, int3(p, 0), 0).r;
+}
+float eq_host_depth(float3 v)
+{
+  float4 p = float4(v, 1.0);
+  float cz = dot(eq_projection[2], p), cw = dot(eq_projection[3], p);
+  return mix(eq_depth_range.x, eq_depth_range.y, (cw * eq_pixel_center.w - cz * eq_pixel_center.z) / cw);
+}
+float eq_depth_to_view_z(float d)
+{
+  float zn = (d - eq_depth_range.x) / (eq_depth_range.y - eq_depth_range.x);   // host NDC z
+  float r = (eq_pixel_center.w - zn) / eq_pixel_center.z;   // GX clip z / w
+  return (eq_projection[2].w - r * eq_projection[3].w) / (r * eq_projection[3].z - eq_projection[2].z);
+}
+float eq_scene_view_z(float2 uv) { return eq_depth_to_view_z(eq_depth_raw(uv)); }
+// Cell `cell` (row-major from the top left) of a cols x rows atlas.
+float4 eq_atlas(float2 uv, float cell, float cols, float rows)
+{
+  float c = mod(floor(cell), cols * rows);
+  float2 origin = float2(mod(c, cols), floor(c / cols));
+  return eq_texture((origin + clamp(uv, 0.0, 1.0)) / float2(cols, rows));
+}
+)");
+  code.Write("// ---- user code ----\n{}\n// ---- end user code ----\n\n", user_code);
