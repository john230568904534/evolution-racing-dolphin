+// metal 0 / gloss 0 / coat 0 / height 1: the metal layer's "no material" (= the MachineMetal = Off look)
+const AbstractTexture* P40NeutralMask()
+{
+  static std::unique_ptr<AbstractTexture> t;
+  if (!t)
+  {
+    t = g_gfx->CreateTexture(TextureConfig(1, 1, 1, 1, 1, AbstractTextureFormat::RGBA8, 0,
+                                           AbstractTextureType::Texture_2DArray),
+                             "metal mask (neutral, lit17s40p)");
+    if (t)
+    {
+      const u8 px[4] = {0, 0, 0, 255};
+      t->Load(0, 1, 1, 1, px, sizeof(px));
+    }
+  }
+  return t.get();
+}
