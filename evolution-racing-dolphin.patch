+// picojson aborts on a wrong type (no exceptions in Dolphin): every read goes through these
+const picojson::value& At(const picojson::value& v, const std::string& key)
+{
+  static const picojson::value null;
+  if (!v.is<picojson::object>())
+    return null;
+  const auto& o = v.get<picojson::object>();
+  const auto it = o.find(key);
+  return it == o.end() ? null : it->second;
+}
+double Num(const picojson::value& v, double def = 0)
+{
+  return v.is<double>() ? v.get<double>() : def;
+}
+std::string Str(const picojson::value& v)
+{
+  return v.is<std::string>() ? v.get<std::string>() : std::string();
+}
+const picojson::array& Arr(const picojson::value& v)
+{
+  static const picojson::array empty;
+  return v.is<picojson::array>() ? v.get<picojson::array>() : empty;
+}
+int HexDigit(char c)
+{
+  if (c >= '0' && c <= '9')
+    return c - '0';
+  if (c >= 'a' && c <= 'f')
+    return c - 'a' + 10;
+  if (c >= 'A' && c <= 'F')
+    return c - 'A' + 10;
+  return -1;
+}
