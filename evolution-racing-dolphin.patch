+bool UpdateHubAllowed(const std::string& hub)
+{
+  const std::string h = Strip(hub);
+  const std::string official = ERGhosts::OfficialHub();  // Sys/er-hub.txt of the member package
+  return (!official.empty() && h == official) || h.starts_with("http://127.0.0.1:") || h.starts_with("http://localhost:");
+}
+
+bool BuildHas(const std::string& own, const std::string& need)
+{
+  static const std::regex re("lit17s(\\d+)([a-z]*)");
+  std::smatch a, b;
+  if (need.empty() || !std::regex_match(need, b, re))
+    return true;
+  if (!std::regex_match(own, a, re))
+    return false;
+  const int an = std::stoi(a[1]), bn = std::stoi(b[1]);
+  if (an != bn)
+    return an > bn;
+  const std::string al = a[2], bl = b[2];
+  return std::all_of(bl.begin(), bl.end(), [&](char c) { return al.find(c) != std::string::npos; });
+}
+
+std::string Human(u64 n)
+{
+  if (n >= 1000000000ull)
+    return fmt::format("{:.2f} GB", n / 1e9);
+  if (n >= 10ull << 20)
+    return fmt::format("{:.0f} MB", n / 1048576.0);
+  return fmt::format("{:.1f} MB", n / 1048576.0);
+}
