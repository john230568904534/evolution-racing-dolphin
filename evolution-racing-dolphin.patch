+bool Install(const std::vector<u8>& gci, std::string* message)
+{
+  Ghost g;
+  const std::string bad = Check(gci, &g);
+  if (!bad.empty())
+  {
+    *message = "The hub sent a file that is not a good ghost: " + bad;
+    return false;
+  }
+  const std::string folder = GciFolder();
+  File::CreateFullPath(folder + "/");
+  const std::string path = folder + "/8P-GFZE-" + g.name + ".gci";
+  std::string old;
+  if (File::ReadFileToString(path, old))
+  {
+    if (std::vector<u8>(old.begin(), old.end()) == gci)
+    {
+      *message = fmt::format("That ghost ({} {}) is already in your memory card.", g.machine_name, g.time);
+      return true;
+    }
+  }
+  AppendLedger(g.sha1, "installed");  // first: the watcher must never send someone else's ghost as this member's
+  s_offered.insert(g.sha1);
+  if (!File::WriteStringToFile(path + ".tmp", std::string(gci.begin(), gci.end())) ||
+      !File::Rename(path + ".tmp", path))
+  {
+    *message = "Could not write the ghost into " + folder;
+    return false;
+  }
+  *message = fmt::format("Ghost installed: {} {}. In Time Attack pick the course, then Y / X (Load Ghost) "
+                         "to race it. If the game is running, start it again to see it.",
+                         g.machine_name, g.time);
+  return true;
+}
+
+bool ParseLink(const std::string& arg, std::string* code, std::string* hub)
+{
+  std::string s = arg.substr(arg.find("link/") + 5);
+  std::string query;
+  const auto q = s.find('?');
+  if (q != std::string::npos)
+  {
+    query = s.substr(q + 1);
+    s = s.substr(0, q);
+  }
+  while (!s.empty() && s.back() == '/')
+    s.pop_back();
+  if (!s.starts_with("erd_") || !SafePart(s, 80))
+    return false;
+  *code = s;
+  hub->clear();
+  for (const std::string& kv : SplitString(query, '&'))
+    if (kv.starts_with("hub="))
+      *hub = Unescape(kv.substr(4));
+  return true;
+}
+
+bool ParseGhost(const std::string& arg, std::string* what)
+{
+  std::string s = arg.substr(arg.find("ghost/") + 6);
+  const auto q = s.find_first_of("?#");
+  if (q != std::string::npos)
+    s = s.substr(0, q);
+  std::vector<std::string> p;
+  for (const std::string& x : SplitString(s, '/'))
+    if (!x.empty())
+      p.push_back(Unescape(x));
+  if (p.size() == 2 && p[0] == "staff" && SafePart(p[1], 80))
+  {
+    *what = "staffghost/" + UrlPart(p[1]) + ".gci";
+    return true;
+  }
+  if (p.size() == 3 && SafePart(p[0], 80) && (p[1] == "race" || p[1] == "lap") && SafePart(p[2], 40))
+  {
+    *what = "ghost/" + UrlPart(p[0]) + "/" + p[1] + "/" + UrlPart(p[2]) + ".gci";
+    return true;
+  }
+  return false;
+}
+
+std::string OfficialHub()
+{
+  static const std::string hub = [] {
+    std::string t;
+    if (!File::ReadFileToString(File::GetSysDirectory() + "er-hub.txt", t))
+      return std::string();
+    t = t.substr(0, t.find_first_of("\r\n"));
+    while (!t.empty() && (t.back() == '/' || t.back() == ' ' || t.back() == '\t'))
+      t.pop_back();
+    return t.starts_with("https://") && HubAllowed(t) ? t : std::string();
+  }();
+  return hub;
+}
+
+bool HubAllowed(const std::string& hub)
+{
+  if (hub.starts_with("https://") && hub.size() > 8 && hub.find_first_of(" \t\r\n@") == std::string::npos)
+    return true;
+  return hub.starts_with("http://127.0.0.1:") || hub.starts_with("http://localhost:") ||
+         hub == "http://127.0.0.1" || hub == "http://localhost";
+}
