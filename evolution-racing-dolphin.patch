+u16 BE16(const u8* p)
+{
+  return static_cast<u16>(p[0] << 8 | p[1]);
+}
+
+u16 Crc16X25(const u8* d, size_t n)
+{
+  u16 crc = 0xFFFF;
+  for (size_t i = 0; i < n; ++i)
+  {
+    crc ^= d[i];
+    for (int b = 0; b < 8; ++b)
+      crc = (crc & 1) ? static_cast<u16>((crc >> 1) ^ 0x8408) : static_cast<u16>(crc >> 1);
+  }
+  return static_cast<u16>(crc ^ 0xFFFF);
+}
