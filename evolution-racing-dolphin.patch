+void NotePerspective(const std::array<std::array<float, 4>, 4>& projection, const std::array<float, 4>& pixel_center)
+{
+  // the world camera = the projection most of this frame's perspective draws use (render-to-texture passes, the sky
+  // or effects with their own projection draw fewer): up to 4 distinct projections are counted per frame
+  if (s_pj_frame != s_frame)
+  {
+    s_pj_frame = s_frame;
+    s_pj_n = 0;
+  }
+  int k = 0;
+  for (; k < s_pj_n; k++)
+    if (s_pj[k].p[0][0] == projection[0][0] && s_pj[k].p[1][1] == projection[1][1] &&
+        s_pj[k].p[2][2] == projection[2][2] && s_pj[k].p[2][3] == projection[2][3] &&
+        s_pj[k].p[0][2] == projection[0][2] && s_pj[k].p[1][2] == projection[1][2])
+      break;
+  if (k == s_pj_n)
+  {
+    if (s_pj_n == 4)
+      return;
+    s_pj[k].p = projection;
+    s_pj[k].pc = pixel_center;
+    s_pj[k].n = 0;
+    s_pj_n++;
+  }
+  s_pj[k].n++;
+  s_persp_since_ortho = true;
+}
+
+void OrthoDraw()
+{
+  if (s_trace > 0 && (s_frame % 600) == 1)
+    std::fprintf(stderr, "NPTRACE ortho frame %llu active %d drawn %d persp %d\n",
+                 static_cast<unsigned long long>(s_frame), s_active ? 1 : 0, s_drawn_frame == s_frame ? 1 : 0,
+                 s_persp_since_ortho ? 1 : 0);
+  if (!s_active || s_drawn_frame == s_frame || !s_persp_since_ortho)
+    return;
+  s_persp_since_ortho = false;
+  // only the first ortho draw after a 3D world of this frame
+  s_drawn_frame = s_frame;
+  if (g_framebuffer_manager->IsEFBStereo() || s_pj_frame != s_frame || s_pj_n == 0)
+    return;
+  int best = 0;
+  for (int k = 1; k < s_pj_n; k++)
+    if (s_pj[k].n > s_pj[best].n)
+      best = k;
+  s_proj = s_pj[best].p;
+  s_pc = s_pj[best].pc;
+  s_proj_frame = s_frame;
+  if (s_trace > 0 && (s_frame % 120) == 0)
+    for (int k = 0; k < s_pj_n; k++)
+      std::fprintf(stderr, "NPTRACE proj %d draws %u: %.4f %.4f %.4f %.4f | %.4f %.4f %.4f %.4f | z %.6f %.6f%s\n", k,
+                   s_pj[k].n, s_pj[k].p[0][0], s_pj[k].p[0][2], s_pj[k].p[1][1], s_pj[k].p[1][2], s_pj[k].p[3][2],
+                   s_pj[k].p[3][3], s_pj[k].pc[0], s_pj[k].pc[1], s_pj[k].p[2][2], s_pj[k].p[2][3],
+                   k == best ? " <- used" : "");
+  static const int cid = PC5090Prof::GroupId("NameplatesCpu");
+  const uint64_t pt0 = PC5090Prof::Enabled() ? PC5090Prof::NowNs() : 0;
+  DrawFrame();
+  if (pt0)
+    PC5090Prof::AddGroup(cid, PC5090Prof::NowNs() - pt0);
+}
