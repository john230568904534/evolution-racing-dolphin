+  // the drops start from a dry lens next time
+  if (m_screen_water && (WeatherNow()[0] != 1.0f || WeatherNow()[1] <= 0.0f || !WeatherUltra() || !ScreenWaterOn()))
+  {
+    m_sw_reset = true;
+    return;
+  }
+  if (!m_switch.empty() && !FxSwitchOn(m_switch))
+    return;  // lit17s24: GFX.ini [PC5090] <switch> = Off
+  if (!m_group_switch.empty() && !FxSwitchOn(m_group_switch))
+    return;  // lit17s35mv: the member's effects picker, GFX.ini [PC5090] Fx<Group> = Off
+  if (m_pads && !PadsReady())
+    return;  // lit17s30: no race / no plates in reach (no copies, no draw)
+  // lit17s31: nothing between impacts (no copies, no draw); none start inside a tube (MiUpdate). lit17s33pt: one that
+  // is already falling / burning keeps drawing when the player enters a tube (it is outside, seen through the glass)
+  if (m_meteor_impact && !MiUpdate())
+    return;
+  // lit17s37m: nothing between meteor-storm events (no copies, no draw)
+  if (m_meteor2 && !MxUpdate())
+    return;
+  // lit17s35L: nothing between strikes (no copies, no draw)
+  if (m_lightning && !LsUpdate())
+    return;
+  // lit17s32: only on fire-tornado weather in a live race (no copies, no draw otherwise)
+  if (m_fire_tornado && !FtUpdate())
+    return;
+  // lit17s36w: a weather2 effect only on its own weather types in a live race (no copies, no draw otherwise)
+  if (m_weather2 && !W2Update(m_w2_id))
+    return;
+  if (m_pr && !m_pr_override)
+  {
+    EmitPerRacer(target);
+    return;
+  }
+
+  std::array<float, 4> gate = {1e9f, 1e9f, 0.0f, 0.0f};
+  if (!m_ram_chain.empty() && m_ram_mask != 0)
+  {
+    // Evolution Racing: gate on emulated RAM (read on the video thread: a flag word, a frame of skew is fine)
+    auto& memory = Core::System::GetInstance().GetMemory();
+    const auto read32 = [&](u32 addr, u32* out) {
+      const u8* p = PC5090TryPointer(memory, addr, 4);
+      if (!p)
+        return false;
+      u32 v;
+      std::memcpy(&v, p, 4);
+      *out = Common::swap32(v);
+      return true;
+    };
+    u32 a = m_ram_chain[0];
+    bool ok = true;
+    for (size_t i = 1; i < m_ram_chain.size() && ok; i++)
+    {
+      u32 v = 0;
+      ok = read32(a, &v);
+      a = v + m_ram_chain[i];
+    }
+    u32 word = 0;
+    ok = ok && read32(a, &word);
+    bool and_ok = true;
+    if (!m_ram_and_chain.empty())
+    {
+      u32 a2 = m_ram_and_chain[0];
+      bool ok2 = true;
+      for (size_t i = 1; i < m_ram_and_chain.size() && ok2; i++)
+      {
+        u32 v = 0;
+        ok2 = read32(a2, &v);
+        a2 = v + m_ram_and_chain[i];
+      }
+      u32 w2 = 0;
+      and_ok = ok2 && read32(a2, &w2) && (w2 & m_ram_and_mask) != 0;
+    }
+    if (m_ram_edge)
+    {
+      // per-event counters (e.g. the dash-plate hit counter): every increase starts a new run that lasts
+      // gate_within_ms; a decrease (new race / state load) only re-arms
+      const u32 w = word & m_ram_mask;
+      if (ok && m_ram_have_prev && w > m_ram_prev && and_ok)
+      {
+        m_ram_run_start_ms = now;
+        m_ram_last_ms = now;
+        m_ram_seen = true;
+      }
+      if (ok)
+      {
+        m_ram_prev = w;
+        m_ram_have_prev = true;
+      }
+      if (!m_ram_seen)
+        return;
