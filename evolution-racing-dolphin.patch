+std::string GeneratePixelShader(const std::string& user_code)
+{
+  ShaderCode code;
+  code.Write("#define EQ_PIXEL 1\n");
+  code.Write("{}", UNIFORM_BLOCK);
+  code.Write("{}", R"(
+SAMPLER_BINDING(0) uniform sampler2DArray samp0;
+SAMPLER_BINDING(1) uniform sampler2DArray samp1;
+SAMPLER_BINDING(2) uniform sampler2DArray samp2;
+VARYING_LOCATION(0) in float2 eq_v_uv;
+VARYING_LOCATION(1) in float4 eq_v_data0;
+VARYING_LOCATION(2) in float4 eq_v_data1;
+VARYING_LOCATION(3) flat in uint eq_v_instance;
+FRAGMENT_OUTPUT_LOCATION(0) out float4 ocol0;
+
+// The action's texture ("texture_file"), or the target draw's own texture.
+float4 eq_texture(float2 uv) { return texture(samp0, float3(uv, 0.0)); }
+// "scene_copy" (lit10): the EFB colour as it was before this action's first emit of the frame.
+// eq_scene_px() = this fragment's position in that texture (0..1); eq_scene(uv) samples it (clamped).
+float2 eq_scene_px() { return gl_FragCoord.xy * eq_scene_size.zw; }
+float4 eq_scene(float2 uv) { return texture(samp1, float3(clamp(uv, eq_scene_size.zw * 0.5, 1.0 - eq_scene_size.zw * 0.5), 0.0)); }
+// "depth_copy" (lit14): the EFB depth as it was before this action's first emit of the frame (host depth, as
+// gl_FragCoord.z). eq_depth_raw(uv) = point sample at 0..1; eq_host_depth(view) = the host depth a GX view-space
+// point gets (same conversion as the vertex stage); eq_depth_to_view_z(d) = the view z (negative = in front) of a
+// host depth (perspective projections); eq_scene_view_z(uv) = both.
+float eq_depth_raw(float2 uv)
+{
+  int2 p = clamp(int2(uv * eq_depth_size.xy), int2(0, 0), int2(eq_depth_size.xy) - int2(1, 1));
+  return texelFetch(samp2, int3(p, 0), 0).r;
+}
+float eq_host_depth(float3 v)
+{
+  float4 p = float4(v, 1.0);
+  float cz = dot(eq_projection[2], p), cw = dot(eq_projection[3], p);
+  return mix(eq_depth_range.x, eq_depth_range.y, (cw * eq_pixel_center.w - cz * eq_pixel_center.z) / cw);
+}
+float eq_depth_to_view_z(float d)
+{
+  float zn = (d - eq_depth_range.x) / (eq_depth_range.y - eq_depth_range.x);   // host NDC z
+  float r = (eq_pixel_center.w - zn) / eq_pixel_center.z;   // GX clip z / w
+  return (eq_projection[2].w - r * eq_projection[3].w) / (r * eq_projection[3].z - eq_projection[2].z);
+}
+float eq_scene_view_z(float2 uv) { return eq_depth_to_view_z(eq_depth_raw(uv)); }
+// Cell `cell` (row-major from the top left) of a cols x rows atlas.
+float4 eq_atlas(float2 uv, float cell, float cols, float rows)
+{
+  float c = mod(floor(cell), cols * rows);
+  float2 origin = float2(mod(c, cols), floor(c / cols));
+  return eq_texture((origin + clamp(uv, 0.0, 1.0)) / float2(cols, rows));
+}
+)");
+  code.Write("// ---- user code ----\n{}\n// ---- end user code ----\n\n", user_code);
+  code.Write("{}", R"(
+void main()
+{
+  ocol0 = emit_pixel(eq_v_instance, eq_v_uv, eq_v_data0, eq_v_data1);
+}
+)");
+  return code.GetBuffer();
+}
