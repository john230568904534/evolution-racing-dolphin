+bool EmitQuadsSceneryActive()
+{
+  return s_sc_refs > 0;
+}
+
+// the RAM view of the frame (read once a frame), and every perspective draw's position matrix near it, by count,
+// each with the GX fog it was drawn with
+void EmitQuadsSceneryNoteDraw(const float* m)
+{
+  if (s_scv.frame != s_global_frame)
+  {
+    s_scv.frame = s_global_frame;
+    s_scv.have_ram = ReadRamView(s_scv.ram);
+    s_scv.cands.clear();
+    s_scv.draws = 0;
+  }
+  s_scv.draws++;
+  if (!s_scv.have_ram)
+    return;
+  const float* V = s_scv.ram;
+  for (int r = 0; r < 3; r++)
+  {
+    for (int c = 0; c < 3; c++)
+      if (std::abs(m[r * 4 + c] - V[r * 4 + c]) > 0.05f)
+        return;
+    if (std::abs(m[r * 4 + 3] - V[r * 4 + 3]) > 10.0f)
+      return;
+  }
+  for (auto& c : s_scv.cands)
+  {
+    if (std::memcmp(c.m.data(), m, sizeof(float) * 12) == 0)
+    {
+      c.n++;
+      return;
+    }
+  }
+  if (s_scv.cands.size() < 16)
+  {
+    ScView::Cand c;
+    std::copy(m, m + 12, c.m.begin());
+    c.n = 1;
+    c.fog = CurrentFog();
+    s_scv.cands.push_back(c);
+  }
+}
+
+// lit17s10: load the slot's scene in the background when the slot changes, then upload it a texture a frame
+void EmitQuadsAction::SceneryPoll(int slot)
+{
+  if (!m_sc)
+    m_sc = std::make_unique<SceneryState>();
+  SceneryState& S = *m_sc;
+  if (S.pending.valid())
+  {
+    if (S.pending.wait_for(std::chrono::seconds(0)) != std::future_status::ready)
+      return;
+    auto sc = S.pending.get();
+    if (sc && sc->slot == S.slot)
+    {
+      S.scene = std::move(sc);
+      S.gpu.clear();
+      S.gpu.resize(S.scene->meshes.size());
+      S.step = 0;
+      S.ready = false;
+    }
+  }
+  if (slot != S.slot && slot >= 0)
+  {
+    S.slot = slot;
+    S.scene.reset();
+    S.gpu.clear();
+    S.ready = false;
+    S.pending = std::async(std::launch::async, LoadScene, m_sc_dir, slot, m_sc_mesh_file, m_sc_pos, m_sc_yaw,
+                           m_sc_scale);
+    return;
+  }
+  if (!S.scene || S.ready)
+    return;
+  if (!S.white)
+  {
+    S.white = ScSolid(0xFFFFFFFFu);
+    S.black = ScSolid(0xFF000000u);
+  }
+  // one upload a frame: mesh i = steps 4i .. 4i + 3 (vertices, base colour, ORM, emissive)
+  const size_t total = S.scene->meshes.size() * 4;
+  if (S.step < total)
+  {
+    const size_t i = S.step / 4;
+    ScMeshData& md = S.scene->meshes[i];
+    ScGpuMesh& g = S.gpu[i];
+    switch (S.step % 4)
+    {
+    case 0:
+      if (md.ok)
+      {
+        const u32 n = static_cast<u32>(md.verts.size());
+        const u32 h = std::max((n + SC_ROW - 1) / SC_ROW, 1u);
+        md.verts.resize(static_cast<size_t>(h) * SC_ROW, 0.0f);
+        g.verts = g_gfx->CreateTexture(TextureConfig(SC_ROW, h, 1, 1, 1, AbstractTextureFormat::R32F, 0,
+                                                     AbstractTextureType::Texture_2DArray),
+                                       "scenery vertices");
+        if (g.verts)
+        {
+          g.verts->Load(0, SC_ROW, h, SC_ROW, reinterpret_cast<const u8*>(md.verts.data()), md.verts.size() * 4);
+          g.nverts = n / 8;
+        }
+        std::vector<float>().swap(md.verts);
+      }
+      break;
+    case 1:
+      g.color = ScTexture(md.color, "scenery base colour");
+      md.color.mips.clear();
+      break;
+    case 2:
+      g.orm = ScTexture(md.orm, "scenery orm");
+      md.orm.mips.clear();
+      break;
+    case 3:
+      g.emissive = ScTexture(md.emissive, "scenery emissive");
+      md.emissive.mips.clear();
+      break;
+    }
+    S.step++;
+  }
+  if (S.step >= total)
+    S.ready = true;
+}
+
+void EmitQuadsAction::EmitScenery(const EmitQuadsAnchor& target)
+{
+  if (target.projection_rows[3][3] != 0.0f)
+    return;  // the world's perspective draws only
+  u32 venue = 0, slot = 0;
+  bool demo = false;
+  if (!ReadGate(&venue, &slot, &demo) || venue >= 256 || demo)
+    return;
+  if (m_sc_course >= 0 && static_cast<u32>(m_sc_course) != venue)
+    return;
+  if (m_sc_slot >= 0 && static_cast<u32>(m_sc_slot) != slot)
+    return;
+  SceneryPoll(static_cast<int>(slot));
+  if (!m_sc || !m_sc->ready || !m_sc->scene || m_sc->scene->inst.empty())
+    return;
+  if (g_framebuffer_manager->IsEFBStereo())
+    return;
+
+  float ram[12];
+  const bool have_ram = ReadRamView(ram);
+  const ScView::Cand* best = nullptr;
+  if (m_sc_gpu_view && s_scv.frame == s_global_frame)
+  {
+    for (const auto& c : s_scv.cands)
+      if (!best || c.n > best->n)
+        best = &c;
+  }
+  float V[12];
+  if (best)
+    std::copy(best->m.begin(), best->m.end(), V);
+  else if (have_ram)
+    std::copy(ram, ram + 12, V);
+  else
+    return;
+  ScFog fog;
+  if (best)
+    fog = best->fog;
+  else if (s_scv.frame == s_global_frame && !s_scv.cands.empty())
+    fog = s_scv.cands[0].fog;
+
+  if (!EnsureResources(target))
+    return;
+  const AbstractPipeline* pipeline = GetPipeline(target);
+  if (!pipeline)
+    return;
+  const ScScene& sc = *m_sc->scene;
+  const ScLight& L = sc.light;
+  // view-space light: towards the sun and world up through the view's rotation
+  const auto rot = [&](const std::array<float, 3>& w) {
+    std::array<float, 3> v{};
+    for (int r = 0; r < 3; r++)
+      v[r] = V[r * 4] * w[0] + V[r * 4 + 1] * w[1] + V[r * 4 + 2] * w[2];
+    const float l = std::sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
+    if (l > 1e-6f)
+      for (float& x : v)
+        x /= l;
+    return v;
+  };
+  const auto sunv = rot(L.sun);
+  const auto upv = rot({0.0f, 1.0f, 0.0f});
+  // frustum planes in view space from the projection rows (left, right, bottom, top)
+  const auto& P = target.projection_rows;
+  std::array<std::array<float, 4>, 4> planes;
+  for (int k = 0; k < 4; k++)
+  {
+    const int row = k / 2;
+    const float sg = (k % 2) ? -1.0f : 1.0f;
+    for (int c = 0; c < 4; c++)
+      planes[k][c] = P[3][c] + sg * P[row][c];
+    const float l = std::sqrt(planes[k][0] * planes[k][0] + planes[k][1] * planes[k][1] + planes[k][2] * planes[k][2]);
+    if (l > 1e-12f)
+      for (float& x : planes[k])
+        x /= l;
+  }
+
+  EmitQuadsUniforms u{};
+  u.projection = target.projection_rows;
+  u.pixel_center = target.pixel_center;
+  const float vw = std::max(target.viewport[0], 1.0f), vh = std::max(target.viewport[1], 1.0f);
+  u.viewport = {vw, vh, 1.0f / vw, 1.0f / vh};
+  {
+    const auto& vs = g_gfx->GetStoredViewportAndScissor();
+    u.depth_range = {vs.viewport_near_depth, vs.viewport_far_depth, 0.0f, 0.0f};
+  }
+  u.ram = {fog.a, fog.c, fog.bmag, fog.bshift, fog.fsel, fog.far_z, fog.z_range, fog.persp};
+  u.player = {fog.col[0], fog.col[1], fog.col[2], fog.fsel > 0.0f ? 1.0f : 0.0f};
+  u.model_min = {L.haze[0], L.haze[1], L.haze[2], L.haze[3]};
+  u32 drawn = 0, culled = 0;
+  for (const ScInstance& in : sc.inst)
+  {
+    const ScGpuMesh& g = m_sc->gpu[in.mesh];
+    if (!g.verts || g.nverts == 0)
+      continue;
+    float c[3];
+    for (int r = 0; r < 3; r++)
+      c[r] = V[r * 4] * in.wc[0] + V[r * 4 + 1] * in.wc[1] + V[r * 4 + 2] * in.wc[2] + V[r * 4 + 3];
+    bool vis = c[2] - in.wr < 0.0f;  // something of it in front of the camera (view looks down -z)
+    if (vis && m_sc_max_dist > 0.0f)
+      vis = std::sqrt(c[0] * c[0] + c[1] * c[1] + c[2] * c[2]) - in.wr < m_sc_max_dist;
+    for (int k = 0; k < 4 && vis; k++)
+      vis = planes[k][0] * c[0] + planes[k][1] * c[1] + planes[k][2] * c[2] + planes[k][3] > -in.wr;
+    if (!vis)
+    {
+      culled++;
+      continue;
+    }
+    const ScMeshData& md = sc.meshes[in.mesh];
+    for (int r = 0; r < 3; r++)
+      for (int k = 0; k < 4; k++)
+      {
+        float x = V[r * 4 + 0] * in.W[k] + V[r * 4 + 1] * in.W[4 + k] + V[r * 4 + 2] * in.W[8 + k];
+        if (k == 3)
+          x += V[r * 4 + 3];
+        u.matrix[r][k] = x;
+      }
+    u.info = {target.time_ms, g.nverts, drawn, m_frame_counter};
+    u.params = {sunv[0], sunv[1], sunv[2], in.glow, L.sun_col[0], L.sun_col[1], L.sun_col[2], L.spec,
+                L.amb[0], L.amb[1], L.amb[2], g.orm ? 1.0f : 0.0f, upv[0], upv[1], upv[2], g.emissive ? 1.0f : 0.0f};
+    u.target = {md.base[0], md.base[1], md.base[2], md.base[3]};
+    u.target_far = {md.em[0], md.em[1], md.em[2], 0.0f};
+    g_vertex_manager->UploadUtilityUniforms(&u, sizeof(u));
+    g_gfx->SetPipeline(pipeline);
+    g_gfx->SetTexture(0, g.verts.get());
+    g_gfx->SetSamplerState(0, RenderState::GetPointSamplerState());
+    SamplerState ss = RenderState::GetLinearSamplerState();
+    ss.tm0.wrap_u = WrapMode::Repeat;
+    ss.tm0.wrap_v = WrapMode::Repeat;
+    ss.tm0.anisotropic_filtering = 3;  // 8x
+    g_gfx->SetTexture(1, g.color ? g.color.get() : m_sc->white.get());
+    g_gfx->SetSamplerState(1, ss);
+    g_gfx->SetTexture(2, g.orm ? g.orm.get() : m_sc->white.get());
+    g_gfx->SetSamplerState(2, ss);
+    g_gfx->SetTexture(3, g.emissive ? g.emissive.get() : m_sc->black.get());
+    g_gfx->SetSamplerState(3, ss);
+    g_gfx->Draw(0, g.nverts);
+    drawn++;
+  }
+  m_emits_this_frame++;
+  if (m_sc_trace)
+  {
+    m_sc_trace--;
+    std::fprintf(stderr, "SCENERY f=%llu venue %u slot %u view %s drawn %u culled %u fog sel %.0f a %.4g c %.4g "
+                 "V=[%.3f %.3f %.3f %.2f | %.3f %.3f %.3f %.2f | %.3f %.3f %.3f %.2f]\n",
+                 static_cast<unsigned long long>(s_global_frame), venue, slot, best ? "gpu" : "ram", drawn, culled,
+                 fog.fsel, fog.a, fog.c, V[0], V[1], V[2], V[3], V[4], V[5], V[6], V[7], V[8], V[9], V[10], V[11]);
+  }
+}
