+
+// Body draws: the CustomShaderBlock of a "damage" custom_pipeline (std140, every member a vec4).
+namespace DamageFx
+{
+namespace
+{
+struct DrawUniforms
+{
+  std::array<float, 4> info;  // x = hits, y = time s, z = machine size (draw model units), w = machine size (view)
+  std::array<std::array<float, 4>, 16> mpos;  // draw model space: centre, w = radius
+  std::array<std::array<float, 4>, 16> mdir;  // draw model space: outward normal, w = depth
+  std::array<std::array<float, 4>, 16> vpos;  // view space: centre, w = radius
+  std::array<std::array<float, 4>, 16> vdir;  // view space: outward normal, w = depth
+  std::array<std::array<float, 4>, 16> vtan;  // view space: scrape direction, w = seed
+  std::array<std::array<float, 4>, 16> aux;   // age s, strength, fade (1 intact .. 0 repaired), heat
+  // lit17c hull effects (view space of this draw)
+  std::array<float, 4> hx_info;                  // heat 0..1+, speed km/h, grip level, 1 = valid
+  std::array<float, 4> hx_vdir;                  // travel direction (unit), w = front extent (view units)
+  std::array<float, 4> hx_vctr;                  // machine centre, w = back extent
+  std::array<float, 4> hx_vup;                   // the machine's up (unit), w = machine size (view units)
+  std::array<std::array<float, 4>, 3> hx_inv;    // view -> machine (hit) space rows (a fixed frame on the hull)
+  // lit17s surface layer
+  std::array<float, 4> sf_info;                  // racer index, machine id, 1 = the player (racer 0), 1 = valid
+  std::array<float, 4> sf_pit;                   // ms since arriving on the pit strip, ms since leaving it (0 on it), 1 on it, energy
+  std::array<std::array<float, 4>, 2> sf_ram;    // configured racer RAM values 0..7
+  std::array<float, 4> sf_clock;                 // the emit clock: ms % 1e6, ms / 1e6 (the body shaders' time_ms is not
+                                                 // re-uploaded per draw: it stays stale between pixel constant uploads)
+};
+static_assert(sizeof(DrawUniforms) == (1 + 6 * 16 + 7 + 5) * 16);
+}  // namespace
+
+std::string_view UniformBlock()
+{
+  return R"(  float4 dm_info;      // x = damage hits (0..16), y = time s, z = machine size (draw model units), w = size (view)
+  float4 dm_mpos[16];  // draw model space: hit centre, w = dent radius
+  float4 dm_mdir[16];  // draw model space: outward hull normal at the hit, w = dent depth
+  float4 dm_vpos[16];  // view space: hit centre, w = radius
+  float4 dm_vdir[16];  // view space: outward normal, w = depth
+  float4 dm_vtan[16];  // view space: scrape direction, w = seed 0..1
+  float4 dm_aux[16];   // x = age s (since the last impact), y = strength, z = 1 intact .. 0 repaired, w = heat
+  float4 hx_info;      // lit17c: x = speed heat 0..1+ (smoothed), y = speed km/h, z = grip level, w = 1 if valid
+  float4 hx_vdir;      // lit17c: travel direction (view, unit), w = front extent from the centre (view units)
+  float4 hx_vctr;      // lit17c: machine centre (view), w = back extent
+  float4 hx_vup;       // lit17c: the machine's up (view, unit), w = machine size (view units)
+  float4 hx_inv[3];    // lit17c: view -> machine space rows (hull-fixed coordinates: dot(hx_inv[i], float4(p, 1)))
+  float4 sf_info;      // lit17s: x = racer index, y = machine id (racer +0x7), z = 1 player, w = 1 if valid
+  float4 sf_pit;       // lit17s: x = ms since arriving on the pit strip, y = ms since leaving it (0 while on it), z = 1 on it, w = energy
+  float4 sf_ram[2];    // lit17s: the surface_layer config's racer RAM values 0..7 (sf_ram[i >> 2][i & 3])
+  float4 sf_clock;     // lit17s: x = ms % 1000000, y = ms / 1000000 (use this, not time_ms: that one is stale per draw); lit17s6: z = night look for this body draw (0 none, 1 dusk, 2 night), w = night strength
