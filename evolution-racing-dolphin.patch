+// ---------------------------------------------------------------- host side
+bool IsLaunchArg(const std::string& arg)
+{
+  return arg.starts_with("evoracing:") || arg.ends_with(".ertest");
+}
+
+bool ClaimOrForward(const std::string& arg)
+{
+  File::CreateFullPath(Dir());
+  const std::string lock = Dir() + "running.lock";
+#ifdef _WIN32
+  s_lock = CreateFileW(UTF8ToWString(lock).c_str(), GENERIC_READ | GENERIC_WRITE, 0, nullptr,
+                       OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+  const bool mine = s_lock != INVALID_HANDLE_VALUE;
+#else
+  s_lock = open(lock.c_str(), O_RDWR | O_CREAT | O_CLOEXEC, 0644);
+  const bool mine = s_lock >= 0 && flock(s_lock, LOCK_EX | LOCK_NB) == 0;
+  if (!mine && s_lock >= 0)
+  {
+    close(s_lock);
+    s_lock = -1;
+  }
+#endif
+  if (mine)
+    return true;
+  // hand it to the running test Dolphin (it looks for *.wake files)
+  std::random_device rd;
+  const std::string name = Dir() + fmt::format("{:08x}{:08x}", rd(), rd());
+  File::WriteStringToFile(name + ".tmp", arg);
+  File::Rename(name + ".tmp", name + ".wake");
+  return false;
+}
+
+void Begin(const std::string& arg)
+{
+  s_active = true;
+  s_begin_file = std::filesystem::file_time_type::clock::now() - std::chrono::seconds(5);
+  File::CreateFullPath(Dir());
+  if (!arg.empty())
+    s_pending_args.push_back(arg);
+  // anything left from an earlier session is stale
+  for (const std::string& f : Common::DoFileSearch(Dir(), ".wake", false))
+    File::Delete(f);
+}
+
+bool Active()
+{
+  return s_active;
+}
+
+void SetDownloadDirs(std::vector<std::string> dirs)
+{
+  s_download_dirs = std::move(dirs);
+}
+
+void RegisterHandlers()
+{
+#ifdef _WIN32
+  wchar_t exe[MAX_PATH];
+  if (!GetModuleFileNameW(nullptr, exe, MAX_PATH))
+    return;
+  const std::wstring cmd = L"\"" + std::wstring(exe) + L"\" \"%1\"";
+  auto set = [](const std::wstring& key, const wchar_t* name, const std::wstring& value) {
+    HKEY k;
+    if (RegCreateKeyExW(HKEY_CURRENT_USER, key.c_str(), 0, nullptr, 0, KEY_SET_VALUE, nullptr, &k,
+                        nullptr) == ERROR_SUCCESS)
+    {
+      RegSetValueExW(k, name, 0, REG_SZ, reinterpret_cast<const BYTE*>(value.c_str()),
+                     static_cast<DWORD>((value.size() + 1) * sizeof(wchar_t)));
+      RegCloseKey(k);
+    }
+  };
+  set(L"Software\\Classes\\evoracing", nullptr, L"URL:Evolution Racing Test in game");
+  set(L"Software\\Classes\\evoracing", L"URL Protocol", L"");
+  set(L"Software\\Classes\\evoracing\\shell\\open\\command", nullptr, cmd);
+  set(L"Software\\Classes\\.ertest", nullptr, L"EvolutionRacing.ertest");
+  set(L"Software\\Classes\\EvolutionRacing.ertest", nullptr, L"Evolution Racing test track");
+  set(L"Software\\Classes\\EvolutionRacing.ertest\\shell\\open\\command", nullptr, cmd);
+#endif
+}
