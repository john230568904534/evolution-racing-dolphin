+void MainWindow::InitERUpdates()
+{
+  ERUpdateTitle();
+  m_er_upd_timer = new QTimer(this);
+  connect(m_er_upd_timer, &QTimer::timeout, this, &MainWindow::ERUpdateTick);
+  // a new folder made by the updater: bring the older folder over first (it waits for that Dolphin to close)
+  const std::string imported = ERUpdates::ImportIfAsked();
+  if (!imported.empty())
+  {
+    ERGhostProbe(false);
+    ERUpdateTitle();
+    QTimer::singleShot(800, this, [this, imported] {
+      ERNote("Updated to " + Common::GetERVersionStr() + ": " + imported + ". The old folder can be deleted when you are happy.");
+    });
+  }
+  // packs an older folder downloaded for this Dolphin
+  auto pend = ERUpdates::PendingPacks();
+  if (!pend.empty())
+  {
+    m_er_run = std::make_shared<ERUpdateRun>();
+    for (auto& p : pend)
+      m_er_run->ready.push_back(p);
+    m_er_run->finished = true;
+    m_er_upd_timer->start(1000);
+  }
+  ERUpdates::Settings us = ERUpdates::Load();
+  if (!us.asked)
+  {
+    QTimer::singleShot(1500, this, [this] { ERFirstRun(); });
+    return;
+  }
+  const ERGhosts::Settings gs = ERGhosts::Load();
+  if (us.mode != ERUpdates::Mode::Off && !gs.offline && !gs.token.empty())
+    QTimer::singleShot(4000, this, [this] { ERUpdateCheck(false); });
+}
