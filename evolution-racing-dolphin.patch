+// A new impact on racer r: pick the hull point facing the impact, add or deepen a hit.
+void DmAddHit(int r, DmRacer& d, const AnchorCluster& cl, float drop, const V3& dir_world, const V3& vel_world,
+              const float* V, u32 now)
+{
+  const DmConfig& c = s_dm_cfg;
+  const M34& M = cl.a.position_matrix;
+  M34 Mi;
+  if (!Inv34(M, &Mi) || cl.a.surf.empty())
+    return;
+  // the machine's samples in hit space (model space of the main part)
+  std::vector<V3> sp, sn;
+  sp.reserve(cl.a.surf.size());
+  sn.reserve(cl.a.surf.size());
+  V3 ctr{};
+  for (const auto& s : cl.a.surf)
+  {
+    sp.push_back(XP(Mi, {s[0], s[1], s[2]}));
+    sn.push_back(s[7] > 0.5f ? Norm3(XV(Mi, {s[4], s[5], s[6]}), {0.0f, 0.0f, 0.0f}) : V3{0.0f, 0.0f, 0.0f});
+    for (int i = 0; i < 3; i++)
+      ctr[i] += sp.back()[i];
+  }
+  for (int i = 0; i < 3; i++)
+    ctr[i] /= static_cast<float>(sp.size());
+  float size = 0.0f;
+  for (const V3& p : sp)
+    size = std::max(size, Len3({p[0] - ctr[0], p[1] - ctr[1], p[2] - ctr[2]}));
+  size = std::max(size * 0.85f, 1e-3f);
+  d.size = size;
+  // impact direction (from the machine towards what hit it) and travel direction, in hit space
+  V3 dm{}, fm{};
+  bool have_dir = false;
+  if (V)
+  {
+    const M34 Vm = {V[0], V[1], V[2], V[3], V[4], V[5], V[6], V[7], V[8], V[9], V[10], V[11]};
+    if (Len3(dir_world) > 1e-6f)
+    {
+      dm = Norm3(XV(Mi, XV(Vm, dir_world)));
+      have_dir = true;
+    }
+    fm = Norm3(XV(Mi, XV(Vm, vel_world)), {0.0f, 0.0f, 1.0f});
+  }
+  else
+  {
+    fm = {0.0f, 0.0f, 1.0f};
+  }
+  if (!have_dir)
+  {
+    // no usable push: a random flank (perpendicular to the travel direction in the machine's own plane)
+    const V3 side = Norm3(Cross3(fm, {0.0f, 1.0f, 0.0f}), {1.0f, 0.0f, 0.0f});
+    const float sg = DmRand() < 0.5f ? -1.0f : 1.0f;
+    dm = Norm3({side[0] * sg + fm[0] * 0.3f, side[1] * sg + fm[1] * 0.3f, side[2] * sg + fm[2] * 0.3f});
+  }
+  // where it struck: the hull points furthest out towards the impact (sideways part weighted up, so a scrape lands on
+  // the flank, not on the nose tip), then among those the one whose surface faces it best; a little jitter spreads
+  // repeated hits over the panel
+  V3 dp = {dm[0] - fm[0] * Dot3(dm, fm) * 0.6f, dm[1] - fm[1] * Dot3(dm, fm) * 0.6f, dm[2] - fm[2] * Dot3(dm, fm) * 0.6f};
+  dp = Norm3(dp, dm);
+  float ext_max = -1e30f;
+  std::vector<float> ext(sp.size());
+  for (size_t i = 0; i < sp.size(); i++)
+  {
+    const V3 q = {sp[i][0] - ctr[0], sp[i][1] - ctr[1], sp[i][2] - ctr[2]};
+    ext[i] = Dot3(q, dp) / size;
+    ext_max = std::max(ext_max, ext[i]);
+  }
+  int best = -1;
+  float best_s = -1e30f;
+  for (size_t i = 0; i < sp.size(); i++)
+  {
+    if (ext[i] < ext_max - 0.3f)
+      continue;
+    float sc = ext[i] * 0.8f + 0.25f * DmRand();
+    // keep off the very bottom / top edge (model y = the machine's up): panels, not the hull's rim
+    if (std::abs(dp[1]) < 0.7f)
+      sc -= 3.0f * std::abs(sp[i][1] - ctr[1]) / size;
+    if (Len3(sn[i]) > 0.5f)
+      sc += 1.0f * Dot3(sn[i], dp);
+    if (sc > best_s)
+    {
+      best_s = sc;
+      best = static_cast<int>(i);
+    }
+  }
+  if (best < 0)
+    return;
+  const V3 P = sp[best];
+  V3 N = Len3(sn[best]) > 0.5f ? sn[best] : Norm3({P[0] - ctr[0], P[1] - ctr[1], P[2] - ctr[2]});
+  if (Dot3(N, dp) < 0.2f)
+    N = Norm3({N[0] + dp[0], N[1] + dp[1], N[2] + dp[2]}, dp);
+  V3 T = {fm[0] - N[0] * Dot3(fm, N), fm[1] - N[1] * Dot3(fm, N), fm[2] - N[2] * Dot3(fm, N)};
+  T = Norm3(T, Norm3(Cross3(N, {0.0f, 1.0f, 0.0f}), {1.0f, 0.0f, 0.0f}));
+  const float s = std::max(drop / std::max(c.full_drop, 1e-3f), 0.05f) * (r > 0 ? c.cpu_scale : 1.0f);
+  const float rad = size * (c.radius + c.radius_k * std::sqrt(std::min(s, 3.0f)));
+  const float dep = size * std::min(c.depth + c.depth_k * s, c.depth_max);
+  // the same impact over consecutive frames, or a hit near an old one: deepen that one
+  int into = -1;
+  if (d.last_hit >= 0 && d.last_hit < static_cast<int>(d.hits.size()) && now - d.last_hit_ms < 60u)
+    into = d.last_hit;
+  else
+  {
+    float bd = 1e30f;
+    for (size_t i = 0; i < d.hits.size(); i++)
+    {
+      const DmHit& h = d.hits[i];
+      const float dd = Len3({h.pos[0] - P[0], h.pos[1] - P[1], h.pos[2] - P[2]});
+      const float lim = c.merge * std::max(h.radius, rad);
+      if (dd < lim && dd < bd && Dot3(h.nrm, N) > 0.3f)
+      {
+        bd = dd;
+        into = static_cast<int>(i);
+      }
+    }
+    if (into < 0 && d.hits.size() >= 16)
+    {
+      for (size_t i = 0; i < d.hits.size(); i++)
+      {
+        const DmHit& h = d.hits[i];
+        const float dd = Len3({h.pos[0] - P[0], h.pos[1] - P[1], h.pos[2] - P[2]});
+        if (dd < bd)
+        {
+          bd = dd;
+          into = static_cast<int>(i);
+        }
+      }
+    }
+  }
+  if (into >= 0)
+  {
+    DmHit& h = d.hits[into];
+    h.strength += s;
+    h.depth = std::min(h.depth + size * c.depth_k * s * 0.6f, size * c.depth_max * 1.35f);
+    h.radius = std::min(std::max(h.radius, rad) * (1.0f + 0.04f * std::min(s, 1.0f)), size * 0.42f);
+    h.heat = std::min(h.heat + s, 6.0f);
+    h.last_ms = now;
+    h.heal = 0.0f;
+  }
+  else
+  {
+    DmHit h;
+    h.pos = P;
+    h.nrm = N;
+    h.tan = T;
+    h.radius = rad;
+    h.depth = dep;
+    h.strength = s;
+    h.heat = std::min(s, 6.0f);
+    h.seed = DmRand();
+    h.born_ms = now;
+    h.last_ms = now;
+    d.hits.push_back(h);
+    into = static_cast<int>(d.hits.size()) - 1;
+  }
+  d.last_hit = into;
+  d.last_hit_ms = now;
+  if (c.trace)
+  {
+    const DmHit& h = d.hits[into];
+    std::fprintf(stderr,
+                 "EQTRACE dmg f=%llu racer=%d drop=%.2f s=%.2f hit=%d/%zu pos=(%.2f %.2f %.2f) n=(%.2f %.2f %.2f) "
+                 "dir=(%.2f %.2f %.2f) r=%.3f depth=%.3f size=%.2f str=%.2f\n",
+                 static_cast<unsigned long long>(s_global_frame), r, drop, s, into, d.hits.size(), h.pos[0],
+                 h.pos[1], h.pos[2], h.nrm[0], h.nrm[1], h.nrm[2], dm[0], dm[1], dm[2], h.radius, h.depth, size,
+                 h.strength);
+  }
+}
+
+// ---- Evolution Racing dolphin-lit17c: hull effects (HullFx) ----
+struct HxConfig
+{
+  u32 off_speed = 0x17c;                 // f32 km/h
+  u32 off_up = 0xec;                     // 3x4 rotation rows at +0xec (+0x10 per row): up = column 1
+  u32 air_mask = 0x01000000;             // state word: airborne
+  float heat_min = 1300.0f, heat_full = 2050.0f;   // km/h
+  float heat_rise_s = 1.2f, heat_fall_s = 3.5f;    // time constants (s)
+  float land_min = 0.10f, land_full = 0.45f;       // fall speed along the machine's up (m / frame) -> strength 0..1
+  float comp_min = 0.10f, comp_full = 0.30f;       // jump in the up velocity on the ground (m / frame^2) -> 0..1
+  float level_s = 0.10f;                           // grip level half-life (s)
+  int min_air = 3;                                 // frames in the air before a touch-down counts as a landing
+  // race scene only (machine select, garage, replays of menus: the racer blocks hold stale data there): the same
+  // condition as the owner's WideScreenHackGate, [80352660] & FFFF0000 == 000A0000
+  u32 scene_addr = 0x80352660, scene_mask = 0xFFFF0000, scene_value = 0x000A0000;
+  // lit17s4: "scene_chain": [A, O1, ...] (as the emit-quads RAM gates: read *A, add O1, ... read) - wins over scene_addr.
+  // The scene word is main-REL data and moves with the REL's load address: [0x800030C8, 0x197DE0]
+  std::vector<u32> scene_chain;
+  u32 trace = 0;
+};
+HxConfig s_hx_cfg;
+bool s_hx_race = false;  // this frame is the race scene (HxFrameGate)
+
+void HxConfigure(const picojson::object& g)
+{
+  HxConfig c;
+  const auto num = [&](const char* key, float* out) {
+    if (const auto n = ReadNumericFromJson<double>(g, key))
+      *out = static_cast<float>(*n);
+  };
+  const auto u = [&](const char* key, u32* out) {
+    if (const auto n = ReadNumericFromJson<double>(g, key))
+      *out = static_cast<u32>(*n);
+  };
+  u("speed", &c.off_speed);
+  u("up", &c.off_up);
+  u("air_mask", &c.air_mask);
+  num("heat_min", &c.heat_min);
+  num("heat_full", &c.heat_full);
+  num("heat_rise_s", &c.heat_rise_s);
+  num("heat_fall_s", &c.heat_fall_s);
+  num("land_min", &c.land_min);
+  num("land_full", &c.land_full);
+  num("comp_min", &c.comp_min);
+  num("comp_full", &c.comp_full);
+  num("level_s", &c.level_s);
+  float ma = static_cast<float>(c.min_air);
+  num("min_air", &ma);
+  c.min_air = static_cast<int>(ma);
+  u("scene_addr", &c.scene_addr);
+  u("scene_mask", &c.scene_mask);
+  u("scene_value", &c.scene_value);
+  if (const auto sc = g.find("scene_chain"); sc != g.end() && sc->second.is<picojson::array>())
+  {
+    for (const auto& v : sc->second.get<picojson::array>())
+    {
+      if (v.is<double>())
+        c.scene_chain.push_back(static_cast<u32>(v.get<double>()));
+    }
+  }
+  u("trace", &c.trace);
+  s_hx_cfg = c;
+}
+
+// once per frame end, before the racers: is this the race scene?
+void HxFrameGate()
+{
+  const HxConfig& h = s_hx_cfg;
+  if (!h.scene_addr && h.scene_chain.empty())
+  {
+    s_hx_race = true;
+    return;
+  }
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const auto read32 = [&](u32 addr, u32* o) {
+    if (addr < 0x80000000u || addr >= 0x81800000u)
+      return false;
+    const u8* q = memory.GetPointerForRange(addr, 4);
+    if (!q)
+      return false;
+    u32 w;
+    std::memcpy(&w, q, 4);
+    *o = Common::swap32(w);
+    return true;
+  };
+  bool ok = true;
+  u32 a = h.scene_addr;
+  if (!h.scene_chain.empty())
+  {
+    a = h.scene_chain[0];
+    for (size_t i = 1; i < h.scene_chain.size() && ok; i++)
+    {
+      u32 w = 0;
+      ok = read32(a, &w);
+      a = w + h.scene_chain[i];
+    }
+  }
+  u32 v = 0;
+  ok = ok && read32(a, &v);
+  s_hx_race = ok && (v & h.scene_mask) == h.scene_value;
+}
+
+// once per frame and racer (DmFrameEnd): speed heat, travel direction / hull shape in hit space, grip impacts
+// lit17s: "surface_layer": {"ram": [{"off": 0x184, "type": "f32"}, {"off": 0, "type": "bit", "mask": 32}, ...]} (up to 8)
+void SfConfigure(const picojson::object& g)
+{
+  const auto it = g.find("ram");
+  if (it == g.end() || !it->second.is<picojson::array>())
+    return;
+  int n = 0;
+  for (const auto& e : it->second.get<picojson::array>())
+  {
+    if (n >= 8 || !e.is<picojson::object>())
+      break;
+    const auto& o = e.get<picojson::object>();
+    SfRam q;
+    if (const auto v = ReadNumericFromJson<double>(o, "off"))
+      q.off = static_cast<u32>(*v);
+    if (const auto v = ReadNumericFromJson<double>(o, "mask"))
+      q.mask = static_cast<u32>(*v);
+    if (const auto t = ReadStringFromJson(o, "type"))
+      q.type = *t == "u32" ? 1 : *t == "u8" ? 2 : *t == "bit" ? 3 : 0;
+    s_sf_ram[n++] = q;
+  }
+  s_sf_nram = std::max(s_sf_nram, n);
+}
+
+void HxUpdate(int r, DmRacer& d, u32 b, u32 state, const V3& pos, const AnchorCluster* cl, const float* V, u32 now)
+{
+  if (s_hx_refs <= 0 && s_sf_refs <= 0)
+    return;
+  if (!s_hx_race)
+  {
+    // not racing: no heat, no grip, no shape (body draws get hx_info.w = 0, the emits are culled)
+    d.hx_heat = 0.0f;
+    d.hx_level = 0.0f;
+    d.hx_str = 0.0f;
+    d.hx_ever = false;
+    d.hx_shape = false;
+    d.hx_air = 0;
+    d.hx_vup[0] = d.hx_vup[1] = d.hx_vup[2] = 0.0f;
+    return;
+  }
+  const HxConfig& h = s_hx_cfg;
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const auto readf = [&](u32 addr, float* out) {
+    const u8* p = memory.GetPointerForRange(addr, 4);
+    if (!p)
+      return false;
+    u32 v;
+    std::memcpy(&v, p, 4);
+    v = Common::swap32(v);
+    std::memcpy(out, &v, 4);
+    return std::isfinite(*out);
+  };
+  float speed = 0.0f;
+  if (!readf(b + h.off_speed, &speed))
+    speed = 0.0f;
+  d.hx_speed = speed;
+  const float tgt = std::clamp((speed - h.heat_min) / std::max(h.heat_full - h.heat_min, 1.0f), 0.0f, 1.3f);
+  const float tc = tgt > d.hx_heat ? h.heat_rise_s : h.heat_fall_s;
+  d.hx_heat += (tgt - d.hx_heat) * (1.0f - std::exp(-1.0f / (std::max(tc, 0.02f) * 60.0f)));
+  // the machine's up (world): column 1 of its rotation
+  V3 up{0.0f, 1.0f, 0.0f};
+  {
+    float a = 0, bb = 0, cc = 0;
+    if (readf(b + h.off_up + 4, &a) && readf(b + h.off_up + 0x14, &bb) && readf(b + h.off_up + 0x24, &cc))
+      up = Norm3({a, bb, cc}, up);
+  }
+  // world velocity (m / frame) from the position
+  V3 vel{};
+  bool have_vel = d.have_prev;
+  if (have_vel)
+  {
+    vel = {pos[0] - d.pos[0], pos[1] - d.pos[1], pos[2] - d.pos[2]};
+    if (Len3(vel) > 30.0f)
+      have_vel = false;
+  }
+  // grip impacts: a touch-down after time in the air, or a hard jolt up on the ground (dip, compression)
+  const bool air = (state & h.air_mask) != 0;
+  float ev = 0.0f;
+  if (have_vel)
+  {
+    const float vup = Dot3(vel, up);
+    const float aup = vup - d.hx_vup[0];
+    if (!air)
+    {
+      if (d.hx_air >= h.min_air)
+      {
+        const float fall = std::max({-d.hx_vup[0], -d.hx_vup[1], -d.hx_vup[2], 0.0f});
+        ev = std::max(ev, 0.15f + (fall - h.land_min) / std::max(h.land_full, 1e-3f));
+      }
+      if (d.hx_air == 0 && aup > h.comp_min)
+        ev = std::max(ev, (aup - h.comp_min) / std::max(h.comp_full, 1e-3f));
+    }
+    d.hx_vup[2] = d.hx_vup[1];
+    d.hx_vup[1] = d.hx_vup[0];
+    d.hx_vup[0] = vup;
+  }
+  else
+  {
+    d.hx_vup[0] = d.hx_vup[1] = d.hx_vup[2] = 0.0f;
+  }
+  d.hx_air = air ? d.hx_air + 1 : 0;
+  ev = std::min(ev, 2.0f);
+  d.hx_level *= std::exp(-0.6931f / (std::max(h.level_s, 0.01f) * 60.0f));
+  if (ev > 0.0f)
+  {
+    d.hx_level = std::max(d.hx_level, std::min(ev, 1.5f));
+    if (!d.hx_ever || now - d.hx_ms > 150u || ev > d.hx_str * 1.25f)
+    {
+      d.hx_ms = now;
+      d.hx_str = ev;
+      d.hx_ever = true;
+    }
+    else
+    {
+      d.hx_str = std::max(d.hx_str, ev);
+    }
+    if (h.trace)
+      std::fprintf(stderr, "EQTRACE grip f=%llu racer=%d ev=%.2f level=%.2f speed=%.0f air=%d\n",
+                   static_cast<unsigned long long>(s_global_frame), r, ev, d.hx_level, speed, d.hx_air);
+  }
+  // travel direction and hull shape in hit space (model space of the main part)
+  if (h.trace > 1 && s_global_frame % 10 == 0 && (r == 0 || h.trace > 2))
+    std::fprintf(stderr, "EQTRACE hxwhy f=%llu racer=%d cl=%d V=%d surf=%d shape=%d draws=%d parts=%d\n",
+                 static_cast<unsigned long long>(s_global_frame), r, cl ? 1 : 0, V ? 1 : 0,
+                 cl ? static_cast<int>(cl->a.surf.size()) : -1, d.hx_shape ? 1 : 0, cl ? static_cast<int>(cl->draws) : -1,
+                 static_cast<int>(d.parts.size()));
+  if (cl && V)
+  {
+    M34 Mi;
+    if (Inv34(cl->a.position_matrix, &Mi))
+    {
+      const M34 Vm = {V[0], V[1], V[2], V[3], V[4], V[5], V[6], V[7], V[8], V[9], V[10], V[11]};
+      if (have_vel && Len3(vel) > 0.05f)
+        d.hx_dir = Norm3(XV(Mi, XV(Vm, vel)), d.hx_dir);
+      d.hx_up = Norm3(XV(Mi, XV(Vm, up)), d.hx_up);
+      if (!cl->a.surf.empty())
+      {
+        V3 lo{1e30f, 1e30f, 1e30f}, hi{-1e30f, -1e30f, -1e30f};
+        std::vector<V3> sp;
+        sp.reserve(cl->a.surf.size());
+        for (const auto& s : cl->a.surf)
+        {
+          sp.push_back(XP(Mi, {s[0], s[1], s[2]}));
+          for (int k = 0; k < 3; k++)
+          {
+            lo[k] = std::min(lo[k], sp.back()[k]);
+            hi[k] = std::max(hi[k], sp.back()[k]);
+          }
+        }
+        const V3 ctr = {(lo[0] + hi[0]) * 0.5f, (lo[1] + hi[1]) * 0.5f, (lo[2] + hi[2]) * 0.5f};
+        float sz = 0.0f, fr = 0.0f, bk = 0.0f, lw = 0.0f;
+        for (const V3& p : sp)
+        {
+          const V3 q = {p[0] - ctr[0], p[1] - ctr[1], p[2] - ctr[2]};
+          sz = std::max(sz, Len3(q));
+          const float t = Dot3(q, d.hx_dir);
+          fr = std::max(fr, t);
+          bk = std::max(bk, -t);
+          lw = std::max(lw, -Dot3(q, d.hx_up));
+        }
+        d.hx_ctr = ctr;
+        d.hx_size = std::max(sz, 1e-3f);
+        d.hx_front = std::max(fr, 1e-3f);
+        d.hx_back = std::max(bk, 1e-3f);
+        d.hx_ymin = lw;
+        d.hx_shape = true;
+        if (h.trace > 1 && r == 0 && s_global_frame % 30 == 0)
+        {
+          const V3 vv = have_vel ? XV(Vm, vel) : V3{};
+          const V3 uv = XV(Vm, up);
+          std::fprintf(stderr,
+                       "EQTRACE hull f=%llu dir=(%.2f %.2f %.2f) up=(%.2f %.2f %.2f) dot=%.2f vel_view=(%.2f %.2f %.2f) "
+                       "up_view=(%.2f %.2f %.2f) ctr=(%.2f %.2f %.2f) size=%.2f front=%.2f back=%.2f low=%.2f heat=%.2f\n",
+                       static_cast<unsigned long long>(s_global_frame), d.hx_dir[0], d.hx_dir[1], d.hx_dir[2],
+                       d.hx_up[0], d.hx_up[1], d.hx_up[2], Dot3(d.hx_dir, d.hx_up), vv[0], vv[1], vv[2], uv[0],
+                       uv[1], uv[2], ctr[0], ctr[1], ctr[2], d.hx_size, d.hx_front, d.hx_back, lw, d.hx_heat);
+        }
+      }
+    }
+  }
+}
+
+void HxFillEmit(int racer, EmitQuadsUniforms& u)
+{
+  u.hx_info = {};
+  u.hx_dir = {};
+  u.hx_ctr = {};
+  u.hx_aux = {};
+  u.hx_up = {};
+  if (s_hx_refs <= 0 || racer < 0 || racer >= static_cast<int>(s_dm.size()))
+    return;
+  const DmRacer& d = s_dm[racer];
+  if (!d.hx_shape)
+    return;
+  const float age = d.hx_ever ? static_cast<float>(s_now_ms - d.hx_ms) * 0.001f : 1000.0f;
+  u.hx_info = {d.hx_heat, d.hx_speed, d.hx_level, age};
+  u.hx_dir = {d.hx_dir[0], d.hx_dir[1], d.hx_dir[2], d.hx_str};
+  u.hx_ctr = {d.hx_ctr[0], d.hx_ctr[1], d.hx_ctr[2], d.hx_size};
+  u.hx_aux = {d.hx_ymin, d.hx_front, d.hx_back, 1.0f};
+  u.hx_up = {d.hx_up[0], d.hx_up[1], d.hx_up[2], 0.0f};
+}
+
+void DmFrameEnd()
+{
+  HxFrameGate();  // lit17c
+  const DmConfig& c = s_dm_cfg;
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const auto read32 = [&](u32 addr, u32* out) {
+    const u8* p = memory.GetPointerForRange(addr, 4);
+    if (!p)
+      return false;
+    u32 v;
+    std::memcpy(&v, p, 4);
+    *out = Common::swap32(v);
+    return true;
+  };
+  const auto readf = [&](u32 addr, float* out) {
+    u32 v;
+    if (!read32(addr, &v))
+      return false;
+    std::memcpy(out, &v, 4);
+    return std::isfinite(*out);
+  };
+  const u32 now = s_now_ms;
+  // lit17sg: outside the race scene nothing is kept or drawn
+  if (c.scene_addr || !c.scene_chain.empty())
+  {
+    u32 sv = 0;
+    u32 sa = c.scene_addr;
+    bool sok = true;
+    if (!c.scene_chain.empty())
+    {
+      sa = c.scene_chain[0];
+      for (size_t i = 1; i < c.scene_chain.size() && sok; i++)
+      {
+        u32 w = 0;
+        sok = sa >= 0x80000000u && sa < 0x81800000u && read32(sa, &w);
+        sa = w + c.scene_chain[i];
+      }
+    }
+    sok = sok && sa >= 0x80000000u && sa < 0x81800000u;
+    s_dm_race = sok && read32(sa, &sv) && (sv & c.scene_mask) == c.scene_value;
+    if (!s_dm_race)
+    {
+      for (DmRacer& d : s_dm)
+      {
+        d.hits.clear();
+        d.have_prev = false;
+        d.last_hit = -1;
+        d.have_main = false;
+      }
+      s_dm_any_hits = false;
+      return;
+    }
+  }
+  else
+  {
+    s_dm_race = true;
+  }
+  // a race restart (or a state load to an earlier point): the HUD race clock went back
+  u32 clk = 0;
+  if (c.clock_addr && read32(c.clock_addr, &clk))
+  {
+    if (s_dm_have_clock && clk + 30 < s_dm_clock)
+    {
+      for (DmRacer& d : s_dm)
+      {
+        d.hits.clear();
+        d.have_prev = false;
+        d.last_hit = -1;
+      }
+      if (c.trace)
+        std::fprintf(stderr, "EQTRACE dmg f=%llu race clock %u -> %u: all damage cleared\n",
+                     static_cast<unsigned long long>(s_global_frame), s_dm_clock, clk);
+    }
+    s_dm_clock = clk;
+    s_dm_have_clock = true;
+  }
+  // the camera's view matrix (found by the per_racer actions' RAM scan)
+  float Vbuf[12];
+  const float* V = nullptr;
+  {
+    u32 ptr = 0;
+    if (s_view_slot && read32(s_view_slot, &ptr) && ptr >= 0x80000000u && ptr < 0x81800000u)
+    {
+      bool ok = true;
+      for (int i = 0; i < 12 && ok; i++)
+        ok = readf(ptr + 0xdc + 4 * i, &Vbuf[i]);
+      if (ok)
+        V = Vbuf;
+    }
+  }
+  // racer block 1
+  u32 b1 = 0;
+  {
+    bool ok = !c.base.empty();
+    u32 a = ok ? c.base[0] : 0;
+    for (size_t j = 1; j < c.base.size() && ok; j++)
+    {
+      u32 v = 0;
+      ok = read32(a, &v);
+      a = v + c.base[j];
+    }
+    u32 b = 0;  // chain [ptr, off]: the block is *(*(ptr) + off) (as per_racer's "base")
+    if (!(ok && read32(a, &b)))
+      b = 0;
+    if (b >= 0x80000000u && b < 0x81800000u)
+      b1 = b;
+  }
+  // this frame's machines
+  std::array<const AnchorCluster*, 64> cl{};
+  if (const auto it = s_slots.find(c.player_slot); it != s_slots.end())
+  {
+    float best = -1.0f;
+    for (const AnchorCluster& k : it->second.cur)
+    {
+      const float area = (k.a.screen_box[2] - k.a.screen_box[0]) * (k.a.screen_box[3] - k.a.screen_box[1]);
+      if (area > best && k.a.model_valid)
+      {
+        best = area;
+        cl[0] = &k;
+      }
+    }
+  }
+  if (const auto it = s_slots.find(c.cpu_slot); it != s_slots.end())
+  {
+    for (const AnchorCluster& k : it->second.cur)
+    {
+      if (k.racer >= 1 && k.racer < static_cast<int>(c.count) && k.a.model_valid &&
+          (!cl[k.racer] || cl[k.racer]->a.radius_view < k.a.radius_view))
+        cl[k.racer] = &k;
+    }
+  }
+  // lit17s4: body draws no anchor noted -> the racer whose main part is nearest (within its radius)
+  for (const auto& m : s_body_draws)
+  {
+    bool known = false;
+    for (u32 r = 0; r < c.count && !known; r++)
+    {
+      for (const DmPart& p : s_dm[r].parts_cur)
+      {
+        if (SameMatrix(p.m, m))
+        {
+          known = true;
+          break;
+        }
+      }
+    }
+    if (known)
+      continue;
+    int best = -1;
+    float bd = 1e30f;
+    for (u32 r = 0; r < c.count; r++)
+    {
+      if (!cl[r])
+        continue;
+      const M34& mm = cl[r]->a.position_matrix;
+      const float dx = m[3] - mm[3], dy = m[7] - mm[7], dz = m[11] - mm[11];
+      const float d2 = dx * dx + dy * dy + dz * dz;
+      const float lim = std::max(cl[r]->a.radius_view * 1.2f, 1.0f);
+      if (d2 < lim * lim && d2 < bd)
+      {
+        bd = d2;
+        best = static_cast<int>(r);
+      }
+    }
+    if (best >= 0 && s_dm[best].parts_cur.size() < 48)
+      s_dm[best].parts_cur.push_back({m, {}});
+  }
+  s_body_draws.clear();
+  const float heat_k = std::exp(-0.6931f / (std::max(c.heat_s, 0.1f) * 60.0f));
+  bool any = false;
+  for (u32 r = 0; r < c.count; r++)
+  {
+    DmRacer& d = s_dm[r];
+    // this frame's body parts against this frame's main matrix: the part -> hit space transforms (rigid)
+    if (cl[r])
+    {
+      const M34& main = cl[r]->a.position_matrix;
+      d.parts.clear();
+      for (const DmPart& p : d.parts_cur)
+      {
+        M34 pi;
+        if (Inv34(p.m, &pi))
+          d.parts.push_back({p.m, Mul34(pi, main)});
+      }
+      if (d.parts.empty())
+      {
+        M34 mi;
+        if (Inv34(main, &mi))
+          d.parts.push_back({main, Mul34(mi, main)});
+      }
+      d.main = main;
+      d.have_main = true;
+      d.main_frame = s_global_frame;
+      d.radius_view = cl[r]->a.radius_view;
+    }
+    d.parts_cur.clear();
+    if (!b1)
+      continue;
+    const u32 b = b1 + r * c.stride;
+    u32 state = 0, surface = 0;
+    float energy = 0.0f;
+    V3 pos{};
+    if (!read32(b + c.off_state, &state) || !read32(b + c.off_surface, &surface) ||
+        !readf(b + c.off_energy, &energy) || !readf(b + c.off_pos, &pos[0]) ||
+        !readf(b + c.off_pos + 4, &pos[1]) || !readf(b + c.off_pos + 8, &pos[2]))
+    {
+      d.have_prev = false;
+      continue;
+    }
+    HxUpdate(static_cast<int>(r), d, b, state, pos, cl[r], V, now);  // lit17c
+    const bool pit = (surface & c.pit_mask) != 0;
+    const bool zone = (surface & c.zone_mask) != 0;
+    if (s_sf_refs > 0)
+    {
+      // lit17s surface layer: pit strip arrival / leave (a hop off the strip shorter than 350 ms keeps the charge)
+      if (pit && !d.sf_on)
+      {
+        if (!d.sf_ever || now - d.sf_off_ms > 350u)
+          d.sf_on_ms = now;
+        d.sf_on = true;
+        d.sf_ever = true;
+      }
+      else if (!pit && d.sf_on)
+      {
+        d.sf_on = false;
+        d.sf_off_ms = now;
+      }
+      d.sf_energy = energy;
+      const u8* mp = memory.GetPointerForRange(b + 0x7, 1);
+      d.sf_machine = mp ? *mp : 0;
+      for (int i = 0; i < s_sf_nram; i++)
+      {
+        const SfRam& q = s_sf_ram[i];
+        u32 v = 0;
+        float x = 0.0f;
+        if (q.type == 2)
+        {
+          const u8* p8 = memory.GetPointerForRange(b + q.off, 1);
+          x = p8 ? static_cast<float>(*p8) : 0.0f;
+        }
+        else if (read32(b + q.off, &v))
+        {
+          if (q.type == 0)
+          {
+            std::memcpy(&x, &v, 4);
+            if (!std::isfinite(x))
+              x = 0.0f;
+          }
+          else if (q.type == 1)
+            x = static_cast<float>(v & q.mask);
+          else
+            x = (v & q.mask) != 0 ? 1.0f : 0.0f;
+        }
+        d.sf_ram[i] = x;
+      }
+    }
+    const bool boosting = (state & c.boost_mask) != 0 && (state & c.dash_mask) == 0;
+    // repair while charging, heat cools down
+    for (DmHit& h : d.hits)
+    {
+      if (pit)
+        h.heal += 1.0f / (std::max(c.heal_s, 0.05f) * 60.0f);
+      h.heat *= heat_k;
+    }
+    std::erase_if(d.hits, [](const DmHit& h) { return h.heal >= 1.0f; });
+    if (d.last_hit >= static_cast<int>(d.hits.size()))
+      d.last_hit = -1;
+    if (!d.have_prev)
+    {
+      d.have_prev = true;
+      d.energy = energy;
+      d.pos = pos;
+      d.vel = {};
+      d.acc_n = 0;
+      d.state = state;
+      any = any || !d.hits.empty();
+      continue;
+    }
+    V3 vel = {pos[0] - d.pos[0], pos[1] - d.pos[1], pos[2] - d.pos[2]};
+    if (Len3(vel) > 30.0f)  // respawn / teleport
+    {
+      d.pos = pos;
+      d.vel = {};
+      d.acc_n = 0;
+      d.energy = energy;
+      d.state = state;
+      any = any || !d.hits.empty();
+      continue;
+    }
+    const V3 acc = {vel[0] - d.vel[0], vel[1] - d.vel[1], vel[2] - d.vel[2]};
+    V3 base{};
+    for (int i = 0; i < d.acc_n; i++)
+      for (int k = 0; k < 3; k++)
+        base[k] += d.acc_hist[i][k] / static_cast<float>(d.acc_n);
+    V3 jerk = {acc[0] - base[0], acc[1] - base[1], acc[2] - base[2]};
+    // only a push sideways or backwards is an impact (boost / dash plates push forwards)
+    const V3 fwd = Norm3(d.vel, {0.0f, 0.0f, 0.0f});
+    const float jf = Dot3(jerk, fwd);
+    if (jf > 0.0f)
+      jerk = {jerk[0] - fwd[0] * jf, jerk[1] - fwd[1] * jf, jerk[2] - fwd[2] * jf};
+    const float jl = Len3(jerk);
+    const float drop = d.energy - energy;
+    float imp = 0.0f;
+    if (!pit && !zone && drop > 0.0f && drop < 60.0f)
+    {
+      if (boosting && jl < c.jerk_min)
+      {
+        // the boost's own cost: learn it, never a hit
+        d.boost_drop = d.boost_drop > 0.0f ? d.boost_drop * 0.9f + drop * 0.1f : drop;
+      }
+      else
+      {
+        const float extra = boosting ? drop - d.boost_drop * 1.5f : drop;
+        if (extra > c.min_drop && (!boosting || !c.hit_mask || (state & c.hit_mask) != 0))
+          imp = extra;
+      }
+    }
+    const bool contact_rise = (state & c.contact_mask) != 0 && (d.state & c.contact_mask) == 0;
+    if (imp <= 0.0f && contact_rise && jl > c.jerk_min && !pit)
+      imp = c.contact_drop;
+    if (c.trace > 1 && r == 0)
+      std::fprintf(stderr, "EQTRACE dmgraw f=%llu e=%.2f drop=%.3f jerk=%.3f boost=%d pit=%d zone=%d state=%08x imp=%.2f\n",
+                   static_cast<unsigned long long>(s_global_frame), energy, drop, jl, boosting, pit, zone, state, imp);
+    if (imp > 0.0f && cl[r])
+    {
+      // the push points away from what was hit
+      V3 dir{};
+      if (jl > c.jerk_min * 0.5f)
+        dir = {-jerk[0], -jerk[1], -jerk[2]};
+      else
+      {
+        // a steady scrape: the side force (wall push, or the turn pressing the machine into the outer wall)
+        const float af = Dot3(acc, fwd);
+        const V3 lat = {acc[0] - fwd[0] * af, acc[1] - fwd[1] * af, acc[2] - fwd[2] * af};
+        if (Len3(lat) > 1e-4f)
+          dir = {-lat[0], -lat[1], -lat[2]};
+      }
+      DmAddHit(static_cast<int>(r), d, *cl[r], imp, dir, Len3(vel) > 1e-4f ? vel : d.vel, V, now);
+    }
+    if (imp <= 0.0f)
+    {
+      d.acc_hist[d.acc_i] = acc;
+      d.acc_i = (d.acc_i + 1) % 4;
+      d.acc_n = std::min(d.acc_n + 1, 4);
+    }
+    d.energy = energy;
+    d.pos = pos;
+    d.vel = vel;
+    d.state = state;
+    any = any || !d.hits.empty();
+  }
+  s_dm_any_hits = any;
+}
+
+bool DmFillEmit(int racer, EmitQuadsUniforms& u)
+{
+  u.dm_info = {};
+  if (s_dm_refs <= 0 || racer < 0 || racer >= static_cast<int>(s_dm.size()))
+    return false;
+  const DmRacer& d = s_dm[racer];
+  const u32 now = s_now_ms;
+  const size_t n = std::min<size_t>(d.hits.size(), 16);
+  for (size_t i = 0; i < n; i++)
+  {
+    const DmHit& h = d.hits[i];
+    u.dm_pos[i] = {h.pos[0], h.pos[1], h.pos[2], h.radius};
+    u.dm_dir[i] = {h.nrm[0], h.nrm[1], h.nrm[2], h.depth};
+    u.dm_tan[i] = {h.tan[0], h.tan[1], h.tan[2], h.seed};
+    u.dm_aux[i] = {static_cast<float>(now - h.last_ms) * 0.001f, h.strength, 1.0f - h.heal, h.heat};
+  }
+  u.dm_info = {static_cast<float>(n), static_cast<float>(now % 1000000u) * 0.001f, d.size, 1.0f};
+  return n > 0;
+}
