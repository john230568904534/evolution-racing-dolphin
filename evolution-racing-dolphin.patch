+void NightTrace(const std::vector<std::string>& names, bool ortho, bool blend, bool additive)
+{
+  static std::map<std::string, int> seen;
+  const bool on = s_nt.trace > 0;
+  if (!on || s_nt.pass_frame != s_global_frame || names.empty())
+    return;
+  if (seen.emplace(names[0], 1).second)
+    std::fprintf(stderr, "NIGHTLATE %s ortho=%d blend=%d add=%d n=%zu\n", names[0].c_str(), ortho ? 1 : 0,
+                 blend ? 1 : 0, additive ? 1 : 0, names.size());
