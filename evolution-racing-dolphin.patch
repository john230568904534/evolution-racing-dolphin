+Reply Call(const Settings& s, const std::string& path, const std::vector<u8>* body,
+           std::vector<u8>* raw_out)
+{
+  Reply r;
+  if (s.offline)
+  {
+    r.error = "Play offline is on";  // no connection at all
+    return r;
+  }
+  if (s.token.empty())
+  {
+    r.error = "this Dolphin is not linked to the hub";
+    return r;
+  }
+  if (!HubAllowed(s.hub))
+  {
+    r.error = "the hub address is not allowed: " + s.hub;
+    return r;
+  }
+  Common::HttpRequest req(std::chrono::milliseconds(20000));
+  if (!req.IsValid())
+  {
+    r.error = "the network library did not start";
+    return r;
+  }
+  Common::HttpRequest::Headers h = {{"X-ER-Dolphin", s.token},
+                                    {"X-ER-Build", Common::GetERBuildStr()},
+                                    {"X-ER-Ghosts", "1"},
+                                    {"Accept", "application/json"},
+                                    {"Expect", std::nullopt}};
+  std::string url = s.hub;
+  while (!url.empty() && url.back() == '/')
+    url.pop_back();
+  url += "/hub/api/erd/" + path;
+  Common::HttpRequest::Response resp;
+  if (body)
+  {
+    h["Content-Type"] = "application/octet-stream";
+    resp = req.Post(url, std::span<const u8>(body->data(), body->size()), h,
+                    Common::HttpRequest::AllowedReturnCodes::All);
+  }
+  else
+  {
+    resp = req.Get(url, h, Common::HttpRequest::AllowedReturnCodes::All);
+  }
+  if (!resp)
+  {
+    r.error = "the hub did not answer (no network?)";
+    return r;
+  }
+  r.status = req.GetLastResponseCode();
+  if (raw_out && r.status == 200)
+  {
+    *raw_out = std::move(*resp);
+    return r;
+  }
+  r.text.assign(resp->begin(), resp->end());
+  if (r.status != 200)
+  {
+    r.error = Field(r.text, "error");
+    if (r.error.empty())
+      r.error = fmt::format("the hub answered HTTP {}", r.status);
+  }
+  return r;
+}
