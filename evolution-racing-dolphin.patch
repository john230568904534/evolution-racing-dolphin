+// ---- tuning (GX world units ~ metres) ----
+constexpr int kMaxLabels = 3;
+constexpr float kAnchorUp = 1.1f;       // label anchor above the machine origin, along the machine up (roof)
+constexpr float kFadeNear = 100.0f;     // full until here, then a smooth ramp
+constexpr float kFadeFar = 160.0f;      // alpha 0 here (reach)
+constexpr float kEnterFar = 150.0f;     // lit17s41s: a NEW label only enters nearer than this
+constexpr float kHoldFar = 175.0f;      // lit17s41s: a shown label is kept (fading) out to here
+constexpr int kHoldRank = 4;            // lit17s41s: a shown label stays while its racer is in the best 4
+constexpr float kMinDist = 3.0f;        // closer than this (camera inside / right on top): hidden
+constexpr float kAlongside = 14.0f;     // |longitudinal offset| below this = alongside
+constexpr float kBehind = -6.0f;        // further behind the focus machine than this: not a candidate
+constexpr float kPlateFrac = 0.040f;    // plate height / screen height near (font 2.9 % = 31 px at 1080p)
+constexpr float kFarScale = 0.65f;      // plate scale at kFadeFar (font ~20 px at 1080p)
+constexpr float kFadeIn = 0.40f;        // s (lit17s41s: smooth, no popping)
+constexpr float kFadeOut = 0.50f;       // s
+constexpr float kTopSafe = 0.80f;       // GX NDC y: the labels stay under the top HUD band
+constexpr float kSideSafe = 0.97f;
+
+// atlas
+constexpr int kAtlasW = 640, kRowH = 64, kRows = 32, kAtlasH = kRowH * kRows, kLevels = 3;
+constexpr float kFontPx = 46.0f;
+constexpr int kPad = 28;  // plate padding left / right of the text (atlas px)
+constexpr int kChevH = 16;
+
+u32 Hash32(u32 x)
+{
+  x ^= x >> 16;
+  x *= 0x7feb352du;
+  x ^= x >> 15;
+  x *= 0x846ca68bu;
+  x ^= x >> 16;
+  return x;
+}
+u32 Fnv(const std::string& s)
+{
+  u32 h = 2166136261u;
+  for (unsigned char c : s)
+    h = (h ^ c) * 16777619u;
+  return h;
+}
+
+// ---- mode ----
+Mode s_mode = Mode::Usernames;
+bool s_active = true;
+u64 s_frame = 0;
+u64 s_mode_frame = ~0ull;
+
+Mode ParseMode(std::string v)
+{
+  for (auto& ch : v)
+    ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+  if (v == "off" || v == "0" || v == "false" || v == "none")
+    return Mode::Off;
+  if (v == "original" || v == "originalnames" || v == "original names" || v == "game")
+    return Mode::Original;
+  return Mode::Usernames;
+}
+
+// ---- RAM ----
+Memory::MemoryManager* s_mem = nullptr;
+bool InRam(u32 a)
+{
+  return a >= 0x80000000u && a < 0x81800000u;
+}
+bool R32(u32 a, u32* o)
+{
+  const u8* p = PC5090TryPointer(*s_mem, a, 4);
+  if (!p)
+    return false;
+  u32 v;
+  std::memcpy(&v, p, 4);
+  *o = Common::swap32(v);
+  return true;
+}
+u32 BE32(const u8* p)
+{
+  u32 v;
+  std::memcpy(&v, p, 4);
+  return Common::swap32(v);
+}
+float BEF(const u8* p)
+{
+  const u32 v = BE32(p);
+  float f;
+  std::memcpy(&f, &v, 4);
+  return std::isfinite(f) ? f : 0.0f;
+}
+s16 BE16(const u8* p)
+{
+  return static_cast<s16>((p[0] << 8) | p[1]);
+}
+
+// ---- the pool ----
+struct PoolName
+{
+  std::string text;
+  u8 arch = 1;  // 1..5 home personality
+  u8 tier = 0;  // 0 rookie .. 3 elite
+  bool regular = false;
+};
+std::vector<PoolName> s_pool;
+bool s_pool_tried = false;
+
+void LoadPool()
+{
+  s_pool_tried = true;
+  const std::string name = "racer-usernames.json";
+  const std::string user = File::GetUserPath(D_LOAD_IDX) + "PC5090" DIR_SEP + name;
+  const std::string sys = File::GetSysDirectory() + RESOURCES_DIR DIR_SEP "PC5090" DIR_SEP + name;
+  const std::string& path = File::Exists(user) ? user : sys;
+  std::string txt;
+  picojson::value v;
+  if (!File::ReadFileToString(path, txt) || !picojson::parse(v, txt).empty() || !v.is<picojson::array>())
+  {
+    std::fprintf(stderr, "NAMEPLATES no username pool at %s (Usernames shows the game's names)\n", path.c_str());
+    return;
+  }
+  std::vector<std::string> seen;
+  for (const auto& e : v.get<picojson::array>())
+  {
+    if (!e.is<std::string>())
+      continue;
+    std::string s = e.get<std::string>();
+    bool ok = s.size() >= 3 && s.size() <= 18;
+    for (unsigned char c : s)
+      ok = ok && c >= 0x21 && c < 0x7F;
+    std::string low = s;
+    for (auto& c : low)
+      c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    if (!ok || std::find(seen.begin(), seen.end(), low) != seen.end())
+      continue;
+    seen.push_back(low);
+    PoolName p;
+    p.text = s;
+    const u32 h = Hash32(Fnv(low));
+    p.arch = static_cast<u8>(1 + h % 5);
+    p.tier = static_cast<u8>((h >> 8) % 4);
+    s_pool.push_back(std::move(p));
+  }
+  // the recurring rivals: the 8 names with the lowest rival hash (fixed for a pool); 2-3 of them race in each roster
+  std::vector<std::pair<u32, size_t>> rh;
+  for (size_t k = 0; k < s_pool.size(); k++)
+    rh.push_back({Hash32(Fnv(s_pool[k].text) ^ 0x50905090u), k});
+  std::sort(rh.begin(), rh.end());
+  for (size_t k = 0; k < rh.size() && k < 8; k++)
+    s_pool[rh[k].second].regular = true;
+  std::fprintf(stderr, "NAMEPLATES pool %s: %zu usernames\n", path.c_str(), s_pool.size());
+}
+
+// ---- the cup / roster ----
+struct Roster
+{
+  bool valid = false;
+  u32 cup_seed = 0;
+  u32 ident_seed = 0;  // NID1 seed (0 = no block)
+  int klass = -1;
+  std::vector<int> courses;  // this cup's courses so far
+  int last_course = -1;
+  std::array<int, 64> pick{};       // slot -> pool index (-1 none)
+  std::array<u8, 64> arch{};
+  std::array<std::string, 64> original{};
+  u32 count = 0;
+  u32 race_arr = 0;  // the racer array this roster was made for
+  int races = 0;
+};
+Roster s_ro;
+u32 s_cups = 0;      // rosters drawn (persisted: User/Config/er-nameplates.txt)
+u32 s_bag_seed = 0;  // the shuffle bag: a permutation of the pool (non-regulars), drawn front to back
+u32 s_bag_pos = 0;
+std::vector<int> s_bag;
+bool s_cups_loaded = false;
+int s_prev_sub = -1;
+std::chrono::steady_clock::time_point s_last_race_frame{};
+int s_last_mode = -1, s_last_index = -1;
+
+std::string CupFile()
+{
+  return File::GetUserPath(D_CONFIG_IDX) + "er-nameplates.txt";
+}
+u32 FileValue(const std::string& t, const char* key, u32 def)
+{
+  const auto p = t.find(key);
+  return p == std::string::npos ? def : static_cast<u32>(std::strtoul(t.c_str() + p + std::strlen(key), nullptr, 10));
+}
+void LoadCups()
+{
+  s_cups_loaded = true;
+  std::string t;
+  File::ReadFileToString(CupFile(), t);
+  s_cups = FileValue(t, "cups=", 0);
+  s_bag_seed = FileValue(t, "bag_seed=", 0);
+  s_bag_pos = FileValue(t, "bag_pos=", 0);
+  if (s_bag_seed == 0)  // first run: a seed from the clock (each install gets its own order)
+    s_bag_seed = Hash32(static_cast<u32>(std::chrono::system_clock::now().time_since_epoch().count())) | 1u;
+}
+void SaveCups()
+{
+  if (!File::WriteStringToFile(CupFile(), "cups=" + std::to_string(s_cups) + "\nbag_seed=" +
+                                              std::to_string(s_bag_seed) + "\nbag_pos=" + std::to_string(s_bag_pos) + "\n"))
+    std::fprintf(stderr, "NAMEPLATES cannot write %s\n", CupFile().c_str());
+}
+void MakeBag()
+{
+  s_bag.clear();
+  for (size_t k = 0; k < s_pool.size(); k++)
+    if (!s_pool[k].regular)
+      s_bag.push_back(static_cast<int>(k));
+  u32 x = s_bag_seed;
+  for (size_t k = s_bag.size(); k > 1; k--)  // Fisher-Yates with the bag's seed
+  {
+    x = Hash32(x + 0x9E3779B9u);
+    std::swap(s_bag[k - 1], s_bag[x % k]);
+  }
+}
+// the next unused name of the bag (a new shuffle when it runs out; never a name already in this race)
+int BagNext(const std::vector<bool>& used)
+{
+  if (s_bag.empty())
+    MakeBag();
+  for (size_t guard = 0; guard < s_bag.size() * 2 + 2; guard++)
+  {
+    if (s_bag_pos >= s_bag.size())
+    {
+      s_bag_seed = Hash32(s_bag_seed + 1u) | 1u;
+      s_bag_pos = 0;
+      MakeBag();
+      std::fprintf(stderr, "NAMEPLATES bag exhausted: reshuffled\n");
+    }
+    const int k = s_bag[s_bag_pos++];
+    if (!used[k])
+      return k;
+  }
+  return -1;
+}
+
+// atlas state (rows = slots)
+struct AtlasRow
+{
+  int text_w = 0;  // atlas px
+  std::string text;  // lit17s41p: the rasterised name (an unchanged row is not redrawn / re-uploaded)
+  bool drawn = false;
+};
+std::array<AtlasRow, kRows> s_rows{};
+std::vector<u8> s_atlas_px;  // RGBA8 level 0
+bool s_atlas_dirty = false;
+std::vector<u8> s_font;
+stbtt_fontinfo s_fi;
+bool s_font_ok = false, s_font_tried = false;
+
+void LoadFont()
+{
+  s_font_tried = true;
+  const std::string f = File::GetSysDirectory() + RESOURCES_DIR DIR_SEP "PC5090" DIR_SEP "NotoSans-Bold.ttf";
+  std::string data;
+  if (!File::ReadFileToString(f, data) || data.empty())
+  {
+    std::fprintf(stderr, "NAMEPLATES font %s missing: no nameplates\n", f.c_str());
+    return;
+  }
+  s_font.assign(data.begin(), data.end());
+  s_font_ok = stbtt_InitFont(&s_fi, s_font.data(), stbtt_GetFontOffsetForIndex(s_font.data(), 0)) != 0;
+}
+
+// rasterise one name into atlas row `row` (R = text coverage, G = dark outline coverage)
+void RasterRow(int row, const std::string& text)
+{
+  u8* base = s_atlas_px.data() + static_cast<size_t>(row) * kRowH * kAtlasW * 4;
+  std::memset(base, 0, static_cast<size_t>(kRowH) * kAtlasW * 4);
+  s_rows[row].text_w = 0;
+  if (!s_font_ok || text.empty())
+    return;
+  float px = kFontPx;
+  const int maxw = kAtlasW - 8;
+  float scale = stbtt_ScaleForPixelHeight(&s_fi, px);
+  // measure (shrink to fit)
+  const auto measure = [&](float sc) {
+    float x = 0.0f;
+    for (size_t i = 0; i < text.size(); i++)
+    {
+      int adv, lsb;
+      stbtt_GetCodepointHMetrics(&s_fi, static_cast<unsigned char>(text[i]), &adv, &lsb);
+      x += adv * sc;
+      if (i + 1 < text.size())
+        x += sc * stbtt_GetCodepointKernAdvance(&s_fi, static_cast<unsigned char>(text[i]),
+                                               static_cast<unsigned char>(text[i + 1]));
+    }
+    return x;
+  };
+  float w = measure(scale);
+  if (w > maxw)
+  {
+    scale *= maxw / w;
+    w = measure(scale);
+  }
+  int asc, desc, gap;
+  stbtt_GetFontVMetrics(&s_fi, &asc, &desc, &gap);
+  // centre the cap height in the row (cap ~ 0.714 em for Noto Sans)
+  const float cap = 0.714f * (asc - desc) * scale * 0.93f;
+  const int baseline = static_cast<int>(std::lround(kRowH * 0.5f + cap * 0.5f)) - 2;
+  std::vector<u8> cov(static_cast<size_t>(kRowH) * kAtlasW, 0);
+  float x = 4.0f;
+  for (size_t i = 0; i < text.size(); i++)
+  {
+    const int cp = static_cast<unsigned char>(text[i]);
+    int adv, lsb, x0, y0, x1, y1;
+    stbtt_GetCodepointHMetrics(&s_fi, cp, &adv, &lsb);
+    const float sx = x - std::floor(x);
+    stbtt_GetCodepointBitmapBoxSubpixel(&s_fi, cp, scale, scale, sx, 0.0f, &x0, &y0, &x1, &y1);
+    const int gw = x1 - x0, gh = y1 - y0;
+    if (gw > 0 && gh > 0)
+    {
+      std::vector<u8> g(static_cast<size_t>(gw) * gh);
+      stbtt_MakeCodepointBitmapSubpixel(&s_fi, g.data(), gw, gh, gw, scale, scale, sx, 0.0f, cp);
+      const int ox = static_cast<int>(std::floor(x)) + x0, oy = baseline + y0;
+      for (int yy = 0; yy < gh; yy++)
+        for (int xx = 0; xx < gw; xx++)
+        {
+          const int X = ox + xx, Y = oy + yy;
+          if (X < 0 || Y < 0 || X >= kAtlasW || Y >= kRowH)
+            continue;
+          u8& d = cov[static_cast<size_t>(Y) * kAtlasW + X];
+          d = std::max(d, g[static_cast<size_t>(yy) * gw + xx]);
+        }
+    }
+    x += adv * scale;
+    if (i + 1 < text.size())
+      x += scale * stbtt_GetCodepointKernAdvance(&s_fi, cp, static_cast<unsigned char>(text[i + 1]));
+  }
+  const int tw = std::min(kAtlasW, static_cast<int>(std::ceil(x)) + 4);
+  s_rows[row].text_w = tw;
+  // outline: disc dilation (r = 3 px) of the coverage. lit17s41p: the same disc (dx^2 + dy^2 <= R^2 + 1, i.e. half
+  // widths 3, 3, 2, 1 for |dy| = 0..3) as the max of per-row horizontal window maxima (identical bytes, ~4x fewer taps)
+  constexpr int R = 3;
+  const int xe = std::min(tw + R, kAtlasW);
+  static constexpr int kHalf[R + 1] = {3, 3, 2, 1};
+  std::vector<u8> hm(static_cast<size_t>(4) * kRowH * kAtlasW, 0);  // [half width 0..3][y][x]
+  for (int hw = 1; hw <= 3; hw++)
+    for (int y = 0; y < kRowH; y++)
+    {
+      const u8* c = cov.data() + static_cast<size_t>(y) * kAtlasW;
+      u8* h = hm.data() + (static_cast<size_t>(hw) * kRowH + y) * kAtlasW;
+      for (int X = 0; X < xe; X++)
+      {
+        u8 m = 0;
+        for (int xx = std::max(0, X - hw), x1 = std::min(kAtlasW - 1, X + hw); xx <= x1; xx++)
+          m = std::max(m, c[xx]);
+        h[X] = m;
+      }
+    }
+  for (int y = 0; y < kRowH; y++)
+    for (int X = 0; X < xe; X++)
+    {
+      u8 m = 0;
+      for (int dy = -R; dy <= R; dy++)
+      {
+        const int yy = y + dy;
+        if (yy < 0 || yy >= kRowH)
+          continue;
+        m = std::max(m, hm[(static_cast<size_t>(kHalf[dy < 0 ? -dy : dy]) * kRowH + yy) * kAtlasW + X]);
+      }
+      u8* p = base + (static_cast<size_t>(y) * kAtlasW + X) * 4;
+      p[0] = cov[static_cast<size_t>(y) * kAtlasW + X];
+      p[1] = m;
+      p[2] = 0;
+      p[3] = 255;
+    }
+}
+
+const char* ArchName(int a)
+{
+  static const char* n[] = {"neutral", "calculated", "attacker", "technical", "opportunist", "inconsistent"};
+  return a >= 0 && a <= 5 ? n[a] : "?";
+}
+
+std::string OriginalName(u32 B, const u8* r)
+{
+  // the character id = the machine id for the stock line-up (verified in the harness log "NAMEPLATES slot")
+  const int machine = BE16(r + 0x6);
+  u32 tbl = B + 0x18E8A8u, sp = 0;
+  if (machine >= 0 && machine < 45 && R32(tbl + 4u * static_cast<u32>(machine), &sp) && InRam(sp))
+  {
+    const u8* s = PC5090TryPointer(*s_mem, sp, 32);
+    if (s)
+    {
+      std::string out;
+      for (int i = 0; i < 31 && s[i]; i++)
+        if (s[i] >= 0x20 && s[i] < 0x7F)
+          out.push_back(static_cast<char>(s[i]));
+      if (!out.empty())
+        return out;
+    }
+  }
+  // fallback: the machine's own name (+0x3C)
+  std::string out;
+  for (int i = 0; i < 31 && r[0x3C + i]; i++)
+    if (r[0x3C + i] >= 0x20 && r[0x3C + i] < 0x7F)
+      out.push_back(static_cast<char>(r[0x3C + i]));
+  return out;
+}
+
+// A race starts (or the racer array changed): keep / make the cup's roster; rasterise the atlas rows.
+void NewRace(u32 B, u32 arr, u32 count, const u8* blk, Mode mode)
+{
+  if (!s_pool_tried)
+    LoadPool();
+  if (!s_font_tried)
+    LoadFont();
+  if (!s_cups_loaded)
+    LoadCups();
+  u32 diff = 0;
+  R32(0x803EF564u, &diff);
+  const int klass = static_cast<int>(diff >> 24) & 3;
+  const int course = static_cast<int>((diff >> 16) & 0xFF);
+  // Natural v2 identity block
+  u32 ident_seed = 0;
+  std::array<u8, 64> arc{};
+  const u8* idh = PC5090TryPointer(*s_mem, B + 0x7D74Cu, 16);
+  if (idh && std::memcmp(idh, "NID1", 4) == 0 && idh[4] == 1)
+  {
+    ident_seed = BE32(idh + 8);
+    const u32 arc_off = BE32(idh + 12);
+    const u32 n = std::min<u32>(idh[5], 64);
+    const u8* a = (arc_off > 0 && arc_off < 0x400000u) ? PC5090TryPointer(*s_mem, B + arc_off, n) : nullptr;
+    if (a)
+      for (u32 i = 0; i < n; i++)
+        arc[i] = a[i] <= 5 ? a[i] : 0;
+    else
+      ident_seed = 0;
+  }
+  // game mode block (main.rel .bss 0x3C30 = B + 0x1BDC70): +0x5 mode, +0xA6 race number in the cup (decomp
+  // bg_win.c / sel_static_disp.c; logged below). A roster is KEPT only for (a) the next race of the same Grand Prix
+  // (same mode and class, race number + 1, a new course, <= 5 courses) or (b) a quick retry of the same course (the
+  // previous race was on screen less than 30 s ago). Everything else - every Practice / Time Attack start, a new
+  // practice session on the same track, a new cup - draws a fresh roster from the shuffle bag.
+  const u8* gm = PC5090TryPointer(*s_mem, B + 0x1BDC70u, 0xA8);
+  const int gmode = gm ? gm[5] : -1, gindex = gm ? gm[0xA6] : -1;
+  const auto now = std::chrono::steady_clock::now();
+  const bool quick = s_ro.valid && now - s_last_race_frame < std::chrono::seconds(30);
+  const bool base_same = s_ro.valid && s_ro.klass == klass && s_ro.ident_seed == ident_seed && s_ro.count == count;
+  const bool retry = base_same && course == s_ro.last_course && quick;
+  const bool next_gp_race = base_same && course != s_ro.last_course && gmode == s_last_mode &&
+                            gindex == s_last_index + 1 && gindex > 0 && s_ro.courses.size() < 5 &&
+                            std::find(s_ro.courses.begin(), s_ro.courses.end(), course) == s_ro.courses.end();
+  const bool same_cup = retry || next_gp_race;
+  s_last_mode = gmode;
+  s_last_index = gindex;
+  if (!same_cup)
+  {
+    s_cups++;
+    s_ro = Roster{};
+    s_ro.valid = true;
+    s_ro.klass = klass;
+    s_ro.ident_seed = ident_seed;
+    s_ro.count = count;
+    s_ro.pick.fill(-1);
+    // slot personalities: the disc's (NID1), else a fixed pseudo-archetype per slot
+    for (u32 i = 0; i < count && i < 64; i++)
+      s_ro.arch[i] = ident_seed && arc[i] ? arc[i] : static_cast<u8>(1 + Hash32(5090u * 64u + i) % 5);
+    std::vector<bool> used(s_pool.size(), false);
+    std::vector<bool> taken(64, false);
+    // the slots that get names: every CPU (a human's name is never shown)
+    std::vector<u32> slots;
+    for (u32 i = 0; i < count && i < 64; i++)
+      if (static_cast<s8>(blk[i * 0x620u + 0x474]) < 0)
+        slots.push_back(i);
+    // 2-3 recurring rivals, each on a slot of ITS personality (the same name always drives the same way)
+    std::vector<int> regs;
+    for (size_t k = 0; k < s_pool.size(); k++)
+      if (s_pool[k].regular)
+        regs.push_back(static_cast<int>(k));
+    const u32 nreg = regs.empty() ? 0 : std::min<u32>(static_cast<u32>(regs.size()), 2 + (s_cups % 2));
+    for (u32 j = 0; j < nreg && !slots.empty(); j++)
+    {
+      const int k = regs[(s_cups * 3 + j) % regs.size()];
+      int best = -1;
+      for (u32 i : slots)
+        if (!taken[i] && (s_ro.arch[i] == s_pool[k].arch || s_ro.arch[i] == 0))
+        {
+          best = static_cast<int>(i);
+          if ((Hash32(s_cups * 31u + j + i) & 1) != 0)  // not always the first match
+            break;
+        }
+      if (best < 0)
+        continue;
+      taken[best] = true;
+      used[k] = true;
+      s_ro.pick[best] = k;
+    }
+    // everyone else: the next names of the shuffle bag
+    for (u32 i : slots)
+      if (!taken[i])
+      {
+        const int k = BagNext(used);
+        if (k < 0)
+          break;
+        used[k] = true;
+        s_ro.pick[i] = k;
+      }
+    SaveCups();
+  }
+  if (!retry)
+  {
+    s_ro.courses.push_back(course);
+    s_ro.races++;
+  }
+  s_ro.last_course = course;
+  s_ro.race_arr = arr;
+  for (u32 i = 0; i < count && i < 64; i++)
+    s_ro.original[i] = OriginalName(B, blk + i * 0x620u);
+  std::fprintf(stderr,
+               "NAMEPLATES race: class %d course %d game mode %d race# %d roster #%u race %d%s, bag %u/%zu, %u racers, "
+               "identities %s (seed %u), mode %s\n",
+               klass, course, gmode, gindex, s_cups, s_ro.races, retry ? " (retry)" : next_gp_race ? " (next GP race)" : "",
+               s_bag_pos, s_bag.size(), count,
+               ident_seed ? "Natural v2 NID1" : "own (no NID1)", ident_seed,
+               mode == Mode::Original ? "Original" : "Usernames");
+  for (u32 i = 0; i < count && i < 64; i++)
+  {
+    const u8* r = blk + i * 0x620u;
+    const s8 port = static_cast<s8>(r[0x474]);
+    u32 ai = BE32(r + 0x484), pilot = 0xFF;
+    if (InRam(ai))
+    {
+      const u8* a = PC5090TryPointer(*s_mem, ai + 0x38, 1);
+      pilot = a ? *a : 0xFF;
+    }
+    char mach[33] = {};
+    for (int k = 0; k < 32 && r[0x3C + k]; k++)
+      mach[k] = (r[0x3C + k] >= 0x20 && r[0x3C + k] < 0x7F) ? static_cast<char>(r[0x3C + k]) : '?';
+    const int pk = s_ro.pick[i];
+    std::fprintf(stderr, "NAMEPLATES slot %2u port %d machine %d '%s' pilot %u original '%s' %s user '%s'%s\n", i,
+                 port, BE16(r + 0x6), mach, pilot, s_ro.original[i].c_str(), ArchName(s_ro.arch[i]),
+                 pk >= 0 ? s_pool[pk].text.c_str() : "-", pk >= 0 && s_pool[pk].regular ? " (regular)" : "");
+  }
+  // atlas rows (row = slot)
+  if (s_atlas_px.empty())
+    s_atlas_px.assign(static_cast<size_t>(kAtlasW) * kAtlasH * 4, 0);
+  for (u32 i = 0; i < static_cast<u32>(kRows); i++)
+  {
+    std::string t;
+    if (i < count)
+    {
+      if (mode == Mode::Usernames && s_ro.pick[i] >= 0)
+        t = s_pool[s_ro.pick[i]].text;
+      else
+        t = s_ro.original[i];
+    }
+    // lit17s41p: a row whose name is unchanged (a retry, an unpause, the next GP race of the same roster) keeps its pixels
+    if (s_rows[i].drawn && s_rows[i].text == t)
+      continue;
+    RasterRow(static_cast<int>(i), t);
+    s_rows[i].text = t;
+    s_rows[i].drawn = true;
+    s_atlas_dirty = true;
+  }
+}
+
+// ---- GPU ----
+struct Uniforms
+{
+  std::array<float, 4> pc;
+  std::array<std::array<float, 4>, 4> pos;   // xy label quad centre (GX NDC), z / w = anchor GX clip z / w
+  std::array<std::array<float, 4>, 4> size;  // xy = half size (NDC), z = plate width (atlas px), w = atlas row
+  std::array<std::array<float, 4>, 4> col;   // rgb accent, a = alpha
+  std::array<std::array<float, 4>, 4> tw;    // x = text width, y = pad, z = plate h, w = total h (atlas px)
+  std::array<float, 4> atlas;                // w, h, row h, 0
+};
+
+std::unique_ptr<AbstractShader> s_vs, s_ps;
+std::unique_ptr<AbstractPipeline> s_pipe;
+u32 s_pipe_fb = 0xFFFFFFFFu;
+std::unique_ptr<AbstractTexture> s_tex;
+bool s_gpu_failed = false;
+
+const char* UBO = R"(
+UBO_BINDING(std140, 1) uniform PSBlock
+{
+  float4 np_pc;
+  float4 np_pos[4];
+  float4 np_size[4];
+  float4 np_col[4];
+  float4 np_tw[4];
+  float4 np_atlas;
+};
+)";
+
+std::string MakeVS()
+{
+  ShaderCode code;
+  code.Write("{}", UBO);
+  code.Write("{}", R"(
+VARYING_LOCATION(0) out float2 v_lp;
+VARYING_LOCATION(1) flat out uint v_i;
+float4 np_to_host(float4 pos)
+{
+  pos.z = pos.w * np_pc.w - pos.z * np_pc.z;
+)");
+  if (!g_backend_info.bSupportsClipControl)
+    code.Write("  pos.z = pos.z * 2.0 - pos.w;\n");
+  code.Write("  pos.xy *= sign(np_pc.xy * float2(1.0, -1.0));\n"
+             "  pos.xy = pos.xy - pos.w * np_pc.xy;\n");
+  if (g_backend_info.api_type == APIType::Vulkan)
+    code.Write("  pos.y = -pos.y;\n");
+  code.Write("{}", R"(
+  return pos;
+}
+void main()
+{
+  uint vid = uint(gl_VertexID);
+  uint i = vid / 6u;
+  uint k = vid - i * 6u;
+  float2 c = float2((k == 1u || k == 4u || k == 5u) ? 1.0 : 0.0, (k == 2u || k == 3u || k == 5u) ? 1.0 : 0.0);
+  float4 P = np_pos[i];
+  float4 S = np_size[i];
+  float2 ndc = P.xy + (c * 2.0 - 1.0) * S.xy;
+  float4 pos = float4(ndc * P.w, P.z, P.w);
+  if (np_col[i].a <= 0.0 || P.w <= 0.0)
+    pos = float4(4.0, 4.0, 0.0, 1.0);
+  v_lp = float2(c.x * S.z, (1.0 - c.y) * np_tw[i].w);
+  v_i = i;
+  gl_Position = np_to_host(pos);
+}
+)");
+  return code.GetBuffer();
+}
+
+std::string MakePS()
+{
+  ShaderCode code;
+  code.Write("{}", UBO);
+  code.Write("{}", R"(
+SAMPLER_BINDING(0) uniform sampler2DArray samp0;
+VARYING_LOCATION(0) in float2 v_lp;
+VARYING_LOCATION(1) flat in uint v_i;
+FRAGMENT_OUTPUT_LOCATION(0) out float4 ocol0;
+void main()
+{
+  uint i = v_i;
+  float2 lp = v_lp;
+  float W = np_size[i].z;
+  float row = np_size[i].w;
+  float tw = np_tw[i].x, pad = np_tw[i].y, Hp = np_tw[i].z, Ht = np_tw[i].w;
+  float3 accent = np_col[i].rgb;
+  float alpha = np_col[i].a;
+  float aa = max(fwidth(lp.x), 0.35);
+  float4 o = float4(0.0);
+  if (lp.y < Hp)
+  {
+    // slanted plate (parallelogram, the HUD's cut): dark glass
+    float off = (Hp - lp.y) * 0.22;
+    float xl = lp.x - (off + 1.0);
+    float xr = (W - 1.0 - Hp * 0.22 + off) - lp.x;
+    float edge = min(min(xl, xr), min(lp.y - 0.5, Hp - 0.5 - lp.y));
+    float pc = smoothstep(-aa, aa, edge);
+    float3 col = mix(float3(0.06, 0.075, 0.10), float3(0.015, 0.02, 0.03), lp.y / Hp);
+    float a = 0.70 * pc;
+    // top hairline + bottom accent bar (HUD cyan)
+    float top = (1.0 - smoothstep(1.0, 3.0, lp.y)) * pc;
+    col = mix(col, float3(0.75, 0.8, 0.9), top * 0.25);
+    float bar = smoothstep(Hp - 4.5, Hp - 3.0, lp.y) * pc;
+    col = mix(col, accent, bar);
+    a = max(a, bar * 0.95);
+    // left tick
+    float tick = smoothstep(-aa, aa, min(xl - 6.0, 12.0 - xl)) * step(lp.y, Hp - 7.0) * step(7.0, lp.y);
+    col = mix(col, accent, tick * 0.95);
+    a = max(a, tick * 0.95);
+    // the name: atlas row, R = text, G = outline
+    float tx = lp.x - pad;
+    if (tx >= 0.0 && tx <= tw)
+    {
+      float2 uv = float2(tx / np_atlas.x, (row * np_atlas.z + clamp(lp.y, 0.5, np_atlas.z - 0.5)) / np_atlas.y);
+      float4 s = texture(samp0, float3(uv, 0.0));
+      col = mix(col, float3(0.0, 0.0, 0.0), s.g * 0.85);
+      a = max(a, s.g * 0.9 * pc);
+      col = mix(col, float3(1.0, 0.975, 0.94), s.r);
+      a = max(a, s.r);
+    }
+    o = float4(col, a);
+  }
+  else
+  {
+    // chevron pointing down at the machine
+    float t = (lp.y - Hp) / max(Ht - Hp, 1.0);
+    float hw = (1.0 - t) * 11.0;
+    float dx = abs(lp.x - W * 0.5);
+    float cov = smoothstep(-aa, aa, hw - dx) * smoothstep(0.0, 0.08, t + 0.04);
+    o = float4(accent, cov * 0.9);
+  }
+  ocol0 = float4(o.rgb, o.a * alpha);
+}
+)");
+  return code.GetBuffer();
+}
+
+bool EnsureGpu()
+{
+  if (s_gpu_failed)
+    return false;
+  if (!s_vs)
+  {
+    s_vs = g_gfx->CreateShaderFromSource(ShaderStage::Vertex, MakeVS(), nullptr, "nameplates vertex");
+    s_ps = g_gfx->CreateShaderFromSource(ShaderStage::Pixel, MakePS(), nullptr, "nameplates pixel");
+    if (!s_vs || !s_ps)
+    {
+      std::fprintf(stderr, "NAMEPLATES shader compile failed: off\n");
+      s_gpu_failed = true;
+      return false;
+    }
+  }
+  const FramebufferState fb = g_framebuffer_manager->GetEFBFramebufferState();
+  if (!s_pipe || s_pipe_fb != fb.hex)
+  {
+    AbstractPipelineConfig config;
+    config.vertex_format = nullptr;
+    config.vertex_shader = s_vs.get();
+    config.geometry_shader = nullptr;
+    config.pixel_shader = s_ps.get();
+    config.rasterization_state = RenderState::GetNoCullRasterizationState(PrimitiveType::Triangles);
+    DepthState depth = RenderState::GetNoDepthTestingDepthState();
+    depth.test_enable = true;
+    depth.update_enable = false;
+    depth.func = CompareMode::LEqual;
+    config.depth_state = depth;
+    BlendingState bs = RenderState::GetNoBlendingBlendState();
+    bs.blend_enable = true;
+    bs.color_update = true;
+    bs.alpha_update = false;
+    bs.src_factor = SrcBlendFactor::SrcAlpha;
+    bs.dst_factor = DstBlendFactor::InvSrcAlpha;
+    bs.src_factor_alpha = SrcBlendFactor::Zero;
+    bs.dst_factor_alpha = DstBlendFactor::One;
+    config.blending_state = bs;
+    config.framebuffer_state = fb;
+    config.usage = AbstractPipelineUsage::Utility;
+    s_pipe = g_gfx->CreatePipeline(config);
+    s_pipe_fb = fb.hex;
+    if (!s_pipe)
+    {
+      std::fprintf(stderr, "NAMEPLATES pipeline failed: off\n");
+      s_gpu_failed = true;
+      return false;
+    }
+  }
+  if (!s_tex)
+  {
+    s_tex = g_gfx->CreateTexture(TextureConfig(kAtlasW, kAtlasH, kLevels, 1, 1, AbstractTextureFormat::RGBA8, 0,
+                                               AbstractTextureType::Texture_2DArray),
+                                 "nameplates atlas");
+    if (!s_tex)
+    {
+      s_gpu_failed = true;
+      return false;
+    }
+    s_atlas_dirty = true;
+  }
+  if (s_atlas_dirty && !s_atlas_px.empty())
+  {
+    s_tex->Load(0, kAtlasW, kAtlasH, kAtlasW, s_atlas_px.data(), s_atlas_px.size());
+    // box mips (lit17s41p: same values, no copy of level 0)
+    std::vector<u8> prev, next;
+    const u8* src = s_atlas_px.data();
+    int w = kAtlasW, h = kAtlasH;
+    for (int l = 1; l < kLevels; l++)
+    {
+      const int nw = w / 2, nh = h / 2;
+      next.resize(static_cast<size_t>(nw) * nh * 4);
+      for (int y = 0; y < nh; y++)
+      {
+        const u8* r0 = src + static_cast<size_t>(2 * y) * w * 4;
+        const u8* r1 = r0 + static_cast<size_t>(w) * 4;
+        u8* o = next.data() + static_cast<size_t>(y) * nw * 4;
+        for (int x = 0; x < nw * 4; x++)
+        {
+          const int c = x & 3, sx = (x >> 2) * 8 + c;
+          o[x] = static_cast<u8>((r0[sx] + r0[sx + 4] + r1[sx] + r1[sx + 4] + 2) / 4);
+        }
+      }
+      s_tex->Load(l, nw, nh, nw, next.data(), next.size());
+      prev.swap(next);
+      src = prev.data();
+      w = nw;
+      h = nh;
+    }
+    s_atlas_dirty = false;
+  }
+  return true;
+}
+
+// ---- per frame ----
+struct ProjSeen
+{
+  std::array<std::array<float, 4>, 4> p{};
+  std::array<float, 4> pc{};
+  u32 n = 0;
+};
+std::array<ProjSeen, 4> s_pj{};
+int s_pj_n = 0;
+u64 s_pj_frame = ~0ull;
+std::array<std::array<float, 4>, 4> s_proj{};
+std::array<float, 4> s_pc{};
+u64 s_proj_frame = ~0ull;
+u64 s_drawn_frame = ~0ull;
+u64 s_last_ortho_frame = ~0ull;
+bool s_persp_since_ortho = false;
+
+struct LabelState
+{
+  float alpha = 0.0f;
+  float dy = 0.0f;  // smoothed de-overlap lift (NDC)
+  bool have_dy = false;
+};
+std::array<LabelState, 64> s_lab{};
+u32 s_lab_arr = 0;
+u32 s_last_clock = 0;
+bool s_logged_draw = false;
+int s_trace = -1;  // User/pc5090nameplates: one NPTRACE line a second
+
+struct Cand
+{
+  int slot;
+  float score;
+  float d;
+  float cx, cy, cz, cw;  // anchor GX NDC xy + clip z / w
+  float hx, hy;          // half size NDC
+  float lift;            // NDC: quad centre above the anchor
+  int row;
+  float textw, platew;
+  float a_ctx;           // context alpha (distance, centre band, player)
+  bool alongside;
+};
+
+void Project(const float* V, const std::array<float, 3>& w, float* vx, float* vy, float* vz)
+{
+  *vx = V[0] * w[0] + V[1] * w[1] + V[2] * w[2] + V[3];
+  *vy = V[4] * w[0] + V[5] * w[1] + V[6] * w[2] + V[7];
+  *vz = V[8] * w[0] + V[9] * w[1] + V[10] * w[2] + V[11];
+}
+void Clip(float vx, float vy, float vz, float* c)
+{
+  for (int r = 0; r < 4; r++)
+    c[r] = s_proj[r][0] * vx + s_proj[r][1] * vy + s_proj[r][2] * vz + s_proj[r][3];
+}
+
+void DrawFrame()
+{
+  auto& system = Core::System::GetInstance();
+  s_mem = &system.GetMemory();
+  const u8* id = PC5090TryPointer(*s_mem, 0x80000000u, 6);
+  if (!id || std::memcmp(id, "GFZE01", 6) != 0)
+    return;
+  u32 B = 0, arr = 0, cams = 0;
+  if (!R32(0x800030C8u, &B) || !InRam(B) || !R32(B + 0x227878u, &arr) || !InRam(arr))
+    return;
+  const u8* pm = PC5090TryPointer(*s_mem, B + 0x1BA9A0u, 4);
+  const u8* pcnt = PC5090TryPointer(*s_mem, B + 0x22788Au, 1);
+  if (!pm || !pcnt)
+    return;
+  const int mode = BE16(pm), sub = BE16(pm + 2);
+  const u32 count = *pcnt;
+  u32 demo = 0;
+  R32(B + 0x17D2FCu, &demo);
+  // live (GFZE01, harness 990): sub-mode 36 while racing (the decomp's 41 is 5 higher), so 35 / 36 = start / race;
+  // 40 / 41 kept in case another build numbers them like the decomp
+  const auto racing = [](int s) { return s == 35 || s == 36 || s == 40 || s == 41; };
+  const bool in_race = mode == 2 && racing(sub) && demo == 0;
+  if (s_trace > 0 && (s_frame % 120) == 0)
+    std::fprintf(stderr, "NPTRACE gate mode %d sub %d count %u demo %u proj %d\n", mode, sub, *pcnt, demo,
+                 s_proj_frame == s_frame ? 1 : 0);
+  const int prev_sub = s_prev_sub;
+  s_prev_sub = sub;
+  if (!in_race || count < 2 || count > 64)
+    return;
+  const auto race_now = std::chrono::steady_clock::now();
+  const u8* blk = PC5090TryPointer(*s_mem, arr, count * 0x620u);
+  if (!blk)
+    return;
+  for (u32 i = 0; i < count; i++)
+    if (BE16(blk + i * 0x620u + 4) != static_cast<s16>(i))
+      return;
+  // a new race (sub-mode entered 40/41, or a new racer array)
+  if (arr != s_ro.race_arr || !racing(prev_sub) || !s_ro.valid)
+  {
+    const auto nr0 = std::chrono::steady_clock::now();
+    NewRace(B, arr, count, blk, s_mode);
+    s_lab = {};
+    std::fprintf(stderr, "NAMEPLATES race setup %.2f ms (names + atlas raster)\n",
+                 std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - nr0).count());
+  }
+  s_last_race_frame = race_now;  // (after NewRace: it compares with the PREVIOUS race's last frame)
+  if (s_ro.count != count)
+    return;
+  // camera
+  float V[12];
+  if (!R32(B + 0x1BAFACu, &cams) || !InRam(cams))
+    return;
+  const u8* cp = PC5090TryPointer(*s_mem, cams, 0xDC + 48);
+  if (!cp)
+    return;
+  for (int i = 0; i < 12; i++)
+    V[i] = BEF(cp + 0xDC + 4 * i);
+  const int focus = BE16(cp + 2);
+  if (s_trace > 0 && (s_frame % 60) == 0)
+    std::fprintf(stderr, "NPTRACE cam fov %08x (%.3f) aspect %08x (%.3f) P00 %.4f P11 %.4f\n", BE32(cp + 8), BEF(cp + 8),
+                 BE32(cp + 12), BEF(cp + 12), s_proj[0][0], s_proj[1][1]);
+  // humans: more than one = split screen (one camera's view here would be wrong): off
+  int humans = 0;
+  for (u32 i = 0; i < count; i++)
+    if (static_cast<s8>(blk[i * 0x620u + 0x474]) >= 0)
+      humans++;
+  if (humans > 1 || focus < 0 || focus >= static_cast<int>(count) || s_proj_frame != s_frame)
+    return;
+
+  // timing (fades): host frame time from the game's unpaused frame counter (60 / s)
+  u32 clock = 0;
+  R32(0x801A66A0u, &clock);
+  float dt = clock >= s_last_clock ? std::min(static_cast<float>(clock - s_last_clock), 4.0f) / 60.0f : 1.0f / 60.0f;
+  s_last_clock = clock;
+
+  const MathUtil::Rectangle<int> tr = g_presenter->GetTargetRectangle();
+  const float sw = static_cast<float>(std::max(1, tr.GetWidth())), sh = static_cast<float>(std::max(1, tr.GetHeight()));
+
+  const u8* fr = blk + static_cast<u32>(focus) * 0x620u;
+  const std::array<float, 3> fpos{BEF(fr + 0x7C), BEF(fr + 0x80), BEF(fr + 0x84)};
+  // focus forward = -basis column 2
+  const std::array<float, 3> ffwd{-BEF(fr + 0xEC + 8), -BEF(fr + 0xEC + 24), -BEF(fr + 0xEC + 40)};
+  // the player's machine on screen (keep labels off it)
+  float pvx, pvy, pvz, pcl[4];
+  Project(V, fpos, &pvx, &pvy, &pvz);
+  Clip(pvx, pvy, pvz, pcl);
+  const bool have_player = pcl[3] > 0.5f;
+  const float ppx = have_player ? pcl[0] / pcl[3] : 0.0f, ppy = have_player ? pcl[1] / pcl[3] : -2.0f;
+  if (s_trace > 0 && (clock % 60) == 0)
+    std::fprintf(stderr, "NPTRACE player view %.2f %.2f %.2f ndc %.3f %.3f\n", pvx, pvy, pvz, ppx, ppy);
+
+  static std::vector<Cand> cands;  // lit17s41p: reused storage (video thread only), no per-frame allocations
+  cands.clear();
+  // the game's own "1ST / 2ND / 3RD" signs (fixed screen size, just above the leaders): obstacles for the layout
+  static std::vector<std::array<float, 4>> signs;
+  signs.clear();
+  for (u32 i = 0; i < count; i++)
+  {
+    const u8* r = blk + i * 0x620u;
+    const u32 prog = BE32(r + 0x49C);
+    const u8* rk = InRam(prog) ? PC5090TryPointer(*s_mem, prog + 0x115, 1) : nullptr;
+    if (!rk || *rk < 1 || *rk > 3 || static_cast<int>(i) == focus)
+      continue;
+    const std::array<float, 3> p{BEF(r + 0x7C), BEF(r + 0x80), BEF(r + 0x84)};
+    float vx, vy, vz, c[4];
+    Project(V, p, &vx, &vy, &vz);
+    if (vz > -1.0f)
+      continue;
+    Clip(vx, vy, vz, c);
+    if (c[3] <= 1e-3f)
+      continue;
+    const float sx = c[0] / c[3], sy = c[1] / c[3];
+    signs.push_back({sx - 0.04f, sy, sx + 0.04f, sy + 0.13f});
+  }
+  for (u32 i = 0; i < count && i < static_cast<u32>(kRows); i++)
+  {
+    if (static_cast<int>(i) == focus)
+      continue;
+    const u8* r = blk + i * 0x620u;
+    const u32 flags = BE32(r);
+    if (flags & 0x08000000u)  // retired
+      continue;
+    const std::array<float, 3> p{BEF(r + 0x7C), BEF(r + 0x80), BEF(r + 0x84)};
+    const std::array<float, 3> up{BEF(r + 0xEC + 4), BEF(r + 0xEC + 20), BEF(r + 0xEC + 36)};
+    const float rel[3] = {p[0] - fpos[0], p[1] - fpos[1], p[2] - fpos[2]};
+    const float lon = rel[0] * ffwd[0] + rel[1] * ffwd[1] + rel[2] * ffwd[2];
+    if (lon < kBehind)
+      continue;
+    std::array<float, 3> a{p[0] + up[0] * kAnchorUp, p[1] + up[1] * kAnchorUp, p[2] + up[2] * kAnchorUp};
+    float vx, vy, vz;
+    Project(V, a, &vx, &vy, &vz);
+    const float d = std::sqrt(vx * vx + vy * vy + vz * vz);
+    if (s_trace > 0 && (clock % 60) == 0 && d < 250.0f)
+    {
+      float tc[4];
+      Clip(vx, vy, vz, tc);
+      std::fprintf(stderr, "NPTRACE racer %u d %.1f lon %.1f view %.1f %.1f %.1f ndc %.3f %.3f\n", i, d, lon, vx, vy, vz,
+                   tc[3] != 0.0f ? tc[0] / tc[3] : 9.0f, tc[3] != 0.0f ? tc[1] / tc[3] : 9.0f);
+    }
+    // lit17s41s: shown labels are kept out to kHoldFar (they fade by distance), new ones enter only below kEnterFar
+    if (vz > -1.0f || d < kMinDist || d > (s_lab[i].alpha > 0.0f ? kHoldFar : kEnterFar))
+      continue;
+    // pull the depth 1.2 units towards the camera (the label must not lose to its own machine's canopy)
+    const float k = std::max(0.0f, (d - 1.2f) / d);
+    float c[4];
+    Clip(vx * k, vy * k, vz * k, c);
+    if (c[3] <= 1e-3f)
+      continue;
+    const float nx = c[0] / c[3], ny = c[1] / c[3];
+    if (std::abs(nx) > 1.05f || ny < -1.05f || ny > 1.05f)
+      continue;
+    Cand cd{};
+    cd.slot = static_cast<int>(i);
+    cd.d = d;
+    cd.cx = nx;
+    cd.cy = ny;
+    cd.cz = c[2];
+    cd.cw = c[3];
+    cd.alongside = std::abs(lon) < kAlongside;
+    // size: plate height in screen px, shrinking a little with distance
+    const float t = std::clamp((d - 20.0f) / (kFadeFar - 20.0f), 0.0f, 1.0f);
+    const float plate_px = kPlateFrac * sh * (1.0f + (kFarScale - 1.0f) * t);
+    const float scale = plate_px / static_cast<float>(kRowH);  // screen px per atlas px
+    cd.row = static_cast<int>(i);
+    cd.textw = static_cast<float>(s_rows[i].text_w);
+    if (cd.textw <= 0.0f)
+      continue;
+    cd.platew = cd.textw + 2.0f * kPad;
+    const float total_h = static_cast<float>(kRowH + kChevH);
+    cd.hx = cd.platew * scale / sw;   // half size in NDC = px / (screen / 2) / 2
+    cd.hy = total_h * scale / sh;
+    cd.lift = cd.hy + 0.004f;  // quad bottom (chevron tip) just above the anchor
+    // the game marks the top three with its own "1ST / 2ND / 3RD" sign above the machine: sit above that sign
+    {
+      const u32 prog = BE32(r + 0x49C);
+      const u8* rk = InRam(prog) ? PC5090TryPointer(*s_mem, prog + 0x115, 1) : nullptr;
+      if (rk && *rk >= 1 && *rk <= 3)
+        cd.lift += 0.11f;  // the sign is a fixed screen size (~0.1 NDC)
+      if (s_trace > 0 && (clock % 60) == 0)
+        std::fprintf(stderr, "NPTRACE rank racer %u = %d\n", i, rk ? *rk : -1);
+    }
+    // context alpha
+    // lit17s41s: smooth distance fade (smoothstep, full at kFadeNear, 0 at kFadeFar; no cut before alpha is 0)
+    const float fd = std::clamp((d - kFadeNear) / (kFadeFar - kFadeNear), 0.0f, 1.0f);
+    float a_ctx = 1.0f - fd * fd * (3.0f - 2.0f * fd);
+    a_ctx *= std::clamp((d - kMinDist) / 3.0f, 0.0f, 1.0f);
+    cd.a_ctx = a_ctx;
+    cd.score = d * (cd.alongside ? 0.55f : 1.0f) * (s_lab[i].alpha > 0.0f ? 0.85f : 1.0f);
+    cands.push_back(cd);
+  }
+  std::sort(cands.begin(), cands.end(), [](const Cand& x, const Cand& y) { return x.score < y.score; });
+  // lit17s41s hysteresis: a shown label stays chosen while its racer is in the best kHoldRank; the free places go to
+  // the best new racers (nearer than kEnterFar). Labels that lose their place fade out (still drawn) instead of popping.
+  std::array<bool, 64> chosen{};
+  int nchosen = 0;
+  for (size_t j = 0; j < cands.size() && j < static_cast<size_t>(kHoldRank) && nchosen < kMaxLabels; j++)
+    if (s_lab[cands[j].slot].alpha > 0.0f)
+    {
+      chosen[cands[j].slot] = true;
+      nchosen++;
+    }
+  for (size_t j = 0; j < cands.size() && nchosen < kMaxLabels; j++)
+    if (!chosen[cands[j].slot] && s_lab[cands[j].slot].alpha <= 0.0f && cands[j].d < kEnterFar)
+    {
+      chosen[cands[j].slot] = true;
+      nchosen++;
+    }
+  // fades: a chosen label grows only while at most 3 labels are visible (the strict cap includes fade-outs)
+  int visible = 0;
+  for (u32 i = 0; i < count; i++)
+  {
+    if (!chosen[i])
+      s_lab[i].alpha = std::max(0.0f, s_lab[i].alpha - dt / kFadeOut);
+    if (s_lab[i].alpha > 0.0f)
+      visible++;
+  }
+  for (const Cand& c : cands)
+  {
+    if (!chosen[c.slot])
+      continue;
+    LabelState& L = s_lab[c.slot];
+    if (L.alpha > 0.0f || visible < kMaxLabels)
+    {
+      if (L.alpha <= 0.0f)
+        visible++;
+      L.alpha = std::min(1.0f, L.alpha + dt / kFadeIn);
+    }
+  }
+  // draw every label with alpha > 0 (fading in, shown, or fading out)
+  cands.erase(std::remove_if(cands.begin(), cands.end(), [](const Cand& c) { return s_lab[c.slot].alpha <= 0.0f; }),
+              cands.end());
+  // layout: nearest first keeps its place; others lift above any overlap; screen-safe clamps
+  std::sort(cands.begin(), cands.end(), [](const Cand& x, const Cand& y) { return x.d < y.d; });
+  struct Box
+  {
+    float x0, y0, x1, y1;
+  };
+  static std::vector<Box> placed;
+  placed.clear();
+  for (const auto& s : signs)
+    placed.push_back({s[0], s[1], s[2], s[3]});
+  Uniforms u{};
+  u.pc = s_pc;
+  u.atlas = {static_cast<float>(kAtlasW), static_cast<float>(kAtlasH), static_cast<float>(kRowH), 0.0f};
+  int n = 0;
+  for (Cand& c : cands)
+  {
+    LabelState& L = s_lab[c.slot];
+    if (L.alpha <= 0.0f)
+      continue;
+    float cx = std::clamp(c.cx, -kSideSafe + c.hx, kSideSafe - c.hx);
+    float cy = c.cy + c.lift;
+    // lift over the labels already placed
+    for (int pass = 0; pass < 4; pass++)
+    {
+      bool moved = false;
+      for (const Box& b : placed)
+        if (cx - c.hx < b.x1 && cx + c.hx > b.x0 && cy - c.hy < b.y1 && cy + c.hy > b.y0)
+        {
+          cy = b.y1 + c.hy + 0.006f;
+          moved = true;
+        }
+      if (!moved)
+        break;
+    }
+    float target_dy = cy - (c.cy + c.lift);
+    if (!L.have_dy)
+    {
+      L.dy = target_dy;
+      L.have_dy = true;
+    }
+    // eased lift, but never lower than the overlap needs (no plate drawn over another while it settles)
+    L.dy += (target_dy - L.dy) * std::min(1.0f, dt * 14.0f);
+    L.dy = std::max(L.dy, target_dy);
+    cy = c.cy + c.lift + L.dy;
+    cy = std::min(cy, kTopSafe - c.hy);
+    float a = L.alpha * L.alpha * (3.0f - 2.0f * L.alpha) * c.a_ctx;  // lit17s41s: eased fade in / out
+    // never over the player's machine: fade a label whose box covers the machine's screen area
+    if (have_player)
+    {
+      const float mx = 0.12f, my_lo = ppy - 0.10f, my_hi = ppy + 0.12f;
+      if (cx - c.hx < ppx + mx && cx + c.hx > ppx - mx && cy - c.hy < my_hi && cy + c.hy > my_lo)
+        a *= 0.45f;
+    }
+    // the game's HUD (16:9 layout, GX NDC): portraits column, POS counter, lap / energy / times, minimap, speedometer.
+    // A label over any of them fades out (the HUD stays clean; another candidate takes no extra slot)
+    {
+      static constexpr float HUD[][4] = {{-1.0f, -1.0f, -0.70f, 1.0f},  {-0.16f, 0.60f, 0.13f, 1.0f},
+                                         {0.36f, 0.42f, 1.0f, 1.0f},    {0.55f, -0.78f, 1.0f, 0.12f},
+                                         {0.48f, -1.0f, 1.0f, -0.74f}};
+      for (const auto& h : HUD)
+        if (cx - c.hx < h[2] && cx + c.hx > h[0] && cy - c.hy < h[3] && cy + c.hy > h[1])
+          a *= 0.12f;
+    }
+    // the road straight ahead (centre band near the horizon): lighter
+    if (std::abs(cx) < 0.18f && cy > -0.35f && cy < 0.25f)
+      a *= 0.8f;
+    placed.push_back({cx - c.hx, cy - c.hy, cx + c.hx, cy + c.hy});
+    if (a <= 0.004f || n >= 4)
+      continue;
+    u.pos[n] = {cx, cy, c.cz, c.cw};
+    u.size[n] = {c.hx, c.hy, c.platew, static_cast<float>(c.row)};
+    // the HUD's cyan frame colour; alongside = brighter, whiter
+    u.col[n] = c.alongside ? std::array<float, 4>{0.62f, 0.96f, 1.0f, a} : std::array<float, 4>{0.22f, 0.80f, 1.0f, a};
+    u.tw[n] = {c.textw, static_cast<float>(kPad), static_cast<float>(kRowH), static_cast<float>(kRowH + kChevH)};
+    n++;
+  }
+  if (s_trace > 0 && (clock % 60) == 0)
+  {
+    std::fprintf(stderr, "NPTRACE clock %u focus %d cands %zu drawn %d", clock, focus, cands.size(), n);
+    for (int j = 0; j < n; j++)
+      std::fprintf(stderr, " [row %d ndc %.3f %.3f a %.2f]", static_cast<int>(u.size[j][3]), u.pos[j][0], u.pos[j][1],
+                   u.col[j][3]);
+    std::fprintf(stderr, "\n");
+  }
+  if (n == 0)
+    return;
+  const bool upload = s_atlas_dirty || !s_tex;
+  const auto eg0 = std::chrono::steady_clock::now();
+  if (!EnsureGpu())
+    return;
+  if (upload)
+    std::fprintf(stderr, "NAMEPLATES atlas upload %.2f ms\n",
+                 std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - eg0).count());
+  static const int gid = PC5090Prof::GroupId("Nameplates");
+  PC5090Prof::GpuMark(gid, false);
+  g_vertex_manager->UploadUtilityUniforms(&u, sizeof(u));
+  g_gfx->SetPipeline(s_pipe.get());
+  g_gfx->SetTexture(0, s_tex.get());
+  g_gfx->SetSamplerState(0, RenderState::GetLinearSamplerState());
+  g_gfx->Draw(0, static_cast<u32>(n) * 6);
+  PC5090Prof::GpuMark(gid, true);
+  if (!s_logged_draw)
+    std::fprintf(stderr, "NAMEPLATES drawing (first labels this session)\n");
+  s_logged_draw = true;
+}
