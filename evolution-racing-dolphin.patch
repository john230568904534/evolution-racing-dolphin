+  if (s_lock != INVALID_HANDLE_VALUE)
+  {
+    CloseHandle(s_lock);
+    s_lock = INVALID_HANDLE_VALUE;
+  }
+#else
+  if (s_lock >= 0)
+  {
+    close(s_lock);
+    s_lock = -1;
+  }
+#endif
+}
