+std::unique_ptr<EmitQuadsAction> EmitQuadsAction::Create(const picojson::value& json_data)
+{
+  if (!json_data.is<picojson::object>())
+    return nullptr;
+  const auto& obj = json_data.get<picojson::object>();
+  const auto vs_file = ReadStringFromJson(obj, "vertex_shader_file");
+  const auto ps_file = ReadStringFromJson(obj, "pixel_shader_file");
+  const auto emit = ReadBoolFromJson(obj, "emit");
+  const bool publish_only = emit && !*emit;
+  if ((!vs_file || !ps_file) && !publish_only)
+  {
+    ERROR_LOG_FMT(VIDEO, "emit_quads: 'vertex_shader_file' and 'pixel_shader_file' are required");
+    return nullptr;
+  }
+  auto action = std::make_unique<EmitQuadsAction>();
+  if (!publish_only && (!File::ReadFileToString(*vs_file, action->m_vs_source) ||
+                        !File::ReadFileToString(*ps_file, action->m_ps_source)))
+  {
+    ERROR_LOG_FMT(VIDEO, "emit_quads: cannot read '{}' / '{}'", *vs_file, *ps_file);
+    return nullptr;
+  }
+  if (vs_file)
+    action->m_name = vs_file->substr(vs_file->find_last_of('/') + 1);
+  if (const auto tex = ReadStringFromJson(obj, "texture_file"))
+    action->m_texture_file = *tex;
+  if (const auto n = ReadNumericFromJson<double>(obj, "quads"))
+    action->m_quads = static_cast<u32>(std::clamp(*n, 1.0, 1024.0));
+  if (const auto n = ReadNumericFromJson<double>(obj, "max_emits_per_frame"))
+    action->m_max_emits_per_frame = static_cast<u32>(std::clamp(*n, 1.0, 4096.0));
+  if (const auto b = ReadBoolFromJson(obj, "skip_original"))
+    action->m_skip_original = *b;
+  if (const auto b = ReadBoolFromJson(obj, "depth_test"))
+    action->m_depth_test = *b;
+  if (const auto blend = ReadStringFromJson(obj, "blend"))
+  {
+    if (*blend == "additive")
+      action->m_blend = BlendMode::Additive;
+    else if (*blend == "alpha")
+      action->m_blend = BlendMode::Alpha;
+    else if (*blend == "premultiplied")
+      action->m_blend = BlendMode::Premultiplied;
+    else if (*blend == "target")
+      action->m_blend = BlendMode::Target;
+    else
+      WARN_LOG_FMT(VIDEO, "emit_quads: unknown blend '{}', using 'target'", *blend);
+  }
+  if (const auto it = obj.find("params"); it != obj.end() && it->second.is<picojson::array>())
+  {
+    const auto& arr = it->second.get<picojson::array>();
+    for (size_t i = 0; i < arr.size() && i < action->m_params.size(); i++)
+    {
+      if (arr[i].is<double>())
+        action->m_params[i] = static_cast<float>(arr[i].get<double>());
+    }
+  }
+  if (const auto v = ReadStringFromJson(obj, "publish_anchor"))
+    action->m_publish = *v;
+  if (const auto n = ReadNumericFromJson<double>(obj, "run_gap_ms"))
+    action->m_run_gap_ms = static_cast<float>(*n);
+  if (const auto b = ReadBoolFromJson(obj, "emit"))
+    action->m_emit = *b;
+  if (const auto v = ReadStringFromJson(obj, "anchor_from"))
+    action->m_anchor_from = *v;
+  if (const auto v = ReadStringFromJson(obj, "anchor_pick"))
+  {
+    action->m_pick_largest = *v == "largest";
+    action->m_pick_all = *v == "all";  // lit15 per_racer "cpus": every cluster of anchor_from
+  }
+  if (const auto b = ReadBoolFromJson(obj, "anchor_prev_frame"))
+    action->m_anchor_prev_frame = *b;
+  if (const auto b = ReadBoolFromJson(obj, "require_anchor"))
+    action->m_require_anchor = *b;
+  if (const auto b = ReadBoolFromJson(obj, "anchor_dedupe"))
+    action->m_anchor_dedupe = *b;
+  if (const auto v = ReadStringFromJson(obj, "gate"))
+    action->m_gate = *v;
+  if (const auto n = ReadNumericFromJson<double>(obj, "gate_within_ms"))
+    action->m_gate_within_ms = static_cast<float>(*n);
+  if (const auto it = obj.find("gate_ram"); it != obj.end() && it->second.is<picojson::object>())
+  {
+    const auto& g = it->second.get<picojson::object>();
+    if (const auto c = g.find("chain"); c != g.end() && c->second.is<picojson::array>())
+    {
+      for (const auto& v : c->second.get<picojson::array>())
+      {
+        if (v.is<double>())
+          action->m_ram_chain.push_back(static_cast<u32>(v.get<double>()));
+      }
+    }
+    if (const auto m = ReadNumericFromJson<double>(g, "mask"))
+      action->m_ram_mask = static_cast<u32>(*m);
+    if (const auto e = ReadBoolFromJson(g, "edge"))
+      action->m_ram_edge = *e;
+    // Evolution Racing 2026-11-12: "value": "f32" -> eq_gate.z = the gate word as a float, eq_gate.w = 2 (level mode)
+    if (const auto v = ReadStringFromJson(g, "value"))
+      action->m_ram_value_f32 = *v == "f32";
+    if (const auto an = g.find("and"); an != g.end() && an->second.is<picojson::object>())
+    {
+      const auto& ao = an->second.get<picojson::object>();
+      if (const auto c = ao.find("chain"); c != ao.end() && c->second.is<picojson::array>())
+      {
+        for (const auto& v : c->second.get<picojson::array>())
+        {
+          if (v.is<double>())
+            action->m_ram_and_chain.push_back(static_cast<u32>(v.get<double>()));
+        }
+      }
+      if (const auto m = ReadNumericFromJson<double>(ao, "mask"))
+        action->m_ram_and_mask = static_cast<u32>(*m);
+    }
+    if (const auto nt = g.find("not"); nt != g.end() && nt->second.is<picojson::object>())
+    {
+      const auto& no = nt->second.get<picojson::object>();
+      if (const auto c = no.find("chain"); c != no.end() && c->second.is<picojson::array>())
+      {
+        for (const auto& v : c->second.get<picojson::array>())
+        {
+          if (v.is<double>())
+            action->m_ram_not_chain.push_back(static_cast<u32>(v.get<double>()));
+        }
+      }
+      if (const auto m = ReadNumericFromJson<double>(no, "mask"))
+        action->m_ram_not_mask = static_cast<u32>(*m);
+    }
+  }
+  if (const auto it = obj.find("ram_values"); it != obj.end() && it->second.is<picojson::array>())
+  {
+    for (const auto& ev : it->second.get<picojson::array>())
+    {
+      if (!ev.is<picojson::object>() || action->m_ram_values.size() >= 8)
+        continue;
+      const auto& e = ev.get<picojson::object>();
+      RamValue rv;
+      if (const auto c = e.find("chain"); c != e.end() && c->second.is<picojson::array>())
+      {
+        for (const auto& v : c->second.get<picojson::array>())
+        {
+          if (v.is<double>())
+            rv.chain.push_back(static_cast<u32>(v.get<double>()));
+        }
+      }
+      if (const auto t = ReadStringFromJson(e, "type"))
+        rv.f32 = *t == "f32";
+      if (const auto n = ReadNumericFromJson<double>(e, "mask"))
+        rv.mask = static_cast<u32>(*n);
+      if (const auto n = ReadNumericFromJson<double>(e, "shift"))
+        rv.shift = static_cast<u32>(std::clamp(*n, 0.0, 31.0));
+      if (const auto b = ReadBoolFromJson(e, "nonzero"))
+        rv.nonzero = *b;
+      if (const auto b = ReadBoolFromJson(e, "since_on"))
+        rv.since_on = *b;
+      if (const auto n = ReadNumericFromJson<double>(e, "rise_ms"))
+        rv.rise_ms = static_cast<float>(std::max(*n, 0.0));
+      if (const auto n = ReadNumericFromJson<double>(e, "fall_ms"))
+        rv.fall_ms = static_cast<float>(std::max(*n, 0.0));
+      if (const auto b = ReadBoolFromJson(e, "night"))
+        rv.night = *b;
+      action->m_ram_values.push_back(std::move(rv));
+    }
+  }
+  if (const auto v = ReadStringFromJson(obj, "player_from"))
+    action->m_player_from = *v;
+  if (const auto b = ReadBoolFromJson(obj, "player_only"))
+    action->m_player_only = *b;
+  if (const auto b = ReadBoolFromJson(obj, "scene_copy"))
+    action->m_scene_copy = *b;
+  if (const auto b = ReadBoolFromJson(obj, "depth_copy"))
+    action->m_depth_copy = *b;
+  if (const auto b = ReadBoolFromJson(obj, "night_only"))
+    action->m_night_only = *b;
+  if (const auto b = ReadBoolFromJson(obj, "emit_before"))
+    action->m_emit_before = *b;
+  if (const auto b = ReadBoolFromJson(obj, "scene_before_night"))
+    action->m_scene_before_night = *b;
+  if (const auto it = obj.find("night"); it != obj.end() && it->second.is<picojson::object>())
+  {
+    // lit17s6: THE night pass: {"courses": [256 looks, 255 = default], "default": 2, "strength": 1,
+    //   "tod_offset": main-REL offset of "TOD1" (0 = scan), "tod_scan": bytes scanned from the REL base}
+    const auto& g = it->second.get<picojson::object>();
+    action->m_night = true;
+    s_nt = NightState{};
+    s_nt.configured = true;
+    s_nt.courses.fill(0xFF);
+    if (const auto a = g.find("courses"); a != g.end() && a->second.is<picojson::array>())
+    {
+      const auto& arr = a->second.get<picojson::array>();
+      for (size_t i = 0; i < arr.size() && i < 256; i++)
+        if (arr[i].is<double>())
+          s_nt.courses[i] = static_cast<u8>(std::clamp(arr[i].get<double>(), 0.0, 255.0));
+    }
+    if (const auto n = ReadNumericFromJson<double>(g, "default"))
+      s_nt.def = static_cast<u8>(std::clamp(*n, 0.0, 2.0));
+    if (const auto n = ReadNumericFromJson<double>(g, "strength"))
+      s_nt.strength = static_cast<float>(std::clamp(*n, 0.0, 1.0));
+    if (const auto n = ReadNumericFromJson<double>(g, "tod_offset"))
+      s_nt.tod_offset = static_cast<u32>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "slot_offset"))
+      s_nt.slot_offset = static_cast<u32>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "demo_offset"))
+      s_nt.demo_offset = static_cast<u32>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "trace"))
+      s_nt.trace = static_cast<int>(*n);
+    if (s_nt.trace)
+      std::fprintf(stderr, "NIGHTCFG default=%d strength=%.2f tod_offset=%x trace=%d\n", s_nt.def, s_nt.strength,
+                 s_nt.tod_offset, s_nt.trace);
+    if (const auto n = ReadNumericFromJson<double>(g, "tod_scan"))
+      s_nt.tod_scan = static_cast<u32>(std::clamp(*n, 0.0, 16777216.0));
+  }
+  if (const auto it = obj.find("gate_speed"); it != obj.end() && it->second.is<picojson::object>())
+  {
+    const auto& g = it->second.get<picojson::object>();
+    if (const auto c = g.find("chain"); c != g.end() && c->second.is<picojson::array>())
+    {
+      for (const auto& v : c->second.get<picojson::array>())
+      {
+        if (v.is<double>())
+          action->m_speed_chain.push_back(static_cast<u32>(v.get<double>()));
+      }
+    }
+    if (const auto n = ReadNumericFromJson<double>(g, "prev"))
+      action->m_speed_prev = static_cast<u32>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "scale"))
+      action->m_speed_scale = static_cast<float>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "min"))
+      action->m_speed_min = static_cast<float>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "full"))
+      action->m_speed_full = static_cast<float>(*n);
+  }
+  if (const auto it = obj.find("per_racer"); it != obj.end() && it->second.is<picojson::object>())
+  {
+    const auto& g = it->second.get<picojson::object>();
+    const auto chain = [&](const char* key, std::vector<u32>* out) {
+      if (const auto c = g.find(key); c != g.end() && c->second.is<picojson::array>())
+      {
+        out->clear();
+        for (const auto& v : c->second.get<picojson::array>())
+        {
+          if (v.is<double>())
+            out->push_back(static_cast<u32>(v.get<double>()));
+        }
+      }
+    };
+    action->m_pr = true;
+    chain("base", &action->m_pr_base);
+    chain("view", &action->m_pr_view);
+    if (const auto n = ReadNumericFromJson<double>(g, "stride"))
+      action->m_pr_stride = static_cast<u32>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "count"))
+      action->m_pr_count = static_cast<u32>(std::clamp(*n, 1.0, 64.0));
+    if (const auto n = ReadNumericFromJson<double>(g, "pos"))
+      action->m_pr_pos = static_cast<u32>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "origin_match"))
+      action->m_pr_origin_match = static_cast<float>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "hold"))
+      action->m_pr_hold = static_cast<u32>(std::clamp(*n, 0.0, 30.0));
+    if (const auto n = ReadNumericFromJson<double>(g, "machine"))
+      action->m_pr_machine = static_cast<u32>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "match"))
+      action->m_pr_match = static_cast<float>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "max_dist"))
+      action->m_pr_max_dist = static_cast<float>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "slot_pad"))
+      action->m_pr_slot_pad = static_cast<float>(*n);
+    if (const auto n = ReadNumericFromJson<double>(g, "slot_gap_ms"))
+      action->m_pr_slot_gap_ms = static_cast<float>(*n);
+    if (const auto v = ReadStringFromJson(g, "mode"))
+      action->m_pr_override = *v == "override";
+    if (action->m_pr_base.empty() || action->m_pr_view.empty())
+      action->m_pr = false;
+  }
+  if (const auto it = obj.find("damage"); it != obj.end() && it->second.is<picojson::object>())
+  {
+    DmConfigure(it->second.get<picojson::object>());
+    action->m_damage_track = true;
+    s_dm_refs++;
+  }
+  if (const auto it = obj.find("hull_fx"); it != obj.end() && it->second.is<picojson::object>())
+  {
+    HxConfigure(it->second.get<picojson::object>());
+    action->m_hull_track = true;
+    s_dm_refs++;  // the hull state is kept by the damage tracker's frame end
+    s_hx_refs++;
+  }
+  if (const auto it = obj.find("surface_layer"); it != obj.end() && it->second.is<picojson::object>())
+  {
+    SfConfigure(it->second.get<picojson::object>());
+    action->m_surface_track = true;
+    s_dm_refs++;  // lit17s: the racer state is kept by the damage tracker's frame end
+    s_sf_refs++;
+  }
+  if (const auto v = ReadStringFromJson(obj, "skip_when"))
+    action->m_skip_when = *v;
+  if (const auto n = ReadNumericFromJson<double>(obj, "skip_within_ms"))
+    action->m_skip_within_ms = static_cast<float>(*n);
+  if (const auto n = ReadNumericFromJson<double>(obj, "trace"))
+    action->m_trace = static_cast<u32>(std::max(*n, 0.0));
+  // Evolution Racing dolphin-lit17s9 / s10 scenery (see EmitQuadsAction.h, SCENERY-LIT17S10.md)
+  if (const auto it = obj.find("scenery"); it != obj.end() && it->second.is<picojson::object>())
+  {
+    const auto& g = it->second.get<picojson::object>();
+    const auto num = [&](const char* k, float def) {
+      const auto n = ReadNumericFromJson<double>(g, k);
+      return n ? static_cast<float>(*n) : def;
+    };
+    action->m_sc_dir = ReadStringFromJson(g, "dir").value_or("");
+    action->m_sc_mesh_file = ReadStringFromJson(g, "mesh_file").value_or("");
+    if (action->m_sc_dir.empty() && action->m_sc_mesh_file.empty())
+    {
+      ERROR_LOG_FMT(VIDEO, "emit_quads scenery: needs \"dir\" (or a step-1 \"mesh_file\")");
+      return nullptr;
+    }
+    if (const auto p = g.find("pos"); p != g.end() && p->second.is<picojson::array>())
+    {
+      const auto& arr = p->second.get<picojson::array>();
+      for (size_t i = 0; i < 3 && i < arr.size(); i++)
+        if (arr[i].is<double>())
+          action->m_sc_pos[i] = static_cast<float>(arr[i].get<double>());
+    }
+    action->m_sc_yaw = -num("yaw", 0.0f);  // step 1's yaw turned the other way round (+ = counter-clockwise)
+    action->m_sc_scale = num("scale", 1.0f);
+    action->m_sc_course = static_cast<int>(num("course", -1.0f));
+    action->m_sc_slot = static_cast<int>(num("slot", -1.0f));
+    action->m_sc_trace = static_cast<u32>(std::max(num("trace", 0.0f), 0.0f));
+    action->m_sc_max_dist = std::max(num("max_dist", 0.0f), 0.0f);
+    if (const auto v = ReadStringFromJson(g, "view"))
+      action->m_sc_gpu_view = *v != "ram";
+    action->m_quads = 1;
+    action->m_max_emits_per_frame = 1;
+    action->m_depth_test = true;
+    action->m_depth_write = true;
+    action->m_scenery = true;
+    s_sc_refs++;
+    std::fprintf(stderr, "SCENERY action: %s course %d slot %d view %s\n",
+                 action->m_sc_dir.empty() ? action->m_sc_mesh_file.c_str() : action->m_sc_dir.c_str(),
+                 action->m_sc_course, action->m_sc_slot, action->m_sc_gpu_view ? "gpu" : "ram");
+  }
+  NOTICE_LOG_FMT(VIDEO, "emit_quads: {} quads, vs '{}', ps '{}', texture '{}', skip_original {}",
+                 action->m_quads, vs_file.value_or("-"), ps_file.value_or("-"),
+                 action->m_texture_file.empty() ? "<target>" : action->m_texture_file,
+                 action->m_skip_original);
+  return action;
+}
+
+EmitQuadsAction::EmitQuadsAction() = default;
+
+// Pipelines first, then the shaders they were built from.
+EmitQuadsAction::~EmitQuadsAction()
+{
+  if (m_surface_track)
+  {
+    s_sf_refs = std::max(s_sf_refs - 1, 0);
+    if (--s_dm_refs <= 0)
+    {
+      s_dm_refs = 0;
+      DmClear();
+    }
+  }
+  if (m_hull_track)
+  {
+    s_hx_refs = std::max(s_hx_refs - 1, 0);
+    if (--s_dm_refs <= 0)
+    {
+      s_dm_refs = 0;
+      DmClear();
+    }
+  }
+  if (m_damage_track && --s_dm_refs <= 0)
+  {
+    s_dm_refs = 0;
+    DmClear();
+  }
+  if (m_scenery)
+    s_sc_refs = std::max(s_sc_refs - 1, 0);
+  if (m_sc && m_sc->pending.valid())
+    m_sc->pending.wait();
+  m_sc.reset();
+  m_pipelines.clear();
+  m_scene.reset();
+  m_depth.reset();
+  m_pixel_shader.reset();
+  m_vertex_shader.reset();
+  m_texture.reset();
+}
+
+void EmitQuadsAction::OnDrawStarted(GraphicsModActionData::DrawStarted* draw_started)
+{
+  if (m_failed || !draw_started || !draw_started->quad_emitters)
+    return;
+  if (m_skip_original && draw_started->skip)
+    *draw_started->skip = true;
+  if (!m_skip_when.empty())
+  {
+    const auto it = s_slots.find(m_skip_when);
+    if (it != s_slots.end() && it->second.ever && draw_started->skip)
+    {
+      const s32 since = static_cast<s32>(s_now_ms - it->second.last_seen_ms);
+      if (since >= 0 && static_cast<float>(since) <= m_skip_within_ms)
+        *draw_started->skip = true;
+    }
+    if (!m_emit && m_publish.empty())
+      return;  // nothing to measure or draw
+  }
+  auto& emitters = *draw_started->quad_emitters;
+  if (std::ranges::find(emitters, this) == emitters.end())
+    emitters.push_back(this);
+}
+
+void EmitQuadsAction::OnGlobalFrameEnd()
+{
+  if (s_dm_refs > 0)
+    DmFrameEnd();  // lit17: before the slots roll (cur = this frame's complete machines)
+  for (auto& [name, slot] : s_slots)
+  {
+    slot.prev = std::move(slot.cur);
+    slot.cur.clear();
+  }
+  s_global_frame++;
+}
+
+void EmitQuadsAction::ClearAnchorSlots()
+{
+  s_slots.clear();
+  DmClear();
+}
+
+void EmitQuadsAction::OnFrameEnd()
+{
+  if (m_scenery && !m_failed)
+  {
+    // lit17s10: the slot's scene loads (and uploads) as soon as the slot is set, before the race draws
+    u32 venue = 0, slot = 0;
+    bool demo = false;
+    if (ReadGate(&venue, &slot, &demo) && !demo && slot < 256 && (m_sc_slot < 0 || static_cast<u32>(m_sc_slot) == slot))
+      SceneryPoll(static_cast<int>(slot));
+  }
+  if (m_pr && !m_pr_override && m_trace && m_pr_count_frame[0] > 0)
+  {
+    const auto& c = m_pr_count_frame;
+    std::fprintf(stderr, "EQTRACE f=%llu frame %s candidates=%u emitted=%u noracer=%u player=%u done=%u gate=%u dist=%u cap=%u calls=%u late=%u\n",
+                 static_cast<unsigned long long>(s_global_frame), m_name.c_str(), c[0], c[1], c[2], c[3], c[4], c[5],
+                 c[6], c[7], m_pr_calls, m_pr_late_emits);
+  }
+  m_pr_count_frame = {};
+  m_pr_calls = 0;
+  m_pr_late_emits = 0;
+  m_prev_frame = std::move(m_this_frame);
+  m_this_frame.clear();
+  m_emitted_clusters.clear();
+  m_emits_this_frame = 0;
+  m_frame_counter++;
+}
+
+bool EmitQuadsAction::EnsureResources(const EmitQuadsAnchor& anchor)
+{
+  if (!m_vertex_shader)
+  {
+    m_vertex_shader = g_gfx->CreateShaderFromSource(
+        ShaderStage::Vertex, GenerateVertexShader(m_vs_source), nullptr, "emit_quads vertex");
+    m_pixel_shader = g_gfx->CreateShaderFromSource(
+        ShaderStage::Pixel, GeneratePixelShader(m_ps_source), nullptr, "emit_quads pixel");
+    if (!m_vertex_shader || !m_pixel_shader)
+    {
+      ERROR_LOG_FMT(VIDEO, "emit_quads: shader compile failed, action disabled (see the log above)");
+      m_failed = true;
+      return false;
+    }
+  }
+  if (!m_texture_file.empty() && !m_texture)
+  {
+    std::string png;
+    Common::UniqueBuffer<u8> rgba;
+    u32 width = 0, height = 0;
+    if (!File::ReadFileToString(m_texture_file, png) ||
+        !Common::LoadPNG(std::span(reinterpret_cast<const u8*>(png.data()), png.size()), &rgba,
+                         &width, &height) ||
+        width == 0 || height == 0)
+    {
+      ERROR_LOG_FMT(VIDEO, "emit_quads: cannot load texture '{}', action disabled", m_texture_file);
+      m_failed = true;
+      return false;
+    }
+    m_texture = g_gfx->CreateTexture(TextureConfig(width, height, 1, 1, 1,
+                                                   AbstractTextureFormat::RGBA8, 0,
+                                                   AbstractTextureType::Texture_2DArray),
+                                     "emit_quads texture");
+    if (!m_texture)
+    {
+      m_failed = true;
+      return false;
+    }
+    m_texture->Load(0, width, height, width, rgba.data(), rgba.size());
+  }
+  return true;
+}
+
+const AbstractPipeline* EmitQuadsAction::GetPipeline(const EmitQuadsAnchor& anchor)
+{
+  BlendingState blend;
+  if (m_blend == BlendMode::Target)
+  {
+    blend = anchor.blending_state;
+    // Dual-source / logic-op blends need GX shader outputs this shader does not have.
+    if (blend.use_dual_src || blend.logic_op_enable || blend.RequiresDualSrc())
+      blend = MakeBlend(true);
+    blend.alpha_update = false;
+  }
+  else
+  {
+    blend = MakeBlend(m_blend == BlendMode::Additive);
+    if (m_blend == BlendMode::Premultiplied)
+      blend.src_factor = SrcBlendFactor::One;
+  }
+
+  DepthState depth = anchor.depth_state;
+  if (!m_depth_test)
+    depth = RenderState::GetNoDepthTestingDepthState();
+  depth.update_enable = m_depth_write;  // effects never write depth (lit17s9: scenery does)
+  if (m_depth_write)
+  {
+    depth.test_enable = true;
+    depth.func = anchor.depth_state.test_enable ? anchor.depth_state.func.Value() : CompareMode::LEqual;
+  }
+
+  const FramebufferState fb = g_framebuffer_manager->GetEFBFramebufferState();
+  const u64 key = (static_cast<u64>(fb.hex) << 32) | (static_cast<u64>(depth.hex & 0xff) << 24) |
+                  (blend.hex & 0xffffff);
+  if (const auto it = m_pipelines.find(key); it != m_pipelines.end())
+    return it->second.get();
+
+  AbstractPipelineConfig config;
+  config.vertex_format = nullptr;
+  config.vertex_shader = m_vertex_shader.get();
+  config.geometry_shader = nullptr;
+  config.pixel_shader = m_pixel_shader.get();
+  config.rasterization_state = RenderState::GetNoCullRasterizationState(PrimitiveType::Triangles);
+  config.depth_state = depth;
+  config.blending_state = blend;
+  config.framebuffer_state = fb;
+  config.usage = AbstractPipelineUsage::Utility;
+  auto pipeline = g_gfx->CreatePipeline(config);
+  if (!pipeline)
+    ERROR_LOG_FMT(VIDEO, "emit_quads: pipeline creation failed");
+  const AbstractPipeline* result = pipeline.get();
+  m_pipelines.emplace(key, std::move(pipeline));  // a null entry stops retrying every draw
+  return result;
+}
+
+void EmitQuadsAction::ReadRamValues(u32 now, std::array<float, 8>* out)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const auto read32 = [&](u32 addr, u32* o) {
+    const u8* p = memory.GetPointerForRange(addr, 4);
+    if (!p)
+      return false;
+    u32 v;
+    std::memcpy(&v, p, 4);
+    *o = Common::swap32(v);
+    return true;
+  };
+  for (size_t i = 0; i < m_ram_values.size(); i++)
+  {
+    RamValue& rv = m_ram_values[i];
+    if (rv.night)
+    {
+      (*out)[i] = static_cast<float>(NightLook());
+      continue;
+    }
+    if (rv.chain.empty())
+      continue;
+    u32 a = rv.chain[0];
+    bool ok = true;
+    for (size_t j = 1; j < rv.chain.size() && ok; j++)
+    {
+      u32 v = 0;
+      ok = read32(a, &v);
+      a = v + rv.chain[j];
+    }
+    u32 word = 0;
+    ok = ok && read32(a, &word);
+    float value = 0.0f;
+    if (ok)
+    {
+      if (rv.f32)
+      {
+        std::memcpy(&value, &word, 4);
+        if (!std::isfinite(value))
+          value = 0.0f;
+      }
+      else
+      {
+        value = static_cast<float>((word & rv.mask) >> rv.shift);
+      }
+    }
+    if (rv.nonzero)
+      value = value != 0.0f ? 1.0f : 0.0f;
+    if (rv.since_on)
+    {
+      const bool on = value != 0.0f;
+      const s32 back = static_cast<s32>(now - rv.on_ms);
+      if (on && (!rv.was_on || back < 0))  // a new run (or the clock went back: a state load)
+      {
+        rv.on_ms = now;
+        rv.ever_on = true;
+      }
+      rv.was_on = on;
+      (*out)[i] = rv.ever_on ? static_cast<float>(std::max<s32>(static_cast<s32>(now - rv.on_ms), 0)) : 1e6f;
+      continue;
+    }
+    if (rv.rise_ms > 0.0f || rv.fall_ms > 0.0f)
+    {
+      const s32 dt = static_cast<s32>(now - rv.last_ms);
+      if (!rv.have || dt < 0 || dt > 1000)
+      {
+        rv.smooth = value;
+      }
+      else if (dt > 0)
+      {
+        const float tau = value > rv.smooth ? rv.rise_ms : rv.fall_ms;
+        rv.smooth = tau <= 0.0f ? value :
+                                  rv.smooth + (value - rv.smooth) *
+                                                  (1.0f - std::exp(-static_cast<float>(dt) / tau));
+      }
+      if (!rv.have || dt != 0)
+        rv.last_ms = now;
+      rv.have = true;
+      value = rv.smooth;
+    }
+    (*out)[i] = value;
+  }
+}
+
+const AbstractTexture* EmitQuadsAction::CopyScene(std::array<float, 4>* size)
+{
+  AbstractTexture* efb = g_framebuffer_manager->GetEFBColorTexture();
+  if (!efb)
+    return nullptr;
+  const u32 w = efb->GetWidth(), h = efb->GetHeight();
+  if (!m_scene || m_scene->GetWidth() != w || m_scene->GetHeight() != h ||
+      m_scene->GetFormat() != efb->GetFormat())
+  {
+    m_scene.reset();
+    m_scene = g_gfx->CreateTexture(TextureConfig(w, h, 1, 1, 1, efb->GetFormat(), 0,
+                                                 AbstractTextureType::Texture_2DArray),
+                                   "emit_quads scene copy");
+    m_scene_frame = 0xffffffffu;
+    if (!m_scene)
+      return nullptr;
+  }
+  if (m_scene_frame != m_frame_counter)
+  {
+    const MathUtil::Rectangle<int> rect(0, 0, static_cast<int>(w), static_cast<int>(h));
+    // multisampled EFB: resolved first (returns the EFB itself when it is not multisampled)
+    AbstractTexture* src = g_framebuffer_manager->ResolveEFBColorTexture(rect);
+    if (!src)
+      return nullptr;
+    m_scene->CopyRectangleFromTexture(src, rect, 0, 0, rect, 0, 0);
+    m_scene->FinishedRendering();
+    m_scene_frame = m_frame_counter;
+  }
+  *size = {static_cast<float>(w), static_cast<float>(h), 1.0f / static_cast<float>(w),
+           1.0f / static_cast<float>(h)};
+  return m_scene.get();
+}
+
+const AbstractTexture* EmitQuadsAction::CopyDepth(std::array<float, 4>* size)
+{
+  const u32 w = g_framebuffer_manager->GetEFBWidth(), h = g_framebuffer_manager->GetEFBHeight();
+  const MathUtil::Rectangle<int> rect(0, 0, static_cast<int>(w), static_cast<int>(h));
+  if (m_depth_frame != m_frame_counter || !m_depth)
+  {
+    // multisampled EFB: resolved to R32F first (else the D32F EFB depth itself)
+    AbstractTexture* src = g_framebuffer_manager->ResolveEFBDepthTexture(rect, false);
+    if (!src)
+      return nullptr;
+    if (!m_depth || m_depth->GetWidth() != w || m_depth->GetHeight() != h ||
+        m_depth->GetFormat() != src->GetFormat())
+    {
+      m_depth.reset();
+      m_depth = g_gfx->CreateTexture(TextureConfig(w, h, 1, 1, 1, src->GetFormat(), 0,
+                                                   AbstractTextureType::Texture_2DArray),
+                                     "emit_quads depth copy");
+      if (!m_depth)
+        return nullptr;
+    }
+    m_depth->CopyRectangleFromTexture(src, rect, 0, 0, rect, 0, 0);
+    m_depth->FinishedRendering();
+    m_depth_frame = m_frame_counter;
+  }
+  *size = {static_cast<float>(w), static_cast<float>(h), 1.0f / static_cast<float>(w),
+           1.0f / static_cast<float>(h)};
+  return m_depth.get();
+}
+
+void EmitQuadsAction::Emit(const EmitQuadsAnchor& target)
+{
+  if (m_failed || !target.valid)
+    return;
+  if (target.projection_rows[3][3] == 0.0f)  // lit17s6: perspective (w = -z)
+  {
+    s_persp_rows = target.projection_rows;
+    s_persp_pc = target.pixel_center;
+    s_have_persp = true;
+  }
+  const u32 now = target.time_ms;
+  s_now_ms = now;
+
+  if (!m_publish.empty())
+  {
+    AnchorSlot& slot = s_slots[m_publish];
+    const s32 since = static_cast<s32>(now - slot.last_seen_ms);
+    if (!slot.ever || since < 0 || static_cast<float>(since) > m_run_gap_ms)
+      slot.run_start_ms = now;  // a new run (or the clock went back: a state load)
+    slot.ever = true;
+    slot.last_seen_ms = now;
+    AnchorCluster* into = nullptr;
+    // lit15: a publisher with "per_racer" files every draw under its racer (nearest racer position), so machines side
+    // by side in a pack stay separate clusters (the radius merge joined them: one cluster between two machines)
+    int pr = -1;
+    if (m_pr)
+    {
+      if (m_pr_frame != m_frame_counter)
+      {
+        UpdateRacers(now);
+        m_pr_frame = m_frame_counter;
+      }
+      if (m_pr_ok && m_pr_origin_match > 0.0f)
+      {
+        const std::array<float, 3> origin = {target.position_matrix[3], target.position_matrix[7],
+                                             target.position_matrix[11]};
+        pr = MatchRacer(origin, m_pr_origin_match);
+      }
+      else if (m_pr_ok)
+      {
+        pr = MatchRacer(target.centroid_view, m_pr_match);
+      }
+    }
+    const bool skip_publish = m_pr && m_pr_ok && m_pr_origin_match > 0.0f && pr < 0;
+    for (AnchorCluster& c : slot.cur)
+    {
+      if (skip_publish)
+        break;
+      if (pr >= 0 || c.racer >= 0)
+      {
+        if (c.racer == pr)
+        {
+          into = &c;
+          break;
+        }
+        continue;
+      }
+      const float lim = std::max(c.a.radius_view, target.radius_view) * 1.25f;
+      if (Dist2(c.a.centroid_view, target.centroid_view) <= lim * lim)
+      {
+        into = &c;
+        break;
+      }
+    }
+    if (skip_publish)
+    {
+    }
+    else if (into)
+      MergeInto(*into, target);
+    else if (slot.cur.size() < 64)
+      slot.cur.push_back({target, pr, 1, target.radius_view});
+    if (s_dm_refs > 0)
+      DmNoteDraw(pr >= 0 ? pr : (m_publish == DmPlayerSlot() ? 0 : -1), target);  // lit17: this draw's matrix
+    if (m_trace)
+    {
+      m_trace--;
+      std::fprintf(stderr,
+                   "EQTRACE f=%llu t=%u publish %s centroid=(%.2f %.2f %.2f) r=%.2f n=%u "
+                   "model=[%.2f %.2f %.2f .. %.2f %.2f %.2f] clusters=%zu\n",
+                   static_cast<unsigned long long>(s_global_frame), now, m_publish.c_str(),
+                   target.centroid_view[0], target.centroid_view[1], target.centroid_view[2],
+                   target.radius_view, target.sampled_vertices, target.model_min[0],
+                   target.model_min[1], target.model_min[2], target.model_max[0],
+                   target.model_max[1], target.model_max[2], slot.cur.size());
+    }
+  }
+  if (!m_emit || m_emits_this_frame >= m_max_emits_per_frame)
+    return;
+  if (m_scenery)
+  {
+    EmitScenery(target);  // lit17s9
+    return;
+  }
+  if (m_night_only && NightLook() == 0)
+    return;  // lit17s8: day course / menus / no night pass installed
+  // lit17s6: the night pass costs nothing on a day course / in the menus (no copies, no draw), and runs once a frame
+  if (m_night && (NightLook() == 0 || s_nt.strength <= 0.0f || s_nt.pass_frame == s_global_frame))
+    return;
+  if (m_pr && !m_pr_override)
+  {
+    EmitPerRacer(target);
+    return;
+  }
+
+  std::array<float, 4> gate = {1e9f, 1e9f, 0.0f, 0.0f};
+  if (!m_ram_chain.empty() && m_ram_mask != 0)
+  {
+    // Evolution Racing: gate on emulated RAM (read on the video thread: a flag word, a frame of skew is fine)
+    auto& memory = Core::System::GetInstance().GetMemory();
+    const auto read32 = [&](u32 addr, u32* out) {
+      const u8* p = memory.GetPointerForRange(addr, 4);
+      if (!p)
+        return false;
+      u32 v;
+      std::memcpy(&v, p, 4);
+      *out = Common::swap32(v);
+      return true;
+    };
+    u32 a = m_ram_chain[0];
+    bool ok = true;
+    for (size_t i = 1; i < m_ram_chain.size() && ok; i++)
+    {
+      u32 v = 0;
+      ok = read32(a, &v);
+      a = v + m_ram_chain[i];
+    }
+    u32 word = 0;
+    ok = ok && read32(a, &word);
+    bool and_ok = true;
+    if (!m_ram_and_chain.empty())
+    {
+      u32 a2 = m_ram_and_chain[0];
+      bool ok2 = true;
+      for (size_t i = 1; i < m_ram_and_chain.size() && ok2; i++)
+      {
+        u32 v = 0;
+        ok2 = read32(a2, &v);
+        a2 = v + m_ram_and_chain[i];
+      }
+      u32 w2 = 0;
+      and_ok = ok2 && read32(a2, &w2) && (w2 & m_ram_and_mask) != 0;
+    }
+    if (m_ram_edge)
+    {
+      // per-event counters (e.g. the dash-plate hit counter): every increase starts a new run that lasts
+      // gate_within_ms; a decrease (new race / state load) only re-arms
+      const u32 w = word & m_ram_mask;
+      if (ok && m_ram_have_prev && w > m_ram_prev && and_ok)
+      {
+        m_ram_run_start_ms = now;
+        m_ram_last_ms = now;
+        m_ram_seen = true;
+      }
+      if (ok)
+      {
+        m_ram_prev = w;
+        m_ram_have_prev = true;
+      }
+      if (!m_ram_seen)
+        return;
+      const s32 run = static_cast<s32>(now - m_ram_run_start_ms);
+      if (run < 0 || static_cast<float>(run) > m_gate_within_ms)
+        return;
+      gate = {0.0f, static_cast<float>(run), static_cast<float>(run), 1.0f};
+    }
+    else if (ok && and_ok && (word & m_ram_mask) != 0)
+    {
+      const s32 since_last = static_cast<s32>(now - m_ram_last_ms);
+      if (!m_ram_seen || since_last < 0 || static_cast<float>(since_last) > m_gate_within_ms)
+        m_ram_run_start_ms = now;
+      m_ram_seen = true;
+      m_ram_last_ms = now;
+    }
+    if (!m_ram_edge)
+    {
+    if (!m_ram_seen)
+      return;
+    const s32 since = static_cast<s32>(now - m_ram_last_ms);
+    if (since < 0 || static_cast<float>(since) > m_gate_within_ms)
+      return;
+    gate = {static_cast<float>(since), static_cast<float>(std::max<s32>(static_cast<s32>(now - m_ram_run_start_ms), 0)),
+            static_cast<float>(std::max<s32>(static_cast<s32>(m_ram_last_ms - m_ram_run_start_ms), 0)), 1.0f};
+    if (m_ram_value_f32 && ok)
+    {
+      float f;
+      std::memcpy(&f, &word, 4);
+      gate[2] = std::isfinite(f) ? f : 0.0f;
+      gate[3] = 2.0f;
+    }
+    }
+  }
+  if (!m_speed_chain.empty())
+  {
+    auto& memory = Core::System::GetInstance().GetMemory();
+    const auto rd = [&](u32 addr, u32* out) {
+      const u8* p = memory.GetPointerForRange(addr, 4);
+      if (!p)
+        return false;
+      u32 v;
+      std::memcpy(&v, p, 4);
+      *out = Common::swap32(v);
+      return true;
+    };
+    u32 a = m_speed_chain[0];
+    bool ok = true;
+    for (size_t i = 1; i < m_speed_chain.size() && ok; i++)
+    {
+      u32 v = 0;
+      ok = rd(a, &v);
+      a = v + m_speed_chain[i];
+    }
+    // The game's own last-frame copy (+0x88) is updated mid-frame, so a read from the video thread often sees
+    // it equal to the position: use our own previous read and the emulated clock instead.
+    std::array<float, 3> pos{};
+    for (u32 i = 0; i < 3 && ok; i++)
+    {
+      u32 c = 0;
+      ok = rd(a + 4 * i, &c);
+      std::memcpy(&pos[i], &c, 4);
+    }
+    if (ok && std::isfinite(pos[0] + pos[1] + pos[2]))
+    {
+      const s32 dt = static_cast<s32>(now - m_speed_last_ms);
+      if (m_speed_have_last && dt >= 12 && dt < 500)
+      {
+        const float d = std::sqrt(Dist2(pos, m_speed_last_pos));
+        // m per ms -> km/h is x 3600; "scale" stays m/frame -> unit (216 = km/h), so x scale / 16.667 ms
+        const float sp = d / static_cast<float>(dt) * (m_speed_scale * 1000.0f / 60.0f);
+        if (sp < 5000.0f)   // a teleport (respawn) is not a speed
+          m_speed_smooth = m_speed_smooth * 0.75f + sp * 0.25f;
+        m_speed_last_pos = pos;
+        m_speed_last_ms = now;
+      }
+      else if (!m_speed_have_last || dt < 0 || dt >= 500)
+      {
+        m_speed_last_pos = pos;
+        m_speed_last_ms = now;
+        m_speed_have_last = true;
+      }
+    }
+    if (m_speed_smooth < m_speed_min)
+    {
+      m_speed_above = false;
+      return;
+    }
+    if (!m_speed_above)
+      m_speed_since_ms = now;
+    m_speed_above = true;
+    const float ramp = std::clamp((m_speed_smooth - m_speed_min) / std::max(m_speed_full - m_speed_min, 1.0f),
+                                  0.0f, 1.0f);
+    gate = {m_speed_smooth, static_cast<float>(std::max<s32>(static_cast<s32>(now - m_speed_since_ms), 0)), ramp, 1.0f};
+  }
+  if (!m_gate.empty())
+  {
+    const auto it = s_slots.find(m_gate);
+    if (it == s_slots.end() || !it->second.ever)
+      return;
+    const s32 since = static_cast<s32>(now - it->second.last_seen_ms);
+    if (since < 0 || static_cast<float>(since) > m_gate_within_ms)
+      return;
+    const s32 run = static_cast<s32>(now - it->second.run_start_ms);
+    gate = {static_cast<float>(since), static_cast<float>(std::max(run, 0)),
+            static_cast<float>(std::max(static_cast<s32>(it->second.last_seen_ms -
+                                                         it->second.run_start_ms),
+                                        0)),
+            1.0f};
+  }
+
+  EmitQuadsAnchor anchor = target;
+  if (!m_anchor_from.empty())
+  {
+    const AnchorCluster* pick = nullptr;
+    const auto it = s_slots.find(m_anchor_from);
+    if (it != s_slots.end())
+    {
+      const auto& list = (!m_anchor_prev_frame && !it->second.cur.empty()) ? it->second.cur :
+                                                                              it->second.prev;
+      float best = 1e30f;
+      for (const AnchorCluster& c : list)
+      {
+        float score;
+        if (m_pick_largest)
+        {
+          score = -(c.a.screen_box[2] - c.a.screen_box[0]) * (c.a.screen_box[3] - c.a.screen_box[1]);
+        }
+        else
+        {
+          score = Dist2(c.a.centroid_view, target.centroid_view);
+        }
+        if (score < best)
+        {
+          best = score;
+          pick = &c;
+        }
+      }
+    }
+    if (!pick)
+    {
+      if (m_require_anchor)
+        return;
+    }
+    else
+    {
+      // One emit per picked object per frame (a ring drawn in several batches).
+      for (const auto& e : m_emitted_clusters)
+      {
+        const std::array<float, 3> p = {e[0], e[1], e[2]};
+        if (m_anchor_dedupe && Dist2(p, pick->a.centroid_view) <= e[3] * e[3] * 0.25f)
+          return;
+      }
+      if (m_anchor_dedupe)
+        m_emitted_clusters.push_back({pick->a.centroid_view[0], pick->a.centroid_view[1],
+                                    pick->a.centroid_view[2], pick->a.radius_view});
+      anchor.centroid_view = pick->a.centroid_view;
+      anchor.radius_view = pick->a.radius_view;
+      anchor.min_view = pick->a.min_view;
+      anchor.max_view = pick->a.max_view;
+      anchor.screen_box = pick->a.screen_box;
+      anchor.screen_centre = pick->a.screen_centre;
+      anchor.position_matrix = pick->a.position_matrix;
+      anchor.model_min = pick->a.model_min;
+      anchor.model_max = pick->a.model_max;
+      anchor.model_valid = pick->a.model_valid;
+      anchor.sampled_vertices = pick->a.sampled_vertices;
+      anchor.surf = pick->a.surf;  // lit16: the whole machine's hull samples, not the trigger draw's
+    }
+  }
+  if (m_trace)
+  {
+    m_trace--;
+    std::fprintf(stderr,
+                 "EQTRACE f=%llu t=%u emit from=%s target=(%.2f %.2f %.2f) r=%.2f anchor=(%.2f %.2f "
+                 "%.2f) r=%.2f model_y=[%.2f %.2f] gate=(%.0f %.0f) far=(%.2f %.2f %.2f)\n",
+                 static_cast<unsigned long long>(s_global_frame), now, m_anchor_from.c_str(),
+                 target.centroid_view[0], target.centroid_view[1], target.centroid_view[2],
+                 target.radius_view, anchor.centroid_view[0], anchor.centroid_view[1],
+                 anchor.centroid_view[2], anchor.radius_view, anchor.model_min[1],
+                 anchor.model_max[1], gate[0], gate[1], target.far_view[0], target.far_view[1],
+                 target.far_view[2]);
+  }
+  DrawEmit(target, anchor, gate, nullptr, nullptr);
+}
+
+void EmitQuadsAction::DrawEmit(const EmitQuadsAnchor& target, const EmitQuadsAnchor& anchor,
+                               const std::array<float, 4>& gate, const std::array<float, 8>* ram_override,
+                               const std::array<float, 4>* player_override,
+                               const std::array<float, 4>* racer_override)
+{
+  if (g_framebuffer_manager->IsEFBStereo())
+  {
+    // Would need a layer-replicating geometry shader for the custom varyings.
+    if (!m_warned_stereo)
+      WARN_LOG_FMT(VIDEO, "emit_quads: stereoscopic 3D is not supported, nothing is emitted");
+    m_warned_stereo = true;
+    return;
+  }
+  // lit10 "player_from": the largest cluster of that slot (previous frame) = the player's machine
+  std::array<float, 4> player{};
+  if (player_override)
+  {
+    player = *player_override;
+  }
+  else if (!m_player_from.empty())
+  {
+    const auto it = s_slots.find(m_player_from);
+    if (it != s_slots.end())
+    {
+      const auto& list = it->second.prev.empty() ? it->second.cur : it->second.prev;
+      float best_area = -1.0f;
+      for (const AnchorCluster& c : list)
+      {
+        const float area = (c.a.screen_box[2] - c.a.screen_box[0]) * (c.a.screen_box[3] - c.a.screen_box[1]);
+        if (area > best_area)
+        {
+          best_area = area;
+          player = {c.a.centroid_view[0], c.a.centroid_view[1], c.a.centroid_view[2],
+                    std::max(c.a.radius_view, 1e-3f)};
+        }
+      }
+    }
+    // "player_only": emit only on the player's machine (the anchor within 1.5 radii of it)
+    if (m_player_only)
+    {
+      if (player[3] <= 0.0f)
+        return;
+      const std::array<float, 3> pc = {player[0], player[1], player[2]};
+      if (Dist2(pc, anchor.centroid_view) > player[3] * player[3] * 2.25f)
+        return;
+    }
+  }
+  if (!EnsureResources(anchor))
+    return;
+  // lit10: the scene copy before the pipeline is bound (the copy ends the render pass)
+  std::array<float, 4> scene_size{};
+  const AbstractTexture* scene = nullptr;
+  if (m_scene_copy)
+  {
+    if (m_scene_before_night && !m_night && s_nt.pass_frame == s_global_frame && s_nt.pass_scene)
+    {
+      // lit17s6: the scene before the night grade (the night pass's copy): lights take their albedo from it
+      scene = s_nt.pass_scene;
+      scene_size = {static_cast<float>(scene->GetWidth()), static_cast<float>(scene->GetHeight()),
+                    1.0f / static_cast<float>(scene->GetWidth()), 1.0f / static_cast<float>(scene->GetHeight())};
+    }
+    else
+    {
+      scene = CopyScene(&scene_size);
+    }
+    if (!scene)
+      return;
+    if (m_night)
+    {
+      s_nt.pass_frame = s_global_frame;
+      s_nt.pass_scene = scene;
+    }
+  }
+  // lit14: the depth copy, likewise before the pipeline
+  std::array<float, 4> depth_size{};
+  const AbstractTexture* depth = nullptr;
+  if (m_depth_copy)
+  {
+    depth = CopyDepth(&depth_size);
+    if (!depth)
+      return;
+  }
+  const AbstractTexture* texture = m_texture ? m_texture.get() : anchor.target_texture;
+  if (!texture)
+    return;
+  const AbstractPipeline* pipeline = GetPipeline(anchor);
+  if (!pipeline)
+    return;
+
+  EmitQuadsUniforms u{};
+  u.projection = anchor.projection_rows;
+  u.pixel_center = anchor.pixel_center;
+  if (m_night && anchor.projection_rows[3][3] != 0.0f && s_have_persp)
+  {
+    // lit17s6: the night pass fired by a HUD draw: the world's perspective for the depth copy
+    u.projection = s_persp_rows;
+    u.pixel_center = s_persp_pc;
+  }
+  u.anchor = {anchor.centroid_view[0], anchor.centroid_view[1], anchor.centroid_view[2],
+              anchor.radius_view};
+  u.view_min = {anchor.min_view[0], anchor.min_view[1], anchor.min_view[2],
+                static_cast<float>(anchor.sampled_vertices)};
+  u.view_max = {anchor.max_view[0], anchor.max_view[1], anchor.max_view[2],
+                anchor.original_skipped ? 1.0f : 0.0f};
+  u.screen_box = anchor.screen_box;
+  for (int r = 0; r < 3; r++)
+  {
+    for (int c = 0; c < 4; c++)
+      u.matrix[r][c] = anchor.position_matrix[r * 4 + c];
+  }
+  const float vw = std::max(anchor.viewport[0], 1.0f);
+  const float vh = std::max(anchor.viewport[1], 1.0f);
+  u.viewport = {vw, vh, 1.0f / vw, 1.0f / vh};
+  u.info = {anchor.time_ms, m_quads, m_emits_this_frame, m_frame_counter};
+  u.params = m_params;
+  u.model_min = {anchor.model_min[0], anchor.model_min[1], anchor.model_min[2],
+                 anchor.model_valid ? 1.0f : 0.0f};
+  u.model_max = {anchor.model_max[0], anchor.model_max[1], anchor.model_max[2], 0.0f};
+  u.gate = gate;
+  u.target = {target.centroid_view[0], target.centroid_view[1], target.centroid_view[2],
+              target.radius_view};
+  u.ram = {};
+  if (ram_override)
+    u.ram = *ram_override;
+  else if (!m_ram_values.empty())
+    ReadRamValues(anchor.time_ms, &u.ram);
+  u.player = player;
+  // lit15 per_racer "override": a machine that is not the player's (the shaders' own eq_player test) gets its own
+  // racer's ram_values, and eq_player = itself so the shaders drive it from them
+  if (m_pr && m_pr_override && !ram_override && !m_ram_values.empty() && player[3] > 0.0f)
+  {
+    const std::array<float, 3> pc = {player[0], player[1], player[2]};
+    if (Dist2(pc, anchor.centroid_view) >= player[3] * player[3] * 2.25f)
+    {
+      if (m_pr_frame != m_frame_counter)
+      {
+        UpdateRacers(anchor.time_ms);
+        m_pr_frame = m_frame_counter;
+      }
+      const int r = m_pr_ok ? MatchRacer(anchor.centroid_view, m_pr_match) : -1;
+      const float d = std::sqrt(Dist2({0.0f, 0.0f, 0.0f}, anchor.centroid_view));
+      if (r > 0 && m_racers[r].pass && (m_pr_max_dist <= 0.0f || d <= m_pr_max_dist))
+      {
+        u.ram = m_racers[r].ram;
+        u.player = {anchor.centroid_view[0], anchor.centroid_view[1], anchor.centroid_view[2],
+                    std::max(anchor.radius_view, 1e-3f)};
+        if (m_trace)
+        {
+          m_trace--;
+          std::fprintf(stderr, "EQTRACE f=%llu t=%u override %s racer=%d anchor=(%.2f %.2f %.2f) ram=(%.2f %.2f %.2f %.0f)\n",
+                       static_cast<unsigned long long>(s_global_frame), anchor.time_ms, m_name.c_str(), r,
+                       anchor.centroid_view[0], anchor.centroid_view[1], anchor.centroid_view[2], u.ram[0], u.ram[1],
+                       u.ram[2], u.ram[3]);
+        }
+      }
+    }
+  }
+  u.scene_size = scene_size;
+  u.depth_size = depth_size;
+  {
+    const auto& vs = g_gfx->GetStoredViewportAndScissor();
+    u.depth_range = {vs.viewport_near_depth, vs.viewport_far_depth, 0.0f, 0.0f};
+  }
+  u.target_far = {target.far_view[0], target.far_view[1], target.far_view[2],
+                  target.far_view[2] != 0.0f ? 1.0f : 0.0f};
+  u.racer = racer_override ? *racer_override : std::array<float, 4>{};
+  // lit16: 64 hull surface samples of the anchor (a cluster: every part of the machine), converted to the model space
+  // of the anchor's main part (eq_matrix) so a sample index stays on the same spot of the hull from frame to frame
+  u.surf_info = {};
+  if (!anchor.surf.empty() && anchor.model_valid)
+  {
+    const auto& P = anchor.position_matrix;
+    // inverse of the 3x3 part (rotation x scale) + translation
+    const float a00 = P[0], a01 = P[1], a02 = P[2], a10 = P[4], a11 = P[5], a12 = P[6], a20 = P[8], a21 = P[9],
+                a22 = P[10];
+    const float det = a00 * (a11 * a22 - a12 * a21) - a01 * (a10 * a22 - a12 * a20) + a02 * (a10 * a21 - a11 * a20);
+    if (std::abs(det) > 1e-12f)
+    {
+      const float id = 1.0f / det;
+      const float I[9] = {(a11 * a22 - a12 * a21) * id, (a02 * a21 - a01 * a22) * id, (a01 * a12 - a02 * a11) * id,
+                          (a12 * a20 - a10 * a22) * id, (a00 * a22 - a02 * a20) * id, (a02 * a10 - a00 * a12) * id,
+                          (a10 * a21 - a11 * a20) * id, (a01 * a20 - a00 * a21) * id, (a00 * a11 - a01 * a10) * id};
+      const size_t n = anchor.surf.size();
+      const size_t k = std::min<size_t>(n, 64);
+      bool normals = false;
+      for (size_t i = 0; i < k; i++)
+      {
+        const auto& sp = anchor.surf[(i * n) / k];
+        const float d[3] = {sp[0] - P[3], sp[1] - P[7], sp[2] - P[11]};
+        std::array<float, 4> mp{}, mn{};
+        for (int r = 0; r < 3; r++)
+        {
+          mp[r] = I[r * 3] * d[0] + I[r * 3 + 1] * d[1] + I[r * 3 + 2] * d[2];
+          // normals: by the transpose of the forward matrix (rotation x uniform scale), then normalised
+          mn[r] = P[r] * sp[4] + P[4 + r] * sp[5] + P[8 + r] * sp[6];
+        }
+        mp[3] = 1.0f;
+        const float l = std::sqrt(mn[0] * mn[0] + mn[1] * mn[1] + mn[2] * mn[2]);
+        if (sp[7] > 0.5f && l > 1e-6f)
+        {
+          mn = {mn[0] / l, mn[1] / l, mn[2] / l, 1.0f};
+          normals = true;
+        }
+        else
+          mn = {};
+        u.surf_pos[i] = mp;
+        u.surf_normal[i] = mn;
+      }
+      u.surf_info = {static_cast<float>(k), normals ? 1.0f : 0.0f, 0.0f, 0.0f};
+    }
+  }
+  // lit17: the machine's damage hits (per_racer: its racer; classic path: the player when anchored on the player slot)
+  {
+    int dr = -1;
+    if (racer_override && (*racer_override)[2] > 0.5f)
+      dr = static_cast<int>((*racer_override)[0] + 0.5f);
+    else if (!m_anchor_from.empty() && m_anchor_from == DmPlayerSlot())
+      dr = 0;
+    DmFillEmit(dr, u);
+    HxFillEmit(dr, u);  // lit17c
+  }
+
+  // Previous frame: the nearest anchor of this action (view space), for motion direction.
+  FrameAnchor current;
+  current.centroid_view = {anchor.centroid_view[0], anchor.centroid_view[1],
+                           anchor.centroid_view[2], 1.0f};
+  current.screen = {anchor.screen_centre[0], anchor.screen_centre[1],
+                    anchor.screen_box[2] - anchor.screen_box[0],
+                    anchor.screen_box[3] - anchor.screen_box[1]};
+  u.screen_centre = {anchor.screen_centre[0], anchor.screen_centre[1], anchor.screen_centre[0],
+                     anchor.screen_centre[1]};
+  u.prev_anchor = {anchor.centroid_view[0], anchor.centroid_view[1], anchor.centroid_view[2], 0.0f};
+  float best = std::max(anchor.radius_view * 8.0f, 1e-3f);
+  best *= best;
+  for (const FrameAnchor& prev : m_prev_frame)
+  {
+    const float dx = prev.centroid_view[0] - anchor.centroid_view[0];
+    const float dy = prev.centroid_view[1] - anchor.centroid_view[1];
+    const float dz = prev.centroid_view[2] - anchor.centroid_view[2];
+    const float d2 = dx * dx + dy * dy + dz * dz;
+    if (d2 < best)
+    {
+      best = d2;
+      u.prev_anchor = {prev.centroid_view[0], prev.centroid_view[1], prev.centroid_view[2], 1.0f};
+      u.screen_centre[2] = prev.screen[0];
+      u.screen_centre[3] = prev.screen[1];
+    }
+  }
+  m_this_frame.push_back(current);
+
+  g_vertex_manager->UploadUtilityUniforms(&u, sizeof(u));  // also invalidates the GX constants
+  g_gfx->SetPipeline(pipeline);
+  g_gfx->SetTexture(0, texture);
+  g_gfx->SetSamplerState(0, RenderState::GetLinearSamplerState());
+  if (scene)
+  {
+    g_gfx->SetTexture(1, scene);
+    g_gfx->SetSamplerState(1, RenderState::GetLinearSamplerState());
+  }
+  if (depth)
+  {
+    g_gfx->SetTexture(2, depth);
+    g_gfx->SetSamplerState(2, RenderState::GetPointSamplerState());
+  }
+  g_gfx->Draw(0, m_quads * 6);
+  // (unit 1 stays bound: VKGfx::SetTexture(i, nullptr) clears unit 0; the next copy transitions the scene texture
+  // with barriers and FinishedRendering() returns it to shader-read before any draw)
+  m_emits_this_frame++;
+}
+
+// ---- Evolution Racing dolphin-lit15: per_racer ----
+
+bool EmitQuadsAction::ResolveChain(const std::vector<u32>& chain, int racer, u32* word_addr) const
+{
+  if (chain.empty())
+    return false;
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const size_t base_len = m_pr_base.size();
+  const bool per = racer >= 0 && chain.size() > base_len &&
+                   std::equal(m_pr_base.begin(), m_pr_base.end(), chain.begin());
+  u32 a = chain[0];
+  for (size_t j = 1; j < chain.size(); j++)
+  {
+    const u8* p = memory.GetPointerForRange(a, 4);
+    if (!p)
+      return false;
+    u32 v;
+    std::memcpy(&v, p, 4);
+    a = Common::swap32(v) + chain[j];
+    if (per && j == base_len)
+      a += static_cast<u32>(racer) * m_pr_stride;
+  }
+  *word_addr = a;
+  return true;
+}
+
+void EmitQuadsAction::ReadRamValuesFor(u32 now, int racer, std::vector<RamValue>& values,
+                                       std::array<float, 8>* out)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  for (size_t i = 0; i < values.size() && i < out->size(); i++)
+  {
+    RamValue& rv = values[i];
+    u32 a = 0, word = 0;
+    bool ok = ResolveChain(rv.chain, racer, &a);
+    if (ok)
+    {
+      const u8* p = memory.GetPointerForRange(a, 4);
+      ok = p != nullptr;
+      if (ok)
+      {
+        std::memcpy(&word, p, 4);
+        word = Common::swap32(word);
+      }
+    }
+    float value = 0.0f;
+    if (ok)
+    {
+      if (rv.f32)
+      {
+        std::memcpy(&value, &word, 4);
+        if (!std::isfinite(value))
+          value = 0.0f;
+      }
+      else
+      {
+        value = static_cast<float>((word & rv.mask) >> rv.shift);
+      }
+    }
+    if (rv.nonzero)
+      value = value != 0.0f ? 1.0f : 0.0f;
+    if (rv.since_on)
+    {
+      const bool on = value != 0.0f;
+      const s32 back = static_cast<s32>(now - rv.on_ms);
+      if (on && (!rv.was_on || back < 0))
+      {
+        rv.on_ms = now;
+        rv.ever_on = true;
+      }
+      rv.was_on = on;
+      (*out)[i] = rv.ever_on ? static_cast<float>(std::max<s32>(static_cast<s32>(now - rv.on_ms), 0)) : 1e6f;
+      continue;
+    }
+    if (rv.rise_ms > 0.0f || rv.fall_ms > 0.0f)
+    {
+      const s32 dt = static_cast<s32>(now - rv.last_ms);
+      if (!rv.have || dt < 0 || dt > 1000)
+      {
+        rv.smooth = value;
+      }
+      else if (dt > 0)
+      {
+        const float tau = value > rv.smooth ? rv.rise_ms : rv.fall_ms;
+        rv.smooth = tau <= 0.0f ? value :
+                                  rv.smooth + (value - rv.smooth) *
+                                                  (1.0f - std::exp(-static_cast<float>(dt) / tau));
+      }
+      if (!rv.have || dt != 0)
+        rv.last_ms = now;
+      rv.have = true;
+      value = rv.smooth;
+    }
+    (*out)[i] = value;
+  }
+}
+
+void EmitQuadsAction::UpdateRacers(u32 now)
+{
+  m_pr_ok = false;
+  if (m_racers.size() != m_pr_count)
+  {
+    m_racers.assign(m_pr_count, RacerState{});
+    for (RacerState& s : m_racers)
+      s.ram_values = m_ram_values;
+  }
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const auto readf = [&](u32 addr, u32 n, float* out) {
+    const u8* p = memory.GetPointerForRange(addr, 4 * n);
+    if (!p)
+      return false;
+    for (u32 i = 0; i < n; i++)
+    {
+      u32 v;
+      std::memcpy(&v, p + 4 * i, 4);
+      v = Common::swap32(v);
+      std::memcpy(&out[i], &v, 4);
+      if (!std::isfinite(out[i]))
+        return false;
+    }
+    return true;
+  };
+  const auto read32 = [&](u32 addr, u32* out) {
+    const u8* p = memory.GetPointerForRange(addr, 4);
+    if (!p)
+      return false;
+    u32 v;
+    std::memcpy(&v, p, 4);
+    *out = Common::swap32(v);
+    return true;
+  };
+  std::vector<u32> pos_chain = m_pr_base;
+  pos_chain.push_back(m_pr_pos);
+  // the camera's view matrix (GX model -> view rows for world-space geometry). The pointer to the camera struct lives
+  // in the main REL's data, which moves when a disc patches the REL (stock 0x8037586c, the AllStar disc 0x8037582c):
+  // the "view" chain is only the first guess; the slot that really holds it is found by a RAM scan (validated against
+  // the player's own machine: racer 0's position must land on the player's "car" cluster) and cached for all actions.
+  float V[12];
+  if (!FindViewMatrix(pos_chain, V))
+    return;
+  for (u32 r = 0; r < m_pr_count; r++)
+  {
+    RacerState& s = m_racers[r];
+    u32 a = 0;
+    float p[3];
+    s.valid = ResolveChain(pos_chain, static_cast<int>(r), &a) && readf(a, 3, p);
+    if (s.valid)
+    {
+      float v[3] = {0.0f, 0.0f, 0.0f};
+      if (s.have_last)
+      {
+        for (int i = 0; i < 3; i++)
+          v[i] = p[i] - s.last_world[i];
+        if (v[0] * v[0] + v[1] * v[1] + v[2] * v[2] > 30.0f * 30.0f)  // a respawn / state load
+          v[0] = v[1] = v[2] = 0.0f;
+      }
+      s.last_world = {p[0], p[1], p[2]};
+      s.have_last = true;
+      const auto xf = [&](const float* w, std::array<float, 3>* out) {
+        for (int i = 0; i < 3; i++)
+          (*out)[i] = V[i * 4] * w[0] + V[i * 4 + 1] * w[1] + V[i * 4 + 2] * w[2] + V[i * 4 + 3];
+      };
+      const float pa[3] = {p[0] + v[0], p[1] + v[1], p[2] + v[2]};
+      const float pb[3] = {p[0] - v[0], p[1] - v[1], p[2] - v[2]};
+      xf(p, &s.view);
+      xf(pa, &s.view_ahead);
+      xf(pb, &s.view_behind);
+      if (const u8* mp = memory.GetPointerForRange(a - m_pr_pos + m_pr_machine, 1))
+        s.machine = *mp;
+    }
+  }
+  // "gate" slot: each cluster of the slot (last complete frame) belongs to its nearest racer
+  std::vector<bool> near(m_pr_count, false);
+  if (!m_gate.empty())
+  {
+    const auto it = s_slots.find(m_gate);
+    if (it != s_slots.end())
+    {
+      const auto& list = it->second.prev.empty() ? it->second.cur : it->second.prev;
+      for (const AnchorCluster& c : list)
+      {
+        const int r = MatchRacer(c.a.centroid_view, c.a.radius_view + m_pr_slot_pad);
+        if (r >= 0)
+          near[r] = true;
+      }
+    }
+  }
+  for (u32 r = 0; r < m_pr_count; r++)
+  {
+    RacerState& s = m_racers[r];
+    s.pass = false;
+    if (!s.valid)
+      continue;
+    if (!m_ram_values.empty())
+      ReadRamValuesFor(now, static_cast<int>(r), s.ram_values, &s.ram);
+    bool pass = true;
+    std::array<float, 4> gate = {1e9f, 1e9f, 0.0f, 0.0f};
+    if (!m_ram_chain.empty() && m_ram_mask != 0)
+    {
+      u32 a = 0, word = 0;
+      const bool ok = ResolveChain(m_ram_chain, static_cast<int>(r), &a) && read32(a, &word);
+      bool and_ok = true;
+      if (!m_ram_and_chain.empty())
+      {
+        u32 a2 = 0, w2 = 0;
+        and_ok = ResolveChain(m_ram_and_chain, static_cast<int>(r), &a2) && read32(a2, &w2) &&
+                 (w2 & m_ram_and_mask) != 0;
+      }
+      if (!m_ram_not_chain.empty())
+      {
+        u32 a3 = 0, w3 = 0;
+        if (ResolveChain(m_ram_not_chain, static_cast<int>(r), &a3) && read32(a3, &w3) && (w3 & m_ram_not_mask) != 0)
+          and_ok = false;
+      }
+      if (m_ram_edge)
+      {
+        const u32 w = word & m_ram_mask;
+        if (ok && s.ram_have_prev && w > s.ram_prev && and_ok)
+        {
+          s.ram_run_start_ms = now;
+          s.ram_last_ms = now;
+          s.ram_seen = true;
+        }
+        if (ok)
+        {
+          s.ram_prev = w;
+          s.ram_have_prev = true;
+        }
+        const s32 run = static_cast<s32>(now - s.ram_run_start_ms);
+        if (!s.ram_seen || run < 0 || static_cast<float>(run) > m_gate_within_ms)
+          pass = false;
+        else
+          gate = {0.0f, static_cast<float>(run), static_cast<float>(run), 1.0f};
+      }
+      else
+      {
+        if (ok && and_ok && (word & m_ram_mask) != 0)
+        {
+          const s32 since_last = static_cast<s32>(now - s.ram_last_ms);
+          if (!s.ram_seen || since_last < 0 || static_cast<float>(since_last) > m_gate_within_ms)
+            s.ram_run_start_ms = now;
+          s.ram_seen = true;
+          s.ram_last_ms = now;
+        }
+        const s32 since = static_cast<s32>(now - s.ram_last_ms);
+        if (!s.ram_seen || since < 0 || static_cast<float>(since) > m_gate_within_ms)
+        {
+          pass = false;
+        }
+        else
+        {
+          gate = {static_cast<float>(since),
+                  static_cast<float>(std::max<s32>(static_cast<s32>(now - s.ram_run_start_ms), 0)),
+                  static_cast<float>(std::max<s32>(static_cast<s32>(s.ram_last_ms - s.ram_run_start_ms), 0)),
+                  1.0f};
+          if (m_ram_value_f32 && ok)
+          {
+            float f;
+            std::memcpy(&f, &word, 4);
+            gate[2] = std::isfinite(f) ? f : 0.0f;
+            gate[3] = 2.0f;
+          }
+        }
+      }
+    }
+    if (!m_speed_chain.empty())
+    {
+      u32 a = 0;
+      float pos[3];
+      if (ResolveChain(m_speed_chain, static_cast<int>(r), &a) && readf(a, 3, pos))
+      {
+        const std::array<float, 3> p3 = {pos[0], pos[1], pos[2]};
+        const s32 dt = static_cast<s32>(now - s.speed_last_ms);
+        if (s.speed_have_last && dt >= 12 && dt < 500)
+        {
+          const float d = std::sqrt(Dist2(p3, s.speed_last_pos));
+          const float sp = d / static_cast<float>(dt) * (m_speed_scale * 1000.0f / 60.0f);
+          if (sp < 5000.0f)
+            s.speed_smooth = s.speed_smooth * 0.75f + sp * 0.25f;
+          s.speed_last_pos = p3;
+          s.speed_last_ms = now;
+        }
+        else if (!s.speed_have_last || dt < 0 || dt >= 500)
+        {
+          s.speed_last_pos = p3;
+          s.speed_last_ms = now;
+          s.speed_have_last = true;
+        }
+      }
+      if (s.speed_smooth < m_speed_min)
+      {
+        s.speed_above = false;
+        pass = false;
+      }
+      else
+      {
+        if (!s.speed_above)
+          s.speed_since_ms = now;
+        s.speed_above = true;
+        const float ramp = std::clamp((s.speed_smooth - m_speed_min) / std::max(m_speed_full - m_speed_min, 1.0f),
+                                      0.0f, 1.0f);
+        gate = {s.speed_smooth, static_cast<float>(std::max<s32>(static_cast<s32>(now - s.speed_since_ms), 0)),
+                ramp, 1.0f};
+      }
+    }
+    if (!m_gate.empty())
+    {
+      if (near[r])
+      {
+        const s32 gap = static_cast<s32>(now - s.slot_last_ms);
+        if (!s.slot_seen || gap < 0 || static_cast<float>(gap) > m_pr_slot_gap_ms)
+          s.slot_run_start_ms = now;
+        s.slot_seen = true;
+        s.slot_last_ms = now;
+      }
+      const s32 since = static_cast<s32>(now - s.slot_last_ms);
+      if (!s.slot_seen || since < 0 || static_cast<float>(since) > m_gate_within_ms)
+      {
+        pass = false;
+      }
+      else
+      {
+        gate = {static_cast<float>(since),
+                static_cast<float>(std::max<s32>(static_cast<s32>(now - s.slot_run_start_ms), 0)),
+                static_cast<float>(std::max<s32>(static_cast<s32>(s.slot_last_ms - s.slot_run_start_ms), 0)),
+                1.0f};
+      }
+    }
+    s.pass = pass;
+    s.gate = gate;
+  }
+  m_pr_ok = true;
+}
+
+namespace
+{
+u32 s_view_slot = 0;       // RAM word holding the camera struct pointer (0 = not found yet)
+u64 s_view_scan_frame = 0;
+bool s_view_scanned = false;
+}  // namespace
+
+bool EmitQuadsAction::FindViewMatrix(const std::vector<u32>& pos_chain, float* V)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const u32 off = m_pr_view.size() >= 2 ? m_pr_view.back() : 0xdc;
+  const auto rd32 = [&](u32 addr, u32* out) {
+    const u8* p = memory.GetPointerForRange(addr, 4);
+    if (!p)
+      return false;
+    u32 v;
+    std::memcpy(&v, p, 4);
+    *out = Common::swap32(v);
+    return true;
+  };
+  const auto rdf = [&](u32 addr, u32 n, float* out) {
+    const u8* p = memory.GetPointerForRange(addr, 4 * n);
+    if (!p)
+      return false;
+    for (u32 i = 0; i < n; i++)
+    {
+      u32 v;
+      std::memcpy(&v, p + 4 * i, 4);
+      v = Common::swap32(v);
+      std::memcpy(&out[i], &v, 4);
+      if (!std::isfinite(out[i]))
+        return false;
+    }
+    return true;
+  };
+  u32 pa = 0;
+  float p0[3];
+  if (!ResolveChain(pos_chain, 0, &pa) || !rdf(pa, 3, p0))
+    return false;
+  // the player's machine: the largest cluster of the "car" slot (last complete frame)
+  bool have_c = false;
+  std::array<float, 3> pc{};
+  if (const auto it = s_slots.find("car"); it != s_slots.end())
+  {
+    const auto& list = it->second.prev.empty() ? it->second.cur : it->second.prev;
+    float best = -1.0f;
+    for (const AnchorCluster& c : list)
+    {
+      const float area = (c.a.screen_box[2] - c.a.screen_box[0]) * (c.a.screen_box[3] - c.a.screen_box[1]);
+      if (area > best)
+      {
+        best = area;
+        pc = c.a.centroid_view;
+        have_c = true;
+      }
+    }
+  }
+  // < 0: not a view matrix of this camera; else the distance of the player's machine from its cluster
+  bool use_c = have_c;
+  const auto score = [&](const float* M) {
+    for (int i = 0; i < 3; i++)
+    {
+      for (int j = 0; j < 3; j++)
+      {
+        const float d = M[i * 4] * M[j * 4] + M[i * 4 + 1] * M[j * 4 + 1] + M[i * 4 + 2] * M[j * 4 + 2];
+        if (std::abs(d - (i == j ? 1.0f : 0.0f)) > 0.02f)
+          return -1.0f;
+      }
+    }
+    std::array<float, 3> v;
+    for (int i = 0; i < 3; i++)
+      v[i] = M[i * 4] * p0[0] + M[i * 4 + 1] * p0[1] + M[i * 4 + 2] * p0[2] + M[i * 4 + 3];
+    if (v[2] > -1.0f || v[2] < -80.0f || std::abs(v[0]) > 25.0f || std::abs(v[1]) > 25.0f)
+      return -1.0f;
+    if (!use_c)
+      return 0.0f;
+    const float d = std::sqrt(Dist2(v, pc));
+    return d <= 6.0f ? d : -1.0f;
+  };
+  const auto from_slot = [&](u32 slot, float* M) {
+    u32 ptr = 0;
+    return slot != 0 && rd32(slot, &ptr) && ptr >= 0x80000000u && ptr < 0x81800000u && rdf(ptr + off, 12, M) &&
+           score(M) >= 0.0f;
+  };
+  // the slot once found: only "a view matrix with the player in front" each frame (the cluster test, frame-skewed
+  // against a fresh RAM read, failed now and then and blanked every CPU effect for that frame)
+  use_c = false;
+  if (from_slot(s_view_slot, V))
+    return true;
+  use_c = have_c;
+  if (m_pr_view.size() == 2 && from_slot(m_pr_view[0], V))
+  {
+    s_view_slot = m_pr_view[0];
+    return true;
+  }
+  // scan (needs the player's cluster to tell the race camera from other matrices), at most once a second
+  if (!have_c || (s_view_scanned && s_global_frame - s_view_scan_frame < 60))
+    return false;
+  s_view_scanned = true;
+  s_view_scan_frame = s_global_frame;
+  constexpr u32 lo = 0x80300000u, hi = 0x80600000u;
+  const u8* base = memory.GetPointerForRange(lo, hi - lo);
+  if (!base)
+    return false;
+  float best = 1e9f;
+  u32 best_slot = 0;
+  float M[12];
+  for (u32 o = 0; o < hi - lo; o += 4)
+  {
+    u32 ptr;
+    std::memcpy(&ptr, base + o, 4);
+    ptr = Common::swap32(ptr);
+    if (ptr < 0x80000000u || ptr >= 0x81800000u - off - 48)
+      continue;
+    if (!rdf(ptr + off, 12, M))
+      continue;
+    const float sc = score(M);
+    if (sc >= 0.0f && sc < best)
+    {
+      best = sc;
+      best_slot = lo + o;
+    }
+  }
+  NOTICE_LOG_FMT(VIDEO, "emit_quads per_racer: camera pointer slot {:08x} (player {:.2f} m off its cluster)", best_slot,
+                 best);
+  std::fprintf(stderr, "EQTRACE per_racer camera slot %08x (%.2f m)\n", best_slot, best);
+  if (best_slot == 0)
+    return false;
+  s_view_slot = best_slot;
+  return from_slot(s_view_slot, V);
+}
+
+int EmitQuadsAction::MatchRacer(const std::array<float, 3>& view, float max_dist) const
+{
+  int best = -1;
+  float best_d2 = max_dist * max_dist;
+  for (size_t r = 0; r < m_racers.size(); r++)
+  {
+    if (!m_racers[r].valid)
+      continue;
+    const float d2 = std::min({Dist2(view, m_racers[r].view), Dist2(view, m_racers[r].view_ahead),
+                               Dist2(view, m_racers[r].view_behind)});
+    if (d2 <= best_d2)
+    {
+      best_d2 = d2;
+      best = static_cast<int>(r);
+    }
+  }
+  return best;
+}
+
+void EmitQuadsAction::EmitPerRacer(const EmitQuadsAnchor& target)
+{
+  const u32 now = target.time_ms;
+  if (m_pr_frame != m_frame_counter)
+  {
+    UpdateRacers(now);
+    m_pr_frame = m_frame_counter;
+  }
+  if (m_trace && (m_frame_counter % 60) == 0)
+  {
+    const auto si = s_slots.find(m_anchor_from);
+    int valid = 0, pass = 0;
+    for (const RacerState& r : m_racers)
+    {
+      valid += r.valid;
+      pass += r.pass;
+    }
+    std::fprintf(stderr, "EQTRACE per_racer status ok=%d racers=%zu valid=%d pass=%d slot=%s clusters=%zu/%zu r0=(%.2f %.2f %.2f)\n",
+                 m_pr_ok, m_racers.size(), valid, pass, m_anchor_from.c_str(),
+                 si == s_slots.end() ? 0 : si->second.cur.size(), si == s_slots.end() ? 0 : si->second.prev.size(),
+                 m_racers.empty() ? 0.0f : m_racers[0].view[0], m_racers.empty() ? 0.0f : m_racers[0].view[1],
+                 m_racers.empty() ? 0.0f : m_racers[0].view[2]);
+    if (si != s_slots.end())
+    {
+      for (const AnchorCluster& c : si->second.cur)
+      {
+        const int r = MatchRacer(c.a.centroid_view, 1e9f);
+        std::fprintf(stderr, "EQTRACE   cluster (%.1f %.1f %.1f) r=%.2f draws=%u -> racer %d at %.2f m pass=%d\n",
+                     c.a.centroid_view[0], c.a.centroid_view[1], c.a.centroid_view[2], c.a.radius_view, c.draws, r,
+                     r < 0 ? -1.0f : std::sqrt(std::min({Dist2(c.a.centroid_view, m_racers[r].view),
+                                                         Dist2(c.a.centroid_view, m_racers[r].view_ahead),
+                                                         Dist2(c.a.centroid_view, m_racers[r].view_behind)})),
+                     r < 0 ? 0 : m_racers[r].pass);
+      }
+    }
+  }
+  m_pr_calls++;
+  if (!m_pr_ok || m_anchor_from.empty())
+    return;
+  const auto it = s_slots.find(m_anchor_from);
+  if (it == s_slots.end())
+    return;
+  const auto& list = (!m_anchor_prev_frame && !it->second.cur.empty()) ? it->second.cur : it->second.prev;
+  std::vector<std::pair<float, const AnchorCluster*>> picks;
+  if (m_pick_all)
+  {
+    for (const AnchorCluster& c : list)
+      picks.emplace_back(Dist2({0.0f, 0.0f, 0.0f}, c.a.centroid_view), &c);
+    std::sort(picks.begin(), picks.end(),
+              [](const auto& x, const auto& y) { return x.first < y.first; });
+  }
+  else
+  {
+    const AnchorCluster* pick = nullptr;
+    float best = 1e30f;
+    for (const AnchorCluster& c : list)
+    {
+      const float d = Dist2(c.a.centroid_view, target.centroid_view);
+      if (d < best)
+      {
+        best = d;
+        pick = &c;
+      }
+    }
+    if (pick)
+      picks.emplace_back(Dist2({0.0f, 0.0f, 0.0f}, pick->a.centroid_view), pick);
+  }
+  for (const auto& [d2, c] : picks)
+  {
+    const int r = (c->racer >= 0 && c->racer < static_cast<int>(m_racers.size())) ? c->racer :
+                                                                                     MatchRacer(c->a.centroid_view, m_pr_match);
+    if (r >= 0 && m_racers[r].emitted_frame == m_frame_counter)
+      continue;  // one emit per racer and frame (other trigger draws of this frame see it again)
+    m_pr_count_frame[0]++;
+    if (m_emits_this_frame >= m_max_emits_per_frame)
+    {
+      m_pr_count_frame[7]++;
+      continue;
+    }
+    if (m_pr_max_dist > 0.0f && d2 > m_pr_max_dist * m_pr_max_dist)
+    {
+      m_pr_count_frame[6]++;
+      continue;
+    }
+    if (r < 0 || r == 0 || !m_racers[r].pass)
+    {  // racer 0 = the player: the classic features own it
+      m_pr_count_frame[r < 0 ? 2 : r == 0 ? 3 : 5]++;
+      continue;
+    }
+    bool done = false;  // racer-keyed clusters: the racer check above is the dedupe (two machines can be closer
+    if (c->racer < 0)   // than half a radius on screen)
+    {
+      for (const auto& e : m_emitted_clusters)
+      {
+        const std::array<float, 3> p = {e[0], e[1], e[2]};
+        if (Dist2(p, c->a.centroid_view) <= e[3] * e[3] * 0.25f)
+          done = true;
+      }
+    }
+    if (done)
+    {
+      m_pr_count_frame[4]++;
+      continue;
+    }
+    m_pr_count_frame[1]++;
+    if (m_pr_calls > 1)
+      m_pr_late_emits++;
+    m_emitted_clusters.push_back({c->a.centroid_view[0], c->a.centroid_view[1], c->a.centroid_view[2],
+                                  c->a.radius_view});
+    m_racers[r].emitted_frame = m_frame_counter;
+    EmitQuadsAnchor anchor = target;
+    anchor.centroid_view = c->a.centroid_view;
+    anchor.radius_view = c->a.radius_view;
+    anchor.min_view = c->a.min_view;
+    anchor.max_view = c->a.max_view;
+    anchor.screen_box = c->a.screen_box;
+    anchor.screen_centre = c->a.screen_centre;
+    anchor.position_matrix = c->a.position_matrix;
+    anchor.model_min = c->a.model_min;
+    anchor.model_max = c->a.model_max;
+    anchor.model_valid = c->a.model_valid;
+    anchor.sampled_vertices = c->a.sampled_vertices;
+    anchor.surf = c->a.surf;  // lit16
+    const std::array<float, 4> player = {anchor.centroid_view[0], anchor.centroid_view[1],
+                                         anchor.centroid_view[2], std::max(anchor.radius_view, 1e-3f)};
+    if (m_trace)
+    {
+      m_trace--;
+      std::fprintf(stderr,
+                   "EQTRACE f=%llu t=%u per_racer %s racer=%d anchor=(%.2f %.2f %.2f) r=%.2f racer_view=(%.2f %.2f "
+                   "%.2f) gate=(%.0f %.0f %.2f %.0f) ram0=%.3f model=[%.3f %.3f %.3f .. %.3f %.3f %.3f]\n",
+                   static_cast<unsigned long long>(s_global_frame), now, m_name.c_str(), r, anchor.centroid_view[0],
+                   anchor.centroid_view[1], anchor.centroid_view[2], anchor.radius_view, m_racers[r].view[0],
+                   m_racers[r].view[1], m_racers[r].view[2], m_racers[r].gate[0], m_racers[r].gate[1],
+                   m_racers[r].gate[2], m_racers[r].gate[3], m_racers[r].ram[0], anchor.model_min[0],
+                   anchor.model_min[1], anchor.model_min[2], anchor.model_max[0], anchor.model_max[1],
+                   anchor.model_max[2]);
+    }
+    const std::array<float, 4> racer = {static_cast<float>(r), static_cast<float>(m_racers[r].machine), 1.0f, 0.0f};
+    {
+      RacerState& s = m_racers[r];
+      s.have_anchor = true;
+      s.anchor_frame = m_frame_counter;
+      s.anchor_racer_view = s.view;
+      s.anchor_centroid = anchor.centroid_view;
+      s.anchor_radius = anchor.radius_view;
+      s.anchor_screen_box = anchor.screen_box;
+      s.anchor_screen_centre = anchor.screen_centre;
+      s.anchor_matrix = anchor.position_matrix;
+      s.anchor_model_min = anchor.model_min;
+      s.anchor_model_max = anchor.model_max;
+      s.anchor_min_view = anchor.min_view;
+      s.anchor_max_view = anchor.max_view;
+      s.anchor_model_valid = anchor.model_valid;
+      s.anchor_surf = anchor.surf;  // lit16
+    }
+    DrawEmit(target, anchor, m_racers[r].gate, &m_racers[r].ram, &player, &racer);
+  }
+  // hold: racers whose machine was emitted on within the last m_pr_hold frames but has no cluster yet this frame get
+  // their last anchor, moved by the racer's own view-space motion since then (only "all" picks: once per frame, at the
+  // last trigger draws the list is as complete as it gets - a machine drawn later still wins: it is emitted first
+  // only if its cluster exists by then)
+  if (m_pick_all && m_pr_hold > 0)
+  {
+    for (size_t r = 1; r < m_racers.size(); r++)
+    {
+      RacerState& s = m_racers[r];
+      if (!s.valid || !s.pass || !s.have_anchor || s.emitted_frame == m_frame_counter)
+        continue;
+      const u32 age = m_frame_counter - s.anchor_frame;
+      if (age == 0 || age > m_pr_hold || m_emits_this_frame >= m_max_emits_per_frame)
+        continue;
+      // a cluster of this racer may still come with a later trigger draw this frame: hold only from the frame's
+      // last trigger is not known here, so the held emit marks the racer done (one emit per racer and frame)
+      std::array<float, 3> d;
+      for (int i = 0; i < 3; i++)
+        d[i] = s.view[i] - s.anchor_racer_view[i];
+      EmitQuadsAnchor anchor = target;
+      for (int i = 0; i < 3; i++)
+      {
+        anchor.centroid_view[i] = s.anchor_centroid[i] + d[i];
+        anchor.min_view[i] = s.anchor_min_view[i] + d[i];
+        anchor.max_view[i] = s.anchor_max_view[i] + d[i];
+      }
+      anchor.radius_view = s.anchor_radius;
+      anchor.screen_box = s.anchor_screen_box;
+      anchor.screen_centre = s.anchor_screen_centre;
+      anchor.position_matrix = s.anchor_matrix;
+      for (int i = 0; i < 3; i++)
+        anchor.position_matrix[i * 4 + 3] += d[i];
+      anchor.model_min = s.anchor_model_min;
+      anchor.model_max = s.anchor_model_max;
+      anchor.model_valid = s.anchor_model_valid;
+      anchor.surf = s.anchor_surf;  // lit16: moved with the racer like the matrix
+      for (auto& p : anchor.surf)
+      {
+        for (int i = 0; i < 3; i++)
+          p[i] += d[i];
+      }
+      if (m_pr_max_dist > 0.0f && Dist2({0.0f, 0.0f, 0.0f}, anchor.centroid_view) > m_pr_max_dist * m_pr_max_dist)
+        continue;
+      s.emitted_frame = m_frame_counter;
+      const std::array<float, 4> player = {anchor.centroid_view[0], anchor.centroid_view[1], anchor.centroid_view[2],
+                                           std::max(anchor.radius_view, 1e-3f)};
+      const std::array<float, 4> racer = {static_cast<float>(r), static_cast<float>(s.machine), 1.0f, 0.0f};
+      if (m_trace)
+      {
+        m_trace--;
+        std::fprintf(stderr, "EQTRACE f=%llu t=%u per_racer %s racer=%zu anchor=(%.2f %.2f %.2f) r=%.2f held=%u\n",
+                     static_cast<unsigned long long>(s_global_frame), now, m_name.c_str(), r, anchor.centroid_view[0],
+                     anchor.centroid_view[1], anchor.centroid_view[2], anchor.radius_view, age);
+      }
+      DrawEmit(target, anchor, s.gate, &s.ram, &player, &racer);
+    }
+  }
+}
