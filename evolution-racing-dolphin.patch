+void MainWindow::StartERTest(const std::string& arg)
+{
+  std::vector<std::string> dirs;
+  const QString dl = QStandardPaths::writableLocation(QStandardPaths::DownloadLocation);
+  if (!dl.isEmpty())
+    dirs.push_back(dl.toStdString());
+  const std::string home_dl = QDir::homePath().toStdString() + "/Downloads";
+  if (dirs.empty() || dirs[0] != home_dl)
+    dirs.push_back(home_dl);
+  ERTest::SetDownloadDirs(std::move(dirs));
+  ERTest::Begin(arg);
+  auto* timer = new QTimer(this);
+  connect(timer, &QTimer::timeout, this, [this] {
+    std::string message;
+    auto boot = ERTest::Poll(&message);
+    if (!message.empty())
+    {
+      if (Core::IsRunning(m_system))
+        Core::DisplayMessage("Test in game: " + message, 8000);
+      else
+        setWindowTitle(QStringLiteral("Test in game: ") + QString::fromStdString(message));
+    }
+    if (!boot)
+      return;
+    raise();
+    activateWindow();
+    if (!Core::IsUninitialized(m_system) && ERTest::SwapInto(m_system, boot))
+      return;  // the running game took it (new disc + save state): no stop, no new renderer
+    if (!Core::IsUninitialized(m_system))
+    {
+      // the previous test closes, the new one boots when it is down (OnStopComplete)
+      m_pending_boot = std::move(boot);
+      ForceStop();
+      return;
+    }
+    StartGame(std::move(boot));
+  });
+  timer->start(250);
+}
