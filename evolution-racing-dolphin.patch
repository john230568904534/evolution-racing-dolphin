+void WriteMetadata()
+{
+  // every graphics mod's metadata.json from its metadata.json.in for where this folder is now (the start scripts do
+  // the same at every start; forward slashes are valid on Windows too)
+  std::string u = Strip(UserDir());
+  std::replace(u.begin(), u.end(), '\\', '/');
+  std::string esc;
+  for (char c : u)
+    esc += c == '"' ? std::string("\\\"") : std::string(1, c);
+  const std::string gm = UserDir() + "Load/GraphicMods/";
+  std::error_code ec;
+  for (const auto& e : fs::directory_iterator(P(gm), ec))
+  {
+    const std::string in = S(e.path() / "metadata.json.in");
+    std::string t;
+    if (!File::ReadFileToString(in, t))
+      continue;
+    size_t pos = 0;
+    while ((pos = t.find("@USERDIR@", pos)) != std::string::npos)
+    {
+      t.replace(pos, 9, esc);
+      pos += esc.size();
+    }
+    File::WriteStringToFile(S(e.path() / "metadata.json"), t);
+  }
+}
