+const AbstractTexture* EmitQuadsAction::CopyScene(std::array<float, 4>* size)
+{
+  if (PC5090Prof::ShareCopies())
+  {
+    AbstractTexture* efb = g_framebuffer_manager->GetEFBColorTexture();
+    if (!efb)
+      return nullptr;
+    const u32 w = efb->GetWidth(), h = efb->GetHeight();
+    if (!s_share_scene || s_share_scene->GetWidth() != w || s_share_scene->GetHeight() != h ||
+        s_share_scene->GetFormat() != efb->GetFormat())
+    {
+      s_share_scene = g_gfx->CreateTexture(TextureConfig(w, h, 1, 1, 1, efb->GetFormat(), 0,
+                                                         AbstractTextureType::Texture_2DArray),
+                                           "emit_quads shared scene copy");
+      s_share_scene_frame = ~0ull;
+      if (!s_share_scene)
+        return nullptr;
+    }
+    if (s_share_scene_frame != s_global_frame)
+    {
+      const MathUtil::Rectangle<int> rect(0, 0, static_cast<int>(w), static_cast<int>(h));
+      AbstractTexture* src = g_framebuffer_manager->ResolveEFBColorTexture(rect);
+      if (!src)
+        return nullptr;
+      s_share_scene->CopyRectangleFromTexture(src, rect, 0, 0, rect, 0, 0);
+      s_share_scene->FinishedRendering();
+      s_share_scene_frame = s_global_frame;
+      if (PC5090Prof::Enabled())
+        PC5090Prof::Add(PC5090Prof::SceneCopies, 1);
+    }
+    *size = {static_cast<float>(w), static_cast<float>(h), 1.0f / static_cast<float>(w),
+             1.0f / static_cast<float>(h)};
+    return s_share_scene.get();
+  }
+  AbstractTexture* efb = g_framebuffer_manager->GetEFBColorTexture();
+  if (!efb)
+    return nullptr;
+  const u32 w = efb->GetWidth(), h = efb->GetHeight();
+  if (!m_scene || m_scene->GetWidth() != w || m_scene->GetHeight() != h ||
+      m_scene->GetFormat() != efb->GetFormat())
+  {
+    m_scene.reset();
+    m_scene = g_gfx->CreateTexture(TextureConfig(w, h, 1, 1, 1, efb->GetFormat(), 0,
+                                                 AbstractTextureType::Texture_2DArray),
+                                   "emit_quads scene copy");
+    m_scene_frame = 0xffffffffu;
+    if (!m_scene)
+      return nullptr;
+  }
+  if (m_scene_frame != m_frame_counter && !PC5090Prof::NoCopyShare() && s_xs_scene.tex &&
+      (PC5090Prof::StageScene() ? (s_xs_scene.stage == PC5090Prof::g_stage && s_xs_scene.game == PC5090Prof::g_game_gen) : s_xs_scene.gen == PC5090Prof::g_scene_gen) && s_xs_scene.frame == s_global_frame && s_xs_scene.w == w &&
+      s_xs_scene.h == h && s_xs_scene.fmt == efb->GetFormat())
+  {
+    // lit17s14m: another action copied the EFB colour at this very generation: the same pixels, no copy
+    m_scene_alias = s_xs_scene.tex;
+    m_scene_frame = m_frame_counter;
+  }
+  if (m_scene_frame != m_frame_counter)
+  {
+    FlushHalfRes();  // lit17s21: queued half-res effects belong in the picture this copy takes
+    m_scene_alias = nullptr;
+    const MathUtil::Rectangle<int> rect(0, 0, static_cast<int>(w), static_cast<int>(h));
+    // multisampled EFB: resolved first (returns the EFB itself when it is not multisampled)
+    AbstractTexture* src = g_framebuffer_manager->ResolveEFBColorTexture(rect);
+    if (!src)
+      return nullptr;
+    m_scene->CopyRectangleFromTexture(src, rect, 0, 0, rect, 0, 0);
+    m_scene->FinishedRendering();
+    m_scene_frame = m_frame_counter;
+    if (PC5090Prof::Enabled())
+      PC5090Prof::Add(PC5090Prof::SceneCopies, 1);
+    s_xs_scene = {m_scene.get(), PC5090Prof::g_scene_gen, s_global_frame, PC5090Prof::g_stage, PC5090Prof::g_game_gen, w, h, efb->GetFormat()};
+  }
+  *size = {static_cast<float>(w), static_cast<float>(h), 1.0f / static_cast<float>(w),
+           1.0f / static_cast<float>(h)};
+  return m_scene_alias ? m_scene_alias : m_scene.get();
+}
