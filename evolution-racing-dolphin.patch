+namespace
+{
+s64 NowS()
+{
+  return std::chrono::duration_cast<std::chrono::seconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+QString Q(const std::string& s)
+{
+  return QString::fromStdString(s);
+}
+
+std::string Host(const std::string& hub)
+{
+  std::string h = hub.substr(hub.find("://") == std::string::npos ? 0 : hub.find("://") + 3);
+  return h.substr(0, h.find('/'));
+}
+}  // namespace
+
+void MainWindow::ERNote(const std::string& text)
+{
+  if (const char* td = std::getenv("ER_UPDATES_TEST"); td && *td)  // the harness proofs only (ERUpdatesUI.cpp)
+  {
+    File::IOFile f(std::string(td) + "/notes.txt", "ab");
+    f.WriteString(text + "\n");
+  }
+  if (!Core::IsUninitialized(m_system))
+  {
+    Core::DisplayMessage("Ghosts: " + text, 9000);
+    return;
+  }
+  auto* box = new QMessageBox(QMessageBox::Information, tr("Evolution Racing ghosts"), Q(text),
+                              QMessageBox::Ok, this);
+  box->setAttribute(Qt::WA_DeleteOnClose);
+  box->setWindowModality(Qt::NonModal);
+  box->show();
+}
+
+void MainWindow::InitERGhosts(const std::string& arg)
+{
+  ERGhosts::ForwardIfRunning("");  // this Dolphin takes the user folder's lock: later evoracing:// links come here
+  m_er_ghost_timer = new QTimer(this);
+  connect(m_er_ghost_timer, &QTimer::timeout, this, &MainWindow::ERGhostTick);
+  m_er_ghost_timer->start(3000);
+  ERGhostProbe(false);
+  if (!arg.empty())
+    QTimer::singleShot(400, this, [this, arg] { ERGhostArg(arg); });
+}
+
+void MainWindow::ERGhostProbe(bool fetch)
+{
+  // the per-frame run telemetry reads what the hub's probe names; ghosts Off or no link: nothing is read
+  const ERGhosts::Settings s = ERGhosts::Load();
+  const bool on = s.mode != ERGhosts::Mode::Off && !s.token.empty() && !s.offline;  // Play offline: nothing read or sent
+  std::string text;
+  if (!ERGhosts::HasProbe() && File::ReadFileToString(ERGhosts::Dir() + "probe.json", text))
+    ERGhosts::LoadProbe(text);
+  ERGhosts::EnableRecording(on);
+  if (!on || (!fetch && ERGhosts::HasProbe() && !m_er_probe_fetched.empty()))
+    return;
+  if (m_er_probe_fetched == "busy")
+    return;
+  m_er_probe_fetched = "busy";
+  std::thread([this, s] {
+    ERGhosts::Reply r = ERGhosts::GetProbe(s);
+    QueueOnObject(this, [this, r] {
+      m_er_probe_fetched = "done";
+      if (r.ok() && ERGhosts::LoadProbe(r.text))
+        ERGhosts::EnableRecording(true);
+    });
+  }).detach();
+}
+
+void MainWindow::ERGhostBoot(const BootParameters& boot)
+{
+  ERGhostProbe(false);  // run telemetry on / off for this boot (ghosts on + linked)
+}
+
+void MainWindow::ERGhostExtras(const ERGhosts::Ghost& g)
+{
+  // the full-rate telemetry of the run this ghost came from (ERGhosts::OnFrame): the hub checks it and shows the replay
+  std::vector<u8> tele = ERGhosts::TakeRunFor(g.frames);
+  if (tele.empty())
+    return;
+  const ERGhosts::Settings s = ERGhosts::Load();
+  std::thread([this, s, sha = g.sha1, tele = std::move(tele)] {
+    ERGhosts::Reply r = ERGhosts::UploadExtra(s, sha, "tele", tele);
+    const std::string note = r.ok() ? "" : "the run's telemetry was not taken: " + r.error;
+    QueueOnObject(this, [this, note] {
+      if (!note.empty())
+        ERNote(note + ".");
+    });
+  }).detach();
+}
+
+void MainWindow::ERGhostTick()
+{
+  for (const std::string& a : ERGhosts::TakeForwarded())
+    ERGhostArg(a);
+  const s64 now = NowS();
+  if (!Core::IsUninitialized(m_system))
+    m_er_last_running = now;
+  // the game writes ghosts while it runs (and the card folder is flushed when it stops): look only then
+  if (m_er_last_running == 0 || now - m_er_last_running > 60)
+    return;
+  const ERGhosts::Settings s = ERGhosts::Load();
+  if (s.mode == ERGhosts::Mode::Off)
+    return;  // Off costs nothing: no folder is read
+  if (s.offline)
+  {
+    // Play offline: a ghost saved now stays on this PC; only "Upload saved ghosts now" sends it later
+    for (ERGhosts::Ghost& g : ERGhosts::TakeNew())
+    {
+      ERGhosts::MarkDone(g.sha1, "offline");
+      ERNote("ghost saved (" + g.machine_name + " " + g.time + "). Play offline is on: it stays on this PC.");
+    }
+    return;
+  }
+  for (ERGhosts::Ghost& g : ERGhosts::TakeNew())
+    m_er_queue.push_back(std::move(g));
+  ERGhostNext();
+}
+
+void MainWindow::ERGhostNext()
+{
+  if (m_er_ghost_busy || m_er_queue.empty())
+    return;
+  ERGhosts::Ghost g = std::move(m_er_queue.front());
+  m_er_queue.pop_front();
+  ERGhosts::Settings s = ERGhosts::Load();
+  if (s.offline || (s.mode == ERGhosts::Mode::Off && !m_er_force_send))
+  {
+    m_er_queue.clear();
+    m_er_force_send = false;
+    return;
+  }
+  if (ERTest::Active() || ERGhosts::BootedForTest())
+  {
+    ERGhosts::MarkDone(g.sha1, "test-in-game");
+    ERNote("a ghost saved in Test in game is not sent to the hub (the track may be a draft).");
+    return ERGhostNext();
+  }
+  if (s.token.empty())
+  {
+    if (s.mode == ERGhosts::Mode::Ask && !s.told_unlinked)
+    {
+      s.told_unlinked = true;
+      ERGhosts::Save(s);
+      m_er_ghost_busy = true;
+      auto* box = new QMessageBox(this);
+      box->setAttribute(Qt::WA_DeleteOnClose);
+      box->setWindowModality(Qt::NonModal);
+      box->setWindowTitle(tr("Evolution Racing ghosts"));
+      box->setText(Q(fmt::format("You saved a Time Attack ghost ({} {}).\n\nLink this Dolphin to your Evolution "
+                                 "Racing hub account and your ghosts go onto the tracks' leaderboards. Make a link "
+                                 "code on the hub's Ghosts page, then paste it in Tools > Evolution Racing ghosts.",
+                                 g.machine_name, g.time)));
+      QPushButton* open = box->addButton(tr("Open the Ghosts page"), QMessageBox::AcceptRole);
+      QPushButton* off = box->addButton(tr("Turn ghost upload off"), QMessageBox::DestructiveRole);
+      box->addButton(tr("Later"), QMessageBox::RejectRole);
+      connect(box, &QMessageBox::buttonClicked, this, [this, open, off, hub = s.hub](QAbstractButton* b) {
+        if (b == open)
+          QDesktopServices::openUrl(QUrl(Q(hub + "/hub/ghosts")));
+        if (b == off)
+        {
+          ERGhosts::Settings s2 = ERGhosts::Load();
+          s2.mode = ERGhosts::Mode::Off;
+          ERGhosts::Save(s2);
+        }
+        m_er_ghost_busy = false;
+        ERGhostNext();
+      });
+      box->show();
+      box->raise();
+    }
+    else
+    {
+      ERNote(fmt::format("ghost saved ({} {}). Link this Dolphin (Tools > Evolution Racing ghosts) to send "
+                         "your ghosts to the hub.",
+                         g.machine_name, g.time));
+    }
+    return;  // not marked: once linked, the next start offers it again
+  }
+  ERGhostSend(std::move(g), s.mode == ERGhosts::Mode::Ask && !m_er_force_send);  // "Upload saved ghosts now": no question
+  if (m_er_queue.empty())
+    m_er_force_send = false;
+}
+
+void MainWindow::ERGhostSend(ERGhosts::Ghost g, bool dry)
+{
+  m_er_ghost_busy = true;
+  const ERGhosts::Settings s = ERGhosts::Load();
+  std::thread([this, g = std::move(g), s, dry]() mutable {
+    const std::string coli = ERGhosts::CourseSha1(g.slot);
+    ERGhosts::Reply r = ERGhosts::Upload(s, g, coli, dry);
+    QueueOnObject(this, [this, g = std::move(g), r, dry]() mutable {
+      m_er_ghost_busy = false;
+      ERGhostReply(std::move(g), r, dry);
+      ERGhostNext();
+    });
+  }).detach();
+}
+
+void MainWindow::ERGhostReply(ERGhosts::Ghost g, const ERGhosts::Reply& r, bool dry)
+{
+  const std::string title = ERGhosts::Field(r.text, "title");
+  if (r.status == 401)
+  {
+    ERGhosts::Settings s = ERGhosts::Load();
+    s.token.clear();
+    s.username.clear();
+    ERGhosts::Save(s);
+    ERNote("this Dolphin's link to the hub ended. Make a new link code on the hub's Ghosts page and paste it in "
+           "Tools > Evolution Racing ghosts. Your ghost is kept and offered again then.");
+    return;
+  }
+  const bool final_answer = ERGhosts::Field(r.text, "final") == "true";
+  if (!r.ok() && !final_answer)
+  {
+    // no network, the hub busy or "slow down": try again in a minute (a few times)
+    const int n = ++m_er_retries[g.sha1];
+    if (n <= 5)
+    {
+      ERNote(fmt::format("could not send the ghost yet ({}); trying again in a minute.", r.error));
+      QTimer::singleShot(60000, this, [this, g = std::move(g)]() mutable {
+        m_er_queue.push_back(std::move(g));
+        ERGhostNext();
+      });
+    }
+    else
+    {
+      ERNote("could not send the ghost: " + r.error + ". It is offered again when Dolphin starts next time.");
+    }
+    return;
+  }
+  if (!r.ok())
+  {
+    ERGhosts::MarkDone(g.sha1, "refused");
+    ERNote("the hub did not take the ghost (" + g.machine_name + " " + g.time + "): " + r.error);
+    return;
+  }
+  if (!dry)
+  {
+    ERGhosts::MarkDone(g.sha1, "sent");
+    if (ERGhosts::Field(r.text, "kept") != "true")  // a slower ghost is not the entry: its run is not sent either
+      ERGhostExtras(g);
+    const std::string rank = ERGhosts::Field(r.text, "rank");
+    ERNote(fmt::format("sent to the hub: {} {} {}.{} {}", title, ERGhosts::Field(r.text, "time"), g.machine_name,
+                       rank.empty() ? "" : " Rank " + rank + ".", ERGhosts::Field(r.text, "message")));
+    return;
+  }
+  // Ask: the hub said what would happen; only a new or faster time is worth a question
+  const std::string would = ERGhosts::Field(r.text, "would"), best = ERGhosts::Field(r.text, "best");
+  if (would == "slower" || would == "removed")
+  {
+    ERGhosts::MarkDone(g.sha1, would);
+    ERNote(would == "slower" ?
+               fmt::format("{} {} on {} is not faster than your best ({}): not sent.", g.machine_name,
+                           g.time, title, best) :
+               fmt::format("Unreal took your time on {} off the leaderboard: not sent.", title));
+    return;
+  }
+  m_er_ghost_busy = true;
+  auto* box = new QMessageBox(this);
+  box->setAttribute(Qt::WA_DeleteOnClose);
+  box->setWindowModality(Qt::NonModal);
+  box->setWindowTitle(tr("Evolution Racing ghosts"));
+  box->setText(Q(fmt::format("Send this ghost to the hub's leaderboard?\n\n{}\n{} - {}\nYour best there: {}",
+                             title, ERGhosts::Field(r.text, "time"), g.machine_name,
+                             best.empty() ? "none yet" : best)));
+  QPushButton* send = box->addButton(tr("Send"), QMessageBox::AcceptRole);
+  QPushButton* always = box->addButton(tr("Always send (Auto)"), QMessageBox::AcceptRole);
+  QPushButton* no = box->addButton(tr("Not this one"), QMessageBox::RejectRole);
+  QPushButton* off = box->addButton(tr("Never (Off)"), QMessageBox::DestructiveRole);
+  connect(box, &QMessageBox::buttonClicked, this,
+          [this, send, always, no, off, g = std::move(g)](QAbstractButton* b) mutable {
+            m_er_ghost_busy = false;
+            if (b == always || b == off)
+            {
+              ERGhosts::Settings s = ERGhosts::Load();
+              s.mode = b == always ? ERGhosts::Mode::Auto : ERGhosts::Mode::Off;
+              ERGhosts::Save(s);
+            }
+            if (b == send || b == always)
+              return ERGhostSend(std::move(g), false);
+            ERGhosts::MarkDone(g.sha1, b == off ? "off" : "declined");
+            if (b == no || b == off)
+              ERGhostNext();
+          });
+  box->show();
+  box->raise();
+  if (!Core::IsUninitialized(m_system))
+    Core::DisplayMessage("Ghosts: send your ghost to the hub? Answer in the Dolphin window.", 8000);
+}
+
+void MainWindow::ERGhostArg(const std::string& arg)
+{
+  if (ERUpdateArg(arg))  // evoracing://update, link ...&then=update, restart; and nothing at all while Play offline is on
+    return;
+  raise();
+  activateWindow();
+  ERGhosts::Settings s = ERGhosts::Load();
+  std::string code, hub;
+  if (arg.find("link/") != std::string::npos && ERGhosts::ParseLink(arg, &code, &hub))
+  {
+    if (hub.empty())
+      hub = s.hub;
+    while (!hub.empty() && hub.back() == '/')
+      hub.pop_back();
+    if (!ERGhosts::HubAllowed(hub))
+      return ERNote("that link points to an address this Dolphin does not send ghosts to: " + hub);
+    if (ModalMessageBox::question(this, tr("Evolution Racing ghosts"),
+                                  Q(fmt::format("Link this Dolphin to your hub account on {}?\n\nYour Time Attack "
+                                                "ghosts will go to that hub's leaderboards.",
+                                                Host(hub)))) != QMessageBox::Yes)
+      return;
+    return ERGhostLink(code, hub);
+  }
+  std::string what;
+  if (arg.find("ghost/") != std::string::npos && ERGhosts::ParseGhost(arg, &what))
+  {
+    if (s.token.empty())
+      return ERNote("link this Dolphin first (Tools > Evolution Racing ghosts), then press Install ghost again.");
+    std::thread([this, s, what] {
+      std::vector<u8> bytes;
+      ERGhosts::Reply r = ERGhosts::Fetch(s, what, &bytes);
+      QueueOnObject(this, [this, r, bytes] {
+        std::string msg;
+        if (r.status != 200)
+          msg = "could not get the ghost: " + r.error;
+        else
+          ERGhosts::Install(bytes, &msg);
+        ERNote(msg);
+      });
+    }).detach();
+    return;
+  }
+  ERNote("this link is not one this Dolphin knows: " + arg.substr(0, 80));
+}
+
+void MainWindow::ERGhostLink(const std::string& code, const std::string& hub)
+{
+  ERGhosts::Settings s = ERGhosts::Load();
+  s.token = code;
+  s.hub = hub;
+  std::thread([this, s] {
+    ERGhosts::Reply r = ERGhosts::Hello(s);
+    QueueOnObject(this, [this, s, r]() mutable {
+      if (!r.ok())
+        return ERNote("linking did not work: " + r.error);
+      s.username = ERGhosts::Field(r.text, "username");
+      s.told_unlinked = false;
+      ERGhosts::Save(s);
+      ERGhostProbe(true);
+      ERNote(fmt::format("linked to the hub as {}. Ghosts you save in Time Attack: {} (change it in Tools > "
+                         "Evolution Racing ghosts).",
+                         s.username,
+                         s.mode == ERGhosts::Mode::Auto ? "sent automatically" :
+                         s.mode == ERGhosts::Mode::Ask  ? "Dolphin asks before it sends each one" :
+                                                          "not sent (Off)"));
+      emit ERGhostsChanged();
+    });
+  }).detach();
+}
