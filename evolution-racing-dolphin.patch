+    XXH3_64bits_update(&hs, key, sizeof(key));
+    XXH3_64bits_update(&hs, source.data(), source.size());
+    const std::string dir = File::GetUserPath(D_SHADERCACHE_IDX) + "pc5090-spv/";
+    spv_cache_file = fmt::format("{}{:016x}.spv", dir, XXH3_64bits_digest(&hs));
+    File::IOFile f(spv_cache_file, "rb");
+    const u64 n = f.IsOpen() ? f.GetSize() : 0;
+    if (n >= 20 && n % sizeof(u32) == 0)
+    {
+      SPIRV::CodeVector cached(n / sizeof(u32));
+      if (f.ReadArray(cached.data(), cached.size()) && cached[0] == 0x07230203u)  // SPIR-V magic
+        return cached;
+    }
+    if (!File::IsDirectory(dir))
+      File::CreateFullPath(dir);
+  }
+  auto spv_result = CompileShaderToSPVUncached(stage, api_type, language_version, stage_filename, source, shader_includer);
+  if (spv_result && !spv_cache_file.empty())
+  {
+    const std::string tmp = spv_cache_file + ".tmp";
+    {
+      File::IOFile f(tmp, "wb");
+      if (f.IsOpen())
+        f.WriteArray(spv_result->data(), spv_result->size());
+    }
+    File::Rename(tmp, spv_cache_file);
+  }
+  return spv_result;
+}
