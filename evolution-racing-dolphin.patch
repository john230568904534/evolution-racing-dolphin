+// GFX.ini [PC5090] LightningStrikes (tier), LightningStrikeEvery, NeonMonsoon - re-read every 30 frames
+void LsReadIni()
+{
+  if (s_ls.cfg_frame != ~0ull && s_global_frame - s_ls.cfg_frame < 30 && s_global_frame >= s_ls.cfg_frame)
+    return;
+  s_ls.cfg_frame = s_global_frame;
+  const std::string t = LsIni("LightningStrikes", "On");
+  int tier = 2;
+  if (t == "off" || t == "0" || t == "no" || t == "false")
+    tier = 0;
+  else if (t == "standard" || t == "low" || t == "1")
+    tier = 1;
+  else if (t == "high" || t == "ultra" || t == "2")
+    tier = 2;
+  else
+    tier = WeatherUltra() ? 2 : 1;
+  const std::string mo = LsIni("NeonMonsoon", "Off");
+  const bool monsoon = (mo == "on" || mo == "1" || mo == "yes" || mo == "true");
+  float every = s_lscfg.every;
+  const std::string e = LsIni("LightningStrikeEvery", "");
+  if (!e.empty())
+  {
+    char* end = nullptr;
+    const double d = std::strtod(e.c_str(), &end);
+    if (end != e.c_str() && std::isfinite(d) && d >= 2.0)
+      every = static_cast<float>(std::min(d, 3600.0));
+  }
+  if (tier != s_ls.tier || monsoon != s_ls.monsoon || every != s_ls.every)
+    std::fprintf(stderr, "LIGHTNING tier %s, every %.0f s, Neon Monsoon %s (GFX.ini [PC5090])\n",
+                 tier == 0 ? "Off" : (tier == 1 ? "Standard" : "High"), every, monsoon ? "On" : "Off");
+  s_ls.tier = tier;
+  s_ls.monsoon = monsoon;
+  s_ls.every = every;
