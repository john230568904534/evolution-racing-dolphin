+void BuildMips(ScImage* img)
+{
+  while (img->mips.size() < 14)
+  {
+    const u32 w = std::max(img->w >> (img->mips.size() - 1), 1u), h = std::max(img->h >> (img->mips.size() - 1), 1u);
+    if (w == 1 && h == 1)
+      break;
+    const u32 nw = std::max(w / 2, 1u), nh = std::max(h / 2, 1u);
+    const auto& src = img->mips.back();
+    std::vector<u8> dst(static_cast<size_t>(nw) * nh * 4);
+    for (u32 y = 0; y < nh; y++)
+      for (u32 x = 0; x < nw; x++)
+        for (u32 c = 0; c < 4; c++)
+        {
+          const u32 x0 = std::min(x * 2, w - 1), x1 = std::min(x * 2 + 1, w - 1);
+          const u32 y0 = std::min(y * 2, h - 1), y1 = std::min(y * 2 + 1, h - 1);
+          const u32 s = src[(static_cast<size_t>(y0) * w + x0) * 4 + c] + src[(static_cast<size_t>(y0) * w + x1) * 4 + c] +
+                        src[(static_cast<size_t>(y1) * w + x0) * 4 + c] + src[(static_cast<size_t>(y1) * w + x1) * 4 + c];
+          dst[(static_cast<size_t>(y) * nw + x) * 4 + c] = static_cast<u8>((s + 2) / 4);
+        }
+    img->mips.push_back(std::move(dst));
+  }
+}
