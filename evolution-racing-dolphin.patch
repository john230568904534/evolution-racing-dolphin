+struct DmConfig
+{
+  std::string player_slot = "car";
+  std::string cpu_slot = "cpucar";
+  std::vector<u32> base{0x800030C8u, 0x227878u};
+  u32 stride = 0x620, count = 30;
+  u32 off_state = 0x0, off_energy = 0x184, off_pos = 0x7c, off_surface = 0x218;
+  u32 boost_mask = 0x20, dash_mask = 0x00200000, contact_mask = 0x02000000;
+  u32 hit_mask = 0x00800000;  // the game's own collision bit (wall / machine): required for a hit while boosting
+  u32 pit_mask = 0x08000000, zone_mask = 0x02000000;
+  u32 clock_addr = 0x803799a4;
+  // Evolution Racing lit17sg: the race scene word (e.g. [0x803527A0] & 0xFFFF0000 == 0x000A0000 on the AllStar disc). Set:
+  // outside the race every racer's damage is cleared and machine draws get no damage / surface block (menus show the
+  // machines clean: machine select, machine settings), so a new race always starts clean too. 0 = no gate.
+  u32 scene_addr = 0;
+  u32 scene_mask = 0xFFFF0000u;   // lit17s4: the race-scene defaults (as HxConfig): a config with only an address works
+  u32 scene_value = 0x000A0000u;
+  // lit17s4: "scene_chain": [A, O1, ...] (read *A, add O1, ... read), wins over scene_addr: the scene word is main-REL
+  // data and moves with the REL's load address, [0x800030C8, 0x197DE0] finds it on every disc
+  std::vector<u32> scene_chain;
+  float min_drop = 0.12f;    // energy (of 100) lost in one frame beyond the boost cost that counts as an impact
+  float full_drop = 5.0f;    // energy lost by a strength-1 impact
+  float jerk_min = 0.05f;    // world units / frame^2: a sudden push sideways / backwards (not forwards: boost, dash)
+  float contact_drop = 0.6f; // strength of a contact-bit impact with no energy loss, in energy units
+  float heal_s = 1.4f;       // seconds of charging that repair a hit completely
+  float heat_s = 7.0f;       // heat (smoke amount) half-life in seconds
+  float merge = 0.9f;        // a new hit within merge x radius of an old one deepens that one
+  float radius = 0.13f, radius_k = 0.07f;              // dent radius: machine size x (radius + radius_k x sqrt(strength))
+  float depth = 0.018f, depth_k = 0.022f, depth_max = 0.075f;  // dent depth: machine size x min(depth + depth_k x s, max)
+  float cpu_scale = 1.0f;    // CPU strength factor
+  u32 trace = 0;
+};
