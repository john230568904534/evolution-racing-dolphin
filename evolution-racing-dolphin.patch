+// ---- one zip: the entries (name, size), then unpack the chosen ones (CRC checked by minizip on every entry)
+struct Zip
+{
+  void* r = nullptr;
+  std::vector<std::pair<std::string, u64>> entries;
+  std::string error;
+  explicit Zip(const std::string& path)
+  {
+    r = mz_zip_reader_create();
+    if (!r || mz_zip_reader_open_file(r, path.c_str()) != MZ_OK)
+    {
+      error = "the download is not a complete zip (no central directory): download it again";
+      return;
+    }
+    if (mz_zip_reader_goto_first_entry(r) != MZ_OK)
+    {
+      error = "the zip is empty";
+      return;
+    }
+    do
+    {
+      mz_zip_file* info = nullptr;
+      if (mz_zip_reader_entry_get_info(r, &info) != MZ_OK || !info || !info->filename)
+      {
+        error = "the zip's directory is damaged";
+        return;
+      }
+      entries.emplace_back(info->filename, info->uncompressed_size);
+    } while (mz_zip_reader_goto_next_entry(r) == MZ_OK);
+  }
+  ~Zip()
+  {
+    if (r)
+    {
+      mz_zip_reader_close(r);
+      mz_zip_reader_delete(&r);
+    }
+  }
+  bool Read(const std::string& name, std::string* out)
+  {
+    if (mz_zip_reader_locate_entry(r, name.c_str(), 0) != MZ_OK)
+      return false;
+    mz_zip_file* info = nullptr;
+    if (mz_zip_reader_entry_get_info(r, &info) != MZ_OK || info->uncompressed_size > (16 << 20))
+      return false;
+    out->resize(info->uncompressed_size);
+    if (mz_zip_reader_entry_open(r) != MZ_OK)
+      return false;
+    Common::ScopeGuard g{[&] { mz_zip_reader_entry_close(r); }};
+    s64 done = 0;
+    while (done < static_cast<s64>(out->size()))
+    {
+      const s32 n = mz_zip_reader_entry_read(r, out->data() + done, static_cast<s32>(std::min<s64>(1 << 20, out->size() - done)));
+      if (n <= 0)
+        return false;
+      done += n;
+    }
+    return true;
+  }
+  // unpack every entry ok(name) says yes to under dest (name -> dest + strip(name)); returns how many, -1 on error
+  int Extract(const std::function<bool(const std::string&)>& ok, const std::function<std::string(const std::string&)>& to,
+              std::vector<std::string>* written)
+  {
+    int n = 0;
+    if (mz_zip_reader_goto_first_entry(r) != MZ_OK)
+      return -1;
+    do
+    {
+      mz_zip_file* info = nullptr;
+      if (mz_zip_reader_entry_get_info(r, &info) != MZ_OK)
+        return -1;
+      const std::string name = info->filename;
+      if (name.empty() || name.back() == '/' || !ok(name))
+        continue;
+      const std::string dest = to(name);
+      File::CreateFullPath(dest);
+      if (mz_zip_reader_entry_save_file(r, dest.c_str()) != MZ_OK)
+      {
+        error = "could not unpack " + name + " (damaged download, or the disk is full)";
+        return -1;
+      }
+      if (static_cast<s64>(File::GetSize(dest)) != info->uncompressed_size)
+      {
+        error = "unpacked size of " + name + " is wrong";
+        return -1;
+      }
+      if (written)
+        written->push_back(dest);
+      ++n;
+    } while (mz_zip_reader_goto_next_entry(r) == MZ_OK);
+    return n;
+  }
+};
