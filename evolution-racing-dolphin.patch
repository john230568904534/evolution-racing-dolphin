+std::string Field(const std::string& json, const std::string& key)
+{
+  picojson::value v;
+  if (!picojson::parse(v, json).empty() || !v.is<picojson::object>())
+    return {};
+  const auto& o = v.get<picojson::object>();
+  const auto it = o.find(key);
+  if (it == o.end() || it->second.is<picojson::null>())
+    return {};
+  if (it->second.is<std::string>())
+    return it->second.get<std::string>();
+  if (it->second.is<double>())
+    return fmt::format("{}", static_cast<long long>(it->second.get<double>()));
+  if (it->second.is<bool>())
+    return it->second.get<bool>() ? "true" : "false";
+  return it->second.serialize();
+}
