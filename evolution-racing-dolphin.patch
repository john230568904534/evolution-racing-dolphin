+  float test_ahead = 0.0f, test_side = 0.0f;  // TESTS: tornado #0 moved test_ahead m down the lap from the player
+  float band[4][2] = {{170.0f, 260.0f}, {420.0f, 700.0f}, {800.0f, 1250.0f}, {1100.0f, 1600.0f}};
+  // ft3d-move
+  bool move = false;
+  float spd_lo = 22.0f, spd_hi = 40.0f, keep = 75.0f, close_keep = 48.0f, close_lo = 35.0f, close_hi = 70.0f;
+  float roam = 900.0f, close_first = 0.0f, close_spd = 45.0f;
+};
+FtCfg s_ftcfg;
+struct FtState
+{
+  u64 frame = ~0ull;
+  bool active = false;
+  u32 key_hdr = 0, key_slot = 0xFFFFFFFFu, key_rel = 0;
+  bool placed = false;
+  bool test_done = false;
+  u64 tried_frame = ~0ull;
