+std::vector<Ghost> TakeOffline()
+{
+  // the ledger's last word per ghost; "offline" = saved while Play offline was on, never sent since
+  std::string text;
+  File::ReadFileToString(LedgerPath(), text);
+  std::map<std::string, std::string> last;
+  for (const std::string& line : SplitString(text, '\n'))
+  {
+    if (line.size() < 42 || line[40] != ' ')
+      continue;
+    const std::string rest = line.substr(41);
+    last[line.substr(0, 40)] = rest.substr(0, rest.find(' '));
+  }
+  std::vector<Ghost> out;
+  const std::string folder = GciFolder();
+  if (!File::IsDirectory(folder))
+    return out;
+  for (const std::string& path : Common::DoFileSearch(folder, ".gci", false))
+  {
+    std::string raw;
+    if (!File::ReadFileToString(path, raw))
+      continue;
+    Ghost g;
+    g.data.assign(raw.begin(), raw.end());
+    g.path = path;
+    if (!Check(g.data, &g).empty())
+      continue;
+    const auto it = last.find(g.sha1);
+    if (it != last.end() && it->second == "offline")
+      out.push_back(std::move(g));
+  }
+  return out;
+}
