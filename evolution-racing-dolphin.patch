+// Evolution Racing emit-quads hook: view-space centroid / AABB / radius and the NDC bounding box of the
+// batch's vertices (at most 128 sampled, so a big draw costs no more than a small one). Reads the
+// converted vertices just before they are committed; they sit right below vertex_end.
+static EmitQuadsAnchor ComputeEmitQuadsAnchor(const u8* vertex_end, u32 num_vertices,
+                                              const NativeVertexFormat* format,
+                                              VertexShaderManager& vertex_shader_manager)
+{
+  EmitQuadsAnchor anchor;
+  if (!format || num_vertices == 0)
+    return anchor;
+  const PortableVertexDeclaration& decl = format->GetVertexDeclaration();
+  if (!decl.position.enable || decl.position.type != ComponentFormat::Float || decl.stride <= 0 ||
+      decl.position.components < 2)
+  {
+    return anchor;
+  }
+  const u32 stride = static_cast<u32>(decl.stride);
+  const u8* start = vertex_end - static_cast<size_t>(num_vertices) * stride;
+  const u32 step = std::max(1u, num_vertices / 128);
+  const u32 default_mtx = g_main_cp_state.matrix_index_a.PosNormalMtxIdx & 0x3f;
+  const int components = std::min(decl.position.components, 3);
