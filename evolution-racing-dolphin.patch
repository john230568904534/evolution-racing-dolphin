+namespace
+{
+std::unique_ptr<AbstractTexture> ScTexture(const ScImage& img, const char* name)
+{
+  if (img.mips.empty())
+    return nullptr;
+  auto t = g_gfx->CreateTexture(TextureConfig(img.w, img.h, static_cast<u32>(img.mips.size()), 1, 1,
+                                              AbstractTextureFormat::RGBA8, 0, AbstractTextureType::Texture_2DArray),
+                                name);
+  if (!t)
+    return nullptr;
+  for (u32 l = 0; l < img.mips.size(); l++)
+  {
+    const u32 w = std::max(img.w >> l, 1u), h = std::max(img.h >> l, 1u);
+    t->Load(l, w, h, w, img.mips[l].data(), img.mips[l].size());
+  }
+  return t;
+}
+std::unique_ptr<AbstractTexture> ScSolid(u32 rgba)
+{
+  auto t = g_gfx->CreateTexture(
+      TextureConfig(1, 1, 1, 1, 1, AbstractTextureFormat::RGBA8, 0, AbstractTextureType::Texture_2DArray), "scenery 1x1");
+  if (t)
+    t->Load(0, 1, 1, 1, reinterpret_cast<const u8*>(&rgba), 4);
+  return t;
+}
