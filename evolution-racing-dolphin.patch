+// Evolution Racing emit-quads hook: view-space centroid / AABB / radius and the NDC bounding box of the
+// batch's vertices (at most 128 sampled, so a big draw costs no more than a small one). Reads the
+// converted vertices just before they are committed; they sit right below vertex_end.
+static EmitQuadsAnchor ComputeEmitQuadsAnchor(const u8* vertex_end, u32 num_vertices,
+                                              const NativeVertexFormat* format,
+                                              VertexShaderManager& vertex_shader_manager)
+{
+  EmitQuadsAnchor anchor;
+  if (!format || num_vertices == 0)
+    return anchor;
+  const PortableVertexDeclaration& decl = format->GetVertexDeclaration();
+  if (!decl.position.enable || decl.position.type != ComponentFormat::Float || decl.stride <= 0 ||
+      decl.position.components < 2)
+  {
+    return anchor;
+  }
+  const u32 stride = static_cast<u32>(decl.stride);
+  const u8* start = vertex_end - static_cast<size_t>(num_vertices) * stride;
+  const u32 step = std::max(1u, num_vertices / 128);
+  const u32 default_mtx = g_main_cp_state.matrix_index_a.PosNormalMtxIdx & 0x3f;
+  const int components = std::min(decl.position.components, 3);
+
+  std::array<float, 3> sum{};
+  std::array<float, 3> vmin{1e30f, 1e30f, 1e30f};
+  std::array<float, 3> vmax{-1e30f, -1e30f, -1e30f};
+  std::array<float, 4> box{1e30f, 1e30f, -1e30f, -1e30f};
+  bool any_on_screen = false;
+  std::vector<std::array<float, 3>> views;
+  views.reserve(129);
+  u32 first_mtx = 0;
+  std::array<float, 3> mmin{1e30f, 1e30f, 1e30f};
+  std::array<float, 3> mmax{-1e30f, -1e30f, -1e30f};
+  for (u32 v = 0; v < num_vertices; v += step)
+  {
+    const u8* vtx = start + static_cast<size_t>(v) * stride;
+    float pos[3] = {0.0f, 0.0f, 0.0f};
+    std::memcpy(pos, vtx + decl.position.offset, sizeof(float) * components);
+    u32 mtx = default_mtx;
+    if (decl.posmtx.enable)
+      mtx = vtx[decl.posmtx.offset] & 0x3f;  // the loaders write the row index as a u32 (LE)
+    const float* m = &xfmem.posMatrices[mtx * 4];
+    const std::array<float, 3> view = {
+        pos[0] * m[0] + pos[1] * m[1] + pos[2] * m[2] + m[3],
+        pos[0] * m[4] + pos[1] * m[5] + pos[2] * m[6] + m[7],
+        pos[0] * m[8] + pos[1] * m[9] + pos[2] * m[10] + m[11]};
+    if (!std::isfinite(view[0]) || !std::isfinite(view[1]) || !std::isfinite(view[2]))
+      continue;
+    if (views.empty())
+    {
+      std::copy(m, m + 12, anchor.position_matrix.begin());
+      first_mtx = mtx;
+    }
+    if (mtx == first_mtx)
+    {
+      for (int i = 0; i < 3; i++)
+      {
+        mmin[i] = std::min(mmin[i], pos[i]);
+        mmax[i] = std::max(mmax[i], pos[i]);
+      }
+    }
+    views.push_back(view);
+    for (int i = 0; i < 3; i++)
+    {
+      sum[i] += view[i];
+      vmin[i] = std::min(vmin[i], view[i]);
+      vmax[i] = std::max(vmax[i], view[i]);
+    }
+    float clip[4];
+    vertex_shader_manager.TransformToClipSpace(pos, clip, mtx);
+    if (clip[3] > 1e-6f)
+    {
+      const float x = clip[0] / clip[3], y = clip[1] / clip[3];
+      box = {std::min(box[0], x), std::min(box[1], y), std::max(box[2], x), std::max(box[3], y)};
+      any_on_screen = true;
+    }
+  }
+  if (views.empty())
+    return anchor;
+
+  const float inv = 1.0f / static_cast<float>(views.size());
+  anchor.centroid_view = {sum[0] * inv, sum[1] * inv, sum[2] * inv};
+  float r2 = 0.0f;
+  for (const auto& view : views)
+  {
+    const float dx = view[0] - anchor.centroid_view[0], dy = view[1] - anchor.centroid_view[1],
+                dz = view[2] - anchor.centroid_view[2];
+    r2 = std::max(r2, dx * dx + dy * dy + dz * dz);
+  }
+  anchor.radius_view = std::sqrt(r2);
+  anchor.min_view = vmin;
+  anchor.max_view = vmax;
+  anchor.sampled_vertices = static_cast<u32>(views.size());
+  // Far end: the mean of the vertices within 15% (of the depth range) of the farthest one, ignoring
+  // vertices at the view origin (collapsed / unused) - e.g. where an exhaust trail leaves its nozzle.
+  {
+    float zfar = 0.0f, znear = -1e30f;
+    bool any = false;
+    for (const auto& v : views)
+    {
+      if (std::abs(v[0]) + std::abs(v[1]) + std::abs(v[2]) <= 1e-4f)
+        continue;
+      zfar = any ? std::min(zfar, v[2]) : v[2];
+      znear = std::max(znear, v[2]);
+      any = true;
+    }
+    if (any)
+    {
+      const float lim = zfar + 0.15f * (znear - zfar) + 1e-5f;
+      std::array<float, 3> acc{};
+      float n = 0.0f;
+      for (const auto& v : views)
+      {
+        if (std::abs(v[0]) + std::abs(v[1]) + std::abs(v[2]) <= 1e-4f || v[2] > lim)
+          continue;
+        for (int i = 0; i < 3; i++)
+          acc[i] += v[i];
+        n += 1.0f;
+      }
+      anchor.far_view = {acc[0] / n, acc[1] / n, acc[2] / n};
+    }
+  }
+  anchor.model_min = mmin;
+  anchor.model_max = mmax;
+  anchor.model_valid = true;
+
+  // Evolution Racing dolphin-lit16: hull surface samples (positions + normals, view space), at most 32 per draw
+  {
+    const bool has_n = decl.normals[0].enable && decl.normals[0].type == ComponentFormat::Float &&
+                       decl.normals[0].components >= 3;
+    const u32 sstep = std::max(1u, num_vertices / 32);
+    anchor.surf.reserve(33);
+    for (u32 v = sstep / 2; v < num_vertices && anchor.surf.size() < 32; v += sstep)
+    {
+      const u8* vtx = start + static_cast<size_t>(v) * stride;
+      float pos[3] = {0.0f, 0.0f, 0.0f};
+      std::memcpy(pos, vtx + decl.position.offset, sizeof(float) * components);
+      u32 mtx = default_mtx;
+      if (decl.posmtx.enable)
+        mtx = vtx[decl.posmtx.offset] & 0x3f;
+      const float* m = &xfmem.posMatrices[mtx * 4];
+      std::array<float, 8> sp{};
+      for (int r = 0; r < 3; r++)
+        sp[r] = pos[0] * m[r * 4] + pos[1] * m[r * 4 + 1] + pos[2] * m[r * 4 + 2] + m[r * 4 + 3];
+      sp[3] = 1.0f;
+      if (!std::isfinite(sp[0]) || !std::isfinite(sp[1]) || !std::isfinite(sp[2]) ||
+          std::abs(sp[0]) + std::abs(sp[1]) + std::abs(sp[2]) <= 1e-4f)
+        continue;
+      if (has_n)
+      {
+        float n[3];
+        std::memcpy(n, vtx + decl.normals[0].offset, sizeof(float) * 3);
+        const float* nm = &xfmem.normalMatrices[3 * (mtx & 31)];
+        float o[3];
+        for (int r = 0; r < 3; r++)
+          o[r] = n[0] * nm[r * 3] + n[1] * nm[r * 3 + 1] + n[2] * nm[r * 3 + 2];
+        const float l = std::sqrt(o[0] * o[0] + o[1] * o[1] + o[2] * o[2]);
+        if (l > 1e-6f && std::isfinite(l))
+          sp = {sp[0], sp[1], sp[2], 1.0f, o[0] / l, o[1] / l, o[2] / l, 1.0f};
+      }
+      anchor.surf.push_back(sp);
+    }
+  }
+
+  const auto& proj = vertex_shader_manager.constants.projection;
+  for (int r = 0; r < 4; r++)
+    anchor.projection_rows[r] = proj[r];
+  const auto row = [&](int r) {
+    return proj[r][0] * anchor.centroid_view[0] + proj[r][1] * anchor.centroid_view[1] +
+           proj[r][2] * anchor.centroid_view[2] + proj[r][3];
+  };
+  const float cw = row(3);
+  if (cw > 1e-6f)
+    anchor.screen_centre = {row(0) / cw, row(1) / cw};
+  else if (any_on_screen)
+    anchor.screen_centre = {(box[0] + box[2]) * 0.5f, (box[1] + box[3]) * 0.5f};
+  if (!any_on_screen)
+    box = {anchor.screen_centre[0], anchor.screen_centre[1], anchor.screen_centre[0],
+           anchor.screen_centre[1]};
+  anchor.screen_box = box;
+  anchor.pixel_center = vertex_shader_manager.constants.pixelcentercorrection;
+  anchor.viewport = {std::abs(xfmem.viewport.wd) * 2.0f, std::abs(xfmem.viewport.ht) * 2.0f};
+  anchor.valid = true;
+  return anchor;
+}
