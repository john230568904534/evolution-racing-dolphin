+// ---- Evolution Racing lit17s41p HD warm-up (see TextureCacheBase.h)
+static std::string WarmFile()
+{
+  return File::GetUserPath(D_CACHE_IDX) + "pc5090-hdwarm.txt";
+}
+
+void TextureCacheBase::HiresWarmRead()
+{
+  if (m_warm_read)
+    return;
+  m_warm_read = true;
+  std::string txt;
+  File::ReadFileToString(WarmFile(), txt);
+  size_t a = 0;
+  while (a < txt.size())
+  {
+    size_t b = txt.find('\n', a);
+    if (b == std::string::npos)
+      b = txt.size();
+    std::string id = txt.substr(a, b - a);
+    if (!id.empty() && id.back() == '\r')
+      id.pop_back();
+    if (!id.empty() && m_warm_known.insert(id).second)
+      m_warm_queue.push_back(std::move(id));
+    a = b + 1;
+  }
+}
+
+void TextureCacheBase::HiresWarmNote(const std::string& id)
+{
+  HiresWarmRead();  // the ids already in the file are not appended again
+  if (!id.empty() && m_warm_known.insert(id).second)
+    m_warm_new.push_back(id);
+  if (m_warm_new.empty() || (!id.empty() && m_warm_new.size() < 64))
+    return;
+  File::IOFile f(WarmFile(), "ab");
+  if (f)
+    for (const auto& s : m_warm_new)
+      f.WriteString(s + "\n");
+  m_warm_new.clear();
+}
+
+void TextureCacheBase::HiresWarmStep(int frame)
+{
+  // ids seen this session go to the file now and then (and at shutdown)
+  if (!m_warm_new.empty() && frame - m_warm_save_frame >= 600)
+  {
+    m_warm_save_frame = frame;
+    HiresWarmNote("");
+  }
+  if (m_warm_state == 2)
+    return;
+  if (m_warm_state == 0)
+  {
+    if (frame < 60 || !g_ActiveConfig.bHiresTextures || m_hires_keep_budget == 0)
+      return;
+    m_warm_state = 1;
+    if (File::Exists(File::GetUserPath(D_USER_IDX) + "pc5090nohdwarm"))
+    {
+      fprintf(stderr, "HDWARM off (pc5090nohdwarm)\n");
+      m_warm_state = 2;
+      return;
+    }
+    HiresWarmRead();
+    fprintf(stderr, "HDWARM %zu HD textures to park (%s)\n", m_warm_queue.size(), WarmFile().c_str());
+  }
+  if (frame < m_warm_next_frame)
+    return;
+  const auto t0 = std::chrono::steady_clock::now();
+  u64 bytes_now = 0;
+  while (m_warm_pos < m_warm_queue.size() && bytes_now < (24ull << 20) &&
+         std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count() < 2.5)
+  {
+    const std::string& id = m_warm_queue[m_warm_pos++];
+    const auto ht = HiresTexture::FindCached(id);
+    if (!ht)
+      continue;
+    const auto data = ht->LoadTexture()->GetData();
+    if (!data)
+    {
+      m_warm_retry.push_back(id);  // still decoding: next pass
+      continue;
+    }
+    if (data->m_slices.empty() || data->m_slices[0].m_levels.empty() || m_hires_keep.count(data.get()))
+      continue;
+    const auto& slice = data->m_slices[0];
+    const auto& first_level = slice.m_levels[0];
+    const u32 levels = static_cast<u32>(slice.m_levels.size());
+    u64 bytes = 0;
+    for (const auto& level : slice.m_levels)
+      bytes += level.data.size();
+    if (m_hires_keep_bytes + bytes > m_hires_keep_budget)
+    {
+      m_warm_pos = m_warm_queue.size();
+      m_warm_retry.clear();
+      fprintf(stderr, "HDWARM keep-alive budget full: stopped\n");
+      break;
+    }
+    const TextureConfig config(first_level.width, first_level.height, levels, 1, 1, first_level.format, 0,
+                               AbstractTextureType::Texture_2DArray);
+    auto tex = g_gfx->CreateTexture(config, "hd warm");
+    if (!tex)
+      continue;
+    for (u32 l = 0; l < levels; l++)
+    {
+      const auto& level = slice.m_levels[l];
+      tex->Load(l, level.width, level.height, level.row_length, level.data.data(), level.data.size());
+    }
+    auto& k = m_hires_keep[data.get()];
+    k.data = data;
+    k.texture = std::move(tex);
+    k.bytes = bytes;
+    k.stamp = ++m_hires_keep_stamp;
+    m_hires_keep_bytes += bytes;
+    bytes_now += bytes;
+    m_warm_count++;
+    m_warm_bytes += bytes;
+  }
+  m_warm_ms += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+  if (m_warm_pos >= m_warm_queue.size())
+  {
+    if (!m_warm_retry.empty() && m_warm_passes < 40)
+    {
+      m_warm_passes++;
+      m_warm_queue.swap(m_warm_retry);
+      m_warm_retry.clear();
+      m_warm_pos = 0;
+      m_warm_next_frame = frame + 30;  // the loader is still decoding: look again in half a second
+      return;
+    }
+    fprintf(stderr, "HDWARM done at frame %d: %u textures parked (%.0f MB, %.0f ms total upload), %zu not loaded\n",
+            frame, m_warm_count, m_warm_bytes / 1048576.0, m_warm_ms, m_warm_retry.size());
+    m_warm_state = 2;
+    std::vector<std::string>().swap(m_warm_queue);
+    std::vector<std::string>().swap(m_warm_retry);
+  }
+}
