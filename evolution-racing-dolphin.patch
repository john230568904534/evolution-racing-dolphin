+
+bool ApplyFastWrites(Core::System& system, Runner& r)
+{
+  const Run& run = *r.run;
+  std::string meta, fst_old;
+  if (!File::ReadFileToString(run.state_meta, meta) ||
+      !File::ReadFileToString(run.state_fst, fst_old))
+    return false;
+  picojson::value v;
+  if (!picojson::parse(v, meta).empty() || !v.is<picojson::object>())
+    return false;
+  const u32 fst_addr = static_cast<u32>(Num(At(v, "fst_addr")));
+  // the state is in when RAM holds its file table
+  if (fst_old.size() != run.fst.size() || fst_addr < 0x80000000 ||
+      fst_addr + fst_old.size() > 0x81800000)
+    return false;
+  std::vector<u8> ram(fst_old.size());
+  system.GetMemory().CopyFromEmu(ram.data(), fst_addr, ram.size());
+  if (std::memcmp(ram.data(), fst_old.data(), ram.size()) != 0)
+    return false;
+  // the main program's fields: only the bytes that differ from the run the state was taken in (the regions also hold
+  // words the game relocated at load time - writing the file's bytes over those crashed the game)
+  std::string old_rel;
+  if (!File::ReadFileToString(run.state_rel, old_rel))
+    return false;
+  // where the main module really is in this state's RAM (the package's addresses assume rel_base)
+  s64 delta = 0;
+  if (run.rel_base && run.rel_head_ptr)
+  {
+    u32 head = 0, id = 0;
+    if (!ReadU32(system, run.rel_head_ptr, &head) || !ReadU32(system, head, &id) || id != run.rel_id)
+    {
+      Status(run.nonce, "note", fmt::format("fast start: main module not found in the state (head {:08x}): full boot", head));
+      return false;
+    }
+    delta = static_cast<s64>(head) - static_cast<s64>(run.rel_base);
+  }
+  size_t pos = 0;
+  std::vector<std::pair<u32, std::vector<u8>>> diffs;
+  size_t wi = 0;
+  for (const auto& [addr, bytes] : run.writes)
+  {
+    const bool ptr = wi < run.write_ptr.size() && run.write_ptr[wi];
+    ++wi;
+    if (pos + 8 > old_rel.size())
+      return false;
+    u32 oaddr, olen;
+    std::memcpy(&oaddr, old_rel.data() + pos, 4);
+    std::memcpy(&olen, old_rel.data() + pos + 4, 4);
+    pos += 8;
+    if (oaddr != addr || olen != bytes.size() || pos + olen > old_rel.size())
+      return false;
+    const u8* o = reinterpret_cast<const u8*>(old_rel.data() + pos);
+    pos += olen;
+    if (ptr)
+    {
+      // pointer words: all of them, each moved by delta (they are what the module loader would have written)
+      std::vector<u8> moved(bytes);
+      for (size_t i = 0; i + 4 <= moved.size(); i += 4)
+      {
+        u32 w;
+        std::memcpy(&w, moved.data() + i, 4);
+        w = Common::swap32(static_cast<u32>(static_cast<s64>(Common::swap32(w)) + delta));
+        std::memcpy(moved.data() + i, &w, 4);
+      }
+      diffs.emplace_back(static_cast<u32>(addr + delta), std::move(moved));
+      continue;
+    }
+    for (size_t i = 0; i < bytes.size();)
+    {
+      if (bytes[i] == o[i])
+      {
+        ++i;
+        continue;
+      }
+      size_t j = i;
+      while (j < bytes.size() && bytes[j] != o[j])
+        ++j;
+      diffs.emplace_back(static_cast<u32>(addr + delta) + static_cast<u32>(i),
+                         std::vector<u8>(bytes.begin() + i, bytes.begin() + j));
+      i = j;
+    }
+  }
+  system.GetMemory().CopyToEmu(fst_addr, run.fst.data(), run.fst.size());
+  for (const auto& [addr, bytes] : diffs)
+    system.GetMemory().CopyToEmu(addr, bytes.data(), bytes.size());
+  Status(run.nonce, "note", fmt::format("fast start: {} main-program field runs changed (main module at {:08x}, {:+x} from the package's)",
+                                        diffs.size(), static_cast<u32>(run.rel_base + delta), delta));
+  return true;
+}
+
+std::string SerializeWrites(const std::vector<std::pair<u32, std::vector<u8>>>& writes)
+{
+  std::string out;
+  for (const auto& [addr, bytes] : writes)
+  {
+    const u32 len = static_cast<u32>(bytes.size());
+    out.append(reinterpret_cast<const char*>(&addr), 4);
+    out.append(reinterpret_cast<const char*>(&len), 4);
+    out.append(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+  }
+  return out;
+}
+
+// one script step per frame; true = the script ended
+bool StepScript(Core::System& system, Runner& r, const std::vector<Step>& script)
+{
+  if (r.step >= script.size())
+    return true;
+  const Step& s = script[r.step];
+  int& f = r.frame_in_step;
+  bool next = false;
+  float lap = 0, dist = 0;
+  switch (s.op)
+  {
+  case Op::Press:
+    s_buttons = f < s.hold ? s.buttons : 0;
+    next = f >= s.hold + s.after;
+    break;
+  case Op::Wait:
+    next = f >= s.after;
+    break;
+  case Op::UntilRace:
+    next = RacerInfo(system, r.run->racer, &lap, &dist) || f >= s.timeout;
+    break;
+  case Op::LeaveDemo:
+  {
+    const bool racing = RacerInfo(system, r.run->racer, &lap, &dist);
+    const int k = s.after > 0 ? f % s.after : 0;
+    s_buttons = racing && k < 6 ? PAD_BUTTON_START : 0;
+    // no race for 30 frames in a row = on the title screen
+    if (!racing && k >= 36)
+      next = true;
+    if (f >= s.timeout)
+    {
+      Finish(r, false, "the attract demo did not end");
+      return true;
+    }
+    break;
+  }
+  case Op::SaveState:
+    if (!r.run->sig.empty() && !r.run->state_path.empty() && f == 0)
+    {
+      // only when RAM holds exactly the table of the booted disc (else the fast start could not repoint it)
+      u32 fst_addr = 0;
+      std::vector<u8> ram(r.run->fst.size());
+      if (r.run->fst_ptr && ReadU32(system, r.run->fst_ptr, &fst_addr) && fst_addr >= 0x80000000 &&
+          fst_addr + ram.size() <= 0x81800000)
+        system.GetMemory().CopyFromEmu(ram.data(), fst_addr, ram.size());
+      if (!ram.empty() && ram == r.run->fst)
+      {
+        auto run = r.run;
+        s_save_done = false;
+        r.waiting_save = true;
+        Core::QueueHostJob([run, fst_addr](Core::System& sys) {
+          State::SaveAs(sys, run->state_path + ".new");
+          picojson::object o;
+          o["fst_addr"] = picojson::value(static_cast<double>(fst_addr));
+          o["sig"] = picojson::value(run->sig);
+          o["dolphin"] = picojson::value(Common::GetScmRevGitStr());
+          o["made"] = picojson::value(static_cast<double>(NowMs()));
+          File::WriteStringToFile(run->state_fst, std::string(run->fst.begin(), run->fst.end()));
+          File::WriteStringToFile(run->state_rel, SerializeWrites(run->writes));
+          File::WriteStringToFile(run->state_meta + ".new", picojson::value(o).serialize(true));
+          s_save_done = true;
+        });
+      }
+      else
+      {
+        Status(r.run->nonce, "note", "no fast start this time: the file table in RAM is not the disc's");
+      }
+    }
+    next = !r.waiting_save || (s_save_done && f > 2) || f > 600;
+    if (next)
+      r.waiting_save = false;
+    break;
+  case Op::StartLine:
+    if (RacerInfo(system, r.run->racer, &lap, &dist) && dist > -r.run->racer.start_window &&
+        dist < r.run->racer.start_window)
+    {
+      next = true;
+      Status(r.run->nonce, "start_line",
+             fmt::format("on the start line, lap {:.0f} m ({} frames in {:.1f} s since the cup select)", lap,
+                         r.frames2, (NowMs() - r.t2) / 1000.0),
+             r.run->t_request);
+    }
+    else if (f >= s.timeout)
+    {
+      Finish(r, false, "the race did not start (menus out of step?) - close Dolphin and press Test in game again");
+      return true;
+    }
+    break;
+  case Op::Throttle:
+    s_unthrottled = s.after == 0;
+    next = true;
+    break;
+  case Op::UntilSet:
+  {
+    u32 v = 0;
+    next = (ReadU32(system, s.addr, &v) && v != 0) || f >= s.timeout;
+    if (next)
+      Status(r.run->nonce, "countdown", f >= s.timeout ? "no countdown seen" : "the countdown runs",
+             r.run->t_request);
+    break;
+  }
+  }
+  ++f;
+  if (next)
+  {
+    s_buttons = 0;
+    ++r.step;
+    f = 0;
+  }
+  return r.step >= script.size();
+}
