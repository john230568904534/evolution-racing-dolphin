+// Copyright 2026 Evolution Racing contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Common/ERDownload.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <memory>
+#include <vector>
+
+#include <curl/curl.h>
+#include <fmt/format.h>
+#include <mbedtls/sha256.h>
+
+#include "Common/FileUtil.h"
+#include "Common/IOFile.h"
+
+namespace Common::ERDownload
+{
+namespace
+{
+struct Ctx
+{
+  File::IOFile* file = nullptr;
+  Result* res = nullptr;
+  u64 base = 0;      // bytes already on disk when the transfer started
+  u64 total = 0;     // whole file size when known
+  bool writing = false;
+  bool failed = false;
+  const std::function<bool(u64, u64)>* progress = nullptr;
+  const std::atomic<bool>* cancel = nullptr;
+  long code = 0;
+  CURL* curl = nullptr;
+  std::string path;
+};
+
+size_t OnHeader(char* data, size_t size, size_t n, void* user)
+{
+  Ctx* c = static_cast<Ctx*>(user);
+  std::string line(data, size * n);
+  const auto colon = line.find(':');
+  if (colon != std::string::npos)
+  {
+    std::string k = line.substr(0, colon), v = line.substr(colon + 1);
+    std::transform(k.begin(), k.end(), k.begin(), [](unsigned char ch) { return std::tolower(ch); });
+    while (!v.empty() && (v.front() == ' ' || v.front() == '\t'))
+      v.erase(v.begin());
+    while (!v.empty() && (v.back() == '\r' || v.back() == '\n' || v.back() == ' '))
+      v.pop_back();
+    c->res->headers[k] = v;
+  }
+  else if (line.starts_with("HTTP/"))
+  {
+    c->res->headers.clear();  // a new response (redirect / 100)
+  }
+  return size * n;
+}
+
+size_t OnData(char* data, size_t size, size_t n, void* user)
+{
+  Ctx* c = static_cast<Ctx*>(user);
+  const size_t len = size * n;
+  if (!c->writing)
+  {
+    curl_easy_getinfo(c->curl, CURLINFO_RESPONSE_CODE, &c->code);
+    if (c->code != 200 && c->code != 206)
+    {
+      if (c->res->body.size() < 65536)
+        c->res->body.append(data, std::min(len, 65536 - c->res->body.size()));
+      return len;
+    }
+    if (c->code == 200 && c->base > 0)
+    {
+      // the server sent the whole file again: start over
+      c->file->Close();
+      c->file->Open(c->path, "wb");
+      c->base = 0;
+    }
+    c->writing = true;
+  }
+  if (!c->file->WriteBytes(data, len))
+  {
+    c->failed = true;
+    return 0;
+  }
+  return len;
+}
+
+int OnProgress(void* user, curl_off_t dltotal, curl_off_t dlnow, curl_off_t, curl_off_t)
+{
+  Ctx* c = static_cast<Ctx*>(user);
+  if (c->cancel && c->cancel->load())
+    return 1;
+  if (c->progress && *c->progress && c->writing)
+  {
+    const u64 total = dltotal > 0 ? c->base + static_cast<u64>(dltotal) : 0;
+    if (!(*c->progress)(c->base + static_cast<u64>(dlnow), total))
+      return 1;
+  }
+  return 0;
+}
+}  // namespace
+
+Result ToFile(const std::string& url, const std::map<std::string, std::string>& headers, const std::string& path,
+              bool resume, const std::function<bool(u64, u64)>& progress, const std::atomic<bool>* cancel)
+{
+  Result r;
+  static bool inited = (curl_global_init(CURL_GLOBAL_DEFAULT), true);
+  (void)inited;
+  std::unique_ptr<CURL, decltype(&curl_easy_cleanup)> curl(curl_easy_init(), curl_easy_cleanup);
+  if (!curl)
+  {
+    r.error = "the network library did not start";
+    return r;
+  }
+  const u64 have = resume && File::Exists(path) ? File::GetSize(path) : 0;
+  File::IOFile f(path, have ? "ab" : "wb");
+  if (!f.IsOpen())
+  {
+    r.error = "cannot write " + path;
+    return r;
+  }
+  Ctx c;
+  c.file = &f;
+  c.res = &r;
+  c.base = have;
+  c.progress = &progress;
+  c.cancel = cancel;
+  c.curl = curl.get();
+  c.path = path;
+  curl_slist* list = nullptr;
+  for (const auto& [k, v] : headers)
+    list = curl_slist_append(list, (k + ": " + v).c_str());
+  if (have)
+    list = curl_slist_append(list, fmt::format("Range: bytes={}-", have).c_str());
+  std::unique_ptr<curl_slist, decltype(&curl_slist_free_all)> hold(list, curl_slist_free_all);
+  CURL* h = curl.get();
+  char err[CURL_ERROR_SIZE] = {};
+  curl_easy_setopt(h, CURLOPT_URL, url.c_str());
+  curl_easy_setopt(h, CURLOPT_HTTPHEADER, list);
+  curl_easy_setopt(h, CURLOPT_NOSIGNAL, 1L);
+  curl_easy_setopt(h, CURLOPT_CONNECTTIMEOUT, 20L);
+  curl_easy_setopt(h, CURLOPT_LOW_SPEED_LIMIT, 1L);   // nothing for 60 s: give up (resumed next time)
+  curl_easy_setopt(h, CURLOPT_LOW_SPEED_TIME, 60L);
+  curl_easy_setopt(h, CURLOPT_FOLLOWLOCATION, 0L);
+  curl_easy_setopt(h, CURLOPT_ERRORBUFFER, err);
+  curl_easy_setopt(h, CURLOPT_HEADERFUNCTION, OnHeader);
+  curl_easy_setopt(h, CURLOPT_HEADERDATA, &c);
+  curl_easy_setopt(h, CURLOPT_WRITEFUNCTION, OnData);
+  curl_easy_setopt(h, CURLOPT_WRITEDATA, &c);
+  curl_easy_setopt(h, CURLOPT_NOPROGRESS, 0L);
+  curl_easy_setopt(h, CURLOPT_XFERINFOFUNCTION, OnProgress);
+  curl_easy_setopt(h, CURLOPT_XFERINFODATA, &c);
+  const CURLcode rc = curl_easy_perform(h);
+  long code = 0;
+  curl_easy_getinfo(h, CURLINFO_RESPONSE_CODE, &code);
+  r.status = static_cast<int>(code);
+  f.Flush();
+  f.Close();
+  r.bytes = File::Exists(path) ? File::GetSize(path) : 0;
+  if (c.failed)
+    r.error = "could not write the file (is the disk full?)";
+  else if (rc == CURLE_ABORTED_BY_CALLBACK)
+    r.error = "stopped";
+  else if (rc != CURLE_OK)
+    r.error = std::string("the download stopped: ") + (err[0] ? err : curl_easy_strerror(rc));
+  else if (code == 416 && have)
+    r.error = "";  // the file was complete already
+  else if (code != 200 && code != 206)
+    r.error = fmt::format("the hub answered HTTP {}", code);
+  return r;
+}
+
+std::string Sha256File(const std::string& path, const std::function<bool(u64, u64)>& progress)
+{
+  File::IOFile f(path, "rb");
+  if (!f.IsOpen())
+    return {};
+  const u64 total = f.GetSize();
+  mbedtls_sha256_context ctx;
+  mbedtls_sha256_init(&ctx);
+  mbedtls_sha256_starts_ret(&ctx, 0);
+  std::vector<u8> buf(1 << 20);
+  u64 done = 0;
+  while (done < total)
+  {
+    const size_t n = static_cast<size_t>(std::min<u64>(buf.size(), total - done));
+    if (!f.ReadBytes(buf.data(), n))
+    {
+      mbedtls_sha256_free(&ctx);
+      return {};
+    }
+    mbedtls_sha256_update_ret(&ctx, buf.data(), n);
+    done += n;
+    if (progress && !progress(done, total))
+    {
+      mbedtls_sha256_free(&ctx);
+      return {};
+    }
+  }
+  u8 out[32];
+  mbedtls_sha256_finish_ret(&ctx, out);
+  mbedtls_sha256_free(&ctx);
+  std::string hex;
+  for (u8 b : out)
+    hex += fmt::format("{:02x}", b);
+  return hex;
+}
+}  // namespace Common::ERDownload
--- a/Source/Core/Common/ERDownload.h
+++ b/Source/Core/Common/ERDownload.h
@@ -0,0 +1,34 @@
+// Copyright 2026 Evolution Racing contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// A download straight to a file (resumes a cut one with Range), for the Evolution Racing updater: packs and Dolphin
+// builds are up to a few GB, so they never sit in memory (Common::HttpRequest keeps the whole answer in a vector).
+
+#pragma once
+
+#include <atomic>
+#include <functional>
+#include <map>
+#include <string>
+
+#include "Common/CommonTypes.h"
+
+namespace Common::ERDownload
+{
+struct Result
+{
+  int status = 0;            // HTTP status (200 / 206), 0 = no answer
+  std::string error;         // "" when the whole file is there
+  std::string body;          // the answer when it was not the file (the hub's JSON error), at most 64 KB
+  std::map<std::string, std::string> headers;  // lower-case names
+  u64 bytes = 0;             // size of the file on disk afterwards
+};
+
+// GET url into path (appends to an existing path from byte File::GetSize(path) with a Range request when resume).
+// progress(done, total) is called now and then; return false (or set *cancel) to stop.
+Result ToFile(const std::string& url, const std::map<std::string, std::string>& headers, const std::string& path,
+              bool resume, const std::function<bool(u64, u64)>& progress, const std::atomic<bool>* cancel);
+
+// sha256 of a file as lowercase hex ("" when it cannot be read); progress(done, total) as above
+std::string Sha256File(const std::string& path, const std::function<bool(u64, u64)>& progress = nullptr);
+}  // namespace Common::ERDownload
