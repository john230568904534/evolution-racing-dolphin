+class AbstractShader;
+class AbstractTexture;
+struct SceneryState;  // Evolution Racing dolphin-lit17s10 (EmitQuadsAction.cpp)
+
+// Computed on the CPU by VertexManagerBase from the target draw's vertices.
+struct EmitQuadsAnchor
+{
+  bool valid = false;
+  u32 sampled_vertices = 0;
+  std::array<float, 3> centroid_view{};  // GX view space (camera looks down -z)
+  float radius_view = 0.0f;              // bounding sphere radius around the centroid
+  std::array<float, 3> min_view{};
+  std::array<float, 3> max_view{};
+  std::array<float, 4> screen_box{};      // GX NDC (y up): min.x, min.y, max.x, max.y
+  std::array<float, 2> screen_centre{};   // GX NDC of the projected centroid
+  std::array<float, 12> position_matrix{};  // model -> view rows of the first sampled vertex
+  // Raw (model space) AABB of the sampled vertices that use the first sampled vertex's matrix.
+  std::array<float, 3> model_min{};
+  std::array<float, 3> model_max{};
+  bool model_valid = false;
+  std::array<float, 3> far_view{};  // mean of the sampled vertices at the far end (most negative z),
+                                    // ignoring vertices at the view origin (collapsed / unused)
+  std::array<std::array<float, 4>, 4> projection_rows{};
+  std::array<float, 4> pixel_center{};
+  std::array<float, 2> viewport{};         // native GX viewport size in pixels (abs)
+  u32 time_ms = 0;
+  const AbstractTexture* target_texture = nullptr;  // texture of the target draw's first named unit
+  bool original_skipped = false;
+  DepthState depth_state{};
+  BlendingState blending_state{};
+  // Evolution Racing dolphin-lit16: hull surface samples of the draw (view space): xyz position, w = 1, then the vertex normal
+  // xyz (view space, normalised), w = 1 if the draw had normals. Every Nth vertex (at most 32 per draw); clusters
+  // collect them, and the uniforms carry 64 of them in the model space of the cluster's main part (eq_surf*).
+  std::vector<std::array<float, 8>> surf;
+};
+
+class EmitQuadsAction final : public GraphicsModAction
+{
+public:
+  static constexpr std::string_view factory_name = "emit_quads";
