+// Copyright 2026 Evolution Racing contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Evolution Racing ghosts in the main window (Core/ERGhosts.h): the Tools > Evolution Racing ghosts dialog (Auto / Ask /
+// Off, the hub link), the watcher of the memory card folder, the Ask question, and evoracing://link / ghost links.
+
+#include "DolphinQt/MainWindow.h"
+
