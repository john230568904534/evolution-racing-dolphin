+void Save(const Settings& s)
+{
+  File::CreateFullPath(File::GetUserPath(D_CONFIG_IDX));
+  File::WriteStringToFile(SettingsPath() + ".tmp",
+                          fmt::format("# Evolution Racing updates (optional; Tools > Evolution Racing settings): "
+                                      "mode = off | notify | auto\nmode={}\nasked={}\n",
+                                      ModeName(s.mode), s.asked ? 1 : 0));
+  File::Rename(SettingsPath() + ".tmp", SettingsPath());
+}
