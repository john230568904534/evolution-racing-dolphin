+
+struct P40MaskJob
+{
+  std::string file;
+  std::atomic<int> state{0};  // 0 queued / decoding, 1 ready, 2 failed
+  u32 width = 0, height = 0;
+  std::vector<std::vector<u8>> levels;
+};
+
+namespace
+{
+// the surface layer texture's box-filtered mip chain (the lit17s loop, unchanged: the same bytes)
+std::vector<std::vector<u8>> P40Mips(const u8* rgba, size_t size, u32 width, u32 height)
+{
+  std::vector<std::vector<u8>> out;
+  u32 levels = 1;
+  while ((width >> levels) > 0 && (height >> levels) > 0 && levels < 12)
+    levels++;
+  out.emplace_back(rgba, rgba + size);
+  u32 w = width, h = height;
+  for (u32 l = 1; l < levels; l++)
+  {
+    const std::vector<u8>& cur = out.back();
+    const u32 nw = std::max(w / 2, 1u), nh = std::max(h / 2, 1u);
+    std::vector<u8> nxt(static_cast<size_t>(nw) * nh * 4);
+    for (u32 y = 0; y < nh; y++)
+      for (u32 x = 0; x < nw; x++)
+        for (u32 c = 0; c < 4; c++)
+        {
+          const u32 x0 = std::min(2 * x, w - 1), x1 = std::min(2 * x + 1, w - 1);
+          const u32 y0 = std::min(2 * y, h - 1), y1 = std::min(2 * y + 1, h - 1);
+          const u32 sum = cur[(static_cast<size_t>(y0) * w + x0) * 4 + c] + cur[(static_cast<size_t>(y0) * w + x1) * 4 + c] +
+                          cur[(static_cast<size_t>(y1) * w + x0) * 4 + c] + cur[(static_cast<size_t>(y1) * w + x1) * 4 + c];
+          nxt[(static_cast<size_t>(y) * nw + x) * 4 + c] = static_cast<u8>((sum + 2) / 4);
+        }
+    out.push_back(std::move(nxt));
+    w = nw;
+    h = nh;
+  }
+  return out;
+}
+
+bool P40Decode(const std::string& file, Common::UniqueBuffer<u8>* rgba, u32* width, u32* height)
+{
+  std::string png;
+  return File::ReadFileToString(file, png) &&
+         Common::LoadPNG(std::span(reinterpret_cast<const u8*>(png.data()), png.size()), rgba, width, height) &&
+         *width > 0 && *height > 0;
+}
+
+std::shared_ptr<AbstractTexture> P40Upload(const std::vector<std::vector<u8>>& levels, u32 width, u32 height,
+                                           std::string_view name)
+{
+  auto t = std::shared_ptr<AbstractTexture>(
+      g_gfx->CreateTexture(TextureConfig(width, height, static_cast<u32>(levels.size()), 1, 1, AbstractTextureFormat::RGBA8,
+                                         0, AbstractTextureType::Texture_2DArray),
+                           name));
+  if (!t)
+    return nullptr;
+  u32 w = width, h = height;
+  for (u32 l = 0; l < levels.size(); l++)
+  {
+    t->Load(l, w, h, w, levels[l].data(), levels[l].size());
+    w = std::max(w / 2, 1u);
+    h = std::max(h / 2, 1u);
+  }
+  return t;
+}
+
+// one texture per file for every action (damage_detail.png / hull_heat.png were decoded and kept once PER action)
+std::shared_ptr<AbstractTexture> P40Shared(const std::string& file, bool mips, std::string_view name)
+{
+  static std::map<std::string, std::weak_ptr<AbstractTexture>> cache;
+  const std::string key = file + (mips ? "#mips" : "");
+  if (const auto it = cache.find(key); it != cache.end())
+    if (auto t = it->second.lock())
+      return t;
+  Common::UniqueBuffer<u8> rgba;
+  u32 width = 0, height = 0;
+  if (!P40Decode(file, &rgba, &width, &height))
+    return nullptr;
+  std::vector<std::vector<u8>> levels;
+  if (mips)
+    levels = P40Mips(rgba.data(), rgba.size(), width, height);
+  else
+    levels.emplace_back(rgba.data(), rgba.data() + rgba.size());
+  auto t = P40Upload(levels, width, height, name);
+  if (t)
+    cache[key] = t;
+  return t;
+}
+
+// 2 worker threads decode the metal masks (PNG + mips: CPU only); the video thread uploads a finished one
+std::mutex s_p40_mu;
+std::condition_variable s_p40_cv;
+std::deque<std::shared_ptr<P40MaskJob>> s_p40_queue;
+bool s_p40_started = false;
+
+void P40Worker()
+{
+  for (;;)
+  {
+    std::shared_ptr<P40MaskJob> job;
+    {
+      std::unique_lock lk(s_p40_mu);
+      s_p40_cv.wait(lk, [] { return !s_p40_queue.empty(); });
+      job = std::move(s_p40_queue.front());
+      s_p40_queue.pop_front();
+    }
+    Common::UniqueBuffer<u8> rgba;
+    u32 width = 0, height = 0;
+    if (job.use_count() > 1 && P40Decode(job->file, &rgba, &width, &height))
+    {
+      job->levels = P40Mips(rgba.data(), rgba.size(), width, height);
+      job->width = width;
+      job->height = height;
+      job->state.store(1, std::memory_order_release);
+    }
+    else
+    {
+      job->state.store(2, std::memory_order_release);
+    }
+  }
+}
+
+std::shared_ptr<P40MaskJob> P40Queue(const std::string& file)
+{
+  auto job = std::make_shared<P40MaskJob>();
+  job->file = file;
+  std::lock_guard lk(s_p40_mu);
+  if (!s_p40_started)
+  {
+    s_p40_started = true;
+    for (int i = 0; i < 2; i++)
+      std::thread(P40Worker).detach();
+  }
+  s_p40_queue.push_back(job);
+  s_p40_cv.notify_one();
+  return job;
+}
