+      (ans == "auto" ? autob : ans == "off" ? off : notify)->click();
+    });
+  connect(box, &QMessageBox::finished, this, [this, box, notify, autob, off](int) {
+    ERUpdates::Settings s = ERUpdates::Load();
+    QAbstractButton* b = box->clickedButton();
+    s.mode = b == autob ? ERUpdates::Mode::Auto : b == off ? ERUpdates::Mode::Off : ERUpdates::Mode::Notify;
+    s.asked = true;
+    ERUpdates::Save(s);
+    const ERGhosts::Settings gs = ERGhosts::Load();
+    if (s.mode != ERUpdates::Mode::Off && !gs.offline && !gs.token.empty())
+      ERUpdateCheck(false);
+    emit ERGhostsChanged();
+  });
+  box->show();
+  box->raise();
+}
+
+void MainWindow::ERUpdateCheck(bool manual)
+{
+  const ERGhosts::Settings s = ERGhosts::Load();
+  if (s.offline)
+  {
+    if (manual)
+      ERNote("Play offline is on: turn it off (Tools menu) to check for updates.");
+    return;
+  }
+  if (s.token.empty())
+  {
+    if (manual)
+      ERNote("link this Dolphin first: Link my Dolphin on the hub's Setup page (or a link code in Tools > Evolution "
+             "Racing settings).");
+    return;
+  }
+  if (m_er_run && !m_er_run->finished)
+  {
+    if (manual)
+      ERNote("an update is already being downloaded.");
+    return;
+  }
+  if (m_er_checking)
+    return;
+  m_er_checking = true;
+  std::thread([this, s, manual] {
+    ERUpdates::CheckResult r = ERUpdates::Check(s);
+    QueueOnObject(this, [this, r, manual] {
+      m_er_checking = false;
+      if (r.relink)
+        return ERNote("this Dolphin's link to the hub ended. Link it again with Link my Dolphin on the hub's Setup page.");
+      if (!r.error.empty())
+      {
+        ERUpdates::Log("check: " + r.error);
+        if (manual)
+          ERNote("could not check for updates: " + r.error);
+        return;
+      }
+      ERUpdates::Log(fmt::format("check: {} item(s){}", r.items.size(), manual ? " (asked)" : ""));
+      if (r.items.empty())
+      {
+        if (manual)
+          ERNote("Everything is up to date (" + Common::GetERVersionStr() + ").");
+        return;
+      }
+      bool preparing = false;
+      for (const auto& i : r.items)
+        preparing |= i.preparing;
+      if (preparing && m_er_rechecks < 6)  // the hub is still making the member's copy: look again in 3 minutes
+      {
+        ++m_er_rechecks;
+        QTimer::singleShot(180000, this, [this] {
+          if (ERUpdates::Load().mode != ERUpdates::Mode::Off || m_er_manual_pending)
+            ERUpdateCheck(false);
+        });
+      }
+      const bool autom = ERUpdates::Load().mode == ERUpdates::Mode::Auto && !manual;
+      if (autom)
+      {
+        std::vector<ERUpdates::Item> go;
+        for (const auto& i : r.items)
+          if (i.Ready())
+            go.push_back(i);
+        if (!go.empty())
+          ERUpdateStart(go);
+        return;
+      }
+      ERUpdatePopup(r.items);
+    });
+  }).detach();
+}
