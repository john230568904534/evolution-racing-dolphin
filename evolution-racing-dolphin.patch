+// Test hook for the harness proofs (never set on a member's PC): ER_UPDATES_TEST=<folder> writes what the windows show
+// into that folder (popup.txt / popup.png, done.txt, notes.txt) and presses the buttons named by files there
+// (accept = "Update now", restart = "Restart now", firstrun = its answer: notify / auto / off).
+std::string TestDir()
+{
+  const char* d = std::getenv("ER_UPDATES_TEST");
+  return d && *d ? std::string(d) + "/" : std::string();
+}
+
+void TestWrite(const std::string& name, const std::string& text, bool append = true)
+{
+  const std::string d = TestDir();
+  if (d.empty())
+    return;
+  File::IOFile f(d + name, append ? "ab" : "wb");
+  f.WriteString(text + "\n");
+}
+
+bool TestHas(const std::string& name, std::string* content = nullptr)
+{
+  const std::string d = TestDir();
+  std::string c;
+  if (d.empty() || !File::ReadFileToString(d + name, c))
+    return false;
+  if (content)
+    *content = std::string(StripWhitespace(c));
+  return true;
+}
