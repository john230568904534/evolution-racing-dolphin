+CustomShaderCache::GetPipelineWait(const VideoCommon::GXPipelineUid& uid,
+                                   const CustomShaderInstance& custom_shaders,
+                                   const AbstractPipelineConfig& pipeline_config)
+{
+  if (auto r = GetPipelineAsync(uid, custom_shaders, pipeline_config))
+    return r;
+  const auto t0 = std::chrono::steady_clock::now();
+  while (std::chrono::steady_clock::now() - t0 < std::chrono::milliseconds(1500))
+  {
+    m_async_shader_compiler->RetrieveWorkItems();
+    if (auto holder = m_pipeline_cache.GetHolder(uid, custom_shaders); holder && !holder->pending)
+      return holder->value.get();
+    std::this_thread::sleep_for(std::chrono::microseconds(200));
+  }
+  return std::nullopt;
+}
