+float DmRand()
+{
+  s_dm_rng ^= s_dm_rng << 13;
+  s_dm_rng ^= s_dm_rng >> 17;
+  s_dm_rng ^= s_dm_rng << 5;
+  return static_cast<float>(s_dm_rng & 0xffffff) / 16777216.0f;
+}
+
+using M34 = std::array<float, 12>;
+using V3 = std::array<float, 3>;
+float Dot3(const V3& a, const V3& b)
+{
+  return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+}
+float Len3(const V3& a)
+{
+  return std::sqrt(Dot3(a, a));
+}
+V3 Norm3(const V3& a, const V3& fallback = {0.0f, 1.0f, 0.0f})
+{
+  const float l = Len3(a);
+  return l > 1e-8f ? V3{a[0] / l, a[1] / l, a[2] / l} : fallback;
+}
+V3 Cross3(const V3& a, const V3& b)
+{
+  return {a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]};
+}
+V3 XP(const M34& m, const V3& p)
+{
+  return {m[0] * p[0] + m[1] * p[1] + m[2] * p[2] + m[3], m[4] * p[0] + m[5] * p[1] + m[6] * p[2] + m[7],
+          m[8] * p[0] + m[9] * p[1] + m[10] * p[2] + m[11]};
+}
+V3 XV(const M34& m, const V3& v)
+{
+  return {m[0] * v[0] + m[1] * v[1] + m[2] * v[2], m[4] * v[0] + m[5] * v[1] + m[6] * v[2],
+          m[8] * v[0] + m[9] * v[1] + m[10] * v[2]};
+}
+float Det34(const M34& P)
+{
+  return P[0] * (P[5] * P[10] - P[6] * P[9]) - P[1] * (P[4] * P[10] - P[6] * P[8]) +
+         P[2] * (P[4] * P[9] - P[5] * P[8]);
+}
+float Scale34(const M34& P)
+{
+  return std::cbrt(std::abs(Det34(P)));
+}
+bool Inv34(const M34& P, M34* out)
+{
+  const float det = Det34(P);
+  if (!(std::abs(det) > 1e-12f) || !std::isfinite(det))
+    return false;
+  const float id = 1.0f / det;
+  const float a00 = P[0], a01 = P[1], a02 = P[2], a10 = P[4], a11 = P[5], a12 = P[6], a20 = P[8], a21 = P[9],
+              a22 = P[10];
+  const float I[9] = {(a11 * a22 - a12 * a21) * id, (a02 * a21 - a01 * a22) * id, (a01 * a12 - a02 * a11) * id,
+                      (a12 * a20 - a10 * a22) * id, (a00 * a22 - a02 * a20) * id, (a02 * a10 - a00 * a12) * id,
+                      (a10 * a21 - a11 * a20) * id, (a01 * a20 - a00 * a21) * id, (a00 * a11 - a01 * a10) * id};
+  M34& o = *out;
+  for (int r = 0; r < 3; r++)
+  {
+    o[r * 4] = I[r * 3];
+    o[r * 4 + 1] = I[r * 3 + 1];
+    o[r * 4 + 2] = I[r * 3 + 2];
+    o[r * 4 + 3] = -(I[r * 3] * P[3] + I[r * 3 + 1] * P[7] + I[r * 3 + 2] * P[11]);
+  }
+  return true;
+}
+M34 Mul34(const M34& A, const M34& B)  // A * B (affine)
+{
+  M34 o{};
+  for (int r = 0; r < 3; r++)
+  {
+    for (int c = 0; c < 4; c++)
+    {
+      float v = A[r * 4] * B[c] + A[r * 4 + 1] * B[4 + c] + A[r * 4 + 2] * B[8 + c];
+      if (c == 3)
+        v += A[r * 4 + 3];
+      o[r * 4 + c] = v;
+    }
+  }
+  return o;
+}
+
+const std::string& DmPlayerSlot()
+{
+  return s_dm_cfg.player_slot;
+}
+
+void DmConfigure(const picojson::object& g)
+{
+  DmConfig c;
+  if (const auto v = ReadStringFromJson(g, "player_slot"))
+    c.player_slot = *v;
+  if (const auto v = ReadStringFromJson(g, "cpu_slot"))
+    c.cpu_slot = *v;
+  const auto num = [&](const char* key, float* out) {
+    if (const auto n = ReadNumericFromJson<double>(g, key))
+      *out = static_cast<float>(*n);
+  };
+  const auto u = [&](const char* key, u32* out) {
+    if (const auto n = ReadNumericFromJson<double>(g, key))
+      *out = static_cast<u32>(*n);
+  };
+  if (const auto it = g.find("base"); it != g.end() && it->second.is<picojson::array>())
+  {
+    c.base.clear();
+    for (const auto& v : it->second.get<picojson::array>())
+      if (v.is<double>())
+        c.base.push_back(static_cast<u32>(v.get<double>()));
+  }
+  u("stride", &c.stride);
+  u("count", &c.count);
+  c.count = std::min<u32>(c.count, 64);
+  u("state", &c.off_state);
+  u("energy", &c.off_energy);
+  u("pos", &c.off_pos);
+  u("surface", &c.off_surface);
+  u("boost_mask", &c.boost_mask);
+  u("dash_mask", &c.dash_mask);
+  u("contact_mask", &c.contact_mask);
+  u("hit_mask", &c.hit_mask);
+  u("pit_mask", &c.pit_mask);
+  u("zone_mask", &c.zone_mask);
+  u("clock", &c.clock_addr);
+  u("scene_addr", &c.scene_addr);
+  u("scene_mask", &c.scene_mask);
+  u("scene_value", &c.scene_value);
+  if (const auto sc = g.find("scene_chain"); sc != g.end() && sc->second.is<picojson::array>())
+  {
+    for (const auto& v : sc->second.get<picojson::array>())
+    {
+      if (v.is<double>())
+        c.scene_chain.push_back(static_cast<u32>(v.get<double>()));
+    }
+  }
+  num("min_drop", &c.min_drop);
+  num("full_drop", &c.full_drop);
+  num("jerk_min", &c.jerk_min);
+  num("contact_drop", &c.contact_drop);
+  num("heal_s", &c.heal_s);
+  num("heat_s", &c.heat_s);
+  num("merge", &c.merge);
+  num("radius", &c.radius);
+  num("radius_k", &c.radius_k);
+  num("depth", &c.depth);
+  num("depth_k", &c.depth_k);
+  num("depth_max", &c.depth_max);
+  num("cpu_scale", &c.cpu_scale);
+  u("trace", &c.trace);
+  s_dm_cfg = c;
+}
