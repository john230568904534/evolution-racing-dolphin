+float Dist2(const std::array<float, 3>& a, const std::array<float, 3>& b)
+{
+  const float dx = a[0] - b[0], dy = a[1] - b[1], dz = a[2] - b[2];
+  return dx * dx + dy * dy + dz * dz;
+}
+
+bool SameMatrix(const std::array<float, 12>& a, const std::array<float, 12>& b)
+{
+  for (size_t i = 0; i < 12; i++)
+  {
+    if (std::abs(a[i] - b[i]) > 1e-3f * (1.0f + std::abs(a[i])))
+      return false;
+  }
+  return true;
+}
+
+// Union of two anchors of the same object (several batches of one machine).
+void MergeInto(AnchorCluster& c, const EmitQuadsAnchor& n)
+{
+  EmitQuadsAnchor& a = c.a;
+  const float wa = static_cast<float>(std::max(a.sampled_vertices, 1u));
+  const float wn = static_cast<float>(std::max(n.sampled_vertices, 1u));
+  for (int i = 0; i < 3; i++)
+  {
+    a.min_view[i] = std::min(a.min_view[i], n.min_view[i]);
+    a.max_view[i] = std::max(a.max_view[i], n.max_view[i]);
+    a.centroid_view[i] = (a.centroid_view[i] * wa + n.centroid_view[i] * wn) / (wa + wn);
+  }
+  a.sampled_vertices += n.sampled_vertices;
+  // lit16: surface samples of every part (draw order is the same each frame, so the set is stable)
+  for (const auto& p : n.surf)
+  {
+    if (a.surf.size() >= 1024)
+      break;
+    a.surf.push_back(p);
+  }
+  float r2 = 0.0f;
+  for (int corner = 0; corner < 8; corner++)
+  {
+    const std::array<float, 3> p = {(corner & 1) ? a.max_view[0] : a.min_view[0],
+                                    (corner & 2) ? a.max_view[1] : a.min_view[1],
+                                    (corner & 4) ? a.max_view[2] : a.min_view[2]};
+    r2 = std::max(r2, Dist2(p, a.centroid_view));
+  }
+  a.radius_view = std::max({a.radius_view, n.radius_view, std::sqrt(r2) * 0.9f});
+  a.screen_box = {std::min(a.screen_box[0], n.screen_box[0]),
+                  std::min(a.screen_box[1], n.screen_box[1]),
+                  std::max(a.screen_box[2], n.screen_box[2]),
+                  std::max(a.screen_box[3], n.screen_box[3])};
+  a.screen_centre = {(a.screen_box[0] + a.screen_box[2]) * 0.5f,
+                     (a.screen_box[1] + a.screen_box[3]) * 0.5f};
+  if (n.model_valid)
+  {
+    // Machines are drawn in parts with their own matrices: the model box + matrix of the biggest
+    // part wins (parts sharing its matrix are added to the box).
+    if (!a.model_valid || (n.radius_view > c.model_radius * 1.05f &&
+                           !SameMatrix(a.position_matrix, n.position_matrix)))
+    {
+      c.model_radius = n.radius_view;
+      a.model_min = n.model_min;
+      a.model_max = n.model_max;
+      a.position_matrix = n.position_matrix;
+      a.model_valid = true;
+    }
+    else if (SameMatrix(a.position_matrix, n.position_matrix))
+    {
+      for (int i = 0; i < 3; i++)
+      {
+        a.model_min[i] = std::min(a.model_min[i], n.model_min[i]);
+        a.model_max[i] = std::max(a.model_max[i], n.model_max[i]);
+      }
+    }
+  }
+  c.draws++;
+}
+
+constexpr std::string_view UNIFORM_BLOCK = R"(
+#define EQ_LIT10 1
+#define EQ_LIT14 1
+#define EQ_LIT15 1
+#define EQ_LIT16 1
+#define EQ_LIT17 1
+#define EQ_LIT17C 1
+#define EQ_LIT17S 1
+#define EQ_LIT17S6 1
+UBO_BINDING(std140, 1) uniform PSBlock
+{
+  float4 eq_projection[4];   // GX projection rows (view -> GX clip), incl. Dolphin's adjustments
+  float4 eq_pixel_center;
+  float4 eq_anchor;          // xyz = target draw's vertex centroid (GX view space, camera looks down -z), w = bounding radius
+  float4 eq_view_min;        // xyz = view-space AABB min, w = number of vertices sampled
+  float4 eq_view_max;        // xyz = view-space AABB max, w = 1 if the original draw was skipped
+  float4 eq_screen_box;      // GX NDC (y up) bounding box of the projected vertices: min.xy, max.xy
+  float4 eq_screen_centre;   // xy = NDC of the centroid, zw = same anchor last frame (= xy if none)
+  float4 eq_prev_anchor;     // xyz = the nearest anchor of this action last frame (view space), w = 1 if found
+  float4 eq_matrix[3];       // the draw's position matrix rows (model -> view), as GX stores it
+  float4 eq_viewport;        // xy = viewport size in native pixels, zw = 1 / xy
+  uint4 eq_info;             // x = time_ms, y = quad count, z = emit index this frame, w = frame counter
+  float4 eq_model_min;       // xyz = model-space AABB min of the anchor (vertices sharing eq_matrix), w = 1 if valid
+  float4 eq_model_max;
+  float4 eq_gate;            // x = ms since the "gate" slot was last published, y = ms since its current run started, z = run length ms, w = 1 if a gate is set
+  float4 eq_target;          // xyz = the trigger draw's own centroid (view), w = its radius (differs from eq_anchor with "anchor_from")
+  float4 eq_target_far;      // xyz = the trigger draw's far end (mean of its vertices nearest the farthest depth, view), w = 1 if found
+  float4 eq_params[4];       // action_data "params" (16 floats)
+  float4 eq_ram[2];          // action_data "ram_values" 0..7 (lit10)
+  float4 eq_player;          // "player_from" slot's largest cluster: centroid xyz (view), w = radius (0 = none) (lit10)
+  float4 eq_scene_size;      // "scene_copy": EFB size xy, 1 / size zw (0 = none) (lit10)
+  float4 eq_depth_size;      // "depth_copy": EFB size xy, 1 / size zw (0 = none) (lit14)
+  float4 eq_depth_range;     // the game viewport's host depth range: x = near, y = far (lit14)
+  float4 eq_racer;           // lit15 per_racer emit: x = racer index, y = machine id (racer block byte "machine"), z = 1; else 0
+  float4 eq_surf_info;       // lit16: x = number of hull surface samples (0..64), y = 1 if they have normals
+  float4 eq_surf_pos[64];    // lit16: hull surface samples, model space of eq_matrix (eq_model_to_view), w = 1
+  float4 eq_surf_normal[64]; // lit16: their normals (model space of eq_matrix), w = 1 if valid
+  float4 eq_dm_info;         // lit17: x = damage hits (0..16), y = time s, z = machine size (model units), w = 1 if racer known
+  float4 eq_dm_pos[16];      // lit17: hit centre (model space of eq_matrix), w = dent radius
+  float4 eq_dm_dir[16];      // lit17: outward hull normal at the hit (unit), w = dent depth
+  float4 eq_dm_tan[16];      // lit17: scrape direction (unit), w = seed 0..1
+  float4 eq_dm_aux[16];      // lit17: x = age s, y = strength (1 = a hard hit), z = 1 intact .. 0 repaired, w = heat
+  float4 eq_hx_info;         // lit17c: x = speed heat 0..1 (smoothed), y = speed km/h, z = grip level 0..1+, w = s since the last grip impact
+  float4 eq_hx_dir;          // lit17c: travel direction (model space of eq_matrix, unit), w = strength of the last grip impact
+  float4 eq_hx_ctr;          // lit17c: machine centre (model space), w = machine size (max sample radius)
+  float4 eq_hx_aux;          // lit17c: x = how far the lowest hull point lies below the centre (along eq_hx_up, model units), y = front / z = back extent along eq_hx_dir, w = 1 if valid
+  float4 eq_hx_up;           // lit17c: the machine's up (model space of eq_matrix, unit; the model's own axes are not y-up)
+};
+float eq_ram_value(int i) { return eq_ram[i >> 2][i & 3]; }
+uint eq_time_ms() { return eq_info.x; }
+uint eq_quad_count() { return eq_info.y; }
+uint eq_emit_index() { return eq_info.z; }
+uint eq_frame() { return eq_info.w; }
+float eq_param(int i) { return eq_params[i >> 2][i & 3]; }
+float eq_aspect() { return eq_viewport.x * eq_viewport.w; }
+)";
+
+std::string GenerateVertexShader(const std::string& user_code)
+{
+  ShaderCode code;
+  code.Write("#define EQ_VERTEX 1\n");
+  code.Write("{}", UNIFORM_BLOCK);
+  code.Write("{}", R"(
+VARYING_LOCATION(0) out float2 eq_v_uv;
+VARYING_LOCATION(1) out float4 eq_v_data0;
+VARYING_LOCATION(2) out float4 eq_v_data1;
+VARYING_LOCATION(3) flat out uint eq_v_instance;
+
+struct EmitVertex
+{
+  float4 clip;   // GX clip space (eq_view_to_clip); the host conversion is done afterwards
+  float2 uv;     // defaults to the quad corner (0..1)
+  float4 data0;  // free for the pixel shader
+  float4 data1;
+};
+// Put every corner of a quad here to drop it (zero-area and off screen).
+const float4 EQ_CULLED = float4(4.0, 4.0, 0.0, 1.0);
+
+float4 eq_view_to_clip(float3 v)
+{
+  float4 p = float4(v, 1.0);
+  return float4(dot(eq_projection[0], p), dot(eq_projection[1], p), dot(eq_projection[2], p),
+                dot(eq_projection[3], p));
+}
+float3 eq_model_to_view(float3 m)
+{
+  float4 p = float4(m, 1.0);
+  return float3(dot(eq_matrix[0], p), dot(eq_matrix[1], p), dot(eq_matrix[2], p));
+}
+// Model axis i (0 = x, 1 = y, 2 = z) of the draw's position matrix, in view space (normalized).
+float3 eq_model_axis(int i)
+{
+  float3 a = float3(eq_matrix[0][i], eq_matrix[1][i], eq_matrix[2][i]);
+  return a / max(length(a), 1e-6);
+}
+// A point at GX NDC xy with the depth / w of a reference clip position (screen-space sprites).
+float4 eq_ndc_at(float2 ndc, float4 ref_clip)
+{
+  return float4(ndc * ref_clip.w, ref_clip.z, ref_clip.w);
+}
+)");
