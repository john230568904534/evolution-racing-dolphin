+Settings LoadFile()
+{
+  Settings s;
+  std::string text;
+  if (!File::ReadFileToString(SettingsPath(), text))
+    return s;
+  for (std::string line : SplitString(text, '\n'))
+  {
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+      line.pop_back();
+    const auto eq = line.find('=');
+    if (eq == std::string::npos)
+      continue;
+    const std::string k = line.substr(0, eq), v = line.substr(eq + 1);
+    if (k == "mode")
+      s.mode = v == "off" ? Mode::Off : v == "auto" ? Mode::Auto : Mode::Ask;
+    else if (k == "hub" && !v.empty())
+      s.hub = v;
+    else if (k == "token")
+      s.token = v;
+    else if (k == "user")
+      s.username = v;
+    else if (k == "told_unlinked")
+      s.told_unlinked = v == "1";
+    else if (k == "offline")
+      s.offline = v == "1";
+
+  }
+  return s;
+}
