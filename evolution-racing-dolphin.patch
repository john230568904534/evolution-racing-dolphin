+namespace
+{
+// the member's own disc: the GFZE01 image in Dolphin's game folders whose main program is the one the browser read
+std::string FindBase(const std::string& want_sha1, const std::string& want_name, std::string* note)
+{
+  const std::string cache = Dir() + "base.json";
+  std::string text;
+  if (File::ReadFileToString(cache, text))
+  {
+    picojson::value v;
+    if (picojson::parse(v, text).empty() && v.is<picojson::object>() &&
+        Str(At(v, "line_sha1")) == want_sha1)
+    {
+      const std::string p = Str(At(v, "path"));
+      if (File::Exists(p) && static_cast<double>(File::GetSize(p)) == Num(At(v, "size")))
+        return p;
+    }
+  }
+  std::vector<std::string> dirs = Config::GetIsoPaths();
+  std::vector<std::string_view> views(dirs.begin(), dirs.end());
+  static constexpr std::array<std::string_view, 7> exts = {".iso", ".gcm", ".ciso", ".gcz",
+                                                            ".rvz", ".wia", ".nfs"};
+  auto paths = Common::DoFileSearch(views, exts, Config::Get(Config::MAIN_RECURSIVE_ISO_PATHS));
+  // the file with the browser's file name first
+  std::stable_partition(paths.begin(), paths.end(), [&](const std::string& p) {
+    return !want_name.empty() && p.ends_with(want_name);
+  });
+  std::string any;
+  for (const std::string& p : paths)
+  {
+    auto vol = DiscIO::CreateVolume(p);
+    if (!vol || vol->GetGameID(DiscIO::PARTITION_NONE) != GAME_ID)
+      continue;
+    if (any.empty())
+      any = p;
+    const auto part = vol->GetGamePartition();
+    std::vector<u8> buf(4 << 20);
+    const u64 n = DiscIO::ReadFile(*vol, part, "enemy_line/line__.bin", buf.data(), buf.size());
+    if (!n)
+      continue;
+    buf.resize(n);
+    if (Hex(Common::SHA1::CalculateDigest(buf)) == want_sha1)
+    {
+      picojson::object o;
+      o["path"] = picojson::value(p);
+      o["size"] = picojson::value(static_cast<double>(File::GetSize(p)));
+      o["line_sha1"] = picojson::value(want_sha1);
+      File::WriteStringToFile(cache, picojson::value(o).serialize(true));
+      return p;
+    }
+  }
+  if (!any.empty())
+    *note = "your disc in Dolphin's game folders is not the one the builder read - testing on " + any;
+  return any;
+}
+
+std::vector<Step> ParseScript(const picojson::value& v)
+{
+  std::vector<Step> out;
+  for (const auto& e : Arr(v))
+  {
+    const auto& a = Arr(e);
+    if (a.empty())
+      continue;
+    auto num = [&](size_t i, int d) { return i < a.size() && a[i].is<double>() ? int(a[i].get<double>()) : d; };
+    const std::string op = Str(a[0]);
+    Step s;
+    if (op == "press")
+    {
+      s.op = Op::Press;
+      s.buttons = Buttons(a.size() > 1 ? Str(a[1]) : "");
+      s.hold = num(2, 6);
+      s.after = num(3, 30);
+    }
+    else if (op == "wait")
+    {
+      s.op = Op::Wait;
+      s.after = num(1, 60);
+    }
+    else if (op == "until_race")
+    {
+      s.op = Op::UntilRace;
+      s.timeout = num(1, 3600);
+    }
+    else if (op == "leave_demo")
+    {
+      s.op = Op::LeaveDemo;
+      s.after = num(1, 240);
+      s.timeout = num(2, 3600);
+    }
+    else if (op == "save_state")
+      s.op = Op::SaveState;
+    else if (op == "start_line")
+    {
+      s.op = Op::StartLine;
+      s.timeout = num(1, 3600);
+    }
+    else if (op == "until_set")
+    {
+      s.op = Op::UntilSet;
+      s.addr = static_cast<u32>(a.size() > 1 && a[1].is<double>() ? a[1].get<double>() : 0);
+      s.timeout = num(2, 1200);
+    }
+    else if (op == "throttle")
+    {
+      s.op = Op::Throttle;
+      s.after = num(1, 1);
+    }
+    else
+      continue;
+    out.push_back(s);
+  }
+  return out;
+}
+
+// a finished package for this nonce? (a browser writes *.crdownload / *.part first and renames at the end)
+std::string FindPackage(const std::string& nonce)
+{
+  for (const std::string& d : s_download_dirs)
+  {
+    const std::string p = d + "/er-test-" + nonce + ".ertest";
+    if (File::Exists(p) && File::GetSize(p) > 16)
+      return p;
+  }
+  return {};
+}
+
+std::unique_ptr<BootParameters> LoadImpl(const std::string& package, std::string* message)
+{
+  const s64 t0 = NowMs();
+  std::string data;
+  if (!File::ReadFileToString(package, data) || data.size() < 12 ||
+      std::memcmp(data.data(), MAGIC, 8) != 0)
+  {
+    *message = "not a Test in game package: " + package;
+    return nullptr;
+  }
+  u32 jlen;
+  std::memcpy(&jlen, data.data() + 8, 4);  // little endian (the browser's DataView)
+  if (12 + static_cast<u64>(jlen) > data.size())
+  {
+    *message = "the package is cut short (still downloading?)";
+    return nullptr;
+  }
+  picojson::value v;
+  const std::string err = picojson::parse(v, data.substr(12, jlen));
+  if (!err.empty() || Num(At(v, "version")) != 1)
+  {
+    *message = "the package is from a newer builder - update this Evolution Racing Dolphin";
+    return nullptr;
+  }
+  const size_t blob0 = 12 + jlen;
+  auto run = std::make_shared<Run>();
+  run->t_request = t0;
+  run->nonce = Str(At(v, "nonce"));
+  run->title = Str(At(v, "title"));
+  if (!SafeName(run->nonce, false))
+  {
+    *message = "bad package id";
+    return nullptr;
+  }
+  Status(run->nonce, "package", "package read: " + run->title);
+
+  // unpack into ERTest/run-<nonce>/files (older runs removed, except the one Dolphin may still read)
+  for (const File::FSTEntry& e : File::ScanDirectoryTree(Dir(), false).children)
+  {
+    if (e.isDirectory && e.virtualName.starts_with("run-") && e.virtualName != "run-" + run->nonce &&
+        e.virtualName != "run-" + s_last_nonce)
+      File::DeleteDirRecursively(e.physicalName);
+  }
+  const std::string root = Dir() + "run-" + run->nonce + "/";
+  File::DeleteDirRecursively(root);
+  File::CreateFullPath(root + "files/");
+  std::string xml = "<wiidisc version=\"1\">\n<id game=\"GFZE\"/>\n<options><section name=\"Evolution Racing\">"
+                    "<option name=\"Test in game\"><choice name=\"On\"><patch id=\"ertest\"/></choice>"
+                    "</option></section></options>\n<patch id=\"ertest\">\n";
+  const auto& files = Arr(At(v, "files"));
+  if (files.empty())
+  {
+    *message = "the package has no files";
+    return nullptr;
+  }
+  for (const auto& f : files)
+  {
+    const std::string path = Str(At(f, "path"));
+    const double doff = Num(At(f, "off"), -1), dsize = Num(At(f, "size"), -1);
+    if (!SafeName(path, true) || doff < 0 || dsize < 0 ||
+        doff + dsize > static_cast<double>(data.size() - blob0))
+    {
+      *message = "bad file in the package: " + path;
+      return nullptr;
+    }
+    const u64 off = static_cast<u64>(doff), size = static_cast<u64>(dsize);
+    if (blob0 + off + size > data.size())
+    {
+      *message = "bad file in the package: " + path;
+      return nullptr;
+    }
+    const std::string out = root + "files/" + path;
+    File::CreateFullPath(out);
+    File::IOFile o(out, "wb");
+    if (!o.WriteBytes(data.data() + blob0 + off, size))
+    {
+      *message = "could not write " + out;
+      return nullptr;
+    }
+    const std::string sha = Str(At(f, "sha1"));
+    if (!sha.empty() &&
+        Hex(Common::SHA1::CalculateDigest(reinterpret_cast<const u8*>(data.data() + blob0 + off),
+                                          size)) != sha)
+    {
+      *message = "damaged package (checksum): " + path;
+      return nullptr;
+    }
+    xml += "<file disc=\"/" + path + "\" external=\"/files/" + path + "\"/>\n";
+  }
+  xml += "</patch>\n</wiidisc>\n";
+  File::WriteStringToFile(root + "er-test.xml", xml);
+
+  // the member's own disc
+  std::string note;
+  const auto& base = At(v, "base");
+  const std::string base_path =
+      FindBase(Str(At(base, "line_sha1")), Str(At(base, "name")), &note);
+  if (base_path.empty())
+  {
+    *message = "no F-Zero GX (USA) disc in Dolphin's game folders: add the folder with your game in "
+               "Config > Paths, then press Test in game again";
+    Status(run->nonce, "failed", *message);
+    return nullptr;
+  }
+  if (!note.empty())
+    Status(run->nonce, "note", note);
+
+  picojson::object desc, riiv, patch, option;
+  desc["type"] = picojson::value("dolphin-game-mod-descriptor");
+  desc["version"] = picojson::value(1.0);
+  desc["base-file"] = picojson::value(base_path);
+  desc["display-name"] = picojson::value("Test in game: " + run->title);
+  option["section-name"] = picojson::value("Evolution Racing");
+  option["option-name"] = picojson::value("Test in game");
+  option["choice"] = picojson::value(1.0);
+  patch["xml"] = picojson::value(root + "er-test.xml");
+  patch["root"] = picojson::value(root);
+  patch["options"] = picojson::value(picojson::array{picojson::value(option)});
+  riiv["patches"] = picojson::value(picojson::array{picojson::value(patch)});
+  desc["riivolution"] = picojson::value(riiv);
+  File::WriteStringToFile(root + "er-test.json", picojson::value(desc).serialize(true));
+
+  // the scripts and the fast start
+  run->boot = ParseScript(At(v, "boot"));
+  run->race = ParseScript(At(v, "race"));
+  const auto& rc = At(v, "racer");
+  for (const auto& x : Arr(At(rc, "chain")))
+    run->racer.chain.push_back(static_cast<s64>(Num(x)));
+  run->racer.lap_off = static_cast<u32>(Num(At(rc, "lap")));
+  run->racer.dist_off = static_cast<u32>(Num(At(rc, "dist")));
+  run->racer.start_window = static_cast<float>(Num(At(rc, "start_window"), 60));
+  if (run->race.empty())
+  {
+    *message = "the package has no race script";
+    return nullptr;
+  }
+  const auto& fast = At(v, "fast");
+  if (SafeName(Str(At(fast, "sig")), false))
+  {
+    run->sig = Str(At(fast, "sig"));
+    run->fst_ptr = static_cast<u32>(Num(At(fast, "fst_ptr")));
+    run->rel_base = static_cast<u32>(Num(At(fast, "rel_base")));
+    run->rel_head_ptr = static_cast<u32>(Num(At(fast, "rel_head_ptr")));
+    run->rel_id = static_cast<u32>(Num(At(fast, "rel_id")));
+    for (const auto& w : Arr(At(fast, "writes")))
+    {
+      const auto& a = Arr(w);
+      if (a.size() < 2)
+        continue;
+      const u32 addr = static_cast<u32>(Num(a[0]));
+      const std::string hx = Str(a[1]);
+      std::vector<u8> bytes(hx.size() / 2);
+      bool ok = !bytes.empty();
+      for (size_t i = 0; i < bytes.size() && ok; ++i)
+      {
+        const int hi = HexDigit(hx[i * 2]), lo = HexDigit(hx[i * 2 + 1]);
+        ok = hi >= 0 && lo >= 0;
+        bytes[i] = static_cast<u8>(hi * 16 + lo);
+      }
+      if (!ok || addr < 0x80000000 || addr + bytes.size() > 0x81800000)
+        continue;
+      const bool ptr = a.size() >= 3 && Num(a[2]) == 1 && bytes.size() % 4 == 0;
+      run->writes.emplace_back(addr, std::move(bytes));
+      run->write_ptr.push_back(ptr);
+    }
+    // one state per Dolphin build + disc + main-program code
+    const std::string key = Hex(Common::SHA1::CalculateDigest(
+                                    run->sig + "|" + Common::GetScmRevGitStr() + "|" + base_path))
+                                .substr(0, 16);
+    run->state_path = Dir() + "state-" + key + ".sav";
+    run->state_meta = Dir() + "state-" + key + ".json";
+    run->state_fst = Dir() + "state-" + key + ".fst";
+    run->state_rel = Dir() + "state-" + key + ".rel";
+    // a state saved last time is promoted once its save finished
+    if (File::Exists(run->state_path + ".new") && File::Exists(run->state_meta + ".new"))
+    {
+      File::Rename(run->state_path + ".new", run->state_path);
+      File::Rename(run->state_meta + ".new", run->state_meta);
+    }
+    run->use_state = File::Exists(run->state_path) && File::Exists(run->state_meta) &&
+                     File::Exists(run->state_fst) && File::Exists(run->state_rel) && !At(v, "full_boot").evaluate_as_boolean();
+  }
+
+  std::optional<std::string> savestate;
+  if (run->use_state)
+    savestate = run->state_path;
+  auto boot = BootParameters::GenerateFromFile(root + "er-test.json",
+                                               BootSessionData(savestate, DeleteSavestateAfterBoot::No));
+  if (!boot || !std::holds_alternative<BootParameters::Disc>(boot->parameters))
+  {
+    *message = "Dolphin could not open your disc with the test track";
+    Status(run->nonce, "failed", *message);
+    return nullptr;
+  }
+  // this test's file table, as the overlaid disc has it (the fast start writes it into a state's RAM)
+  {
+    const auto& vol = *std::get<BootParameters::Disc>(boot->parameters).volume;
+    u32 fst_off = 0, fst_size = 0;
+    vol.Read(0x424, 4, reinterpret_cast<u8*>(&fst_off), DiscIO::PARTITION_NONE);
+    vol.Read(0x428, 4, reinterpret_cast<u8*>(&fst_size), DiscIO::PARTITION_NONE);
+    fst_off = Common::swap32(fst_off);
+    fst_size = Common::swap32(fst_size);
+    if (fst_size > 0 && fst_size < (1 << 20))
+    {
+      run->fst.resize(fst_size);
+      vol.Read(fst_off, fst_size, run->fst.data(), DiscIO::PARTITION_NONE);
+    }
+  }
+  if (run->fst.empty())
+  {
+    run->use_state = false;
+    run->sig.clear();
+  }
+  if (run->use_state)
+  {
+    std::string old;
+    if (!File::ReadFileToString(run->state_fst, old) || old.size() != run->fst.size())
+    {
+      Status(run->nonce, "note", "fast start not possible for this track (other files): full boot");
+      boot = BootParameters::GenerateFromFile(root + "er-test.json");
+      run->use_state = false;
+    }
+  }
+  run->t_boot = NowMs();
+  Status(run->nonce, "boot",
+         fmt::format("{} ({}) on {}", run->use_state ? "fast start from the save state" : "full boot",
+                     run->title, base_path),
+         run->t_request);
+  {
+    std::lock_guard lk(s_mutex);
+    s_run = nullptr;  // the running test (if any) stops driving at once; OnBoot hands the new one over
+    s_buttons = 0;
+    s_unthrottled = false;
+    s_next = run;
+  }
+  s_last_nonce = run->nonce;
+  return boot;
+}
+
+std::unique_ptr<BootParameters> Load(const std::string& package, std::string* message)
+{
+  return LoadImpl(package, message);
+}
+}  // namespace
+
+std::unique_ptr<BootParameters> Poll(std::string* message)
+{
+  message->clear();
+  if (!s_active)
+    return nullptr;
+  // requests handed over by later launches
+  for (const std::string& w : Common::DoFileSearch(Dir(), ".wake", false))
+  {
+    std::string arg;
+    if (File::ReadFileToString(w, arg))
+      s_pending_args.push_back(arg);
+    File::Delete(w);
+  }
+  for (const std::string& arg : s_pending_args)
+  {
+    if (arg.ends_with(".ertest") && File::Exists(arg))
+    {
+      const std::string nonce = NonceOf(arg);
+      std::erase_if(s_waiting, [&](const auto& w) { return w.first == nonce; });
+      s_pending_args.erase(std::find(s_pending_args.begin(), s_pending_args.end(), arg));
+      return Load(arg, message);
+    }
+    const std::string nonce = NonceOf(arg);
+    if (!nonce.empty() &&
+        std::none_of(s_waiting.begin(), s_waiting.end(), [&](const auto& w) { return w.first == nonce; }))
+    {
+      s_waiting.emplace_back(nonce, NowMs());
+      Status(nonce, "waiting", "waiting for the builder's package");
+    }
+  }
+  s_pending_args.clear();
+  // the newest request wins; older ones are dropped
+  if (s_waiting.size() > 1)
+    s_waiting.erase(s_waiting.begin(), s_waiting.end() - 1);
+  if (s_waiting.empty())
+  {
+    // a test Dolphin that is already open also takes a new package without its link (the link may still be on
+    // its way through the desktop): any er-test-*.ertest that arrived since this Dolphin started
+    std::error_code ec;
+    for (const std::string& d : s_download_dirs)
+      for (const auto& e : std::filesystem::directory_iterator(d, ec))
+      {
+        const std::string n = e.path().filename().string();
+        if (!n.starts_with("er-test-") || !n.ends_with(".ertest") || !e.is_regular_file(ec) || e.file_size(ec) < 16)
+          continue;
+        const auto age = std::filesystem::file_time_type::clock::now() - e.last_write_time(ec);
+        const std::string nonce = NonceOf(n);
+        if (ec || nonce.empty() || nonce == s_last_nonce || age > std::chrono::minutes(2) ||
+            e.last_write_time(ec) < s_begin_file)
+          continue;
+        auto boot = Load(e.path().string(), message);
+        File::Delete(e.path().string(), File::IfAbsentBehavior::NoConsoleWarning);
+        return boot;
+      }
+    return nullptr;
+  }
+  const auto [nonce, since] = s_waiting.back();
+  const std::string pkg = FindPackage(nonce);
+  if (!pkg.empty())
+  {
+    s_waiting.clear();
+    auto boot = Load(pkg, message);
+    File::Delete(pkg, File::IfAbsentBehavior::NoConsoleWarning);  // keeps Downloads tidy (no harm if read-only)
+    return boot;
+  }
+  const s64 now = NowMs();
+  if (now - since > 240000)
+  {
+    s_waiting.clear();
+    *message = "no package arrived from the builder in 4 minutes. If your browser asks where to save "
+               "downloads, open the downloaded .ertest file with this Dolphin instead.";
+  }
+  else if (now - since > 45000 && now - s_last_wait_note > 30000)
+  {
+    s_last_wait_note = now;
+    *message = "still waiting for the builder (looking in your Downloads folder for er-test-" + nonce +
+               ".ertest)";
+  }
+  return nullptr;
+}
+
+// ---------------------------------------------------------------- CPU thread
+void OnFrame(Core::System& system)
+{
+  if (!s_active)
+    return;
+  std::shared_ptr<Run> run;
+  {
+    std::lock_guard lk(s_mutex);
+    run = s_run;
+  }
+  Runner& r = s_runner;
+  if (r.run != run)
+  {
+    r = Runner{};
+    r.run = run;
+  }
+  if (run && r.phase == 3 && r.capture > 0)
+  {
+    --r.capture;
+    if (r.frame++ % 30 == 0)
+    {
+      const std::string name = fmt::format("ertest-{}-{:04d}", run->nonce, r.frame / 30);
+      Core::QueueHostJob([name](Core::System& sys) {
+        if (Core::GetState(sys) == Core::State::Running)
+          Core::SaveScreenShot(name);
+      });
+    }
+    const char* d = getenv("ERTEST_DEMO_DRIVE");
+    s_buttons = (d && d[0] == '1' && r.capture > 0) ? PAD_BUTTON_A : 0;
+    return;
+  }
+  if (!run || r.phase == 3)
+    return;
+  if (r.phase == 0)
+  {
+    ++r.frame;
+    if (run->use_state)
+    {
+      if (ApplyFastWrites(system, r))
+      {
+        Status(run->nonce, "state", "save state in, pointed at the test track", run->t_request);
+        s_unthrottled = true;
+        r.phase = 2;
+        r.step = 0;
+        r.frame_in_step = 0;
+        return;
+      }
+      if (r.frame < 30)
+        return;  // the state may need a few frames
+      Status(run->nonce, "note", "the save state did not load: full boot", run->t_request);
+      File::Delete(run->state_path);
+      File::Delete(run->state_meta);
+    }
+    s_unthrottled = true;
+    r.phase = 1;
+    r.step = 0;
+    r.frame_in_step = 0;
+  }
+  if (r.phase == 1)
+  {
+    if (StepScript(system, r, run->boot) && r.phase != 3)
+    {
+      Status(run->nonce, "menus", "at the cup select", run->t_request);
+      r.phase = 2;
+      r.step = 0;
+      r.frame_in_step = 0;
+    }
+    return;
+  }
+  if (r.phase == 2 && r.t2 == 0)
+    r.t2 = NowMs();
+  if (r.phase == 2)
+    ++r.frames2;
+  if (r.phase == 2 && StepScript(system, r, run->race) && r.phase != 3)
+  {
+    Finish(r, true, "in the race");
+    r.capture = CaptureFrames();
+    r.frame = 0;
+  }
+}
+
+bool SwapInto(Core::System& system, std::unique_ptr<BootParameters>& boot)
+{
+  std::shared_ptr<Run> next;
+  {
+    std::lock_guard lk(s_mutex);
+    next = s_next;
+  }
+  if (!next || !next->use_state || !boot || !std::holds_alternative<BootParameters::Disc>(boot->parameters) ||
+      Core::GetState(system) == Core::State::Uninitialized)
+    return false;
+  auto& disc = std::get<BootParameters::Disc>(boot->parameters);
+  if (!disc.volume || disc.volume->GetGameID() != GAME_ID)
+    return false;
+  std::unique_ptr<DiscIO::VolumeDisc> vol = std::move(disc.volume);
+  boot.reset();
+  // the running game keeps its renderer: the new disc goes in and the cup-select state loads over it
+  Core::RunOnCPUThread(system, [&system, vol = std::move(vol), next]() mutable {
+    system.GetDVDInterface().SetDisc(std::move(vol), {});
+    State::LoadAs(system, next->state_path);
+    OnBoot();
+  });
+  Status(next->nonce, "swap", "new disc in the running Dolphin, save state loading", next->t_request);
+  return true;
+}
+
+void OnBoot()
+{
+  std::lock_guard lk(s_mutex);
+  if (s_next)
+  {
+    s_run = std::move(s_next);
+    s_next = nullptr;
+  }
+}
+
+bool Unthrottled()
+{
+  return s_unthrottled;
+}
+
+void FilterPad(int chan, GCPadStatus* pad)
+{
+  if (chan != 0 || !s_active)
+    return;
+  const u16 b = s_buttons;
+  if (!b)
+    return;
+  pad->button |= b;
+  if (b & PAD_BUTTON_A)
+    pad->analogA = 0xFF;
+  if (b & PAD_BUTTON_B)
+    pad->analogB = 0xFF;
+}
