+// ---- Evolution Racing lit17s39 WEATHER 3 BEGIN ----
+// ---- Evolution Racing lit17s39 WEATHER 3 (lighting_mod/weather2/W39.md): weather stages + blends, presets, persistent surface
+// water, gust fronts. One state, shaped once a frame inside WeatherNow() (every pass sees the same weather):
+//   - PRESETS: menu / table codes 25..29 are combos: the passes see the BASE type (25 Neon Monsoon -> rain 1, 26 Solar
+//     Veil -> aurora 12, 27 Ashfall+ -> ash 11, 28 Above the Clouds -> fog banks 16, 29 Event Horizon -> gravity well
+//     23); W39Preset() = the preset code, and actions whose "types" list the preset code also draw (weather2 effects,
+//     lightning strikes, meteor storm / impacts).
+//   - BLENDS: a mid-race weather change (pause menu / test sequence) fades the shown weather out (precipitation
+//     first, wind, the clouds last; clouds are carried over when both are cloudy) and the new one in (clouds first,
+//     then wind + the gust front, then precipitation). Race start / course change / retry: snapped (as before).
+//   - STAGES: GFX.ini [PC5090] WeatherEvolution = Static (default: peak for good) | Dynamic (approach -> onset ->
+//     peak -> clearing -> lull cycles, seeded per course + cycle) with SEPARATE curves for clouds, wind,
+//     precipitation and the gust-front strength; the surface water dries on its own clock.
+//   - SURFACE WATER: wet film depth (reflections deepen as it builds), puddle coverage (forms slowly once the road is
+//     wet) and drying progress (dry patches spread once the rain stops, puddles last longest) - integrated over game
+//     time from the precipitation; the road stays wet after the rain stops (the weather pass keeps drawing ONLY the
+//     wet road while the shown weather does not draw its own: W39WetOnly).
+//   - GUST FRONTS: planes perpendicular to the wind moving down-wind (14-44 m/s), one every P m (only one inside a
+//     course at a time), strength per front; every weather shader samples the same front (rain, spray, ash, sand,
+//     smoke all pushed by it).
+// GFX.ini [PC5090]: Weather3 = On (default) | Off (exactly the lit17s38 behaviour: no shaping, no pack);
+//   W39FrontAt = N (TESTS: the nearest front N m down-wind of the camera at the race start);
+//   W39TimeScale = 1 (TESTS: stage / blend clocks x N); W39WetScale = 1 (TESTS: the surface water clock x N); WeatherTestSeq = "S:CODE S:CODE .." (TESTS: the
+//   requested weather replaced by CODE from game second S of the race); trace: touch USERDIR/pc5090w39trace.
+// Uniform pack (eq_dm_aux[12..15], unused by weather actions) on every weather-family action, marker 39:
+//   [12] = (clouds, wind, precipitation, 39)   [13] = (wet film, puddles, drying 0..1, 1 = wet road only)
+//   [14] = (front dir x, front dir z, front position S m along it, spacing P m)
+//   [15] = (front strength 0..1, front speed m/s, preset code, snow cover 0..1 (builds while it snows))
+struct W39Preset
+{
+  int code, base;
+};
+constexpr W39Preset W39_PRESETS[] = {{25, 1}, {26, 12}, {27, 11}, {28, 16}, {29, 23}};
+struct W39State
+{
+  bool on = false, active = false, have_f = false;
+  u64 cfg_frame = ~0ull, seen_frame = ~0ull;
+  u32 slot = 0xFFFF, last_f = 0, off_frames = 1000;
+  double gt = 0.0, t0 = 0.0, race_t0 = 0.0;
+  std::array<float, 4> shown{};
+  int req_code = 0, shown_code = 0, shown_base = 0, preset = 0;
+  float env = 1.0f;
+  int phase = 0;  // 0 steady, 1 fading the shown weather out, 2 fading the new one in
+  bool carry = false, dynamic = false;
+  float cloud = 1.0f, wind = 1.0f, precip = 1.0f, front = 1.0f, w2amount = 1.0f, req_int = 0.0f;
+  int stage = 2;
+  float sprog = 0.0f;
+  float wet = 0.0f, pud = 0.0f, dry = 1.0f, snow = 0.0f;
+  float sc = 1.0f, sw = 1.0f, sp = 1.0f, sf = 0.0f;  // smoothed components
+  float fs = 0.0f, fp = 3600.0f, fv = 20.0f;
+  std::array<float, 2> fe{0.0f, 1.0f};
+  float scale = 1.0f, wscale = 1.0f, front_at = 0.0f;
+  bool front_place = false;
+  std::vector<std::pair<float, int>> seq;
+  std::string seq_src;
