+
+// "Test in game" for the Evolution Racing track builder.
+//
+// The builder (in the member's browser, built from the member's own disc image) writes a small package
+// "er-test-<id>.ertest" (the changed game files + a run script) to the Downloads folder and opens
+// evoracing://test/<id>. This Dolphin picks the package up, finds the member's own F-Zero GX disc in its game
+// folders, boots it with the package as a Riivolution file overlay (nothing is written to the disc image) and
+// drives the menus into the race. A save state taken at the first run (on the member's machine, from their disc)
+// makes later runs start in seconds. Only one test Dolphin runs: a second launch hands its request to the first.
+
+#pragma once
+
+#include <memory>
+#include <string>
+#include <vector>
+
+struct BootParameters;
+struct GCPadStatus;
+
+namespace Core
+{
+class System;
+}
+
+namespace ERTest
+{
+// ---------------------------------------------------------------- host (UI) thread
+// "evoracing:..." URL or a path ending in .ertest
+bool IsLaunchArg(const std::string& arg);
+// Takes the single-instance test lock. Returns false when another test Dolphin holds it: the argument was handed
+// to that one and this process should exit.
+bool ClaimOrForward(const std::string& arg);
+// Test mode on for this process, with the launch argument (URL or package path).
+void Begin(const std::string& arg);
+bool Active();
+// Folders the browser downloads into (Downloads of the current user).
+void SetDownloadDirs(std::vector<std::string> dirs);
+// Called a few times a second while Active(): returns the boot of a new test when one is ready. *message gets a
+// short line for the user when something went wrong (empty otherwise).
+std::unique_ptr<BootParameters> Poll(std::string* message);
+// The running emulation takes the new test without stopping (new disc + the cup-select save state). False = not
+// possible (no save state for it, nothing running): stop and boot `boot` as usual.
+bool SwapInto(Core::System& system, std::unique_ptr<BootParameters>& boot);
+// Windows: register evoracing:// and .ertest for this Dolphin.exe (current user, no admin). Elsewhere a no-op.
+void RegisterHandlers();
+
+// ---------------------------------------------------------------- CPU thread
+// A new emulation started (after a save state, if any, is in): the test loaded for it takes over.
+void OnBoot();
+void OnFrame(Core::System& system);
+bool Unthrottled();
+void FilterPad(int chan, GCPadStatus* pad);
+}  // namespace ERTest
