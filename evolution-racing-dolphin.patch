+// Evolution Racing lit17s5: custom shader texts are interned, immutable and shared. A draw used to copy
+// each ~60 KB machine shader text 3-4 times and compare it in full against the pipeline cache;
+// with ~41 machines on the machine select that was most of every frame. Equal text = same
+// pointer (InternShaderText), so copies are reference counts and == is a pointer compare.
+using ShaderText = std::shared_ptr<const std::string>;
+inline ShaderText InternShaderText(std::string_view text)
+{
+  if (text.empty())
+    return nullptr;
+  static std::mutex mutex;
+  static std::unordered_map<std::string, ShaderText> table;
+  std::lock_guard lk(mutex);
+  auto it = table.find(std::string(text));
+  if (it == table.end())
+    it = table.emplace(std::string(text), std::make_shared<const std::string>(text)).first;
+  return it->second;
+}
+inline const std::string& ShaderTextOf(const ShaderText& text)
+{
+  static const std::string empty;
+  return text ? *text : empty;
