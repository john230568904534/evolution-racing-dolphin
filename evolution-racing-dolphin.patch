+// ---------------------------------------------------------------- full-rate run telemetry
+namespace
+{
+struct ProbeField
+{
+  std::string name;
+  std::vector<s32> path;  // from the racer: deref every offset but the last
+  int type = 0;           // 0 u32/s32, 1 f32, 2 u8, 3 u16
+  double scale = 1;
+};
+struct Probe
+{
+  std::vector<u32> base;    // a = u32(base[0]); a = u32(a + base[i]) ...: the player's racer
+  u32 counter = 0;          // u32: 0 outside a race, counts from the countdown
+  std::vector<s32> end_path;
+  u32 end_mask = 0;         // the racer word that says finished / retired
+  std::vector<ProbeField> fields;
+  int max_frames = 72000;
+};
+struct Run
+{
+  std::vector<s32> values;  // frame-major, fields.size() per frame
+  int frames = 0;
+  int finish = -1;          // frame index the finish word was first set
+};
+
+std::mutex s_run_mutex;
+std::shared_ptr<const Probe> s_probe;
+std::atomic<bool> s_probe_ok{false};
+std::vector<s32> s_ring;    // CPU thread only: the last max_frames frames
+size_t s_ring_pos = 0, s_ring_count = 0;
+const void* s_ring_probe = nullptr;
+bool s_finished = false;
+int s_after = -1;
+std::deque<Run> s_runs;     // finished (guarded by s_run_mutex)
+
+// User/ERGhosts/runs.log: one line per run event (a few per race; diagnostics for members and for us)
+void RunLog(const std::string& line)
+{
+  File::IOFile f(Dir() + "runs.log", "ab");
+  if (f.IsOpen() && f.GetSize() < (256u << 10))
+    f.WriteString(line + "\n");
+}
+
+bool RdU32(Core::System& system, u32 addr, u32* out)
+{
+  if (addr < 0x80000000 || addr > 0x817FFFFC)
+    return false;
+  u32 v;
+  system.GetMemory().CopyFromEmu(&v, addr, 4);
+  *out = Common::swap32(v);
+  return true;
+}
+
+bool Resolve(Core::System& system, u32 racer, const std::vector<s32>& path, u32* addr)
+{
+  u32 a = racer;
+  for (size_t i = 0; i + 1 < path.size(); ++i)
+    if (!RdU32(system, a + static_cast<u32>(path[i]), &a) || a < 0x80000000)
+      return false;
+  *addr = a + static_cast<u32>(path.empty() ? 0 : path.back());
+  return true;
+}
+
+s32 ReadField(Core::System& system, u32 racer, const ProbeField& f)
+{
+  u32 a = 0;
+  if (!Resolve(system, racer, f.path, &a) || a < 0x80000000 || a > 0x817FFFFC)
+    return 0;
+  auto& mem = system.GetMemory();
+  switch (f.type)
+  {
+  case 1:
+  {
+    u32 v;
+    mem.CopyFromEmu(&v, a, 4);
+    v = Common::swap32(v);
+    float fl;
+    std::memcpy(&fl, &v, 4);
+    if (!std::isfinite(fl))
+      return 0;
+    const double d = std::clamp(static_cast<double>(fl) * f.scale, -2.0e9, 2.0e9);
+    return static_cast<s32>(std::lround(d));
+  }
+  case 2:
+  {
+    u8 v;
+    mem.CopyFromEmu(&v, a, 1);
+    return v;
+  }
+  case 3:
+  {
+    u16 v;
+    mem.CopyFromEmu(&v, a, 2);
+    return Common::swap16(v);
+  }
+  default:
+  {
+    u32 v;
+    mem.CopyFromEmu(&v, a, 4);
+    return static_cast<s32>(Common::swap32(v));
+  }
+  }
+}
+
+void PutVar(std::vector<u8>& out, u32 v)
+{
+  while (v >= 0x80)
+  {
+    out.push_back(static_cast<u8>(v | 0x80));
+    v >>= 7;
+  }
+  out.push_back(static_cast<u8>(v));
+}
+
+std::vector<s32> Ints(const picojson::value& v)
+{
+  std::vector<s32> out;
+  if (v.is<picojson::array>())
+    for (const auto& x : v.get<picojson::array>())
+      if (x.is<double>())
+        out.push_back(static_cast<s32>(static_cast<long long>(x.get<double>())));
+  return out;
+}
+}  // namespace
+
+std::vector<u8> Zstd(const std::vector<u8>& raw)
+{
+  std::vector<u8> out(ZSTD_compressBound(raw.size()));
+  const size_t n = ZSTD_compress(out.data(), out.size(), raw.data(), raw.size(), 9);
+  if (ZSTD_isError(n))
+    return {};
+  out.resize(n);
+  return out;
+}
+
+bool LoadProbe(const std::string& json)
+{
+  picojson::value v;
+  if (!picojson::parse(v, json).empty() || !v.is<picojson::object>())
+    return false;
+  const auto& o = v.get<picojson::object>();
+  auto get = [&](const char* k) -> const picojson::value& {
+    static const picojson::value none;
+    const auto it = o.find(k);
+    return it == o.end() ? none : it->second;
+  };
+  auto p = std::make_shared<Probe>();
+  for (s32 x : Ints(get("base")))
+    p->base.push_back(static_cast<u32>(x));
+  if (get("counter").is<double>())
+    p->counter = static_cast<u32>(static_cast<long long>(get("counter").get<double>()));
+  p->end_path = Ints(get("end_path"));
+  if (get("end_mask").is<double>())
+    p->end_mask = static_cast<u32>(static_cast<long long>(get("end_mask").get<double>()));
+  if (get("max_frames").is<double>())
+    p->max_frames = std::clamp(static_cast<int>(get("max_frames").get<double>()), 600, 216000);
+  if (get("fields").is<picojson::array>())
+    for (const auto& f : get("fields").get<picojson::array>())
+    {
+      if (!f.is<picojson::object>())
+        continue;
+      const auto& fo = f.get<picojson::object>();
+      ProbeField fl;
+      if (fo.count("n") && fo.at("n").is<std::string>())
+        fl.name = fo.at("n").get<std::string>();
+      if (fo.count("p"))
+        fl.path = Ints(fo.at("p"));
+      if (fo.count("t") && fo.at("t").is<std::string>())
+      {
+        const std::string ty = fo.at("t").get<std::string>();
+        fl.type = ty == "f32" ? 1 : ty == "u8" ? 2 : ty == "u16" ? 3 : 0;
+      }
+      if (fo.count("s") && fo.at("s").is<double>())
+        fl.scale = fo.at("s").get<double>();
+      if (!fl.name.empty() && !fl.path.empty() && p->fields.size() < 48)
+        p->fields.push_back(std::move(fl));
+    }
+  if (p->base.empty() || p->counter < 0x80000000 || p->fields.empty())
+    return false;
+  {
+    std::lock_guard lk(s_run_mutex);
+    s_probe = p;
+  }
+  File::CreateFullPath(Dir());
+  File::WriteStringToFile(Dir() + "probe.json", json);
+  return true;
+}
+
+bool HasProbe()
+{
+  std::lock_guard lk(s_run_mutex);
+  return s_probe != nullptr;
+}
+
+void EnableRecording(bool on)
+{
+  std::lock_guard lk(s_run_mutex);
+  s_probe_ok = on && s_probe != nullptr;
+}
+
+void OnFrame(Core::System& system)
+{
+  // Every frame of the player's racer goes into a ring of the probe's max_frames (about 5 MB); when the finish word rises,
+  // the ring up to 30 frames after it becomes a run. No start signal is needed: the ghost's own length (and the hub,
+  // which lines the run up with the ghost's positions) says where the race began.
+  if (!s_probe_ok)
+    return;  // no probe (not linked / ghosts off): nothing read
+  std::shared_ptr<const Probe> p;
+  {
+    std::lock_guard lk(s_run_mutex);
+    p = s_probe;
+  }
+  if (!p)
+    return;
+  const size_t nf = p->fields.size(), cap = static_cast<size_t>(p->max_frames);
+  if (s_ring_probe != p.get())
+  {
+    s_ring.assign(cap * nf, 0);
+    s_ring_pos = s_ring_count = 0;
+    s_ring_probe = p.get();
+    s_finished = false;
+    s_after = -1;
+  }
+  u32 racer = 0;
+  bool ok = RdU32(system, p->base[0], &racer);
+  for (size_t i = 1; ok && i < p->base.size(); ++i)
+    ok = RdU32(system, racer + p->base[i], &racer) && racer >= 0x80000000;
+  s32* row = &s_ring[s_ring_pos * nf];
+  bool fin = false;
+  if (ok)
+  {
+    for (size_t i = 0; i < nf; ++i)
+      row[i] = ReadField(system, racer, p->fields[i]);
+    u32 a = 0, w = 0;
+    fin = p->end_mask && Resolve(system, racer, p->end_path, &a) && RdU32(system, a, &w) && (w & p->end_mask);
+  }
+  else
+  {
+    std::fill(row, row + nf, 0);
+  }
+  s_ring_pos = (s_ring_pos + 1) % cap;
+  s_ring_count = std::min(s_ring_count + 1, cap);
+  if (fin && !s_finished && s_after < 0)
+  {
+    s_after = 30;  // the finish: keep 30 more frames (the machine coasting over the line)
+    RunLog(fmt::format("finish after {} frames in the ring", s_ring_count));
+  }
+  s_finished = fin;
+  if (s_after > 0 && --s_after == 0)
+  {
+    Run r;
+    r.frames = static_cast<int>(s_ring_count);
+    r.finish = r.frames - 31;
+    r.values.resize(s_ring_count * nf);
+    const size_t start = (s_ring_pos + cap - s_ring_count) % cap;
+    for (size_t k = 0; k < s_ring_count; ++k)
+      std::copy_n(&s_ring[((start + k) % cap) * nf], nf, &r.values[k * nf]);
+    std::lock_guard lk(s_run_mutex);
+    s_runs.push_back(std::move(r));
+    while (s_runs.size() > 3)
+      s_runs.pop_front();
+    s_after = -1;
+  }
+}
+
+std::vector<u8> TakeRunFor(int frames)
+{
+  std::lock_guard lk(s_run_mutex);
+  if (!s_probe)
+    return {};
+  RunLog(fmt::format("ghost of {} frames: {} run(s) kept", frames, s_runs.size()));
+  for (auto it = s_runs.rbegin(); it != s_runs.rend(); ++it)
+  {
+    const int lead = it->finish - frames;  // GO, as far as the finish says
+    RunLog(fmt::format("  run: {} frames, finish {}, GO at {}", it->frames, it->finish, lead));
+    if (lead < 0)
+      continue;
+    // only the race: from 10 s before GO to the end
+    const int cut = std::max(0, lead - 600);
+    if (cut > 0)
+    {
+      const size_t nf0 = s_probe->fields.size();
+      it->values.erase(it->values.begin(), it->values.begin() + static_cast<std::ptrdiff_t>(cut * nf0));
+      it->frames -= cut;
+      it->finish -= cut;
+    }
+    const size_t nf = s_probe->fields.size();
+    picojson::array names, scales;
+    for (const ProbeField& f : s_probe->fields)
+    {
+      names.emplace_back(f.name);
+      scales.emplace_back(f.scale);
+    }
+    picojson::object hdr;
+    hdr["v"] = picojson::value(1.0);
+    hdr["fields"] = picojson::value(names);
+    hdr["scale"] = picojson::value(scales);
+    hdr["frames"] = picojson::value(static_cast<double>(it->frames));
+    hdr["finish"] = picojson::value(static_cast<double>(it->finish));
+    hdr["ghost_frames"] = picojson::value(static_cast<double>(frames));
+    hdr["build"] = picojson::value(Common::GetERBuildStr());
+    const std::string h = picojson::value(hdr).serialize();
+    std::vector<u8> raw = {'E', 'R', 'R', 'U', 'N', '1', 0, 0};
+    const u32 hl = static_cast<u32>(h.size());
+    for (int b = 0; b < 4; ++b)
+      raw.push_back(static_cast<u8>(hl >> (8 * b)));
+    raw.insert(raw.end(), h.begin(), h.end());
+    for (size_t c = 0; c < nf; ++c)
+    {
+      s32 prev = 0;
+      for (int fr = 0; fr < it->frames; ++fr)
+      {
+        const s32 v = it->values[static_cast<size_t>(fr) * nf + c];
+        const s32 d = static_cast<s32>(static_cast<u32>(v) - static_cast<u32>(prev));
+        PutVar(raw, (static_cast<u32>(d) << 1) ^ static_cast<u32>(d >> 31));
+        prev = v;
+      }
+    }
+    Run taken = std::move(*it);
+    s_runs.erase(std::next(it).base());
+    return Zstd(raw);
+  }
+  return {};
+}
