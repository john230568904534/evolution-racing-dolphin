+// ---------------------------------------------------------------- the hub
+CheckResult Check(const ERGhosts::Settings& s)
+{
+  CheckResult r;
+  if (s.offline)
+  {
+    r.error = "Play offline is on";
+    return r;
+  }
+  if (s.token.empty())
+  {
+    r.error = "this Dolphin is not linked to the hub";
+    return r;
+  }
+  if (!UpdateHubAllowed(s.hub))
+  {
+    r.error = "updates come only from the project's hub" +
+              (ERGhosts::OfficialHub().empty() ? std::string() : " " + ERGhosts::OfficialHub()) + " (this Dolphin is linked to " + s.hub + ")";
+    return r;
+  }
+  Common::HttpRequest req(std::chrono::milliseconds(30000));
+  if (!req.IsValid())
+  {
+    r.error = "the network library did not start";
+    return r;
+  }
+  picojson::object body;
+  body["platform"] = picojson::value(Platform());
+  body["build"] = picojson::value(Common::GetERBuildStr());
+  body["installed"] = picojson::value(ReadJsonObject(InstalledPath()));
+  const std::string payload = picojson::value(body).serialize();
+  Common::HttpRequest::Headers h = {{"X-ER-Dolphin", s.token},
+                                    {"X-ER-Build", Common::GetERBuildStr()},
+                                    {"X-ER-Ghosts", "1"},
+                                    {"Content-Type", "application/json"},
+                                    {"Accept", "application/json"},
+                                    {"Expect", std::nullopt}};
+  const auto resp = req.Post(Strip(s.hub) + "/hub/api/erd/updates", std::string_view(payload), h,
+                             Common::HttpRequest::AllowedReturnCodes::All);
+  if (!resp)
+  {
+    r.error = "the hub did not answer (no network?)";
+    return r;
+  }
+  r.status = req.GetLastResponseCode();
+  const std::string text(resp->begin(), resp->end());
+  picojson::value v;
+  if (!picojson::parse(v, text).empty() || !v.is<picojson::object>())
+  {
+    r.error = fmt::format("the hub answered HTTP {}", r.status);
+    return r;
+  }
+  const auto& o = v.get<picojson::object>();
+  if (r.status != 200)
+  {
+    r.error = Str(o, "error");
+    r.relink = r.status == 401;
+    if (r.error.empty())
+      r.error = fmt::format("the hub answered HTTP {}", r.status);
+    return r;
+  }
+  const auto it = o.find("items");
+  if (it == o.end() || !it->second.is<picojson::array>())
+    return r;
+  for (const auto& x : it->second.get<picojson::array>())
+  {
+    if (!x.is<picojson::object>())
+      continue;
+    const auto& io = x.get<picojson::object>();
+    Item i;
+    i.id = Str(io, "id");
+    i.kind = Str(io, "kind");
+    i.title = Str(io, "title");
+    i.detail = Str(io, "detail");
+    i.version = Str(io, "version");
+    i.url = Str(io, "url");
+    i.sha256 = Str(io, "sha256");
+    i.needs = Str(io, "needs");
+    i.note = Str(io, "note");
+    i.blocked = Str(io, "blocked");
+    i.file = Str(io, "file");
+    i.size = Num(io, "size");
+    i.required = Bool(io, "required");
+    i.preparing = Bool(io, "preparing");
+    i.after_dolphin = Bool(io, "after_dolphin");
+    i.er_version = Str(io, "er_version");
+    static const std::set<std::string> kinds = {"dolphin", "effects", "hd", "machines", "track-hd", "scenery"};
+    if (!kinds.contains(i.kind) || !i.url.starts_with("/hub/api/erd/get/"))
+      continue;
+    r.items.push_back(std::move(i));
+  }
+  return r;
+}
+
+bool Download(const ERGhosts::Settings& s, const Item& it, std::string* path, std::string* error, const ProgressFn& progress,
+              const std::atomic<bool>* cancel)
+{
+  if (s.offline)
+  {
+    *error = "Play offline is on";
+    return false;
+  }
+  if (!UpdateHubAllowed(s.hub) || s.token.empty())
+  {
+    *error = "not linked to the project's hub";
+    return false;
+  }
+  if (!it.Ready())
+  {
+    *error = it.note.empty() ? "not ready on the hub yet" : it.note;
+    return false;
+  }
+  const std::string dl = Dir() + "dl/";
+  File::CreateFullPath(dl);
+  std::string ext = it.kind == "dolphin" ? (it.file.ends_with(".zip") ? ".zip" : ".tar.gz") : ".zip";
+  const std::string name = fmt::format("{}-{}{}", it.kind, it.sha256.substr(0, 16), ext);
+  const std::string done = dl + name, part = done + ".part";
+  if (File::Exists(done) && File::GetSize(done) == it.size && Common::ERDownload::Sha256File(done) == it.sha256)
+  {
+    *path = done;
+    return true;
+  }
+  // (the hub serves the member's own copy: the same sha256 as the manifest said, else the download is refused below)
+  std::map<std::string, std::string> h = {{"X-ER-Dolphin", s.token}, {"X-ER-Build", Common::GetERBuildStr()},
+                                          {"X-ER-Ghosts", "1"}};
+  Common::ERDownload::Result r;
+  for (int attempt = 0; attempt < 3; ++attempt)
+  {
+    r = Common::ERDownload::ToFile(Strip(s.hub) + it.url, h, part, true, progress, cancel);
+    if (r.error.empty() || r.error == "stopped" || (r.status >= 400 && r.status != 503))
+      break;
+  }
+  if (!r.error.empty())
+  {
+    std::string msg = r.error;
+    picojson::value v;
+    if (!r.body.empty() && picojson::parse(v, r.body).empty() && v.is<picojson::object>() &&
+        !Str(v.get<picojson::object>(), "error").empty())
+      msg = Str(v.get<picojson::object>(), "error");
+    if (r.status >= 400)
+      File::Delete(part);  // not the file: start over next time
+    *error = msg;
+    return false;
+  }
+  if (r.bytes != it.size)
+  {
+    *error = fmt::format("the download has {} bytes, the hub said {}: it will download again", r.bytes, it.size);
+    if (r.bytes > it.size)
+      File::Delete(part);
+    return false;
+  }
+  const std::string got = Common::ERDownload::Sha256File(part);
+  if (got != it.sha256)
+  {
+    File::Delete(part);
+    *error = "the download is damaged (its sha256 does not match the hub's): it will download again";
+    return false;
+  }
+  File::Delete(done);
+  if (!File::Rename(part, done))
+  {
+    *error = "could not keep the download";
+    return false;
+  }
+  Log(fmt::format("downloaded {} {} {} bytes sha256 {}", it.kind, it.version, it.size, it.sha256));
+  *path = done;
+  return true;
+}
+
+// ---------------------------------------------------------------- packs
+bool InstallPack(const Item& it, const std::string& zip, std::string* message)
+{
+  const std::string u = UserDir(), tex = u + "Load/Textures/", gm = u + "Load/GraphicMods/";
+  Zip z(zip);
+  if (!z.error.empty())
+  {
+    *message = z.error;
+    return false;
+  }
+  u64 need = 0;
+  for (const auto& [n, sz] : z.entries)
+  {
+    if (!SafeName(n))
+    {
+      *message = "the pack holds a file name this Dolphin does not unpack: " + n;
+      return false;
+    }
+    need += sz;
+  }
+  std::error_code ec;
+  const auto space = fs::space(P(u), ec);
+  if (!ec && space.available < need + (200ull << 20))
+  {
+    *message = fmt::format("not enough free disk space ({} needed, {} free)", Human(need), Human(space.available));
+    return false;
+  }
+  picojson::object inst = ReadJsonObject(InstalledPath());
+  picojson::object upd = inst.count("updater") && inst["updater"].is<picojson::object>() ?
+                             inst["updater"].get<picojson::object>() :
+                             picojson::object{};
+  const s64 now = Now();
+  const std::string file = P(zip).filename().string();
+  Backup b;
+  std::vector<std::string> roots;
+  std::function<bool(const std::string&)> ok;
+  std::function<std::string(const std::string&)> to;
+  int expect = 0;
+  picojson::object man;
+  std::string keep_prev;
+
+  if (it.kind == "effects")
+  {
+    std::string mj;
+    if (!z.Read("Config/er-pack.json", &mj))
+    {
+      *message = "not an effects pack from the hub (no Config/er-pack.json)";
+      return false;
+    }
+    picojson::value v;
+    if (!picojson::parse(v, mj).empty() || !v.is<picojson::object>())
+    {
+      *message = "the effects pack's manifest is damaged";
+      return false;
+    }
+    man = v.get<picojson::object>();
+    if (!BuildHas(Common::GetERBuildStr(), Str(man, "needs")))
+    {
+      *message = "this effects pack needs Evolution Racing Dolphin " + Str(man, "needs") + " or newer";
+      return false;
+    }
+    expect = static_cast<int>(Num(man, "files"));
+    for (const char* d : EFFECT_DIRS)
+      roots.push_back(gm + d);
+    roots.push_back(tex + "0-GFZE01-strips");
+    for (const char* f : {"GraphicMods/GFZE01.json", "er-pack.json", "er-pack-settings.ini"})
+      roots.push_back(u + "Config/" + f);
+    ok = [](const std::string& n) {
+      if (n.starts_with("README"))
+        return false;
+      return n.starts_with("Load/GraphicMods/") || n.starts_with("Load/Textures/0-GFZE01-strips/") || n.starts_with("Config/");
+    };
+    for (const auto& [n, sz] : z.entries)
+      if (!n.ends_with("/") && !ok(n) && !n.starts_with("README"))
+      {
+        *message = "not an effects pack from the hub: " + n;
+        return false;
+      }
+    to = [u](const std::string& n) { return u + n; };
+    keep_prev = "effects";
+  }
+  else if (it.kind == "hd")
+  {
+    roots.push_back(tex + "GFZE01");
+    ok = [](const std::string& n) { return n.starts_with("GFZE01/"); };
+    to = [tex](const std::string& n) { return tex + n; };
+    for (const auto& [n, sz] : z.entries)
+      if (!n.ends_with("/") && !ok(n))
+      {
+        *message = "not an HD texture pack from the hub: " + n;
+        return false;
+      }
+  }
+  else if (it.kind == "machines")
+  {
+    roots.push_back(tex + "GFZE01/00-machine-remasters");
+    ok = [](const std::string& n) { return n.starts_with("GFZE01/00-machine-remasters/"); };
+    to = [tex](const std::string& n) { return tex + n; };
+  }
+  else if (it.kind == "track-hd")
+  {
+    ok = [](const std::string& n) { return n.starts_with("GFZE01/"); };
+    to = [tex](const std::string& n) { return tex + n; };
+    for (const auto& [n, sz] : z.entries)
+      if (!n.ends_with("/") && ok(n))
+        roots.push_back(tex + n);  // single files: each one set aside when it is there already
+  }
+  else if (it.kind == "scenery")
+  {
+    roots.push_back(gm + "GFZE01-fx/scenery");
+    ok = [](const std::string& n) { return n.starts_with("scenery/"); };
+    to = [gm](const std::string& n) { return gm + "GFZE01-fx/" + n; };
+  }
+  else
+  {
+    *message = "unknown pack kind " + it.kind;
+    return false;
+  }
+  if (!b.Take(it.kind, roots))
+  {
+    *message = b.error;
+    return false;
+  }
+  std::vector<std::string> written;
+  const int n = z.Extract(ok, to, &written);
+  std::string fail;
+  if (n < 0)
+    fail = z.error;
+  else if (n == 0)
+    fail = "the pack has nothing to install";
+  else if (expect && n != expect)
+    fail = fmt::format("{} of {} files: the pack is incomplete", n, expect);
+  if (!fail.empty())
+  {
+    b.Restore();
+    Log("install failed, rolled back: " + it.kind + " " + it.version + ": " + fail);
+    *message = fail + ". Nothing changed: what you had is back.";
+    return false;
+  }
+  // the HD pack replaces GFZE01: the machine remasters inside it come back
+  if (it.kind == "hd")
+  {
+    for (const auto& [orig, bak] : b.moved)
+    {
+      const fs::path mr = P(bak) / "00-machine-remasters";
+      if (orig == Strip(tex + "GFZE01") && fs::is_directory(mr, ec) && !fs::exists(P(tex + "GFZE01/00-machine-remasters"), ec))
+        fs::rename(mr, P(tex + "GFZE01/00-machine-remasters"), ec);
+    }
+  }
+  // what is installed now (the same keys the start scripts write)
+  if (it.kind == "effects")
+  {
+    picojson::object e;
+    e["at"] = picojson::value(static_cast<double>(now));
+    e["file"] = picojson::value(file);
+    e["legacy"] = picojson::value(false);
+    for (const char* k : {"needs", "effects_build", "made", "tier", "chosen", "labels", "total"})
+      if (man.count(k))
+        e[k] = man[k];
+    inst["effects"] = picojson::value(e);
+    const auto ch = man.count("chosen") && man["chosen"].is<picojson::array>() ? man["chosen"].get<picojson::array>().size() : 0;
+    StatusLine("Effects pack:", fmt::format("Effects pack: {} of {} effects{} (installed {})", ch, Str(man, "total"),
+                                            Str(man, "tier").empty() ? "" : ", " + Str(man, "tier"), Day()));
+  }
+  else if (it.kind == "hd")
+  {
+    picojson::object h;
+    const std::string tier = it.url.find("tier=high") != std::string::npos ? "high" : "standard";
+    h["at"] = picojson::value(static_cast<double>(now));
+    h["file"] = picojson::value(file);
+    h["files"] = picojson::value(static_cast<double>(n));
+    h["tier"] = picojson::value(tier);
+    inst["hd"] = picojson::value(h);
+    StatusLine("HD textures:", fmt::format("HD textures: {} ({} files, {})", tier == "high" ? "High" : "Standard", n, Day()));
+  }
+  else if (it.kind == "machines" || it.kind == "track-hd")
+  {
+    picojson::array extra = inst.count("hd_extra") && inst["hd_extra"].is<picojson::array>() ? inst["hd_extra"].get<picojson::array>() :
+                                                                                               picojson::array{};
+    picojson::object x;
+    x["at"] = picojson::value(static_cast<double>(now));
+    x["file"] = picojson::value(it.kind == "machines" ? std::string("Machine-remasters-updater.zip") : file);
+    x["files"] = picojson::value(static_cast<double>(n));
+    extra.push_back(picojson::value(x));
+    inst["hd_extra"] = picojson::value(extra);
+  }
+  else if (it.kind == "scenery")
+  {
+    picojson::object sc;
+    sc["at"] = picojson::value(static_cast<double>(now));
+    sc["file"] = picojson::value(file);
+    sc["slots"] = picojson::value(static_cast<double>(n));
+    inst["scenery"] = picojson::value(sc);
+  }
+  upd[it.kind] = picojson::value(it.version);
+  // the setup's Evolution Racing X.Y.Z: the newest pack version installed (Common::GetERSetupVersion reads it)
+  if (!it.er_version.empty() && it.kind != "dolphin" &&
+      (!inst.count("er_version") || !inst["er_version"].is<std::string>() ||
+       Common::ERVersionCompare(it.er_version, inst["er_version"].get<std::string>()) > 0))
+    inst["er_version"] = picojson::value(it.er_version);
+  inst["updater"] = picojson::value(upd);
+  WriteJson(InstalledPath(), inst);
+  Common::ERVersionChanged();
+  WriteMetadata();
+  b.Drop(keep_prev);
+  Log(fmt::format("installed {} {} ({} files)", it.kind, it.version, n));
+  *message = fmt::format("{} installed ({} files)", it.title.empty() ? it.kind : it.title, n);
+  return true;
+}
+
+void KeepForNewDolphin(const Item& it, const std::string& zip)
+{
+  const std::string dir = Dir() + "pending/";
+  File::CreateFullPath(dir);
+  const std::string dst = dir + P(zip).filename().string();
+  File::Rename(zip, dst);
+  picojson::object o;
+  o["kind"] = picojson::value(it.kind);
+  o["version"] = picojson::value(it.version);
+  o["title"] = picojson::value(it.title);
+  o["url"] = picojson::value(it.url);
+  o["needs"] = picojson::value(it.needs);
+  WriteJson(dst + ".json", o);
+  Log("kept for the new Dolphin: " + it.kind + " " + it.version);
+}
+
+std::vector<std::pair<Item, std::string>> PendingPacks()
+{
+  std::vector<std::pair<Item, std::string>> out;
+  for (const std::string& j : Common::DoFileSearch({Dir() + "pending/"}, {".json"}, false))
+  {
+    const std::string zip = j.substr(0, j.size() - 5);
+    if (!File::Exists(zip))
+    {
+      File::Delete(j);
+      continue;
+    }
+    const picojson::object o = ReadJsonObject(j);
+    Item i;
+    i.kind = Str(o, "kind");
+    i.version = Str(o, "version");
+    i.title = Str(o, "title");
+    i.url = Str(o, "url");
+    i.needs = Str(o, "needs");
+    if (BuildHas(Common::GetERBuildStr(), i.needs))
+      out.emplace_back(i, zip);
+  }
+  return out;
+}
+
+void PendingDone(const std::string& zip)
+{
+  File::Delete(zip);
+  File::Delete(zip + ".json");
+}
