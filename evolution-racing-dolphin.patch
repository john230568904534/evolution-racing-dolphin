+bool QualityUltra();
+
+// CPU thread (every pad poll of port 1): the native pause lines' block
+void NativeSync(bool serve)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  u32 rel = 0, magic = 0;
+  if (!Read32(0x800030C8, &rel) || rel < 0x80000000u || rel >= 0x81700000u ||
+      !Read32(rel + NM_OFF, &magic) || magic != NM_MAGIC)
+  {
+    s_nm_on = false;
+    return;
+  }
+  const u32 a = rel + NM_OFF;
+  u8* p = PC5090TryPointer(memory, a, NM_LBL + 4 * NM_LBL_LEN);
+  if (!p)
+  {
+    s_nm_on = false;
+    return;
+  }
+  if (a != s_nm_addr)
+  {
+    s_nm_addr = a;
+    std::fprintf(stderr, "NATIVEMENU block at %08x (%s)\n", a, serve ? "native lines" : "overlay mode: lines off");
+  }
+  if (!serve)
+  {
+    std::memset(p + 4, 0, 4);  // no handshake: the game adds no lines
+    s_nm_on = false;
+    return;
+  }
+  const bool wx = WeatherAvailable(), night = NightAvailable(), ultra = UltraAvailable();
+  const u8 cnt[4] = {static_cast<u8>(wx ? N_WEATHER : 0), static_cast<u8>(wx ? 4 : 0),
+                     static_cast<u8>(night ? N_TOD : 0), static_cast<u8>(wx ? (ultra ? 4 : 2) : 0)};  // lit17s39 evolution
+  std::memcpy(p + NM_CNT, cnt, 4);
+  if (p[NM_INIT] == 0)  // a new boot: quality starts as GFX.ini has it
+  {
+    p[NM_SEL + 3] = static_cast<u8>(ultra ? ((QualityUltra() ? 1 : 0) | (EvolutionDynamic() ? 2 : 0)) :
+                                            (EvolutionDynamic() ? 1 : 0));  // lit17s39 evolution
+    p[NM_INIT] = 1;
+    s_nm_q = ultra ? (p[NM_SEL + 3] & 1) : -1;
+    s_nm_e = EvolutionDynamic() ? 1 : 0;
+    s_nm_chg = -1;
+  }
+  for (int i = 0; i < 4; i++)
+    if (cnt[i] && p[NM_SEL + i] >= cnt[i])
+      p[NM_SEL + i] = 0;
+  s_nm_w = p[NM_SEL + 0] < N_WEATHER ? p[NM_SEL + 0] : 0;
+  s_nm_i = p[NM_SEL + 1] < 4 ? p[NM_SEL + 1] : 0;
+  s_nm_t = p[NM_SEL + 2] < N_TOD ? p[NM_SEL + 2] : 0;
+  const int q = ultra ? (p[NM_SEL + 3] & 1) : (QualityUltra() ? 1 : 0);  // lit17s39 evolution
+  const int ev = ultra ? ((p[NM_SEL + 3] >> 1) & 1) : (p[NM_SEL + 3] & 1);
+  if (cnt[3] && ev != s_nm_e)
+  {
+    if (s_nm_e >= 0)
+      SetEvolution(ev != 0);
+    s_nm_e = ev;
+  }
+  if (cnt[3] && ultra && q != s_nm_q)
+  {
+    Config::SetBaseOrCurrent(Config::GFX_PC5090_WEATHER_QUALITY, std::string(q ? "Ultra" : "Low"));
+    s_nm_q = q;
+  }
+  const bool cur_ultra = QualityUltra();
+  // the line texts (the game's font: printable ASCII)
+  char lab[4][NM_LBL_LEN];
+  const int tw = s_track_wtype.load(), tl = s_track_look.load();
+  const int w = s_nm_w.load(), t = s_nm_t.load();
+  if (WEATHER[w].code < 0)
+  {
+    if (tw >= 0 && tw < static_cast<int>(sizeof(NM_TYPE) / sizeof(NM_TYPE[0])))
+      std::snprintf(lab[0], NM_LBL_LEN, "Weather: Track - %s", NM_TYPE[tw]);
+    else
+      std::snprintf(lab[0], NM_LBL_LEN, "Weather: Track");
+  }
+  else
+    std::snprintf(lab[0], NM_LBL_LEN, "Weather: %s", NM_TYPE[WEATHER[w].code]);
+  std::snprintf(lab[1], NM_LBL_LEN, "Intensity: %s", NM_INTENSITY[s_nm_i.load()]);
+  if (TOD[t].code < 0)
+  {
+    if (tl >= 0 && tl <= 2)
+      std::snprintf(lab[2], NM_LBL_LEN, "Time: Track - %s", LOOK_NAME[tl]);
+    else
+      std::snprintf(lab[2], NM_LBL_LEN, "Time: Track");
+  }
+  else
+    std::snprintf(lab[2], NM_LBL_LEN, "Time: %s", TOD[t].name);
+  if (ultra)  // lit17s39 evolution
+    std::snprintf(lab[3], NM_LBL_LEN, "Quality: %s - %s", cur_ultra ? "Ultra" : "Low", ev ? "Dynamic" : "Static");
+  else
+    std::snprintf(lab[3], NM_LBL_LEN, "Weather: %s", ev ? "Dynamic" : "Static");
+  for (int i = 0; i < 4; i++)
+  {
+    u8* d = p + NM_LBL + i * NM_LBL_LEN;
+    if (std::memcmp(d, lab[i], std::strlen(lab[i]) + 1) != 0)
+      std::memcpy(d, lab[i], std::strlen(lab[i]) + 1);
+  }
+  const u32 hs = Common::swap32(NM_HS);
+  std::memcpy(p + 4, &hs, 4);
+  s_nm_on = true;
+  if (p[NM_CHG] != s_nm_chg)
+  {
+    if (s_nm_chg >= 0)
+      std::fprintf(stderr, "NATIVEMENU set: %s | %s | %s | %s\n", lab[0], lab[1], lab[2], lab[3]);
+    s_nm_chg = p[NM_CHG];
+  }
+}
+
+bool RowShown(int r)
+{
+  switch (r)
+  {
+  case ROW_WEATHER:
+  case ROW_INTENSITY:
+    return s_av_weather.load();
+  case ROW_TOD:
+    return s_av_night.load();
+  case ROW_QUALITY:
+    return s_av_weather.load() && s_av_ultra.load();
+  case ROW_EVOLUTION:  // lit17s39 evolution
+    return s_av_weather.load();
+  }
+  return false;
+}
+// intensity only means something for a weather picked here
+bool RowEnabled(int r, const Choice& c)
+{
+  if (!RowShown(r))
+    return false;
+  if (r == ROW_INTENSITY)
+    return WEATHER[c.weather].code > 0;
+  return true;
+}
+
+bool QualityUltra()
+{
+  std::string q = Config::Get(Config::GFX_PC5090_WEATHER_QUALITY);
+  for (auto& ch : q)
+    ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+  return q != "low";
+}
+
+// s_mu held
+void FixRow(const Choice& c)
+{
+  if (RowEnabled(s_row, c))
+    return;
+  for (int i = 0; i < N_ROWS; i++)
+  {
+    if (RowEnabled(i, c))
+    {
+      s_row = i;
+      return;
+    }
+  }
+}
+
+void Log(const char* what, u32 slot, const Choice& c)
+{
+  std::fprintf(stderr, "WXMENU %s slot %u: weather %s, intensity %s, time %s, quality %s\n", what, slot,
+               WEATHER[c.weather].name, INTENSITY[c.intensity], TOD[c.tod].name, QualityUltra() ? "Ultra" : "Low");
+}
+
+// s_mu held. dir: 1 up 2 down 3 left 4 right 5 A (next)
+void Act(int dir)
+{
+  const u32 slot = s_slot.load();
+  Choice& c = s_choice[slot];
+  FixRow(c);
+  if (dir == 1 || dir == 2)
+  {
+    const int step = dir == 1 ? -1 : 1;
+    for (int i = 1; i <= N_ROWS; i++)
+    {
+      const int r = s_row + step * i;
+      if (r < 0 || r >= N_ROWS)
+        break;  // no wrap: the cursor stops at the ends
+      if (RowEnabled(r, c))
+      {
+        s_row = r;
+        break;
+      }
+    }
+    return;
+  }
+  const int d = dir == 3 ? -1 : 1;
+  switch (s_row)
+  {
+  case ROW_WEATHER:
+    c.weather = (c.weather + d + N_WEATHER) % N_WEATHER;
+    break;
+  case ROW_INTENSITY:
+    c.intensity = dir == 5 ? (c.intensity + 1) % 3 : std::clamp(c.intensity + d, 0, 2);
+    break;
+  case ROW_TOD:
+    c.tod = (c.tod + d + N_TOD) % N_TOD;
+    break;
+  case ROW_QUALITY:
+    Config::SetBaseOrCurrent(Config::GFX_PC5090_WEATHER_QUALITY,
+                             std::string(QualityUltra() ? "Low" : "Ultra"));
+    break;
+  case ROW_EVOLUTION:  // lit17s39 evolution
+    SetEvolution(!EvolutionDynamic());
+    break;
+  }
+  Log("set", slot, c);
+}
+
+void Update()
+{
+  bool vis = false;
+  u32 rel = 0;
+  u16 mode = 0, sub = 0;
+  u32 demo = 0, all = 0, run = 0;
+  const bool av = NightAvailable() || WeatherAvailable();
+  if (av && Read32(0x800030C8, &rel) && rel >= 0x80000000u && rel < 0x81800000u &&
+      Read16(rel + 0x1BA9A0, &mode) && Read16(rel + 0x1BA9A2, &sub) && Read32(0x801A66C8, &all) &&
+      Read32(0x801A66A0, &run))
+  {
+    // a race: the mode manager's mode 2 (GAME; the sub-mode is 36 in a GP race, not the decomp's 41) and the race gate
+    // the night / weather passes use (top half of rel+0x197DE0 < 256); the attract demo is a race too
+    u32 gate = 0;
+    const bool race = mode == 2 && Read32(rel + 0x197DE0, &gate) && (gate >> 16) < 256 &&
+                      !(Read32(rel + 0x17D2FC, &demo) && demo != 0);
+    // paused: main.dol .sbss 0x801A66C8 counts every frame, 0x801A66A0 only while the game is not paused (stalled
+    // for 3 presented frames), and the decomp's pause test (game.c fn_1_3F164; bss = rel + 0x1BA040)
+    if (all != s_last_all)
+      s_stall = (run == s_last_run) ? s_stall + 1 : 0;
+    s_last_all = all;
+    s_last_run = run;
+    const u32 bss = rel + 0x1BA040;
+    u32 p0 = 0, p1 = 0, p2 = 0, p3 = 0;
+    const bool pause_expr = Read32(bss + 0x50F8, &p0) && Read32(bss + 0x3C30, &p1) && Read32(bss + 0x26B50, &p2) &&
+                            Read32(bss + 0x3C10, &p3) && (p0 != 0 || (p1 & 2) != 0 || p2 != 0) &&
+                            ((p3 >> 8) & 0xFF) != 0;
+    vis = race && s_stall >= 3 && pause_expr;
+    (void)sub;
+    if (vis)
+    {
+      u32 sw = 0;
+      u32 slot = 0xFFFF;
+      if (Read32((rel + 0x18B5AC) & ~3u, &sw))
+        slot = (sw >> (((rel + 0x18B5AC) & 2u) ? 0 : 16)) & 0xFFFFu;
+      if (slot >= 256)
+        vis = false;
+      else
+        s_slot = slot;
+    }
+  }
+  s_av_night = NightAvailable();
+  s_av_weather = WeatherAvailable();
+  s_av_ultra = UltraAvailable();
+  if (vis && !s_was_visible)
+    s_lab_z = PadLabel("Z");
+  if (vis != s_was_visible)
+  {
+    std::lock_guard lk(s_mu);
+    Choice& c = s_choice[s_slot.load()];
+    FixRow(c);
+    Log(vis ? "shown" : "hidden", s_slot.load(), c);
+  }
+  s_was_visible = vis;
+  s_visible = vis;
+}
+
+// ---- drawing: in F-Zero GX's own pause-menu style (the game's blue glowing box, its menu fonts read from the
+// player's disc by lighting_mod/menu_font.py into User/Load/PC5090/), flush right of the game's [ MENU ] box
+float s_alpha = 1.0f;  // the panel fades in with the game's own [ MENU ] box (about 0.2 s)
+ImU32 Col(int r, int g, int b, float a)
+{
+  return IM_COL32(r, g, b, static_cast<int>(std::clamp(a * s_alpha, 0.0f, 1.0f) * 255.0f + 0.5f));
+}
+ImFont* F(ImFont* f)
+{
+  return f ? f : ImGui::GetFont();
+}
+
+// a bitmap font from the game: an RGBA sheet of fixed cells, packed into the ImGui atlas as a custom rectangle
+struct BmpFont
+{
+  ImFontAtlasRectId id = ImFontAtlasRectId_Invalid;
+  int w = 0, h = 0;      // sheet
+  int cw = 0, ch = 0;    // cell
+  int cols = 0;
+  int first = 0;         // code of cell 0
+  bool prop = false;     // proportional advance (the title font)
+  std::array<u8, 256> x0{}, x1{};  // inked columns of each cell (prop)
+};
+BmpFont s_bf_item, s_bf_title;
+bool s_have_bmp = false;
+
+bool LoadBmpFont(BmpFont* f, const std::string& path, int cw, int ch, int cols, int first, bool prop)
+{
+  std::string png;
+  Common::UniqueBuffer<u8> rgba;
+  u32 w = 0, h = 0;
+  if (!File::ReadFileToString(path, png) ||
+      !Common::LoadPNG(std::span(reinterpret_cast<const u8*>(png.data()), png.size()), &rgba, &w, &h) ||
+      w == 0 || h == 0)
+    return false;
+  ImFontAtlas* atlas = ImGui::GetIO().Fonts;
+  ImFontAtlasRect r;
+  const ImFontAtlasRectId id = atlas->AddCustomRect(static_cast<int>(w), static_cast<int>(h), &r);
+  if (id == ImFontAtlasRectId_Invalid || !atlas->TexData || atlas->TexData->Format != ImTextureFormat_RGBA32)
+    return false;
+  for (u32 y = 0; y < h; y++)
+    std::memcpy(atlas->TexData->GetPixelsAt(r.x, r.y + static_cast<int>(y)), rgba.data() + y * w * 4, w * 4);
+  ImFontAtlasTextureBlockQueueUpload(atlas, atlas->TexData, r.x, r.y, r.w, r.h);
+  atlas->TexPixelsUseColors = true;
+  *f = BmpFont{};
+  f->id = id;
+  f->w = static_cast<int>(w);
+  f->h = static_cast<int>(h);
+  f->cw = cw;
+  f->ch = ch;
+  f->cols = cols;
+  f->first = first;
+  f->prop = prop;
+  const int ncell = (f->w / cw) * (f->h / ch);
+  for (int k = 0; k < ncell && k < 256; k++)
+  {
+    const int cx = (k % cols) * cw, cy = (k / cols) * ch;
+    int a = cw, b = -1;
+    for (int x = 0; x < cw; x++)
+      for (int y = 0; y < ch; y++)
+        if (rgba.data()[((cy + y) * f->w + cx + x) * 4 + 3] > 60)
+        {
+          a = std::min(a, x);
+          b = std::max(b, x);
+        }
+    f->x0[k] = static_cast<u8>(b < 0 ? 0 : a);
+    f->x1[k] = static_cast<u8>(b < 0 ? cw / 3 : b + 1);
+  }
+  std::fprintf(stderr, "WXMENU game font %s %ux%u\n", path.c_str(), w, h);
+  return true;
+}
+
+// the game draws its menus filtered: so do we (ImGui's own draws use point sampling in Dolphin)
+void LinearOn(const ImDrawList*, const ImDrawCmd*)
+{
+  g_gfx->SetSamplerState(0, RenderState::GetLinearSamplerState());
+}
+void LinearOff(const ImDrawList*, const ImDrawCmd*)
+{
+  g_gfx->SetSamplerState(0, RenderState::GetPointSamplerState());
+}
+
+float BmpAdvance(const BmpFont& f, unsigned char c, float sc)
+{
+  const int k = static_cast<int>(c) - f.first;
+  if (!f.prop || k < 0 || k >= 256)
+    return f.cw * sc;
+  if (c == ' ')
+    return f.cw * 0.5f * sc;
+  return (f.x1[k] - f.x0[k] + 2) * sc;
+}
+float BmpWidth(const BmpFont& f, float size, const char* t)
+{
+  const float sc = size / f.ch;
+  float w = 0;
+  for (; *t; t++)
+    w += BmpAdvance(f, static_cast<unsigned char>(*t), sc);
+  return w;
+}
+// size = the cell height on screen
+float BmpText(ImDrawList* dl, const BmpFont& f, float size, ImVec2 p, ImU32 col, const char* t)
+{
+  ImFontAtlas* atlas = ImGui::GetIO().Fonts;
+  ImFontAtlasRect r;
+  const float sc = size / f.ch;
+  float x = p.x;
+  if (!atlas->GetCustomRect(f.id, &r))
+    return 0;
+  const float du = (r.uv1.x - r.uv0.x) / r.w, dv = (r.uv1.y - r.uv0.y) / r.h;
+  for (; *t; t++)
+  {
+    const unsigned char c = static_cast<unsigned char>(*t);
+    const int k = static_cast<int>(c) - f.first;
+    const float adv = BmpAdvance(f, c, sc);
+    if (c != ' ' && k >= 0 && k < (f.w / f.cw) * (f.h / f.ch))
+    {
+      const int cx = (k % f.cols) * f.cw, cy = (k / f.cols) * f.ch;
+      const int a = f.prop ? f.x0[k] : 0, b = f.prop ? f.x1[k] : f.cw;
+      dl->AddImage(atlas->TexRef, ImVec2(x, p.y), ImVec2(x + (b - a) * sc, p.y + f.ch * sc),
+                   ImVec2(r.uv0.x + (cx + a) * du, r.uv0.y + cy * dv),
+                   ImVec2(r.uv0.x + (cx + b) * du, r.uv0.y + (cy + f.ch) * dv), col);
+    }
+    x += adv;
+  }
+  return x - p.x;
+}
+// fallback without the game fonts: Noto Sans at the same places
+float AnyText(ImDrawList* dl, bool title, float size, ImVec2 p, ImU32 col, const char* t)
+{
+  if (s_have_bmp)
+    return BmpText(dl, title ? s_bf_title : s_bf_item, size, p, col, t);
+  ImFont* f = F(title ? s_font_head : s_font_body);
+  const float fs = size * 0.95f;
+  dl->AddText(f, fs, p, col, t);
+  return f->CalcTextSizeA(fs, 1e9f, 0.0f, t).x;
+}
+float AnyWidth(bool title, float size, const char* t)
+{
+  if (s_have_bmp)
+    return BmpWidth(title ? s_bf_title : s_bf_item, size, t);
+  return F(title ? s_font_head : s_font_body)->CalcTextSizeA(size * 0.95f, 1e9f, 0.0f, t).x;
+}
