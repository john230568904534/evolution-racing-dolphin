+    const Mode m = GetMode();
+    if (m != s_mode && s_ro.valid)
+      s_ro.race_arr = 0;  // re-rasterise the rows for the other name set at the next frame
+    if (m != s_mode || s_mode_frame == 1)
+      std::fprintf(stderr, "NAMEPLATES mode %s\n", m == Mode::Off ? "Off" : m == Mode::Original ? "Original" : "Usernames");
