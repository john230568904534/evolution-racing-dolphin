+
+void FillDrawUniforms(const std::array<float, 12>& M, std::vector<u8>* out)
+{
+  out->assign(sizeof(DrawUniforms), 0);
+  if (s_nt_late_draw)
+  {
+    // lit17s6: a late world draw: only the night look (sf_clock.z, 0 before the pass) and strength
+    s_nt_late_draw = false;
+    DrawUniforms U{};
+    U.sf_clock = {static_cast<float>(s_now_ms % 1000000u), static_cast<float>(s_now_ms / 1000000u), NightForBody(),
+                  s_nt.strength};
+    std::memcpy(out->data(), &U, sizeof(U));
+    return;
+  }
+  if (!s_dm_race)
+    return;  // lit17sg: not the race scene: an empty block (no damage, no surface layer) on machine draws
+  if (s_dm_refs <= 0 || (!s_dm_any_hits && s_hx_refs <= 0 && s_sf_refs <= 0))
+    return;
+  // lit17s4: note this body draw's frame for DmFrameEnd (parts the anchors never see)
+  {
+    bool seen = false;
+    for (const auto& m : s_body_draws)
+    {
+      if (SameMatrix(m, M))
+      {
+        seen = true;
+        break;
+      }
+    }
+    if (!seen && s_body_draws.size() < 512)
+      s_body_draws.push_back(M);
+  }
+  // which machine / part: the nearest part matrix of the last frame (draw order and part transforms are stable)
+  int br = -1;
+  const DmPart* bp = nullptr;
+  float bd = 1e30f;
+  for (size_t r = 0; r < s_dm.size(); r++)
+  {
+    const DmRacer& d = s_dm[r];
+    if (!d.have_main || s_global_frame - d.main_frame > 3)
+      continue;
+    for (const DmPart& p : d.parts)
+    {
+      float d2 = 0.0f;
+      for (int k = 0; k < 3; k++)
+      {
+        const float t = M[k * 4 + 3] - p.m[k * 4 + 3];
+        d2 += t * t;
+        for (int j = 0; j < 3; j++)
+        {
+          const float q = M[k * 4 + j] - p.m[k * 4 + j];
+          d2 += q * q;
+        }
+      }
+      if (d2 < bd)
+      {
+        bd = d2;
+        br = static_cast<int>(r);
+        bp = &p;
+      }
+    }
+  }
+  if (br < 0 || !bp)
+    return;
+  const DmRacer& d = s_dm[br];
+  const float lim = std::max(2.5f, d.radius_view * 0.6f);
+  if (bd > lim * lim)
+    return;
+  DrawUniforms U{};
+  if (s_sf_refs > 0)
+  {
+    const u32 now = s_now_ms;
+    const float never = 1.0e7f;
+    U.sf_info = {static_cast<float>(br), static_cast<float>(d.sf_machine), br == 0 ? 1.0f : 0.0f, 1.0f};
+    U.sf_pit = {d.sf_ever ? static_cast<float>(now - d.sf_on_ms) : never,
+                d.sf_on ? 0.0f : (d.sf_ever ? static_cast<float>(now - d.sf_off_ms) : never), d.sf_on ? 1.0f : 0.0f,
+                d.sf_energy};
+    for (int i = 0; i < 8; i++)
+      U.sf_ram[i >> 2][i & 3] = d.sf_ram[i];
+    // lit17s6: z = the night look for this body draw (0 before / without the night pass), w = night strength
+    U.sf_clock = {static_cast<float>(now % 1000000u), static_cast<float>(now / 1000000u), NightForBody(),
+                  s_nt.strength};
+  }
+  if ((s_hx_refs > 0 || s_sf_refs > 0) && d.hx_shape)
+  {
+    // lit17c: hit space -> this draw's view space = M (part model -> view) x G (hit -> part model)
+    const M34 T = Mul34(M, bp->g);
+    const float st = Scale34(T);
+    M34 Ti;
+    if (st > 1e-6f && Inv34(T, &Ti))
+    {
+      const V3 vd = Norm3(XV(T, d.hx_dir));
+      const V3 vc = XP(T, d.hx_ctr);
+      const V3 vu = Norm3(XV(T, d.hx_up));
+      U.hx_info = {d.hx_heat, d.hx_speed, d.hx_level, 1.0f};
+      U.hx_vdir = {vd[0], vd[1], vd[2], d.hx_front * st};
+      U.hx_vctr = {vc[0], vc[1], vc[2], d.hx_back * st};
+      U.hx_vup = {vu[0], vu[1], vu[2], d.hx_size * st};
+      // normalised to machine size: hull-fixed coordinates in units of the machine's size
+      const float k = 1.0f / std::max(d.hx_size, 1e-4f);
+      for (int i = 0; i < 3; i++)
+        U.hx_inv[i] = {Ti[i * 4] * k, Ti[i * 4 + 1] * k, Ti[i * 4 + 2] * k, (Ti[i * 4 + 3] - d.hx_ctr[i]) * k};
+    }
+  }
+  if (d.hits.empty())
+  {
+    std::memcpy(out->data(), &U, sizeof(U));
+    return;
+  }
+  const M34& G = bp->g;
+  const float sg = Scale34(G);
+  const float sm = Scale34(M);
+  const u32 now = s_now_ms;
+  const size_t n = std::min<size_t>(d.hits.size(), 16);
+  for (size_t i = 0; i < n; i++)
+  {
+    const DmHit& h = d.hits[i];
+    const V3 pm = XP(G, h.pos);
+    const V3 nm = Norm3(XV(G, h.nrm));
+    const V3 tm = Norm3(XV(G, h.tan));
+    const V3 pv = XP(M, pm);
+    const V3 nv = Norm3(XV(M, nm));
+    const V3 tv = Norm3(XV(M, tm));
+    U.mpos[i] = {pm[0], pm[1], pm[2], h.radius * sg};
+    U.mdir[i] = {nm[0], nm[1], nm[2], h.depth * sg};
+    U.vpos[i] = {pv[0], pv[1], pv[2], h.radius * sg * sm};
+    U.vdir[i] = {nv[0], nv[1], nv[2], h.depth * sg * sm};
+    U.vtan[i] = {tv[0], tv[1], tv[2], h.seed};
+    U.aux[i] = {static_cast<float>(now - h.last_ms) * 0.001f, h.strength, 1.0f - h.heal, h.heat};
+  }
+  U.info = {static_cast<float>(n), static_cast<float>(now % 1000000u) * 0.001f, d.size * sg, d.size * sg * sm};
+  std::memcpy(out->data(), &U, sizeof(U));
+}
+}  // namespace DamageFx
