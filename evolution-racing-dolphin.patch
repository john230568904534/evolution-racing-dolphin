+void NeonAddRows(const std::array<float, 12>& M, const std::vector<std::array<float, 3>>& pts, bool blend)
+{
+  (void)M;
+  (void)blend;
+  NnFlip();
+  // rows of 2 (one strip row each): the row midpoints, joined row to row; a join that is not along the line (its
+  // direction against the row's across vector) or far too long is the gap between two strips: skipped
+  const size_t rows = pts.size() / 2;
+  V3 pm{};
+  V3 pa{};
+  bool have = false;
+  for (size_t r = 0; r < rows && s_nn.cur.size() < 4096; r++)
+  {
+    const auto& q0 = pts[2 * r];
+    const auto& q1 = pts[2 * r + 1];
+    const V3 m = {(q0[0] + q1[0]) * 0.5f, (q0[1] + q1[1]) * 0.5f, (q0[2] + q1[2]) * 0.5f};
+    const V3 ac = {q1[0] - q0[0], q1[1] - q0[1], q1[2] - q0[2]};
+    if (have)
+    {
+      const V3 d = {m[0] - pm[0], m[1] - pm[1], m[2] - pm[2]};
+      const float l = Len3(d), la = Len3(ac), lp = Len3(pa);
+      const bool ok = l > 0.05f && l < 600.0f && la > 0.05f && la < 6.0f && std::abs(la - lp) < 0.5f &&
+                      std::abs(Dot3(d, ac)) < 0.35f * l * la;
+      if (ok)
+        s_nn.cur.push_back({pm, m, s_nn.rgb, s_nn.inten});
+    }
+    pm = m;
+    pa = ac;
+    have = true;
+  }
+}
+static void NnFill(DrawUniforms& U, const M34& V, bool neon_draw, bool blend)
+{
+  const DmRacer& d = s_dm[0];
+  if (s_nn.trace < 0)
+    s_nn.trace = File::Exists(File::GetUserPath(D_USER_IDX) + "pc5090neontrace") ? 1 : 0;
+  if (!d.have_prev)
+  {
+    if (s_nn.trace > 0 && neon_draw && (s_global_frame % 120) == 0)
+      std::fprintf(stderr, "NEONTRACE f=%llu no player (damage tracker off?)\n", static_cast<unsigned long long>(s_global_frame));
+    return;
+  }
+  NnSelect();
+  const V3 c = XP(V, d.pos);
+  const V3 f = Norm3(XV(V, s_nn.fwd), {0.0f, 0.0f, -1.0f});
+  U.nn_info = {1.0f, blend ? 1.0f : 0.0f, s_nn.speed, static_cast<float>(s_nn.nl)};
+  U.nn_fwd = {f[0], f[1], f[2], static_cast<float>(s_nn.S)};
+  U.nn_ctr = {c[0], c[1], c[2], neon_draw ? s_nn.inten : 1.0f};
+  U.nn_col = {s_nn.rgb[0], s_nn.rgb[1], s_nn.rgb[2], static_cast<float>(s_now_ms % 1000000u) * 0.001f};
+  for (int i = 0; i < s_nn.nl; i++)
+  {
+    const NnSeg& g = s_nn.sel[i];
+    const V3 a = XP(V, g.a), b = XP(V, g.b);
+    U.nn_la[i] = {a[0], a[1], a[2], s_nn.sel_d[i]};
+    U.nn_lb[i] = {b[0], b[1], b[2], s_nn.sel_side[i]};
+    U.nn_lc[i] = {g.c[0], g.c[1], g.c[2], g.k};
+  }
+  if (s_nn.trace < 0)
+    s_nn.trace = File::Exists(File::GetUserPath(D_USER_IDX) + "pc5090neontrace") ? 1 : 0;
+  if (s_nn.trace > 0 && neon_draw && (s_global_frame % 60) == 0)
+  {
+    static u64 last = 0;
+    if (last != s_global_frame)
+    {
+      last = s_global_frame;
+      std::fprintf(stderr, "NEONTRACE f=%llu segs=%zu/%zu lights=%d d0=%.1f speed=%.1f S=%.1f ctr=(%.2f %.2f %.2f) fwd=(%.2f %.2f %.2f) main=(%.2f %.2f %.2f) mainf=%llu\n",
+                   static_cast<unsigned long long>(s_global_frame), s_nn.prev.size(), s_nn.cur.size(), s_nn.nl,
+                   s_nn.nl ? s_nn.sel_d[0] : -1.0f, s_nn.speed, s_nn.S, c[0], c[1], c[2], f[0], f[1], f[2],
+                   d.main[3], d.main[7], d.main[11], static_cast<unsigned long long>(d.main_frame));
+    }
+  }
+}
+
+// lit17s33p PADPLATE: the 4 plates nearest the player (within 150 m) for the hull light layer (sf_padlight). Only
+// while a "pads" action ran this frame (BoostPlates on, race, plates read): its world -> view.
+static void PdFill(DrawUniforms& U)
+{
+  U.pd_info = {};
+  const DmRacer& d = s_dm[0];
+  if (!d.have_prev || s_pad_view_frame == ~0ull || s_global_frame - s_pad_view_frame > 2 || s_pads.pads.empty())
+    return;
+  const float* V = s_pad_view.data();
+  std::vector<std::pair<float, size_t>> cs;
+  for (size_t i = 0; i < s_pads.pads.size(); i++)
+  {
+    const float dd = std::sqrt(Dist2(s_pads.pads[i].c, {d.pos[0], d.pos[1], d.pos[2]}));
+    if (dd < 150.0f + s_pads.pads[i].hl)
+      cs.push_back({dd, i});
+  }
+  std::sort(cs.begin(), cs.end());
+  const bool looks = FxSwitchOn("BoostPadLooks");
+  const int n = static_cast<int>(std::min<size_t>(cs.size(), 4));
+  for (int j = 0; j < n; j++)
+  {
+    const Pad& p = s_pads.pads[cs[j].second];
+    float c[3], a[3];
+    for (int r = 0; r < 3; r++)
+    {
+      c[r] = V[r * 4] * p.c[0] + V[r * 4 + 1] * p.c[1] + V[r * 4 + 2] * p.c[2] + V[r * 4 + 3];
+      a[r] = V[r * 4] * p.along[0] + V[r * 4 + 1] * p.along[1] + V[r * 4 + 2] * p.along[2];
+    }
+    const float al = std::sqrt(a[0] * a[0] + a[1] * a[1] + a[2] * a[2]);
+    const float st = looks ? p.strength : 1.0f;
+    const std::array<float, 3> rgb = st < 1.25f ? std::array<float, 3>{1.0f, 0.62f, 0.16f} :
+                                     (st < 1.75f ? std::array<float, 3>{0.62f, 0.30f, 1.0f} :
+                                                   std::array<float, 3>{1.0f, 0.16f, 0.08f});
+    const s32 since = static_cast<s32>(s_now_ms - p.hit_ms);
+    const float surge = (p.hit_ever && since >= 0) ? std::exp(-static_cast<float>(since) / 300.0f) : 0.0f;
+    U.pd_a[j] = {c[0], c[1], c[2], p.hl};
+    U.pd_b[j] = {a[0] / std::max(al, 1e-6f), a[1] / std::max(al, 1e-6f), a[2] / std::max(al, 1e-6f), p.hw};
+    U.pd_c[j] = {rgb[0], rgb[1], rgb[2], surge};
+  }
+  U.pd_info = {static_cast<float>(n), static_cast<float>(s_now_ms % 1000000u) * 0.001f, 1.0f, 0.0f};
+}
+
+// lit17s33p: the plate under a board draw. V = world -> view of the frame (pads pass), M = this draw's model -> view.
+static void PdFillBoard(DrawUniforms& U, const std::array<float, 12>& M, const std::array<float, 3>& cm)
+{
+  U.pd_info = {};
+  if (s_pad_view_frame == ~0ull || s_global_frame - s_pad_view_frame > 3 || s_pads.pads.empty())
+    return;
+  float cv[3];
+  for (int r = 0; r < 3; r++)
+    cv[r] = M[r * 4] * cm[0] + M[r * 4 + 1] * cm[1] + M[r * 4 + 2] * cm[2] + M[r * 4 + 3];
+  const float* V = s_pad_view.data();
+  float best = 1e30f;
+  const Pad* bp = nullptr;
+  float bc[3] = {};
+  for (const Pad& p : s_pads.pads)
+  {
+    float c[3];
+    for (int r = 0; r < 3; r++)
+      c[r] = V[r * 4] * p.c[0] + V[r * 4 + 1] * p.c[1] + V[r * 4 + 2] * p.c[2] + V[r * 4 + 3];
+    const float d = (c[0] - cv[0]) * (c[0] - cv[0]) + (c[1] - cv[1]) * (c[1] - cv[1]) + (c[2] - cv[2]) * (c[2] - cv[2]);
+    if (d < best)
+    {
+      best = d;
+      bp = &p;
+      std::copy(c, c + 3, bc);
+    }
+  }
+  if (!bp || best > 40.0f * 40.0f)
+    return;
+  float al[3], ac[3], up[3];
+  for (int r = 0; r < 3; r++)
+  {
+    al[r] = V[r * 4] * bp->along[0] + V[r * 4 + 1] * bp->along[1] + V[r * 4 + 2] * bp->along[2];
+    ac[r] = V[r * 4] * bp->across[0] + V[r * 4 + 1] * bp->across[1] + V[r * 4 + 2] * bp->across[2];
+    up[r] = V[r * 4] * bp->up[0] + V[r * 4 + 1] * bp->up[1] + V[r * 4 + 2] * bp->up[2];
+  }
+  const float st = FxSwitchOn("BoostPadLooks") ? bp->strength : 1.0f;
+  const s32 since = static_cast<s32>(s_now_ms - bp->hit_ms);
+  U.pd_a[0] = {bc[0], bc[1], bc[2], bp->hl};
+  U.pd_b[0] = {al[0], al[1], al[2], bp->hw};
+  U.pd_c[0] = {ac[0], ac[1], ac[2], st};
+  U.pd_c[1] = {up[0], up[1], up[2], (bp->hit_ever && since >= 0) ? static_cast<float>(since) : 1e6f};
+  U.pd_info = {1.0f, static_cast<float>(s_now_ms % 1000000u) * 0.001f, 1.0f, 1.0f};
+}
+
+void FillDrawUniforms(const std::array<float, 12>& M, std::vector<u8>* out)
+{
+  // lit17s33p PADPLATE: a board draw - pd_a[0..] = the plate nearest the draw's centroid (view space), pd_info.w = 1
+  if (s_pb_pending)
+  {
+    s_pb_pending = false;
+    out->assign(sizeof(DrawUniforms), 0);
+    DrawUniforms U{};
+    U.sf_clock = {static_cast<float>(s_now_ms % 1000000u), static_cast<float>(s_now_ms / 1000000u), 0.0f, 0.0f};
+    PdFillBoard(U, M, s_pb_ctr);
+    std::memcpy(out->data(), &U, sizeof(U));
+    return;
+  }
+  // lit17s33n: a neon track draw: only the nn_* members (M = the track's model -> view = world -> view)
+  if (s_nn.pending)
+  {
+    s_nn.pending = false;
+    out->assign(sizeof(DrawUniforms), 0);
+    DrawUniforms U{};
+    s_nn.view = M;
+    s_nn.view_frame = s_global_frame;
+    NnFill(U, M, true, s_nn_blend_now);
+    U.sf_clock = {static_cast<float>(s_now_ms % 1000000u), static_cast<float>(s_now_ms / 1000000u),
+                  NightForBody() > 0.0f ? NightForBody() : -NightLightLevel(),  // lit17s37r rails v3: coming night (negative)
+                  s_nt.strength};
+    std::memcpy(out->data(), &U, sizeof(U));
+    return;
+  }
+  out->assign(sizeof(DrawUniforms), 0);
+  if (s_nt_late_draw)
+  {
+    // lit17s6: a late world draw: only the night look (sf_clock.z, 0 before the pass) and strength
+    s_nt_late_draw = false;
+    DrawUniforms U{};
+    U.sf_clock = {static_cast<float>(s_now_ms % 1000000u), static_cast<float>(s_now_ms / 1000000u), NightForBody(),
+                  s_nt.strength};
+    std::memcpy(out->data(), &U, sizeof(U));
+    return;
+  }
+  if (!s_dm_race)
+    return;  // lit17sg: not the race scene: an empty block (no damage, no surface layer) on machine draws
+  if (s_dm_refs <= 0 || (!s_dm_any_hits && s_hx_refs <= 0 && s_sf_refs <= 0))
+    return;
+  // lit17s4: note this body draw's frame for DmFrameEnd (parts the anchors never see)
+  {
+    bool seen = false;
+    for (const auto& m : s_body_draws)
+    {
+      if (SameMatrix(m, M))
+      {
+        seen = true;
+        break;
+      }
+    }
+    if (!seen && s_body_draws.size() < 512)
+      s_body_draws.push_back(M);
+  }
+  // which machine / part: the nearest part matrix of the last frame (draw order and part transforms are stable)
+  int br = -1;
+  const DmPart* bp = nullptr;
+  float bd = 1e30f;
+  for (size_t r = 0; r < s_dm.size(); r++)
+  {
+    const DmRacer& d = s_dm[r];
+    if (!d.have_main || s_global_frame - d.main_frame > 3)
+      continue;
+    for (const DmPart& p : d.parts)
+    {
+      float d2 = 0.0f;
+      for (int k = 0; k < 3; k++)
+      {
+        const float t = M[k * 4 + 3] - p.m[k * 4 + 3];
+        d2 += t * t;
+        for (int j = 0; j < 3; j++)
+        {
+          const float q = M[k * 4 + j] - p.m[k * 4 + j];
+          d2 += q * q;
+        }
+      }
+      if (d2 < bd)
+      {
+        bd = d2;
+        br = static_cast<int>(r);
+        bp = &p;
+      }
+    }
+  }
+  if (br < 0 || !bp)
+    return;
+  const DmRacer& d = s_dm[br];
+  const float lim = std::max(2.5f, d.radius_view * 0.6f);
+  if (bd > lim * lim)
+    return;
+  DrawUniforms U{};
+  if (s_sf_refs > 0)
+  {
+    const u32 now = s_now_ms;
+    const float never = 1.0e7f;
+    U.sf_info = {static_cast<float>(br), static_cast<float>(d.sf_machine), br == 0 ? 1.0f : 0.0f, 1.0f};
+    U.sf_pit = {d.sf_ever ? static_cast<float>(now - d.sf_on_ms) : never,
+                d.sf_on ? 0.0f : (d.sf_ever ? static_cast<float>(now - d.sf_off_ms) : never), d.sf_on ? 1.0f : 0.0f,
+                d.sf_energy};
+    for (int i = 0; i < 8; i++)
+      U.sf_ram[i >> 2][i & 3] = d.sf_ram[i];
+    // lit17s6: z = the night look for this body draw (0 before / without the night pass), w = night strength
+    U.sf_clock = {static_cast<float>(now % 1000000u), static_cast<float>(now / 1000000u), NightForBody(),
+                  s_nt.strength};
+  }
+  if ((s_hx_refs > 0 || s_sf_refs > 0) && d.hx_shape)
+  {
+    // lit17c: hit space -> this draw's view space = M (part model -> view) x G (hit -> part model)
+    const M34 T = Mul34(M, bp->g);
+    const float st = Scale34(T);
+    M34 Ti;
+    if (st > 1e-6f && Inv34(T, &Ti))
+    {
+      const V3 vd = Norm3(XV(T, d.hx_dir));
+      const V3 vc = XP(T, d.hx_ctr);
+      const V3 vu = Norm3(XV(T, d.hx_up));
+      U.hx_info = {d.hx_heat, d.hx_speed, d.hx_level, 1.0f};
+      U.hx_vdir = {vd[0], vd[1], vd[2], d.hx_front * st};
+      U.hx_vctr = {vc[0], vc[1], vc[2], d.hx_back * st};
+      U.hx_vup = {vu[0], vu[1], vu[2], d.hx_size * st};
+      // normalised to machine size: hull-fixed coordinates in units of the machine's size
+      const float k = 1.0f / std::max(d.hx_size, 1e-4f);
+      for (int i = 0; i < 3; i++)
+        U.hx_inv[i] = {Ti[i * 4] * k, Ti[i * 4 + 1] * k, Ti[i * 4 + 2] * k, (Ti[i * 4 + 3] - d.hx_ctr[i]) * k};
+    }
+  }
+  if (s_nn.view_frame != ~0ull && s_global_frame - s_nn.view_frame <= 2)
+    NnFill(U, s_nn.view, false, false);  // lit17s33n: the neon lights for the hull (the frame's world -> view)
+  PdFill(U);  // lit17s33p: the dash plates' light on the hulls
+  if (d.hits.empty())
+  {
+    std::memcpy(out->data(), &U, sizeof(U));
+    return;
+  }
+  const M34& G = bp->g;
+  const float sg = Scale34(G);
+  const float sm = Scale34(M);
+  const u32 now = s_now_ms;
+  const size_t n = std::min<size_t>(d.hits.size(), 16);
+  for (size_t i = 0; i < n; i++)
+  {
+    const DmHit& h = d.hits[i];
+    const V3 pm = XP(G, h.pos);
+    const V3 nm = Norm3(XV(G, h.nrm));
+    const V3 tm = Norm3(XV(G, h.tan));
+    const V3 pv = XP(M, pm);
+    const V3 nv = Norm3(XV(M, nm));
+    const V3 tv = Norm3(XV(M, tm));
+    U.mpos[i] = {pm[0], pm[1], pm[2], h.radius * sg};
+    U.mdir[i] = {nm[0], nm[1], nm[2], h.depth * sg};
+    U.vpos[i] = {pv[0], pv[1], pv[2], h.radius * sg * sm};
+    U.vdir[i] = {nv[0], nv[1], nv[2], h.depth * sg * sm};
+    U.vtan[i] = {tv[0], tv[1], tv[2], h.seed};
+    U.aux[i] = {static_cast<float>(now - h.last_ms) * 0.001f, h.strength, 1.0f - h.heal, h.heat};
+  }
+  U.info = {static_cast<float>(n), static_cast<float>(now % 1000000u) * 0.001f, d.size * sg, d.size * sg * sm};
+  std::memcpy(out->data(), &U, sizeof(U));
+}
+}  // namespace DamageFx
