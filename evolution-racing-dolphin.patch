+void MainWindow::SetEROffline(bool on)
+{
+  ERGhosts::Settings s = ERGhosts::Load();
+  s.offline = on;
+  ERGhosts::Save(s);  // (only the switch: the link, the modes and the queue of saved ghosts stay)
+  ERGhostProbe(false);  // run telemetry off while offline
+  if (on && m_er_run && !m_er_run->finished)
+    m_er_run->cancel = true;  // a download in progress stops (it resumes later)
+  ERUpdateTitle();
+  emit ERGhostsChanged();
+  ERNote(on ? "Play offline is on: this Dolphin makes no connections at all. Ghosts you save now stay on this PC "
+              "(Tools > Evolution Racing settings > Upload saved ghosts now sends them later, if you want)." :
+              "Play offline is off: what you switched on in Evolution Racing settings connects again.");
