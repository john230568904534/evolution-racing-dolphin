+std::string NonceOf(const std::string& arg)
+{
+  // evoracing://test/<nonce>  or  .../er-test-<nonce>.ertest
+  std::string s = arg;
+  const auto q = s.find_first_of("?#");
+  if (q != std::string::npos)
+    s = s.substr(0, q);
+  while (!s.empty() && (s.back() == '/' || s.back() == '\\'))
+    s.pop_back();
+  const auto slash = s.find_last_of("/\\");
+  std::string last = slash == std::string::npos ? s : s.substr(slash + 1);
+  if (last.ends_with(".ertest"))
+    last = last.substr(0, last.size() - 7);
+  if (last.starts_with("er-test-"))
+    last = last.substr(8);
+  if (last.size() < 6 || last.size() > 40 || !SafeName(last, false))
+    return {};
+  return last;
+}
+
+bool ReadU32(Core::System& system, u32 addr, u32* out)
+{
+  if (addr < 0x80000000 || addr > 0x817FFFFC)
+    return false;
+  u32 v;
+  system.GetMemory().CopyFromEmu(&v, addr, 4);
+  *out = Common::swap32(v);
+  return true;
+}
+
+bool ReadF32(Core::System& system, u32 addr, float* out)
+{
+  u32 v;
+  if (!ReadU32(system, addr, &v))
+    return false;
+  std::memcpy(out, &v, 4);
+  return true;
+}
+
+// lap length + race distance of the player's racer, when a race runs
+bool RacerInfo(Core::System& system, const Racer& r, float* lap, float* dist)
+{
+  if (r.chain.empty())
+    return false;
+  u32 p = 0;
+  for (size_t i = 0; i < r.chain.size(); ++i)
+  {
+    const s64 a = i == 0 ? r.chain[0] : static_cast<s64>(p) + r.chain[i];
+    if (a < 0x80000000LL || a > 0x817FFFFCLL || !ReadU32(system, static_cast<u32>(a), &p))
+      return false;
+  }
+  if (!ReadF32(system, p + r.lap_off, lap) || !ReadF32(system, p + r.dist_off, dist))
+    return false;
+  return *lap > r.lap_min && *lap < r.lap_max;
+}
