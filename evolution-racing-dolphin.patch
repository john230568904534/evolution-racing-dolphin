+BlendingState MakeBlend(bool additive)
+{
+  BlendingState bs = RenderState::GetNoBlendingBlendState();
+  bs.blend_enable = true;
+  bs.color_update = true;
+  bs.alpha_update = false;  // never touch EFB alpha (games read it back for later effects)
+  bs.subtract = false;
+  bs.subtract_alpha = false;
+  bs.use_dual_src = false;
+  bs.logic_op_enable = false;
+  bs.src_factor = additive ? SrcBlendFactor::One : SrcBlendFactor::SrcAlpha;
+  bs.dst_factor = additive ? DstBlendFactor::One : DstBlendFactor::InvSrcAlpha;
+  bs.src_factor_alpha = SrcBlendFactor::Zero;
+  bs.dst_factor_alpha = DstBlendFactor::One;
+  return bs;
+}
