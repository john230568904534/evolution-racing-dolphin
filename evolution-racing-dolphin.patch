+// Evolution Racing dolphin-lit17s6 NIGHT MODE: the look of the current course (0 day = nothing, 1 dusk, 2 night), from
+//  1. the disc's time-of-day table: magic "TOD1" + 64 bytes (course id 0..63 -> 0 stock, 1 day, 2 dusk, 3 night) in
+//     the main REL ([0x800030C8] = its base): at "tod_offset" from the base, else found by a scan (once per base);
+//  2. for "stock" (0) / no table / course id >= 64: the installer's per-course table "courses" (256 looks), else
+//     "default".
+// The course id is the top half of [[0x800030C8] + 0x197DE0] (< 256 a race, 0xFFFF the menus: look 0).
+struct NightState
+{
+  bool configured = false;
+  std::array<u8, 256> courses{};
+  u8 def = 2;
+  float strength = 1.0f;
+  u32 tod_offset = 0;   // 0 = scan
+  u32 tod_scan = 0x800000;
+  u32 slot_offset = 0x18B5AC;  // main-REL u16: the course SLOT being raced (0x197DE0 holds the venue / stage id)
+  u32 demo_offset = 0x17D2FC;  // main-REL word, nonzero while the title screen's attract demo runs (0 = no gate)
+  int trace = 0;        // "trace": log the textures drawn after the pass (NIGHTLATE lines on stderr)
+  // per frame
+  u64 frame = ~0ull;
+  int look = 0;
+  // the TOD1 table
+  u32 rel = 0;
+  u32 tod_addr = 0;     // 0 = none found for this REL base
+  // the pass
+  u64 pass_frame = ~0ull;
+  const AbstractTexture* pass_scene = nullptr;
+};
+NightState s_nt;
+// the last perspective draw's projection / pixel centre (any emit_quads target, e.g. the machine-body publishers):
+// the night pass fired by a HUD draw (orthographic) rebuilds view depth with it
+std::array<std::array<float, 4>, 4> s_persp_rows{};
+std::array<float, 4> s_persp_pc{};
+bool s_have_persp = false;
+
+int NightLook()
+{
+  if (!s_nt.configured)
+    return 0;
+  if (s_nt.frame == s_global_frame)
+    return s_nt.look;
+  s_nt.frame = s_global_frame;
+  s_nt.look = 0;
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const auto read32 = [&](u32 addr, u32* o) {
+    const u8* p = memory.GetPointerForRange(addr, 4);
+    if (!p)
+      return false;
+    u32 v;
+    std::memcpy(&v, p, 4);
+    *o = Common::swap32(v);
+    return true;
+  };
+  u32 rel = 0, word = 0;
+  if (!read32(0x800030C8, &rel) || rel < 0x80000000u || rel >= 0x81800000u || !read32(rel + 0x197DE0, &word))
+    return 0;
+  if ((word >> 16) >= 256)
+    return 0;  // menus (0xFFFF)
+  // the TOD1 table and the per-course table are indexed by the course SLOT (0x197DE0's top half is the venue)
+  u32 course = word >> 16;
+  if (s_nt.slot_offset)
+  {
+    u32 sw = 0;
+    if (read32((rel + s_nt.slot_offset) & ~3u, &sw))
+    {
+      const u32 sh = ((rel + s_nt.slot_offset) & 2u) ? 0 : 16;
+      course = (sw >> sh) & 0xFFFFu;
+    }
+    if (course >= 256)
+      return 0;
+  }
+  // the title screen's attract demo is a race too (course 10 on the AllStar discs): it stays as the game draws it
+  u32 demo = 0;
+  if (s_nt.demo_offset && read32(rel + s_nt.demo_offset, &demo) && demo != 0)
+    return 0;
+  const u32 magic = 0x544F4431u;  // "TOD1"
+  if (s_nt.tod_offset)
+  {
+    // a fixed place (the hub's timeofday.py): the magic is checked every frame (one read; a disc swap / RAM edit)
+    u32 m = 0;
+    const u32 addr = (read32(rel + s_nt.tod_offset, &m) && m == magic) ? rel + s_nt.tod_offset + 4 : 0;
+    if (addr != s_nt.tod_addr || rel != s_nt.rel)
+      std::fprintf(stderr, "NIGHT REL %08x: TOD1 table %s (%08x)\n", rel, addr ? "found" : "absent", addr);
+    s_nt.rel = rel;
+    s_nt.tod_addr = addr;
+  }
+  else if (rel != s_nt.rel)
+  {
+    s_nt.rel = rel;
+    s_nt.tod_addr = 0;
+    for (u32 a = rel; a < rel + s_nt.tod_scan && a < 0x81800000u - 68; a += 4)
+    {
+      const u8* p = memory.GetPointerForRange(a, 4);
+      if (!p)
+        break;
+      if (p[0] == 'T' && p[1] == 'O' && p[2] == 'D' && p[3] == '1')
+      {
+        s_nt.tod_addr = a + 4;
+        break;
+      }
+    }
+    std::fprintf(stderr, "NIGHT REL %08x: TOD1 table scan %s (%08x)\n", rel, s_nt.tod_addr ? "found" : "absent",
+                 s_nt.tod_addr);
+  }
+  int look = -1;
+  if (s_nt.tod_addr && course < 64)
+  {
+    const u8* p = memory.GetPointerForRange(s_nt.tod_addr + course, 1);
+    const u8 b = p ? *p : 0;
+    if (b >= 1 && b <= 3)
+      look = b - 1;  // 1 day -> 0, 2 dusk -> 1, 3 night -> 2
+  }
+  if (look < 0)
+    look = s_nt.courses[course] != 0xFF ? s_nt.courses[course] : s_nt.def;
+  s_nt.look = std::clamp(look, 0, 2);
+  return s_nt.look;
+}
+// the machine-body surface layer: the night look for a draw AFTER this frame's night pass (0 before it: the pass
+// grades what is already drawn)
+float NightForBody()
+{
+  const int look = NightLook();
+  return (look > 0 && s_nt.pass_frame == s_global_frame) ? static_cast<float>(look) : 0.0f;
+}
