+// ---- lit17s29m NATIVE PAUSE LINES (fzgx-custom scripts/nativemenu.py): the disc's own pause menu carries Weather /
+// Intensity / Time / Quality lines in the game's font. The game keeps the choices in a block of its main REL
+// ([0x800030C8] + 0x7CD98, "PMN1"); this Dolphin writes the handshake (the lines only show with it: stock Dolphin
+// keeps the stock menu), the number of options per line and the line texts, and applies the choices. GFX.ini
+// [PC5090] WeatherMenu = Native (default: native lines, no overlay) | Overlay (the lit17s28 panel, no native lines).
+const Config::Info<std::string> GFX_PC5090_WEATHER_MENU{{Config::System::GFX, "PC5090", "WeatherMenu"}, "Native"};
+constexpr u32 NM_OFF = 0x7CD98, NM_MAGIC = 0x504D4E31 /* PMN1 */, NM_HS = 0x45564F4C /* EVOL */;
+constexpr u32 NM_CNT = 8, NM_SEL = 0xC, NM_CHG = 0x12, NM_INIT = 0x13, NM_LBL = 0x30, NM_LBL_LEN = 40;
+constexpr const char* NM_INTENSITY[] = {"Track", "Light", "Normal", "Heavy"};
+constexpr const char* NM_TYPE[] = {"Clear", "Rain", "Storm", "Snow", "Sleet",
+                                   "Snowstorm", "Ice storm", "Ion storm", "Meteor shower", "Plasma rain",
+                                   "Solar flare", "Ash", "Aurora", "Fire tornadoes", "Solar wind",
+                                   "Amber Front", "Fog banks", "Data storm", "Neon rain", "Pollen storm",
+                                   "Hail", "Ocean spray", "Hurricane", "Gravity well", "Diamond dust",
+                                   "Neon Monsoon", "Solar Veil", "Ashfall+", "Above the Clouds", "Event Horizon"};
+std::atomic<bool> s_nm_on{false};  // the disc has the lines and this Dolphin serves them
+std::atomic<int> s_nm_w{0}, s_nm_i{0}, s_nm_t{0};  // the choices (WEATHER / NM_INTENSITY / TOD indices)
+int s_nm_q = -1;          // quality choice last applied (0 low, 1 ultra)
+int s_nm_chg = -1;        // the game's change counter
+u32 s_nm_addr = 0;        // block address last logged  // the button the player presses for GC Z (port 1 mapping), read when the panel shows
+
+// the physical button behind a GC button on port 1: an Xbox-style SDL pad shows its own name (Z on Shoulder R -> RB)
+std::string PadLabel(const char* gc_name)
+{
+  auto* g = Pad::GetGroup(0, PadGroup::Buttons);
+  if (!g)
+    return gc_name;
+  for (const auto& c : g->controls)
+  {
+    if (!c || c->name != gc_name || !c->control_ref)
+      continue;
+    std::string e = c->control_ref->GetExpression();
+    std::erase(e, '`');
+    static const std::pair<const char*, const char*> NAMES[] = {
+        {"Shoulder R", "RB"}, {"Shoulder L", "LB"}, {"Trigger R", "RT"}, {"Trigger L", "LT"},
+        {"Button S", "A"},    {"Button E", "B"},    {"Button W", "X"},   {"Button N", "Y"}};
+    for (const auto& [k, v] : NAMES)
+      if (e == k)
+        return v;
+    return gc_name;
+  }
+  return gc_name;
+}
