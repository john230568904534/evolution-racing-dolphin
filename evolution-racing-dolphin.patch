+// ---- Evolution Racing lit17s16 GPU pass timing (PC5090Prof, user-dir file "pc5090gpuprof") ----
+namespace
+{
+constexpr uint32_t GPU_Q_PER_BUF = 4096;
+VkQueryPool s_gpu_pool = VK_NULL_HANDLE;
+double s_gpu_period_ns = 1.0;
+struct GpuMarkRec
+{
+  int id;
+  bool end;
+};
+std::vector<GpuMarkRec> s_gpu_marks[Vulkan::NUM_COMMAND_BUFFERS];
+uint32_t s_gpu_used[Vulkan::NUM_COMMAND_BUFFERS];
+bool s_gpu_reset[Vulkan::NUM_COMMAND_BUFFERS];
+
+void GpuMarkImpl(int id, bool end)
+{
+  if (s_gpu_pool == VK_NULL_HANDLE || !Vulkan::g_command_buffer_mgr)
+    return;
+  const u32 b = Vulkan::g_command_buffer_mgr->GetCurrentCommandBufferIndexForProf();
+  if (!s_gpu_reset[b] || s_gpu_used[b] >= GPU_Q_PER_BUF)
+    return;
+  vkCmdWriteTimestamp(Vulkan::g_command_buffer_mgr->GetCurrentCommandBuffer(), VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                      s_gpu_pool, b * GPU_Q_PER_BUF + s_gpu_used[b]);
+  s_gpu_used[b]++;
+  s_gpu_marks[b].push_back({id, end});
+}
+
+// buffer b is idle (its fence passed): collect its results, then reset its range in the new recording
+void GpuCollectAndReset(u32 b, VkCommandBuffer cmd)
+{
+  if (!PC5090Prof::GpuEnabled())
+    return;
+  if (s_gpu_pool == VK_NULL_HANDLE)
+  {
+    VkPhysicalDeviceProperties props;
+    vkGetPhysicalDeviceProperties(Vulkan::g_vulkan_context->GetPhysicalDevice(), &props);
+    s_gpu_period_ns = props.limits.timestampPeriod;
+    VkQueryPoolCreateInfo ci = {VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO, nullptr, 0, VK_QUERY_TYPE_TIMESTAMP,
+                                GPU_Q_PER_BUF * static_cast<uint32_t>(Vulkan::NUM_COMMAND_BUFFERS), 0};
+    if (vkCreateQueryPool(Vulkan::g_vulkan_context->GetDevice(), &ci, nullptr, &s_gpu_pool) != VK_SUCCESS)
+      s_gpu_pool = VK_NULL_HANDLE;
+    PC5090Prof::g_gpu_mark = GpuMarkImpl;
+    std::fprintf(stderr, "EQPROF gpu timestamps %s (period %.3f ns)\n", s_gpu_pool ? "on" : "FAILED", s_gpu_period_ns);
+  }
+  if (s_gpu_pool == VK_NULL_HANDLE)
+    return;
+  if (s_gpu_reset[b] && s_gpu_used[b] > 0)
+  {
+    std::vector<uint64_t> t(s_gpu_used[b]);
+    if (vkGetQueryPoolResults(Vulkan::g_vulkan_context->GetDevice(), s_gpu_pool, b * GPU_Q_PER_BUF, s_gpu_used[b],
+                              t.size() * sizeof(uint64_t), t.data(), sizeof(uint64_t),
+                              VK_QUERY_RESULT_64_BIT) == VK_SUCCESS)
+    {
+      // pairs: begin (end=false) ... end (end=true) of the same id, possibly nested never (emits are sequential)
+      std::vector<std::pair<int, uint64_t>> open;
+      for (size_t i = 0; i < t.size(); i++)
+      {
+        const GpuMarkRec& m = s_gpu_marks[b][i];
+        if (!m.end)
+        {
+          open.emplace_back(m.id, t[i]);
+        }
+        else if (!open.empty() && open.back().first == m.id)
+        {
+          if (t[i] >= open.back().second)
+            PC5090Prof::AddGroupGpu(m.id, static_cast<uint64_t>((t[i] - open.back().second) * s_gpu_period_ns));
+          open.pop_back();
+        }
+      }
+      if (t.size() >= 2 && t.back() >= t.front())
+        PC5090Prof::AddGpuCmdBuf(static_cast<uint64_t>((t.back() - t.front()) * s_gpu_period_ns));
+    }
+  }
+  s_gpu_marks[b].clear();
+  s_gpu_used[b] = 0;
+  vkCmdResetQueryPool(cmd, s_gpu_pool, b * GPU_Q_PER_BUF, GPU_Q_PER_BUF);
+  s_gpu_reset[b] = true;
+  // a mark at the very start of the buffer (the "whole buffer" span starts here)
+  vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, s_gpu_pool, b * GPU_Q_PER_BUF);
+  s_gpu_used[b] = 1;
+  s_gpu_marks[b].push_back({-1, false});
+}
