+const AbstractTexture* EmitQuadsAction::CopyDepth(std::array<float, 4>* size)
+{
+  const u32 w = g_framebuffer_manager->GetEFBWidth(), h = g_framebuffer_manager->GetEFBHeight();
+  const MathUtil::Rectangle<int> rect(0, 0, static_cast<int>(w), static_cast<int>(h));
+  if (PC5090Prof::ShareCopies())
+  {
+    if (s_share_depth_frame != s_global_frame || !s_share_depth)
+    {
+      AbstractTexture* src = g_framebuffer_manager->ResolveEFBDepthTexture(rect, false);
+      if (!src)
+        return nullptr;
+      if (!s_share_depth || s_share_depth->GetWidth() != w || s_share_depth->GetHeight() != h ||
+          s_share_depth->GetFormat() != src->GetFormat())
+      {
+        s_share_depth = g_gfx->CreateTexture(TextureConfig(w, h, 1, 1, 1, src->GetFormat(), 0,
+                                                           AbstractTextureType::Texture_2DArray),
+                                             "emit_quads shared depth copy");
+        if (!s_share_depth)
+          return nullptr;
+      }
+      s_share_depth->CopyRectangleFromTexture(src, rect, 0, 0, rect, 0, 0);
+      s_share_depth->FinishedRendering();
+      s_share_depth_frame = s_global_frame;
+      if (PC5090Prof::Enabled())
+        PC5090Prof::Add(PC5090Prof::DepthCopies, 1);
+    }
+    *size = {static_cast<float>(w), static_cast<float>(h), 1.0f / static_cast<float>(w),
+             1.0f / static_cast<float>(h)};
+    return s_share_depth.get();
+  }
+  if ((m_depth_frame != m_frame_counter || (!m_depth && !m_depth_alias)) && !PC5090Prof::NoCopyShare() &&
+      s_xs_depth.tex && (PC5090Prof::StageDepth() ? s_xs_depth.stage == PC5090Prof::g_stage : s_xs_depth.gen == PC5090Prof::g_depth_gen) && s_xs_depth.frame == s_global_frame &&
+      s_xs_depth.w == w && s_xs_depth.h == h)
+  {
+    // lit17s14m: another action copied the EFB depth at this very generation (effects never write depth)
+    m_depth_alias = s_xs_depth.tex;
+    m_depth_frame = m_frame_counter;
+  }
+  if (m_depth_frame != m_frame_counter || (!m_depth && !m_depth_alias))
+  {
+    FlushHalfRes();  // lit17s21
+    m_depth_alias = nullptr;
+    // multisampled EFB: resolved to R32F first (else the D32F EFB depth itself)
+    AbstractTexture* src = g_framebuffer_manager->ResolveEFBDepthTexture(rect, false);
+    if (!src)
+      return nullptr;
+    if (!m_depth || m_depth->GetWidth() != w || m_depth->GetHeight() != h ||
+        m_depth->GetFormat() != src->GetFormat())
+    {
+      m_depth.reset();
+      m_depth = g_gfx->CreateTexture(TextureConfig(w, h, 1, 1, 1, src->GetFormat(), 0,
+                                                   AbstractTextureType::Texture_2DArray),
+                                     "emit_quads depth copy");
+      if (!m_depth)
+        return nullptr;
+    }
+    m_depth->CopyRectangleFromTexture(src, rect, 0, 0, rect, 0, 0);
+    m_depth->FinishedRendering();
+    m_depth_frame = m_frame_counter;
+    if (PC5090Prof::Enabled())
+      PC5090Prof::Add(PC5090Prof::DepthCopies, 1);
+    s_xs_depth = {m_depth.get(), PC5090Prof::g_depth_gen, s_global_frame, PC5090Prof::g_stage, PC5090Prof::g_game_gen, w, h, m_depth->GetFormat()};
+  }
+  *size = {static_cast<float>(w), static_cast<float>(h), 1.0f / static_cast<float>(w),
+           1.0f / static_cast<float>(h)};
+  return m_depth_alias ? m_depth_alias : m_depth.get();
+}
