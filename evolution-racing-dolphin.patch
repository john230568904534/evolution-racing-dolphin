+// ---------------------------------------------------------------- the ghost file
+std::string Check(const std::vector<u8>& gci, Ghost* out)
+{
+  if (gci.size() != GCI_SIZE)
+    return fmt::format("not a Time Attack ghost (size {} bytes, a ghost is {})", gci.size(), GCI_SIZE);
+  const u8* h = gci.data();
+  if (std::memcmp(h, "GFZE", 4) != 0 || std::memcmp(h + 4, "8P", 2) != 0)
+    return "not a ghost from the USA game (GFZE)";
+  std::string name(reinterpret_cast<const char*>(h + 8), 32);
+  name = name.substr(0, name.find('\0'));
+  bool name_ok = name.size() == 23 && name.starts_with("fzg") && name.ends_with(".dat");
+  for (size_t i = 3; name_ok && i < 19; ++i)
+    name_ok = std::isxdigit(static_cast<unsigned char>(name[i])) && !std::isupper(static_cast<unsigned char>(name[i]));
+  if (!name_ok)
+    return "not a Time Attack ghost (the memory card file name is not fzg...dat)";
+  if (BE16(h + 0x38) != 3)
+    return "not a Time Attack ghost (a ghost has 3 memory card blocks)";
+  const u8* d = h + GCI_HEADER;
+  if (BE16(d) != Crc16X25(d + 2, DATA_LEN - 2))
+    return "the file is damaged or was edited (its checksum does not match)";
+  const u8* g = d + GHOST;
+  if (g[8] != 'F' || g[9] != 'Z')
+    return "not a Time Attack ghost (missing marker)";
+  const int mm = g[0x24], ss = g[0x25], ms = BE16(g + 0x26);
+  const u32 total = static_cast<u32>((mm * 60 + ss) * 1000 + ms);
+  if (ss >= 60 || ms >= 1000 || total == 0 || total >= 6000000)
+    return "the time in the file is not a real race time";
+  // race frames: a u32 at +0x1C (the upper half is 0 under 18:12, so older builds read the u16 at +0x1E); long ghosts
+  // (fzgx-custom scripts/ghostlong.py discs, up to 40 min) need all 32 bits
+  const u32 frames32 = (static_cast<u32>(BE16(g + 0x1C)) << 16) | BE16(g + 0x1E);
+  const int samples = BE16(g + 0x18), frames = frames32 > 0 && frames32 < 6000000 ? static_cast<int>(frames32) : BE16(g + 0x1E);
+  if (samples <= 0 || samples > MAX_SAMPLES)
+    return "the ghost has no usable race data";
+  if (std::abs(frames - static_cast<double>(total) * 60 / 1000) > 2)
+    return "the race time and the race length in frames do not agree";
+  int sum = 0;
+  for (int k = 0; k < samples; ++k)
+    sum += g[0x30 + 16 * k + 8];
+  if (std::abs(sum - frames) > 6)
+    return "the race data does not add up to the race time";
+  if (out)
+  {
+    out->name = name;
+    out->machine = g[0];
+    out->slot = g[1];
+    out->total_ms = total;
+    out->frames = frames;
+    out->time = fmt::format("{}'{:02}\"{:03}", mm, ss, ms);
+    out->machine_name = g[0] < std::size(MACHINES) ? MACHINES[g[0]] : "Custom machine";
+    out->sha1 = Hex(Common::SHA1::CalculateDigest(gci));
+  }
+  return {};
+}
