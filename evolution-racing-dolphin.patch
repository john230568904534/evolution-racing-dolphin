+    setWindowTitle(Q(Common::GetERVersionStr() + (ERGhosts::Offline() ? " - Offline" : "")));
+  if (!TestDir().empty())
+    TestWrite("title.txt", Common::GetERVersionStr() + "\n", false);
+  if (Core::IsRunning(m_system))  // (not while a game is still starting: the CPU is not there yet)
+    Core::UpdateTitle(m_system);
