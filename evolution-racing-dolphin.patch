+// ---- backup / roll back of the folders and files a pack replaces
+struct Backup
+{
+  std::string dir;  // User/ERUpdates/backup/<kind>/
+  std::vector<std::pair<std::string, std::string>> moved;  // (original, backup)
+  std::vector<std::string> roots;                          // what the pack writes (removed on roll back)
+  std::string error;
+  bool Take(const std::string& kind, const std::vector<std::string>& paths)
+  {
+    dir = Dir() + "backup/" + kind + "/";
+    std::error_code ec;
+    fs::remove_all(P(dir), ec);
+    File::CreateFullPath(dir);
+    int i = 0;
+    for (const std::string& p : paths)
+    {
+      roots.push_back(p);
+      if (!fs::exists(P(Strip(p)), ec))
+        continue;
+      const std::string b = dir + fmt::format("{:02}", i++);
+      fs::rename(P(Strip(p)), P(b), ec);
+      if (ec)
+      {
+        error = "could not set " + p + " aside (" + ec.message() + ")";
+        Restore();
+        return false;
+      }
+      moved.emplace_back(Strip(p), b);
+    }
+    return true;
+  }
+  void Restore()
+  {
+    std::error_code ec;
+    for (const std::string& r : roots)
+      fs::remove_all(P(Strip(r)), ec);
+    for (auto it = moved.rbegin(); it != moved.rend(); ++it)
+    {
+      File::CreateFullPath(it->first);
+      fs::rename(P(it->second), P(it->first), ec);
+    }
+    moved.clear();
+  }
+  void Drop(const std::string& keep_as = "")
+  {
+    std::error_code ec;
+    if (!keep_as.empty())
+    {
+      fs::remove_all(P(Dir() + "previous/" + keep_as), ec);
+      File::CreateFullPath(Dir() + "previous/");
+      fs::rename(P(Strip(dir)), P(Dir() + "previous/" + keep_as), ec);
+      if (!ec)
+        return;
+    }
+    fs::remove_all(P(Strip(dir)), ec);
+  }
+};
