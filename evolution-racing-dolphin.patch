+Settings Load()
+{
+  Settings s;
+  std::string text;
+  if (!File::ReadFileToString(SettingsPath(), text))
+    return s;
+  for (std::string line : SplitString(text, '\n'))
+  {
+    while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+      line.pop_back();
+    const auto eq = line.find('=');
+    if (eq == std::string::npos)
+      continue;
+    const std::string k = line.substr(0, eq), v = line.substr(eq + 1);
+    if (k == "mode")
+      s.mode = v == "off" ? Mode::Off : v == "auto" ? Mode::Auto : Mode::Notify;
+    else if (k == "asked")
+      s.asked = v == "1";
+  }
+  return s;
+}
