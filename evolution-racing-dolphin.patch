+  v.clip = EQ_CULLED;
+  v.uv = corner;
+  v.data0 = float4(0.0, 0.0, 0.0, 0.0);
+  v.data1 = float4(0.0, 0.0, 0.0, 0.0);
+  emit_vertex(instance, corner, v);
+  eq_v_uv = v.uv;
+  eq_v_data0 = v.data0;
+  eq_v_data1 = v.data1;
+  eq_v_instance = instance;
