+// ---- Evolution Racing dolphin-lit17s34m MACHINE METAL: the scene probe -------------------------------------------------------
+namespace PC5090Material
+{
+namespace
+{
+constexpr int kLevels = 5;  // 1/2, 1/4, 1/8, 1/16, 1/32 of the EFB (box filtered by halving blits)
+struct Probe
+{
+  std::array<std::unique_ptr<AbstractTexture>, kLevels> tex;
+  std::array<std::unique_ptr<AbstractFramebuffer>, kLevels> fb;
+  std::unique_ptr<AbstractTexture> black;
+  u32 efb_w = 0, efb_h = 0;
+  bool have = false;            // a probe was captured at the current size
+  bool pending = false;         // this flush's draw wants it
+  u64 used_frame = ~0ull;       // a probe draw ran in this frame
+  u64 captured_frame = ~0ull;
+  u64 setting_frame = ~0ull;
+  bool on = true;
+};
+Probe s_mt;
+
+bool MetalOn()
+{
+  if (s_mt.setting_frame != s_global_frame)
+  {
+    s_mt.setting_frame = s_global_frame;
+    std::string v = Config::Get(Config::GFX_PC5090_MACHINE_METAL);
+    for (auto& ch : v)
+      ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+    s_mt.on = !(v == "off" || v == "0" || v == "false");
+  }
+  return s_mt.on;
+}
+
+bool Ensure(u32 w, u32 h)
+{
+  if (s_mt.efb_w == w && s_mt.efb_h == h && s_mt.tex[0])
+    return true;
+  s_mt = Probe{std::move(s_mt.tex), std::move(s_mt.fb), std::move(s_mt.black)};
+  for (int i = 0; i < kLevels; i++)
+  {
+    s_mt.fb[i].reset();
+    s_mt.tex[i].reset();
+    const u32 lw = std::max(1u, (w + (2u << i) - 1) >> (i + 1)), lh = std::max(1u, (h + (2u << i) - 1) >> (i + 1));
+    s_mt.tex[i] = g_gfx->CreateTexture(TextureConfig(lw, lh, 1, 1, 1, AbstractTextureFormat::RGBA8,
+                                                     AbstractTextureFlag_RenderTarget,
+                                                     AbstractTextureType::Texture_2DArray),
+                                       "machine metal probe");
+    if (!s_mt.tex[i])
+      return false;
+    s_mt.fb[i] = g_gfx->CreateFramebuffer(s_mt.tex[i].get(), nullptr);
+    if (!s_mt.fb[i])
+      return false;
+  }
+  s_mt.efb_w = w;
+  s_mt.efb_h = h;
+  s_mt.have = false;
+  return true;
+}
+
+const AbstractTexture* Black()
+{
+  if (!s_mt.black)
+  {
+    s_mt.black = g_gfx->CreateTexture(TextureConfig(1, 1, 1, 1, 1, AbstractTextureFormat::RGBA8, 0,
+                                                    AbstractTextureType::Texture_2DArray),
+                                      "machine metal off");
+    if (s_mt.black)
+    {
+      const u8 px[4] = {0, 0, 0, 0};
+      s_mt.black->Load(0, 1, 1, 1, px, 4);
+    }
+  }
+  return s_mt.black.get();
+}
+
+void Capture()
+{
+  AbstractTexture* efb = g_framebuffer_manager->GetEFBColorTexture();
+  if (!efb || efb->GetLayers() > 1)
+    return;
+  const u32 w = efb->GetWidth(), h = efb->GetHeight();
+  if (!Ensure(w, h))
+    return;
+  const MathUtil::Rectangle<int> rect(0, 0, static_cast<int>(w), static_cast<int>(h));
+  AbstractTexture* src = g_framebuffer_manager->ResolveEFBColorTexture(rect);
+  if (!src)
+    return;
+  src->FinishedRendering();  // out of the render pass, readable (no layout change inside the scale blit's pass)
+  const u64 pt0 = PC5090Prof::Enabled() ? PC5090Prof::NowNs() : 0;
+  for (int i = 0; i < kLevels; i++)
+  {
+    const AbstractTexture* from = i == 0 ? src : s_mt.tex[i - 1].get();
+    g_gfx->UnbindTexture(s_mt.tex[i].get());
+    g_gfx->ScaleTexture(s_mt.fb[i].get(), s_mt.fb[i]->GetRect(), from, from->GetConfig().GetRect());
+    s_mt.tex[i]->FinishedRendering();
+  }
+  s_mt.have = true;
+  s_mt.captured_frame = s_global_frame;
+  if (pt0 && PC5090Prof::Enabled())
+    PC5090Prof::Add(PC5090Prof::SceneCopies, 1);
+}
+}  // namespace
+
+void BeginDraw()
+{
+  s_mt.pending = false;
+}
+bool MetalEnabled()
+{
+  return MetalOn();
+}
+void NoteProbeDraw()
+{
+  s_mt.pending = true;
+}
+bool ProbePending()
+{
+  return s_mt.pending;
+}
+void OrthoDraw()
+{
+  if (s_mt.used_frame != s_global_frame || s_mt.captured_frame == s_global_frame || !MetalOn())
+    return;
+  Capture();
+}
+void Bind()
+{
+  if (!s_mt.pending)
+    return;
+  s_mt.used_frame = s_global_frame;
+  const bool on = MetalOn();
+  // nothing captured yet (first frame / size change): black until the next HUD start takes the first copy. Never
+  // capture here: this runs after the draw's own textures are bound, and the scale blits would replace them
+  SamplerState ss = RenderState::GetLinearSamplerState();
+  ss.tm0.wrap_u = WrapMode::Clamp;
+  ss.tm0.wrap_v = WrapMode::Clamp;
+  const bool ok = on && s_mt.have;
+  const AbstractTexture* t11 = ok ? s_mt.tex[2].get() : Black();
+  const AbstractTexture* t12 = ok ? s_mt.tex[4].get() : Black();
+  if (!t11 || !t12)
+    return;
+  g_gfx->SetTexture(11, t11);
+  g_gfx->SetSamplerState(11, ss);
+  g_gfx->SetTexture(12, t12);
+  g_gfx->SetSamplerState(12, ss);
+}
