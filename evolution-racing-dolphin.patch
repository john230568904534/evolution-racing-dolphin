+bool MainWindow::ERUpdateArg(const std::string& arg)
+{
+  // evoracing://update (the hub's Update in Dolphin), evoracing://link/<code>?hub=...[&then=update] (Link my Dolphin /
+  // Update in Dolphin), evoracing://restart. Links to the project's hub (or a test hub on this computer) link at once:
+  // the member clicked the hub's button; a link to any other address goes to ERGhosts, which asks first (ghosts only).
+  const bool upd = arg.starts_with("evoracing://update") || arg.starts_with("evoracing:update");
+  const bool restart = arg.starts_with("evoracing://restart") || arg.starts_with("evoracing:restart");
+  const bool is_link = arg.find("link/") != std::string::npos;
+  const bool then_update = is_link && arg.find("then=update") != std::string::npos;
+  if (restart)
+    return true;  // (run.sh handles it; a running Dolphin ignores it)
+  ERGhosts::Settings s = ERGhosts::Load();
+  if (s.offline && (upd || is_link || arg.find("ghost/") != std::string::npos))
+  {
+    raise();
+    ERNote("Play offline is on: this Dolphin makes no connections. Turn it off (Tools > Play offline) and click the "
+           "button on the hub again.");
+    return true;
+  }
+  if (upd)
+  {
+    raise();
+    activateWindow();
+    m_er_manual_pending = true;
+    ERUpdateCheck(true);
+    return true;
+  }
+  if (!is_link)
+    return false;  // evoracing://ghost/...: ERGhosts installs it as before
+  std::string code, hub;
+  if (!ERGhosts::ParseLink(arg, &code, &hub))
+    return false;
+  while (!hub.empty() && hub.back() == '/')
+    hub.pop_back();
+  if (hub.empty())
+    hub = s.hub;
+  if (!ERUpdates::UpdateHubAllowed(hub))
+    return false;
+  raise();
+  activateWindow();
+  if (then_update && !s.token.empty() && s.hub == hub)
+  {
+    // linked already: the new code is not needed (it ends by itself on the hub)
+    m_er_manual_pending = true;
+    ERUpdateCheck(true);
+    return true;
+  }
+  s.token = code;
+  s.hub = hub;
+  std::thread([this, s, then_update] {
+    ERGhosts::Reply r = ERGhosts::Hello(s);
+    QueueOnObject(this, [this, s, r, then_update]() mutable {
+      if (!r.ok())
+        return ERNote("linking did not work: " + r.error);
+      s.username = ERGhosts::Field(r.text, "username");
+      s.told_unlinked = false;
+      ERGhosts::Save(s);
+      ERGhostProbe(true);
+      emit ERGhostsChanged();
+      if (!then_update)
+        return ERNote("linked to the hub as " + s.username +
+                      ". What connects is up to you: Tools > Evolution Racing settings (or Play offline).");
+      ERNote("linked to the hub as " + s.username + ". Checking for updates...");
+      m_er_manual_pending = true;
+      ERUpdateCheck(true);
+    });
+  }).detach();
+  return true;
+}
+
+void MainWindow::ERUploadSavedGhosts()
+{
+  const ERGhosts::Settings s = ERGhosts::Load();
+  if (s.offline)
+    return ERNote("Play offline is on: turn it off first, then press Upload saved ghosts now.");
+  if (s.token.empty())
+    return ERNote("link this Dolphin first (Link my Dolphin on the hub's Setup page).");
+  std::vector<ERGhosts::Ghost> gs = ERGhosts::TakeOffline();
+  if (gs.empty())
+    return ERNote("no ghosts saved while offline are waiting.");
+  for (auto& g : gs)
+    m_er_queue.push_back(std::move(g));
+  m_er_force_send = true;
+  ERNote(fmt::format("sending {} ghost(s) saved while offline.", m_er_queue.size()));
+  ERGhostNext();
+}
