+};
+struct FtTw
+{
+  V3 home{}, pos{};
+  float clear = 0.0f, seed = 0.0f, ph = 0.0f, ph2 = 0.0f, size = 1.0f, height = 1000.0f, near = 0.0f, dist = 1e9f;
+  // ft3d-move: travelling tornado state
+  float hd = 0.0f, spd = 0.0f, tspd = 20.0f, turn_t = 0.0f, tgt_hd = 0.0f, clr_s = 0.0f, ys = 0.0f, mode_t = 0.0f;
+  float tr_t = 0.0f, min_pd = 1e9f;
+  int mode = 0, tr_n = 0, tr_head = 0;  // mode 0 wander, 1 run in to a close pass, 2 hold beside the road
+  bool mv_init = false;
+  V3 vel{}, tgt{};
+  std::array<std::array<float, 4>, 12> tr{};  // trail ring: ground point + game time (12 points: 4 tornadoes fit the uniforms)
+};
+struct FtCfg
+{
