@@ -0,0 +1,63 @@
+// Evolution Racing (lighting_mod/apply_safe_guest_reads.py): panic-proof guest-memory lookup for the mod's host-side reads.
+// MemoryManager::GetPointerForRange raises a modal "Unknown Pointer" panic for an address outside RAM (2026-11-22:
+// the owner's game stopped on one). This returns nullptr instead and logs the call site (rate limited).
+#pragma once
+
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <source_location>
+#include <string>
+#include <utility>
+
+#include "Common/CommonTypes.h"
+#include "Core/HW/Memmap.h"
+#include "Core/PowerPC/PowerPC.h"
+#include "Core/System.h"
+// Windows: <windows.h> (via the headers above) defines near / far as macros; the mod sources use them as names
+#ifdef _WIN32
+#undef near
+#undef far
+#endif
+
+inline u8* PC5090TryPointer(const Memory::MemoryManager& mem, u32 address, size_t size,
+                            std::source_location loc = std::source_location::current())
+{
+  auto& mm = const_cast<Memory::MemoryManager&>(mem);
+  const u32 a = address & 0x3FFFFFFF;
+  u8* base = nullptr;
+  size_t avail = 0;
+  if (mm.GetRAM() && a < mm.GetRamSizeReal())
+  {
+    base = mm.GetRAM() + a;
+    avail = mm.GetRamSizeReal() - a;
+  }
+  else if (mm.GetEXRAM() && (a >> 28) == 0x1 && (a & 0x0fffffff) < mm.GetExRamSizeReal())
+  {
+    base = mm.GetEXRAM() + (a & mm.GetExRamMask());
+    avail = mm.GetExRamSizeReal() - (a & mm.GetExRamMask());
+  }
+  if (base && size <= avail)
+    return base;
+  static std::mutex s_mtx;
+  static std::map<std::pair<std::string, u32>, unsigned long long> s_hits;
+  unsigned long long n;
+  {
+    std::lock_guard lk(s_mtx);
+    n = ++s_hits[{loc.file_name(), static_cast<u32>(loc.line())}];
+  }
+  unsigned long long p = 1;
+  while (p < n)
+    p *= 10;
+  if (p == n)
+  {
+    const char* f = loc.file_name();
+    if (const char* s = std::strrchr(f, '/'))
+      f = s + 1;
+    auto& ppc = Core::System::GetInstance().GetPPCState();
+    std::fprintf(stderr, "PC5090 BADPTR %s:%u addr %08x size %zu PC %08x LR %08x (hit %llu)\n", f,
+                 static_cast<unsigned>(loc.line()), address, size, ppc.pc, LR(ppc), n);
+  }
+  return nullptr;
+}
