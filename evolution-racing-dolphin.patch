+bool ReadU32(u32 a, u32* o)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const u8* p = memory.GetPointerForRange(a, 4);
+  if (!p)
+    return false;
+  u32 v;
+  std::memcpy(&v, p, 4);
+  *o = Common::swap32(v);
+  return true;
+}
+
+bool ReadRamView(float* V)
+{
+  u32 rel = 0, cam = 0;
+  if (!ReadU32(0x800030C8, &rel) || rel < 0x80000000u || rel >= 0x81800000u || !ReadU32(rel + 0x1BAFAC, &cam) ||
+      cam < 0x80000000u || cam >= 0x81800000u - 0x200)
+    return false;
+  for (u32 i = 0; i < 12; i++)
+  {
+    u32 w = 0;
+    if (!ReadU32(cam + 0xdc + 4 * i, &w))
+      return false;
+    std::memcpy(&V[i], &w, 4);
+    if (!std::isfinite(V[i]))
+      return false;
+  }
+  for (int i = 0; i < 3; i++)
+    for (int j = 0; j < 3; j++)
+    {
+      const float d = V[i * 4] * V[j * 4] + V[i * 4 + 1] * V[j * 4 + 1] + V[i * 4 + 2] * V[j * 4 + 2];
+      if (std::abs(d - (i == j ? 1.0f : 0.0f)) > 0.02f)
+        return false;
+    }
+  return true;
+}
+
+// the race gate: venue (top half of [REL + 0x197DE0], < 256 = a race), course slot (u16 at REL + 0x18B5AC), attract
+// demo (REL + 0x17D2FC nonzero); false when the REL is not there
+bool ReadGate(u32* venue, u32* slot, bool* demo)
+{
+  u32 rel = 0, word = 0, sw = 0, d = 0;
+  if (!ReadU32(0x800030C8, &rel) || rel < 0x80000000u || rel >= 0x81800000u || !ReadU32(rel + 0x197DE0, &word))
+    return false;
+  *venue = word >> 16;
+  *demo = ReadU32(rel + 0x17D2FC, &d) && d != 0;
+  *slot = 0xFFFF;
+  if (ReadU32((rel + 0x18B5AC) & ~3u, &sw))
+    *slot = (sw >> (((rel + 0x18B5AC) & 2u) ? 0 : 16)) & 0xFFFFu;
+  return true;
+}
