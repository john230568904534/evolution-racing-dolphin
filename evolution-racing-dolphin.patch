+
+bool TextureCacheBase::HiresKeepPut(TCacheEntry* entry)
+{
+  if (m_hires_keep_budget == 0 || !entry->is_custom_tex || !entry->texture)
+    return false;
+  const auto data = entry->custom_data.lock();
+  if (!data)
+    return false;
+  u64 bytes = 0;
+  for (const auto& slice : data->m_slices)
+    for (const auto& level : slice.m_levels)
+      bytes += level.data.size();
+  if (bytes > m_hires_keep_budget)
+    return false;
+  auto& k = m_hires_keep[data.get()];
+  if (k.texture)  // the same HD data held by two entries: the older texture goes to the pool
+  {
+    m_hires_keep_bytes -= k.bytes;
+    const auto config = k.texture->GetConfig();
+    m_texture_pool.emplace(config, TexPoolEntry(std::move(k.texture), nullptr));
+  }
+  k.data = data;
+  k.texture = std::move(entry->texture);
+  entry->framebuffer.reset();
+  k.bytes = bytes;
+  k.stamp = ++m_hires_keep_stamp;
+  m_hires_keep_bytes += bytes;
+  while (m_hires_keep_bytes > m_hires_keep_budget && !m_hires_keep.empty())
+  {
+    auto oldest = m_hires_keep.begin();
+    for (auto it = m_hires_keep.begin(); it != m_hires_keep.end(); ++it)
+      if (it->second.stamp < oldest->second.stamp)
+        oldest = it;
+    m_hires_keep_bytes -= oldest->second.bytes;
+    m_hires_keep.erase(oldest);
+  }
+  return true;
+}
+
+std::unique_ptr<AbstractTexture>
+TextureCacheBase::HiresKeepTake(const VideoCommon::CustomTextureData* data,
+                                const TextureConfig& config)
+{
+  const auto it = m_hires_keep.find(data);
+  if (it == m_hires_keep.end())
+    return nullptr;
+  std::unique_ptr<AbstractTexture> tex;
+  // the same live HD data object (a reloaded asset is a new object: the weak pointer expires)
+  if (it->second.data.lock().get() == data && it->second.texture &&
+      it->second.texture->GetConfig() == config)
+  {
+    tex = std::move(it->second.texture);
+  }
+  m_hires_keep_bytes -= it->second.bytes;
+  m_hires_keep.erase(it);
+  return tex;
 }
 
