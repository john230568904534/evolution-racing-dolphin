+// ---------------------------------------------------------------- a newer Dolphin
+bool StageDolphin(const Item& it, const std::string& archive, std::string* message)
+{
+  picojson::object o;
+  o["version"] = picojson::value(it.version);
+  o["file"] = picojson::value(P(archive).filename().string());
+  o["sha256"] = picojson::value(it.sha256);
+  o["size"] = picojson::value(static_cast<double>(it.size));
+#ifdef _WIN32
+  // unpack next to this folder now (the next start, or Restart, switches to it)
+  const fs::path parent = P(Strip(TopDir())).parent_path();
+  std::string target = S(parent / ("EvolutionRacing-Dolphin-" + it.version));
+  for (int k = 2; File::Exists(target) && !File::Exists(target + "/er-staged-by-updater.txt"); ++k)
+    target = S(parent / fmt::format("EvolutionRacing-Dolphin-{}-{}", it.version, k));
+  std::error_code ec;
+  const std::string tmp = S(parent / (".er-update-" + it.version));
+  fs::remove_all(P(tmp), ec);
+  fs::remove_all(P(target), ec);
+  {
+    Zip z(archive);
+    if (!z.error.empty())
+    {
+      *message = z.error;
+      return false;
+    }
+    for (const auto& [n, sz] : z.entries)
+      if (!SafeName(n) || !n.starts_with("EvolutionRacing-Dolphin/"))
+      {
+        *message = "not an Evolution Racing Dolphin download: " + n;
+        return false;
+      }
+    if (z.Extract([](const std::string&) { return true; }, [&](const std::string& n) { return tmp + "/" + n; }, nullptr) <= 0)
+    {
+      fs::remove_all(P(tmp), ec);
+      *message = "could not unpack the new Dolphin next to this folder: " + z.error;
+      return false;
+    }
+  }
+  fs::rename(P(tmp + "/EvolutionRacing-Dolphin"), P(target), ec);
+  fs::remove_all(P(tmp), ec);
+  if (ec || !File::Exists(target + "/Dolphin.exe"))
+  {
+    *message = "could not put the new Dolphin next to this folder (" + ec.message() + ")";
+    return false;
+  }
+  File::WriteStringToFile(target + "/er-staged-by-updater.txt", it.version + "\n");
+  const std::string nu = target + "/User/Config/";
+  File::CreateFullPath(nu);
+  for (const char* f : {"GFX.ini", "er-quality.txt"})  // no quality question in the new folder
+    File::Copy(File::GetUserPath(D_CONFIG_IDX) + f, nu + f);
+  File::WriteStringToFile(nu + "er-import-from.txt", Strip(TopDir()) + "\n");
+  o["folder"] = picojson::value(target);
+  File::Delete(archive);
+#endif
+  WriteJson(Dir() + "pending-dolphin.json", o);
+  Log("new Dolphin ready: " + it.version);
+  *message = "Evolution Racing Dolphin " + it.version + " is ready";
+  return true;
+}
+
+bool DolphinStaged()
+{
+  return File::Exists(Dir() + "pending-dolphin.json") || File::Exists(Dir() + "moved-to.txt");
+}
+
+bool StartNewFolder(const std::vector<std::string>& args)
+{
+#ifdef _WIN32
+  std::string target;
+  if (File::ReadFileToString(Dir() + "moved-to.txt", target))
+  {
+    target = Strip(std::string(StripWhitespace(target)));
+  }
+  else
+  {
+    const picojson::object o = ReadJsonObject(Dir() + "pending-dolphin.json");
+    target = Str(o, "folder");
+    if (target.empty())
+      return false;
+  }
+  const std::string exe = target + "/Dolphin.exe";
+  if (!File::Exists(exe))
+    return false;
+  File::WriteStringToFile(Dir() + "moved-to.txt", target + "\n");
+  File::Delete(Dir() + "pending-dolphin.json");
+  std::wstring cmd = L"\"" + UTF8ToWString(exe) + L"\" -u \"" + UTF8ToWString(target + "/User") + L"\"";
+  for (size_t i = 0; i < args.size(); ++i)
+  {
+    if (args[i] == "-u" || args[i] == "--user")
+    {
+      ++i;
+      continue;
+    }
+    cmd += L" \"" + UTF8ToWString(args[i]) + L"\"";
+  }
+  STARTUPINFOW si{};
+  si.cb = sizeof si;
+  PROCESS_INFORMATION pi{};
+  std::wstring wdir = UTF8ToWString(target);
+  if (!CreateProcessW(nullptr, cmd.data(), nullptr, nullptr, FALSE, 0, nullptr, wdir.c_str(), &si, &pi))
+    return false;
+  CloseHandle(pi.hThread);
+  CloseHandle(pi.hProcess);
+  Log("started the new folder " + target);
+  return true;
+#else
+  (void)args;
+  return false;
+#endif
+}
+
+void RestartViaLink()
+{
+  Log("restart asked (evoracing://restart through the desktop)");
+}
+
+std::string ImportIfAsked()
+{
+  const std::string marker = File::GetUserPath(D_CONFIG_IDX) + "er-import-from.txt";
+  std::string old;
+  if (!File::ReadFileToString(marker, old))
+    return {};
+  old = Strip(std::string(StripWhitespace(old)));
+  const std::string ou = UserOf(old), nu = UserDir();
+  if (ou.empty() || P(Strip(ou)) == P(Strip(nu)))
+  {
+    File::Delete(marker);
+    return "the older folder was not found: nothing was brought over (" + old + ")";
+  }
+  if (!WaitLockFree(ou, 60))
+    return {};  // the older Dolphin still runs: next start
+  int files = 0;
+  for (const char* d : {"GC", "Wii", "StateSaves", "Load/GraphicMods/GFZE01-fx/scenery", "ERGhosts"})
+    CopyTree(P(ou + d), P(nu + d), false, &files);
+  std::error_code ec;
+  fs::remove(P(nu + "ERGhosts/running.lock"), ec);
+  CopyTree(P(ou + "Load/Textures"), P(nu + "Load/Textures"), true, &files);
+  // the effects pack fits the newer Dolphin too (an effects pack only ever needs an older or the same build)
+  bool fx = false;
+  for (const char* d : EFFECT_DIRS)
+    if (File::IsDirectory(ou + "Load/GraphicMods/" + d))
+    {
+      fs::remove_all(P(nu + "Load/GraphicMods/" + d), ec);
+      CopyTree(P(ou + "Load/GraphicMods/" + d), P(nu + "Load/GraphicMods/" + d), false, &files);
+      fx = true;
+    }
+  std::vector<std::string> cfg = {"GCPadNew.ini", "Hotkeys.ini", "GCKeyNew.ini", "WiimoteNew.ini", "GFX.ini",
+                                  "er-quality.txt", "er-ghosts.txt", "er-updates.txt"};
+  if (fx)
+    for (const char* f : {"GraphicMods/GFZE01.json", "er-pack.json"})
+      cfg.push_back(f);
+  for (const std::string& f : cfg)
+    if (File::Exists(ou + "Config/" + f))
+    {
+      File::CreateFullPath(nu + "Config/" + f);
+      File::Copy(ou + "Config/" + f, nu + "Config/" + f);
+    }
+  // game folders and controller ports from Dolphin.ini
+  Common::IniFile oi, ni;
+  if (oi.Load(ou + "Config/Dolphin.ini"))
+  {
+    ni.Load(nu + "Config/Dolphin.ini");
+    for (const auto& [sec, keep] : std::vector<std::pair<std::string, std::function<bool(const std::string&)>>>{
+             {"General", [](const std::string& k) { return k.starts_with("ISOPath") || k == "RecursiveISOPaths"; }},
+             {"Core", [](const std::string& k) { return k.starts_with("SIDevice"); }}})
+    {
+      std::vector<std::string> keys;
+      oi.GetKeys(sec, &keys);
+      for (const std::string& k : keys)
+      {
+        if (!keep(k))
+          continue;
+        std::string v;
+        oi.GetOrCreateSection(sec)->Get(k, &v);
+        ni.GetOrCreateSection(sec)->Set(k, v);
+      }
+    }
+    ni.Save(nu + "Config/Dolphin.ini");
+  }
+  // what is installed (the effects only when they came along)
+  picojson::object oj = ReadJsonObject(ou + "Config/er-installed.json"), nj = ReadJsonObject(InstalledPath());
+  for (const char* k : {"hd", "hd_extra", "scenery", "updater", "effects"})
+    if (oj.count(k) && (std::string(k) != "effects" || fx))
+      nj[k] = oj[k];
+  WriteJson(InstalledPath(), nj);
+  Common::ERVersionChanged();
+  // packs the older folder downloaded for this Dolphin
+  CopyTree(P(ou + "ERUpdates/pending"), P(nu + "ERUpdates/pending"), false, nullptr);
+  WriteMetadata();
+  for (const char* line : {"Effects pack:", "HD textures:"})
+  {
+    std::string t;
+    if (File::ReadFileToString(ou + "Config/er-status.txt", t))
+      for (const std::string& l : SplitString(t, '\n'))
+        if (l.starts_with(line))
+          StatusLine(line, l);
+  }
+#ifdef _WIN32
+  File::CreateFullPath(ou + "ERUpdates/");
+  File::WriteStringToFile(ou + "ERUpdates/moved-to.txt", Strip(TopDir()) + "\n");
+  File::Delete(ou + "ERUpdates/pending-dolphin.json");
+#endif
+  File::Delete(marker);
+  File::Delete(Strip(TopDir()) + "/er-staged-by-updater.txt");
+  Log(fmt::format("imported from {}: {} files", old, files));
+  return fmt::format("brought over from the older folder: saves, settings, packs and the hub link ({} files)", files);
+}
