+void LoadFonts()
+{
+  ImGuiIO& io = ImGui::GetIO();
+  if (io.Fonts->Fonts.empty())
+    io.Fonts->AddFontDefault();  // Dolphin's own OSD keeps the first font
+  const std::string dir = File::GetSysDirectory() + DIR_SEP + RESOURCES_DIR + DIR_SEP + "PC5090" + DIR_SEP;
+  const auto load = [&](const char* name) -> ImFont* {
+    const std::string f = dir + name;
+    if (!File::Exists(f))
+    {
+      std::fprintf(stderr, "WXMENU font %s missing (the panel uses the OSD font)\n", f.c_str());
+      return nullptr;
+    }
+    return io.Fonts->AddFontFromFileTTF(f.c_str());
+  };
+  s_font_head = load("Orbitron.ttf");
+  s_font_body = load("NotoSans-SemiBold.ttf");
+  s_font_bold = load("NotoSans-Bold.ttf");
+  // the game's own menu fonts (lighting_mod/menu_font.py, from the player's disc): items 12x12 cells by ASCII code,
+  // title 18x18 cells from ' '
+  const std::string ud = File::GetUserPath(D_LOAD_IDX) + "PC5090" + DIR_SEP;
+  s_have_bmp = LoadBmpFont(&s_bf_item, ud + "menu_font.png", 12, 12, 16, 0, false) &&
+               LoadBmpFont(&s_bf_title, ud + "menu_title.png", 18, 18, 12, 32, true);
+  if (!s_have_bmp)
+    std::fprintf(stderr, "WXMENU no game fonts in %s (run lighting_mod/menu_font.py): Noto Sans\n", ud.c_str());
+}
+
+int NightOverride(u32 slot, int track_look)
+{
+  if (s_nm_on.load())
+  {
+    s_track_look = track_look;
+    return TOD[s_nm_t.load()].code;
+  }
+  if (!OverlayOn())
+    return -1;
+  if (slot == s_slot.load())
+    s_track_look = track_look;
+  std::lock_guard lk(s_mu);
+  const auto it = s_choice.find(slot);
+  if (it == s_choice.end())
+    return -1;
+  return TOD[it->second.tod].code;
+}
+
+void WeatherOverride(u32 slot, std::array<float, 4>* w)
+{
+  if (s_nm_on.load())
+  {
+    s_track_wtype = static_cast<int>((*w)[0] + 0.5f);
+    const int type = WEATHER[s_nm_w.load()].code, in = s_nm_i.load();
+    const bool track_wx = (*w)[0] > 0.5f;
+    if (type < 0)
+    {
+      if (track_wx && in > 0)
+        (*w)[1] = INTENSITY_VAL[in - 1];  // the track's weather at the picked intensity
+      return;
+    }
+    if (type == 0)
+    {
+      *w = {};
+      return;
+    }
+    *w = {static_cast<float>(type), in > 0 ? INTENSITY_VAL[in - 1] : 0.6f, track_wx ? (*w)[2] : 0.0f,
+          track_wx ? (*w)[3] : 0.0f};
+    return;
+  }
+  if (!OverlayOn())
+    return;
+  if (slot == s_slot.load())
+    s_track_wtype = static_cast<int>((*w)[0] + 0.5f);
+  std::lock_guard lk(s_mu);
+  const auto it = s_choice.find(slot);
+  if (it == s_choice.end())
+    return;
+  const Choice& c = it->second;
+  const int type = WEATHER[c.weather].code;
+  if (type < 0)
+    return;  // track default
+  if (type == 0)
+  {
+    *w = {};
+    return;
+  }
+  // keep the track's wind when it has weather of its own (the builder's wind), else still air
+  const bool track_wx = (*w)[0] > 0.5f;
+  *w = {static_cast<float>(type), INTENSITY_VAL[c.intensity], track_wx ? (*w)[2] : 0.0f, track_wx ? (*w)[3] : 0.0f};
+}
+
+void FilterPad(int chan, GCPadStatus* s)
+{
+  if (chan != 0 || !s)
+    return;
+  const bool overlay = OverlayOn();
+  NativeSync(!overlay);
+  if (!overlay)
+    return;  // lit17s29m: the native pause lines; the overlay panel is off (GFX.ini [PC5090] WeatherMenu = Overlay)
+  const u16 raw = s->button;
+  const u16 pressed = raw & ~s_prev;
+  s_prev = raw;
+  s_swallow &= raw;  // released buttons go back to the game
+  const bool vis = s_visible.load();
+  if (!vis)
+  {
+    if (s_focus.exchange(false))
+      s_swallow |= raw;
+    s_dir = 0;
+  }
+  const auto neutral_sticks = [&] {
+    s->stickX = GCPadStatus::MAIN_STICK_CENTER_X;
+    s->stickY = GCPadStatus::MAIN_STICK_CENTER_Y;
+    s->substickX = GCPadStatus::C_STICK_CENTER_X;
+    s->substickY = GCPadStatus::C_STICK_CENTER_Y;
+  };
+  const int dx = static_cast<int>(s->stickX) - 128, dy = static_cast<int>(s->stickY) - 128;
+  if (s_stick_swallow)
+  {
+    if (std::abs(dx) < 32 && std::abs(dy) < 32)
+      s_stick_swallow = false;
+    else
+      neutral_sticks();
+  }
+  const bool was_focus = s_focus.load();
+  if (vis && !was_focus)
+  {
+    if (pressed & PAD_TRIGGER_Z)
+    {
+      s_focus = true;
+      s_dir = 100;  // a held direction does not act until it is let go
+      s_swallow |= raw;
+      std::lock_guard lk(s_mu);
+      Choice& c = s_choice[s_slot.load()];
+      FixRow(c);
+      Log("focus", s_slot.load(), c);
+    }
+    s->button &= ~PAD_TRIGGER_Z;  // Z is the panel's button while it shows
+  }
+  if (vis && was_focus && s_focus.load())
+  {
+    if (pressed & PAD_BUTTON_START)
+    {
+      // START resumes the race (passed to the game); the panel lets go
+      s_focus = false;
+      s_swallow |= raw & ~PAD_BUTTON_START;
+      s_stick_swallow = true;
+      s->button &= ~s_swallow;
+      neutral_sticks();
+      s->triggerLeft = s->triggerRight = 0;
+      return;
+    }
+    if (pressed & (PAD_BUTTON_B | PAD_TRIGGER_Z))
+    {
+      s_focus = false;
+      s_swallow |= raw;
+      s_stick_swallow = true;
+      std::lock_guard lk(s_mu);
+      Log("done", s_slot.load(), s_choice[s_slot.load()]);
+    }
+    else
+    {
+      int dir = 0;
+      if ((raw & PAD_BUTTON_UP) || dy > 60)
+        dir = 1;
+      else if ((raw & PAD_BUTTON_DOWN) || dy < -60)
+        dir = 2;
+      else if ((raw & PAD_BUTTON_LEFT) || dx < -60)
+        dir = 3;
+      else if ((raw & PAD_BUTTON_RIGHT) || dx > 60)
+        dir = 4;
+      const auto now = std::chrono::steady_clock::now();
+      if (s_dir == 100)
+      {
+        if (dir == 0)
+          s_dir = 0;
+      }
+      else if (dir != s_dir)
+      {
+        s_dir = dir;
+        if (dir)
+        {
+          std::lock_guard lk(s_mu);
+          Act(dir);
+          s_repeat = now + std::chrono::milliseconds(420);
+        }
+      }
+      else if (dir && now >= s_repeat)
+      {
+        std::lock_guard lk(s_mu);
+        Act(dir);
+        s_repeat = now + std::chrono::milliseconds(150);
+      }
+      if (pressed & PAD_BUTTON_A)
+      {
+        std::lock_guard lk(s_mu);
+        Act(5);
+      }
+    }
+    // the game sees an idle pad (only the origin bit is kept)
+    s->button = raw & PAD_GET_ORIGIN;
+    neutral_sticks();
+    s->triggerLeft = s->triggerRight = 0;
+    s->analogA = s->analogB = 0;
+    return;
+  }
+  s->button &= ~s_swallow;
+}
+
+void Draw(float W, float H)
+{
+  if (!OverlayOn())
+  {
+    s_visible = false;
+    return;
+  }
+  Update();
+  if (!s_visible.load() || W < 64 || H < 64)
+    return;
+  Choice c;
+  int row;
+  {
+    std::lock_guard lk(s_mu);
+    c = s_choice[s_slot.load()];
+    FixRow(c);
+    row = s_row;
+  }
+  const bool focus = s_focus.load();
+  s_alpha = std::clamp((s_stall - 5) / 8.0f, 0.0f, 1.0f);
+  if (s_alpha <= 0.0f)
+    return;
+  const bool ultra = QualityUltra();
+  const int tlook = s_track_look.load(), twx = s_track_wtype.load();
+
+  // the game's picture on the backbuffer; the game's [ MENU ] box is centred on it: 604 x 388 (1080p units) at y 341
+  float gl = 0, gt = 0, gw = W, gh = H;
+  if (g_presenter)
+  {
+    const auto& tr = g_presenter->GetTargetRectangle();
+    if (tr.GetWidth() > 64 && tr.GetHeight() > 64)
+    {
+      gl = static_cast<float>(tr.left);
+      gt = static_cast<float>(tr.top);
+      gw = static_cast<float>(tr.GetWidth());
+      gh = static_cast<float>(tr.GetHeight());
+    }
+  }
+  const float s = gh / 1080.0f;
+  const float cx = gl + gw * 0.5f;
+  const float x0 = cx + 302 * s + 14 * s, x1 = x0 + 570 * s;
+  const float y0 = gt + 341 * s, y1 = gt + 729 * s;
+  ImDrawList* dl = ImGui::GetForegroundDrawList();
+
+  // the box: soft cyan glow, navy glass, a bright rounded rim and a thin chamfered inner line (as the game's)
+  const float rad = 18 * s;
+  for (int i = 3; i >= 1; i--)
+    dl->AddRect(ImVec2(x0 - i * 3 * s, y0 - i * 3 * s), ImVec2(x1 + i * 3 * s, y1 + i * 3 * s),
+                Col(80, 230, 255, 0.10f + 0.08f * (3 - i)), rad + i * 3 * s, 0, 4 * s);
+  dl->AddRectFilled(ImVec2(x0 + 2 * s, y0 + 2 * s), ImVec2(x1 - 2 * s, y1 - 2 * s), Col(14, 38, 86, 0.76f), rad);
+  dl->AddRect(ImVec2(x0, y0), ImVec2(x1, y1), Col(120, 236, 255, 1.0f), rad, 0, 4 * s);
+  {
+    const float i = 10 * s, cf = 12 * s;
+    const ImVec2 pts[] = {{x0 + i + cf, y0 + i}, {x1 - i - cf, y0 + i}, {x1 - i, y0 + i + cf}, {x1 - i, y1 - i - cf},
+                          {x1 - i - cf, y1 - i}, {x0 + i + cf, y1 - i}, {x0 + i, y1 - i - cf}, {x0 + i, y0 + i + cf}};
+    dl->AddPolyline(pts, 8, Col(60, 180, 255, 0.9f), ImDrawFlags_Closed, 2 * s);
+  }
+
+  dl->AddCallback(LinearOn, nullptr);
+  const float mid = (x0 + x1) * 0.5f;
+  const auto centred = [&](bool title, float y, float size, ImU32 col, const char* t) {
+    AnyText(dl, title, size, ImVec2(mid - AnyWidth(title, size, t) * 0.5f, y), col, t);
+  };
+  // the title, like "F-ZERO GX / [ MENU ]"
+  centred(true, gt + 365 * s, 40 * s, Col(255, 255, 255, 1.0f), "EVOLUTION");
+  centred(true, gt + 405 * s, 40 * s, Col(255, 255, 255, 1.0f), "[ WEATHER ]");
+
+  // rows on the game's item lines (Continue / Retry / Settings / Quit: 493 + 54 k)
+  const ImU32 yellow = Col(255, 236, 0, 1.0f), grey = Col(200, 204, 212, 1.0f), dim = Col(200, 204, 212, 0.40f);
+  const ImU32 cyan = Col(110, 200, 240, 1.0f), cyan_dim = Col(110, 200, 240, 0.40f);
+  char buf[96];
+  int k = 0;
+  for (int r = 0; r < N_ROWS; r++)
+  {
+    if (!RowShown(r))
+      continue;
+    const bool en = RowEnabled(r, c);
+    const bool sel = focus && r == row;
+    const char* label = "";
+    const char* val = "";
+    switch (r)
+    {
+    case ROW_WEATHER:
+      label = "WEATHER";
+      if (WEATHER[c.weather].code < 0)
+      {
+        const char* tn = "None";
+        for (const auto& o : WEATHER)
+          if (o.code == twx && o.code > 0)
+            tn = o.name;
+        if (twx > 0 && std::strcmp(tn, "None") == 0)
+          tn = "Other";
+        std::snprintf(buf, sizeof(buf), "Track (%s)", tn);
+        val = buf;
+      }
+      else
+        val = WEATHER[c.weather].name;
+      break;
+    case ROW_INTENSITY:
+      label = "INTENSITY";
+      val = en ? INTENSITY[c.intensity] : "Track";
+      break;
+    case ROW_TOD:
+      label = "TIME OF DAY";
+      if (TOD[c.tod].code < 0)
+      {
+        std::snprintf(buf, sizeof(buf), "Track (%s)", tlook >= 0 && tlook <= 2 ? LOOK_NAME[tlook] : "Day");
+        val = buf;
+      }
+      else
+        val = TOD[c.tod].name;
+      break;
+    case ROW_QUALITY:
+      label = "QUALITY";
+      val = ultra ? "Ultra" : "Low";
+      break;
+    case ROW_EVOLUTION:  // lit17s39 evolution
+      label = "WEATHER EVOLUTION";
+      val = EvolutionDynamic() ? "Dynamic" : "Static";
+      break;
+    }
+    const float yc = gt + (493 + 44 * k) * s;  // lit17s39 evolution: 5 rows
+    const float lx = x0 + 40 * s, vs = 26 * s;
+    AnyText(dl, false, 15 * s, ImVec2(lx, yc - 31 * s), en ? cyan : cyan_dim, label);
+    if (sel)
+    {
+      // <- value -> in the game's yellow, with the game font's own arrows
+      AnyText(dl, false, vs, ImVec2(lx, yc - 8 * s), yellow, s_have_bmp ? "\x1d" : "<");
+      const float w = AnyText(dl, false, vs, ImVec2(lx + vs * 1.4f, yc - 8 * s), yellow, val);
+      AnyText(dl, false, vs, ImVec2(lx + vs * 1.8f + w, yc - 8 * s), yellow, s_have_bmp ? "\x1c" : ">");
+    }
+    else
+    {
+      AnyText(dl, false, vs, ImVec2(lx, yc - 8 * s), en ? grey : dim, val);
+    }
+    k++;
+  }
+
+  // the controls, one line at the bottom of the box
+  std::string z = s_lab_z;
+  for (auto& ch : z)
+    ch = static_cast<char>(std::toupper(static_cast<unsigned char>(ch)));
+  std::string foot;
+  if (!focus)
+    foot = "PRESS " + z + " TO CHANGE";
+  else if (s_have_bmp)
+    foot = "\x1d\x1c CHANGE  \x1e\x1f SELECT  " + z + " DONE";
+  else
+    foot = "LEFT/RIGHT CHANGE  UP/DOWN SELECT  " + z + " DONE";
+  centred(false, gt + 694 * s, 15 * s, Col(150, 210, 240, 1.0f), foot.c_str());
+  dl->AddCallback(LinearOff, nullptr);
+}
