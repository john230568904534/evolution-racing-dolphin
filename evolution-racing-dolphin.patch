+  std::array<float, 3> mmax{-1e30f, -1e30f, -1e30f};
+  for (u32 v = 0; v < num_vertices; v += step)
+  {
+    const u8* vtx = start + static_cast<size_t>(v) * stride;
+    float pos[3] = {0.0f, 0.0f, 0.0f};
+    std::memcpy(pos, vtx + decl.position.offset, sizeof(float) * components);
+    u32 mtx = default_mtx;
+    if (decl.posmtx.enable)
+      mtx = vtx[decl.posmtx.offset] & 0x3f;  // the loaders write the row index as a u32 (LE)
