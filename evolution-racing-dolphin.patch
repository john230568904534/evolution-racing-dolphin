+void LsConfigure(const picojson::object& g)
+{
+  s_lscfg = LsCfg{};
+  if (const auto n = ReadNumericFromJson<double>(g, "every"))
+    s_lscfg.every = static_cast<float>(std::clamp(*n, 2.0, 3600.0));
+  if (const auto n = ReadNumericFromJson<double>(g, "test_every"))
+    s_lscfg.test_every = static_cast<float>(std::max(*n, 0.0));
+  if (const auto n = ReadNumericFromJson<double>(g, "test_first"))
+    s_lscfg.test_first = static_cast<float>(std::max(*n, 0.5));
+  if (const auto it = g.find("types"); it != g.end() && it->second.is<picojson::array>())
+  {
+    s_lscfg.types.clear();
+    for (const auto& v : it->second.get<picojson::array>())
+      if (v.is<double>())
+        s_lscfg.types.push_back(static_cast<int>(v.get<double>()));
+  }
+  s_ls.stage.reset();
+  s_ls = LsState{};
+  s_ls.rng ^= static_cast<u32>(std::chrono::steady_clock::now().time_since_epoch().count());
+  if (s_ls.rng == 0)
+    s_ls.rng = 0x2545F491u;
+  s_ls.every = s_lscfg.every;
+}
