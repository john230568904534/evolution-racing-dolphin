+bool Read32(u32 addr, u32* o)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const u8* p = PC5090TryPointer(memory, addr, 4);
+  if (!p)
+    return false;
+  u32 v;
+  std::memcpy(&v, p, 4);
+  *o = Common::swap32(v);
+  return true;
+}
+bool Read16(u32 addr, u16* o)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const u8* p = PC5090TryPointer(memory, addr, 2);
+  if (!p)
+    return false;
+  u16 v;
+  std::memcpy(&v, p, 2);
+  *o = Common::swap16(v);
+  return true;
+}
