# CMake toolchain: Windows x64 with MinGW-w64 (Fedora's x86_64-w64-mingw32 cross compiler and sysroot)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc)
set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++)
set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)
set(CMAKE_FIND_ROOT_PATH /usr/x86_64-w64-mingw32/sys-root/mingw)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_LIBDIR} "/usr/x86_64-w64-mingw32/sys-root/mingw/lib/pkgconfig:/usr/x86_64-w64-mingw32/sys-root/mingw/share/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
# MSVC-only names the Windows code paths use (Source/Core/Common/MinGWCompat.h, from the Windows patch)
set(CMAKE_CXX_FLAGS_INIT "-include ${CMAKE_SOURCE_DIR}/Source/Core/Common/MinGWCompat.h")
# MSVC takes these from #pragma comment(lib); MinGW-w64 needs them at the end of every link line
set(CMAKE_CXX_STANDARD_LIBRARIES "-lcfgmgr32 -lbthprops -lqwave -ldwmapi -lhid -ldinput8 -ldxguid -lsetupapi -liphlpapi -lwinmm -lws2_32 -lavrt -lole32 -loleaut32 -luuid -lshlwapi -lversion -lpropsys -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lcomdlg32 -ladvapi32" CACHE STRING "" FORCE)
