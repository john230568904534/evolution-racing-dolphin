diff --git a/Source/Core/Common/MinGWCompat.h b/Source/Core/Common/MinGWCompat.h
new file mode 100644
index 0000000..5567a30
--- /dev/null
+++ b/Source/Core/Common/MinGWCompat.h
@@ -0,0 +1,28 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Force-included in MinGW-w64 builds (CMake: -include): MSVC-only names the Windows code paths use.
+#pragma once
+#if defined(__MINGW32__) && defined(__cplusplus)
+#include <share.h>
+#include <tchar.h>
+#include <pthread.h>
+#ifndef __callback
+#define __callback
+#endif
+// memmem (GNU / POSIX 2024): not in the MinGW-w64 C runtime; the race modes search emulated RAM with it
+#include <cstddef>
+#include <cstring>
+inline void* memmem(const void* hay, std::size_t hay_len, const void* needle, std::size_t needle_len)
+{
+  if (needle_len == 0)
+    return const_cast<void*>(hay);
+  if (hay_len < needle_len)
+    return nullptr;
+  const unsigned char* h = static_cast<const unsigned char*>(hay);
+  const unsigned char* n = static_cast<const unsigned char*>(needle);
+  for (std::size_t i = 0; i + needle_len <= hay_len; i++)
+    if (h[i] == n[0] && std::memcmp(h + i, n, needle_len) == 0)
+      return const_cast<unsigned char*>(h + i);
+  return nullptr;
+}
+#endif
