 namespace Common
 {
+#ifdef DOLPHIN_HAS_WINRT
 std::string GetHResultMessage(HRESULT hr)
 {
   auto err = winrt::hresult_error(hr);
@@ -14,4 +15,19 @@ std::string GetHResultMessage(const winrt::hresult& hr)
 {
   return GetHResultMessage(hr.value);
 }
+#else
+std::string GetHResultMessage(HRESULT hr)
+{
+  char* buf = nullptr;
+  const DWORD n = FormatMessageA(FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM |
+                                     FORMAT_MESSAGE_IGNORE_INSERTS,
+                                 nullptr, static_cast<DWORD>(hr), 0, reinterpret_cast<LPSTR>(&buf), 0, nullptr);
+  std::string s = n && buf ? std::string(buf, n) : std::string("HRESULT error");
+  if (buf)
+    LocalFree(buf);
+  while (!s.empty() && (s.back() == '\n' || s.back() == '\r'))
+    s.pop_back();
+  return s;
+}
+#endif
 }  // namespace Common
