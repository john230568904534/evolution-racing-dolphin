# The Windows x64 build environment of the Evolution Racing Dolphin: Fedora 44 with the MinGW-w64 cross compiler and
# MinGW-w64 Qt 6 (Fedora's mingw64-* packages), as used for the distributed build.
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install cmake ninja-build git python3 gettext which file \
      mingw64-gcc-c++ mingw64-qt6-qtbase mingw64-qt6-qtsvg mingw64-qt6-qttools mingw64-winpthreads-static mingw64-vulkan-headers \
    && dnf clean all
# Windows headers are case-insensitive: the names Dolphin / wil use with capitals, linked to MinGW-w64's lower-case files
RUN cd /usr/x86_64-w64-mingw32/sys-root/mingw/include && \
    for h in OleAuto PathCch Psapi Security ShlObj WeakReference WinUser Windows; do \
      l=$(echo $h | tr A-Z a-z); [ -e $h.h ] || ln -s $l.h $h.h; done
